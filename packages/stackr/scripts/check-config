#!/usr/bin/env python3
"""Static checks that no service's own validator covers. Run by scripts/validate.

Usage: scripts/check-config dashboards

dashboards: every dashboard under deploy/grafana/dashboards is valid JSON, has
a unique uid and a title, and refers only to the data sources Grafana is
provisioned with (by uid), or to a dashboard variable.
"""

from __future__ import annotations

import json
import sys
from collections.abc import Iterator
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parent.parent
GRAFANA = ROOT / "deploy" / "grafana"


def walk(node: Any) -> Iterator[dict[str, Any]]:
    """Yield every JSON object in a document, depth first."""
    if isinstance(node, dict):
        yield node
        for value in node.values():
            yield from walk(value)
    elif isinstance(node, list):
        for item in node:
            yield from walk(item)


def provisioned_uids() -> set[str]:
    """The uids of the data sources in Grafana's provisioning."""
    uids: set[str] = set()
    for path in (GRAFANA / "provisioning" / "datasources").glob("*.yaml"):
        document = yaml.safe_load(path.read_text()) or {}
        uids |= {source["uid"] for source in document.get("datasources", [])}
    return uids


def check_dashboards() -> list[str]:
    """Check every dashboard file; return the problems found."""
    problems: list[str] = []
    known = provisioned_uids()
    seen: dict[str, Path] = {}
    for path in sorted((GRAFANA / "dashboards").rglob("*.json")):
        name = path.relative_to(ROOT)
        before = len(problems)
        try:
            dashboard = json.loads(path.read_text())
        except json.JSONDecodeError as error:
            problems.append(f"{name}: invalid JSON: {error}")
            continue
        uid, title = dashboard.get("uid"), dashboard.get("title")
        if not uid or not title:
            problems.append(f"{name}: needs a uid and a title")
        elif uid in seen:
            problems.append(f"{name}: uid {uid!r} is also used by {seen[uid]}")
        else:
            seen[uid] = name
        for node in walk(dashboard):
            source = node.get("datasource")
            if isinstance(source, dict) and "uid" in source:
                ref = str(source["uid"])
                if ref not in known and not ref.startswith("$") and not ref.startswith("-- "):
                    problems.append(f"{name}: unknown data source uid {ref!r}")
        if len(problems) == before:
            print(f"ok: {name}")
    if not seen and not problems:
        print("none yet")
    return problems


def main() -> int:
    checks = {"dashboards": check_dashboards}
    if len(sys.argv) != 2 or sys.argv[1] not in checks:
        print(f"usage: scripts/check-config {{{','.join(checks)}}}", file=sys.stderr)
        return 2
    problems = checks[sys.argv[1]]()
    for problem in problems:
        print(f"FAIL: {problem}", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
