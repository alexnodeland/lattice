def test_a_restarted_application_follows_the_workspaces_it_knows(
    tmp_path: Path, script: Script
) -> None:
    url = f"sqlite+aiosqlite:///{tmp_path / 'app.db'}"
    config = Settings(database_url=url, auth=settings().auth, gateway=settings().gateway)
    with TestClient(app(script, config), headers=bearer()) as client:
        command(client, type="create_thread", thread_id="t1")
        wait_for(lambda: asyncio.run(_followed(url)))
    asyncio.run(_write_while_stopped(url))  # a message no follower saw
    with TestClient(app(script, config), headers=bearer()) as client:
        wait_for(lambda: asyncio.run(_cursor(url)) >= 2)
        bridged = client.get(f"{REFLEXR}/events", params={"type": "artifactr:message_posted"})
        contents = [e["event"]["content"] for e in bridged.json()]
        assert contents == ["While the application was stopped"]


async def _write_while_stopped(url: str) -> None:
    engine = open_database(url, schema="").engine
    try:
        workspaces = Workspaces(SqlStorage(engine))
        workspace = await workspaces.open(TENANT, "main", actor=UserActor(id="alice"))
        await workspace.post_message("t1", "While the application was stopped")
    finally:
        await engine.dispose()


async def _followed(url: str) -> list[WorkspaceKey]:
    engine = open_database(url, schema="").engine
    try:
        return await SqlLedger(engine).followed()
    finally:
        await engine.dispose()


async def _cursor(url: str) -> int:
    engine = open_database(url, schema="").engine
    try:
        return await SqlLedger(engine).cursor(WorkspaceKey(TENANT, "main"))
    finally:
        await engine.dispose()


def test_a_resolution_with_no_incident_closes_nothing(client: TestClient) -> None:
    resolved = {"type": RESOLVED, "service": "none", "summary": "Nothing."}
    assert client.post(f"{REFLEXR}/events", json={"event": resolved}).status_code == 200

    def ran() -> list[str]:
        params = {"rule": "{{ package_name }}:close-incident"}
        return [r["status"] for r in client.get(f"{REFLEXR}/runs", params=params).json()]

    wait_for(lambda: ran() == ["succeeded"])
    assert client.get(f"{ARTIFACTR}/proposals").json() == []


def alert(client: TestClient, service: str, summary: str = "Payments fail") -> str:
    """Fire an alert, and wait for its incident: the incident's thread."""
    before = {t["data"]["thread_id"] for t in timelines(client)}
    fired = {"type": FIRED, "service": service, "summary": summary}
    assert client.post(f"{REFLEXR}/events", json={"event": fired}).status_code == 200
    wait_for(lambda: {t["data"]["thread_id"] for t in timelines(client)} - before)
    [thread] = {t["data"]["thread_id"] for t in timelines(client)} - before
    return thread


def resolve(client: TestClient, service: str, summary: str = "Rolled back.") -> None:
    """Resolve a service's incident, and wait for close-incident's run to end."""
    before = len(closings(client))
    resolved = {"type": RESOLVED, "service": service, "summary": summary}
    assert client.post(f"{REFLEXR}/events", json={"event": resolved}).status_code == 200
    wait_for(lambda: len(closings(client)) > before and "succeeded" in closings(client)[:1])


def closings(client: TestClient) -> list[str]:
    params = {"rule": "{{ package_name }}:close-incident"}
    return [r["status"] for r in client.get(f"{REFLEXR}/runs", params=params).json()]


def postmortems(client: TestClient) -> list[dict[str, Any]]:
    found = client.get(f"{ARTIFACTR}/proposals").json()
    return [p for p in found if p["change"].get("kind") == "postmortem"]


def test_a_resolution_closes_its_incident_with_a_postmortem(client: TestClient) -> None:
    thread = alert(client, "checkout")
    resolve(client, "checkout")
    [proposal] = postmortems(client)
    assert proposal["thread_id"] == thread
    entry = {"source": "monitoring", "text": "Payments fail"}
    assert proposal["change"]["data"]["timeline"] == [entry]
    assert proposal["rationale"] == (
        "Drawn from the incident's timeline, 1 entry, and from its resolution: Rolled back."
    )
    closed = "Resolved: Rolled back. Its postmortem is proposed for review."
    wait_for(lambda: notices(client, thread)[-1:] == [closed])
    assert timelines(client)[0]["data"]["resolved_at"] is not None

    resolve(client, "checkout", "Resolved again.")
    assert len(postmortems(client)) == 1, "a resolved incident is closed once"


def test_the_latest_open_incident_of_the_service_is_closed(client: TestClient) -> None:
    first = alert(client, "checkout")
    latest = alert(client, "checkout", "Payments fail again")
    other = alert(client, "billing")
    resolve(client, "checkout")
    assert [p["thread_id"] for p in postmortems(client)] == [latest]
    resolve(client, "checkout")
    assert [p["thread_id"] for p in postmortems(client)] == [latest, first]
    assert other not in [p["thread_id"] for p in postmortems(client)]


