"""The application: {% if libraries == 'both' %}artifactr and reflexr side by side{% else %}{{ libraries }}'s surfaces{% endif %}, on one database and telemetry setup.

Run it with ``{{ project_slug }}`` (``make serve``), or beside the stack in its
``app`` profile (``make up``). Every surface needs a Supabase access token{% if access == 'grantr' %}, or a service
principal's key, and names its tenant (``access.py``){% endif %}.
{%- if use_artifactr %}

- ``/artifactr/v1``: artifactr's REST commands and reads, and its WebSocket stream
- ``/artifactr/mcp/``: artifactr's MCP server
{%- endif %}
{%- if use_reflexr %}

- ``/reflexr/v1``: reflexr's REST publishing, reads and administration, and its WebSocket stream
- ``/reflexr/mcp/``: reflexr's MCP server
{%- endif %}
{%- if access == 'grantr' %}

- ``/grantr/v1``: grantr's admin API: tenants, members, groups, roles, grants and keys
{%- endif %}
{%- if use_files %}
- ``/artifactr/v1/workspaces/{w}/files``: native files, while ``FILES_CRAFTS`` names an app
  (``files.py``)
{%- endif %}
{%- if use_portal %}
- ``/portalr``: portalr's app and admin UIs, and the reads behind them (``portal.py``)
{%- endif %}
{%- if use_tracker %}
- ``/relayr/v1/trackers``: where {% if tracker == 'plane' %}Plane{% else %}Vikunja{% endif %}'s webhooks wake relayr's followers (``tracking.py``)
{%- endif %}
"""

import contextlib
from collections.abc import AsyncGenerator
from contextlib import AbstractAsyncContextManager
{%- if use_reflexr %}
from datetime import timedelta
{%- endif %}
from importlib.metadata import metadata
from typing import Protocol

{% if use_files %}import httpx
{% endif -%}
import uvicorn
from fastapi import FastAPI
from pydantic_ai.models import Model
{%- if access == 'grantr' or use_integrations %}
{% if access == 'grantr' %}
from grantr import Grants
{%- else %}
from lattice_core.integrations import Defaults
{%- endif %}
{%- if use_tracker %}
from relayr.trackers import Connect
{%- endif %}
{%- endif %}

{% if access == 'grantr' -%}
from {{ package_name }}.access import Access
{% endif -%}
from {{ package_name }}.auth import TokenVerifier
{%- if use_reflexr %}
from {{ package_name }}.automation import STOP_GRACE, Automation
{%- endif %}
{%- if use_relayr %}
from {{ package_name }}.bridge import Bridge
{%- endif %}
{%- if use_artifactr %}
from {{ package_name }}.collaboration import Collaboration
{%- endif %}
from {{ package_name }}.database import Database, create_schema, open_database
{%- if use_files %}
from {{ package_name }}.files import Files
{%- endif %}
from {{ package_name }}.gateway import gateway_model
{%- if use_portal %}
from {{ package_name }}.portal import Portal
{%- endif %}
from {{ package_name }}.redaction import LOG_CONFIG
{%- if use_tracker %}
from {{ package_name }}.scores import opened
{%- endif %}
from {{ package_name }}.settings import Settings
from {{ package_name }}.telemetry import TelemetryHandle, configure
{%- if use_tracker %}
from {{ package_name }}.tracking import Tracking
{%- endif %}

TITLE = {{ project_name | tojson }}
DISTRIBUTION = "{{ project_slug }}"

DRAIN = 2
"""Seconds the server lets open requests finish when the application stops, before it cancels
them and the lifespan shuts down. {% if use_reflexr %}``DRAIN``, the reactor's ``STOP_GRACE`` and the rest of the
shutdown must end within the app profile's ``stop_grace_period``.{% else %}``DRAIN`` and the rest of the shutdown must end within
the time the platform gives a stopping process.{% endif %}"""


class Part(Protocol):
    """One library's surfaces, mounted under a prefix of its own."""

    async def migrate(self, database: Database) -> None:
        """Upgrade the database to the library's schema, as its owner."""
        ...

    def lifespan(self) -> AbstractAsyncContextManager[None]:
        """Run what the library needs while the application is up."""
        ...

    def mount(self, app: FastAPI) -> None:
        """Add the library's routes to the application."""
        ...


def create_app(
    settings: Settings | None = None,
    *,
    model: Model | None = None,
    telemetry: TelemetryHandle | None = None,
{%- if access == 'grantr' %}
    grants: Grants | None = None,
{%- endif %}
{%- if use_reflexr %}
    poll_interval: timedelta = timedelta(seconds=1),
    grace: timedelta = STOP_GRACE,
{%- endif %}
{%- if use_tracker %}
    tracker: Connect | None = None,
{%- endif %}
{%- if use_files %}
    workers: httpx.AsyncBaseTransport | None = None,
{%- endif %}
) -> FastAPI:
    """Build the application.

    Args:
        settings: The settings; read from the environment by default.
        model: The agents' model; the gateway's model group by default. Tests pass a scripted
            one.
        telemetry: OpenTelemetry and Langfuse, as ``telemetry.configure`` sets them up; it
            traces the application's requests and its database's queries.
{%- if access == 'grantr' %}
        grants: grantr, when the caller has built it, as the tests do; otherwise it is built
            over the database.
{%- endif %}
{%- if use_reflexr %}
        poll_interval: How often the reactor looks for work.
        grace: How long the reactor's running actions have to end when the application stops;
            keep it below the time the platform gives a stopping process.
{%- endif %}
{%- if use_tracker %}
        tracker: The task tracker's adapter; {% if tracker == 'plane' %}Plane{% else %}Vikunja{% endif %}'s, over HTTP, by default. Tests pass
            relayr's ``FakeTracker``'s.
{%- endif %}
{%- if use_files %}
        workers: How requests reach native files' workers; HTTP, by their names on the
            ``files`` network, by default. Tests pass the workers themselves.
{%- endif %}
    """
    settings = settings or Settings.from_environ()
    verifier = TokenVerifier.from_settings(settings.auth)
    model = model or gateway_model(settings.gateway)
    database = (
        open_database(
            settings.database_url,
            schema=settings.database_schema,
            admin_url=settings.database_admin_url,
        )
        if settings.database_url
        else None
    )
{%- if access == 'grantr' %}
    access = Access(
        name=settings.service_name,
        verifier=verifier,
        database=database,
        grants=grants,
        telemetry=telemetry,
    )
{%- if use_artifactr %}
    artifactr_hooks = access.grants.hooks(access.artifactr_subject)
{%- endif %}
{%- endif %}
{%- if use_integrations %}
    # Whether each integration is on in a workspace: {% if access == 'grantr' %}as grantr's switches say{% else %}each one's default, everywhere{% endif %}.
    integrations = {% if access == 'grantr' %}access.grants{% else %}Defaults(){% endif %}
{%- endif %}
{%- if use_files %}
    files = Files(settings.files, integrations=integrations, database=database, transport=workers)
{%- endif %}
{%- if use_relayr %}
    bridge = Bridge(database=database, telemetry=telemetry{% if access == 'grantr' %}, grants=access.grants{% endif %})
{%- endif %}
{%- if use_tracker %}
    tracking = Tracking(
        bridge.ledger,
        settings.tracker,
        integrations=integrations,
        connect=tracker,
        telemetry=telemetry,
    )
{%- endif %}
{%- if use_reflexr %}
    automation = Automation(
        name=settings.service_name,
{%- if access == 'grantr' %}
        authenticate=access.authenticate,
        identify=access.identify,
        authorize=access.grants.hooks(access.reflexr_subject).authorize,
{%- else %}
        authenticate=verifier.authenticate,
        identify=verifier.authenticate,
{%- endif %}
        model=model,
        gateway=settings.gateway,
        database=database,
        telemetry=telemetry,
        poll_interval=poll_interval,
        grace=grace,
{%- if use_tracker %}
        on_open=opened(bridge.watch, tracking.watch),
        run_context=bridge.run_context,
        actions={**bridge.actions(), **tracking.actions()},
{%- elif use_relayr %}
        on_open=bridge.watch,
        run_context=bridge.run_context,
        actions=bridge.actions(),
{%- endif %}
    )
{%- endif %}
{%- if use_artifactr %}
    collaboration = Collaboration(
        name=settings.service_name,
{%- if access == 'grantr' %}
        authenticate=access.authenticate,
        identify=access.identify,
        authorize=artifactr_hooks.authorize,
        hidden=artifactr_hooks.hidden,
{%- if use_ui %}
        is_admin=access.administers,
{%- endif %}
{%- else %}
        authenticate=verifier.authenticate,
        identify=verifier.authenticate,
{%- endif %}
{%- if use_ui or use_files %}
        integrations=integrations,
{%- endif %}
{%- if use_files %}
        files=files,
{%- endif %}
        model=model,
        gateway=settings.gateway,
        database=database,
        telemetry=telemetry,
{%- if use_relayr %}
        on_open=bridge.watch,
        turn_context=bridge.turn_context,
        drafting=bridge.drafting(automation),
{%- endif %}
    )
{%- endif %}
{%- if use_relayr %}
    bridge.connect(collaboration, automation)
{%- endif %}
{%- if use_tracker %}
    tracking.connect(automation.workspaces, automation.resolve_actor)
{%- endif %}
{%- if use_portal %}
    portal = Portal(access=access, settings=settings)
{%- endif %}
{%- if use_relayr %}
    # The bridge starts after the libraries' parts, and stops before them.
{%- endif %}
    parts: list[Part] = [
{%- if access == 'grantr' %}
        access,
{%- endif %}
{%- if use_artifactr %}
        collaboration,
{%- endif %}
{%- if use_reflexr %}
        automation,
{%- endif %}
{%- if use_relayr %}
        bridge,
{%- endif %}
{%- if use_tracker %}
        tracking,
{%- endif %}
{%- if use_portal %}
        portal,
{%- endif %}
    ]

    @contextlib.asynccontextmanager
    async def lifespan(_app: FastAPI) -> AsyncGenerator[None]:
        async with contextlib.AsyncExitStack() as stack:
            if database is not None:
                stack.push_async_callback(database.dispose)
                await create_schema(database.owner, settings.database_schema)
                for part in parts:
                    await part.migrate(database)
                await database.check(settings.database_schema)
            for part in parts:
                await stack.enter_async_context(part.lifespan())
            yield

    app = FastAPI(title=TITLE, description=metadata(DISTRIBUTION)["Summary"], lifespan=lifespan)
    for part in parts:
        part.mount(app)

    @app.get("/")
    async def about() -> dict[str, str]:
        """Where the surfaces are."""
        return {
            "name": TITLE,
{%- if access == 'grantr' %}
            "grantr": "/grantr/v1",
{%- endif %}
{%- if use_portal %}
            **({"portalr": "/portalr/"} if portal.configured else {}),
{%- endif %}
{%- if use_artifactr %}
            "artifactr": "/artifactr/v1",
            "artifactr_mcp": "/artifactr/mcp/",
{%- endif %}
{%- if use_reflexr %}
            "reflexr": "/reflexr/v1",
            "reflexr_mcp": "/reflexr/mcp/",
{%- endif %}
        }

    @app.get("/healthz")
    async def health() -> dict[str, str]:
        """Whether the application is up; for health checks, and untraced."""
        return {"status": "ok"}

    if telemetry is not None:
        telemetry.instrument_app(app)
        if database is not None:
            for engine in dict.fromkeys((database.engine, database.owner)):
                telemetry.instrument_engine(engine)
    return app


def main() -> None:
    """Serve the application on ``APP_HOST``:``APP_PORT``, as the environment configures it."""
    settings = Settings.from_environ()
    telemetry = configure(settings)
    try:
        uvicorn.run(
            create_app(settings, telemetry=telemetry),
            host=settings.host,
            port=settings.port,
            timeout_graceful_shutdown=DRAIN,
            log_config=LOG_CONFIG,
        )
    finally:
        if telemetry is not None:
            telemetry.shutdown()
