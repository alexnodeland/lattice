{
  "description": "Forms in artifactr.ui's schema subset, with values each accepts and refuses, and schemas the subset refuses. A refused value names the property at its error's loc; a refused schema names the keyword or the reason in its message, at the loc given. portalr's TypeScript validator reads these too. A refused schema's loc is the Python validator's, which puts the property's kind after its name, as Pydantic tags it; another validator need match only the names.",
  "limits": {
    "measure": "the UTF-8 bytes of a value's compact JSON, as JSON.stringify writes it; max_schema_bytes counts a form's title, schema and ui together",
    "max_properties": 50,
    "max_choices": 64,
    "max_length": 10000,
    "max_schema_bytes": 32768,
    "max_values_bytes": 65536,
    "max_number": 9007199254740991,
    "property_name": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$, and not __proto__, constructor or prototype"
  },
