# {{ project_name }} beside stackr's stack, in the `app` profile: `make up`, or
#
#   docker compose --profile app up --detach --build --wait
#
# Start the stack first (`make up` in stackr): it creates the two networks the application
# joins, `stackr` and local Supabase's, where it reaches the stack's services by name. The
# settings come from .env, except the stack's addresses on its networks, from stackr.env.

name: {{ project_slug }}

services:
  app:
    profiles: [app]
    build: .
    image: {{ project_slug }}:local
    restart: unless-stopped
{%- if use_reflexr %}
    # Docker's default, stated for DRAIN in app.py and STOP_GRACE in automation.py, which must end within it.
    stop_grace_period: 10s
{%- endif %}
    # A later file's value replaces an earlier one's.
    env_file:
      - path: .env
        required: false
      - stackr.env
    environment:
      APP_HOST: 0.0.0.0
      APP_PORT: "8000"
    ports:
      - ${APP_BIND:-127.0.0.1}:${APP_PORT:-{{ app_port }}}:8000
    networks: [stackr, supabase]
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 30s

networks:
  stackr:
    external: true
  supabase:
    name: supabase_network_stackr-supabase
    external: true
