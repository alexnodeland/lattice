meta {
  name: Read a code rule
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/workspaces/{{workspace}}/rules/oncall:runbook
  body: none
  auth: none
}

tests {
  test("it is code, with no version", function () {
    expect(res.status).to.equal(200);
    expect(res.body.origin).to.equal("code");
    expect(res.body.version).to.equal(null);
  });
}
