{
  "components": {
    "schemas": {
      "AgentActor": {
        "description": "The built-in agent of one thread, acting within one run.\n\nA run acts for whoever's message or answer started it: its ``on_behalf_of``, which every\ncheck sees. A run started by the system, or by another agent, acts for no one.",
        "properties": {
          "kind": {
            "const": "agent",
            "default": "agent",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "default": "assistant",
            "title": "Name",
            "type": "string"
          },
          "on_behalf_of": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserActor"
              },
              {
                "$ref": "#/components/schemas/ExternalAgentActor"
              },
              {
                "type": "null"
              }
            ],
            "title": "On Behalf Of"
          },
          "run_id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunId"
              },
              {
                "type": "null"
              }
            ]
          },
          "thread_id": {
            "$ref": "#/components/schemas/ThreadId"
          }
        },
        "required": [
          "thread_id",
          "kind"
        ],
        "title": "AgentActor",
        "type": "object"
      },
      "ArtifactId": {
        "type": "string"
      },
      "CheckedIn": {
        "description": "What a check-in made: a revision, a proposal if it was stale, or nothing.",
        "properties": {
          "outcome": {
            "enum": [
              "applied",
              "proposed",
              "unchanged"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "proposal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "outcome"
        ],
        "title": "CheckedIn",
        "type": "object"
      },
      "Checkout": {
        "description": "A person's check-out of a native file.",
        "properties": {
          "actor": {
            "discriminator": {
              "mapping": {
                "agent": "#/components/schemas/AgentActor",
                "evaluator": "#/components/schemas/EvaluatorActor",
                "external_agent": "#/components/schemas/ExternalAgentActor",
                "system": "#/components/schemas/SystemActor",
                "user": "#/components/schemas/UserActor"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserActor"
              },
              {
                "$ref": "#/components/schemas/AgentActor"
              },
              {
                "$ref": "#/components/schemas/ExternalAgentActor"
              },
              {
                "$ref": "#/components/schemas/SystemActor"
              },
              {
                "$ref": "#/components/schemas/EvaluatorActor"
              }
            ],
            "title": "Actor"
          },
          "artifact_id": {
            "$ref": "#/components/schemas/ArtifactId"
          },
          "base_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Base Sha256",
            "type": "string"
          },
          "base_version": {
            "minimum": 1.0,
            "title": "Base Version",
            "type": "integer"
          },
          "checked_in": {
            "default": false,
            "title": "Checked In",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "artifact_id",
          "base_version",
          "base_sha256",
          "actor",
          "expires_at"
        ],
        "title": "Checkout",
        "type": "object"
      },
      "EvaluatorActor": {
        "description": "An evaluator: a judge or decision model whose verdicts are recorded as feedback.\n\nEvaluators only give feedback; every other command from one is forbidden.",
        "properties": {
          "kind": {
            "const": "evaluator",
            "default": "evaluator",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "kind"
        ],
        "title": "EvaluatorActor",
        "type": "object"
      },
      "ExternalAgentActor": {
        "description": "An agent outside artifactr, connected over MCP.\n\nA person who connects a client with their own credentials acts through it: their actor is\nits ``on_behalf_of``, and it is checked as them. A client with credentials of its own acts\nfor no one.",
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "kind": {
            "const": "external_agent",
            "default": "external_agent",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "on_behalf_of": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserActor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "client_id",
          "kind"
        ],
        "title": "ExternalAgentActor",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": true,
        "description": "One problem FastAPI found with a request's parameters or body.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "FileStatus": {
        "description": "A native file as a person about to check it out sees it.",
        "properties": {
          "artifact_id": {
            "$ref": "#/components/schemas/ArtifactId"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "lease": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Lease"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "outline": {
            "title": "Outline",
            "type": "string"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "talk": {
            "enum": [
              "save",
              "bridged",
              "commands",
              "polled",
              "pushed"
            ],
            "title": "Talk",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "version",
          "name",
          "media_type",
          "size",
          "outline",
          "pages",
          "lease",
          "talk",
          "enabled",
          "limit"
        ],
        "title": "FileStatus",
        "type": "object"
      },
      "Lease": {
        "description": "Who has a native file, until when.",
        "properties": {
          "checked_out_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked Out By"
          },
          "checkout_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkout Id"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "checked_out_by",
          "expires_at"
        ],
        "title": "Lease",
        "type": "object"
      },
      "Refused": {
        "description": "The body of a refused request.\n\n``detail`` is the rejection, the message of a resolver's refusal, or the problems FastAPI\nfound with the request.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RejectionDetail"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Refused",
        "type": "object"
      },
      "RejectionDetail": {
        "additionalProperties": true,
        "description": "A rejection, as REST sends it: its ``type``, its ``message`` and its typed details.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
