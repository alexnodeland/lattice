TYPES: Final[Mapping[str, type[NativeFile]]] = {
{%- for name, craft in crafts.items() %}
    "{{ name }}": {{ craft.type }},
{%- endfor %}
}
"""The native type each app keeps."""


FILE_INSTRUCTIONS: Final = """\
You can create files of any type `create_native_file` lists. Never say you can't create files.

- A file is created empty: in the same turn, find its commands with `find_commands`, then put \
its content in with `edit_native`, in as few batches as you can: each is a proposal a person \
reviews.
- Your edits of these files are proposals, in Ask and Auto alike: the file stays empty until a \
person accepts one. Say the content waits for review, never that the file is written.
"""
"""What the agent is told of native files while any app runs."""


def worker_url(craft: str) -> str:
    """Where an app's worker answers: its relay, on the ``files`` network."""
    return f"http://files-{craft}:8080"
{%- if use_diagrams %}


DIAGRAMS_URL: Final = "http://diagrams:8080"
"""Where the diagrams worker answers: its relay, on the ``files`` network."""

TENDER: Final = SWEEPER
"""Who tends: the sweep's own actor, which sees everything."""
{%- else %}


TENDER: Final = SystemActor(name="files-tend")
"""Who tends: the application's own actor, which sees everything."""
{%- endif %}

TEND_EVERY: Final = 3600.0
"""Seconds between tendings, about: each waits between half and one and a half of it."""

TENDED: Final = timedelta(days=3)
"""How long after a person last opened a workspace it is still tended: long enough for{% if use_diagrams %} a
tombstone, a day old, to be swept, and revisions a day old thinned{% else %} bytes
dropped from it to be collected{% endif %}."""

LOGGER = logging.getLogger(__name__)

_TENDING: ContextVar[bool] = ContextVar("tending", default=False)
"""Whether this task is tending: tending's own opens are no person's, and aren't noted."""


@dataclass(frozen=True)
class Tended:
    """What a tending did: {% if use_diagrams %}tombstones swept, revisions thinned, {% endif %}unnamed bytes collected."""

    workspaces: int = 0
{%- if use_diagrams %}
    swept: int = 0
    thinned: int = 0
{%- endif %}
    collected: int = 0


class Files:
    """Native files in the application: each app's worker, the files' stores, routes and tools.

    Args:
        settings: Which apps run, and the token their workers let in.
        integrations: Whether each app is on in a workspace.
        database: The database; without one, the files' bytes and check-outs live in memory.
        transport: How requests reach the workers; HTTP by default. Tests pass the workers
            themselves.
    """

    def __init__(
        self,
        settings: FilesSettings,
        *,
        integrations: Integrations,
        database: Database | None = None,
        transport: httpx.AsyncBaseTransport | None = None,
    ) -> None:
        self._workers = {
            craft: Worker.at(worker_url(craft), token=settings.tokens[craft], transport=transport)
            for craft in settings.crafts
        }
        self._uploads = settings.uploads
        self._integrations = integrations
        blobs, checkouts = _stores(database, settings)
        self._blobs = blobs
        self.native: NativeFiles | None = None
        if self._workers:
            apps: dict[type[NativeFile], App] = {
                TYPES[craft]: worker for craft, worker in self._workers.items()
            }
            self.native = NativeFiles(
                blobs,
                checkouts,
                apps,
                integrations=integrations,
                readings=settings.uploads.readings,
{%- if use_diagrams %}
                # Diagrams name images in the same store, which its collection keeps.
                naming=(Diagram,),
{%- endif %}
            )
{%- if use_diagrams %}
        self.diagrams = (
            WorkerConverter.at(DIAGRAMS_URL, token=settings.diagrams_token, transport=transport)
            if settings.diagrams
            else None
        )
{%- endif %}
        self._opened: dict[tuple[str, str], float] = {}
        """Workspaces people opened lately, by tenant and id: when, by this process's clock."""
        self._workspaces: Workspaces | None = None
{%- if use_diagrams %}
        self._storage: Storage | None = None
{%- endif %}

    @property
    def types(self) -> list[type[{% if use_diagrams %}Artifact{% else %}NativeFile{% endif %}]]:
        """The native types of the apps that run{% if use_diagrams %}, and diagrams{% endif %}."""
        return [{% if use_diagrams %}Diagram, {% endif %}*(TYPES[craft] for craft in self._workers)]

    def key_of(self, kind: str, data: Mapping[str, JsonValue]) -> str | None:
        """The integration that governs an artifact: its app's, for a native file."""
{%- if use_diagrams %}
        if diagram := excalidraw_key_of(kind, data):
            return diagram
{%- endif %}
        return self.native.key_of(kind, data) if self.native else None
{%- if use_diagrams %}

    def checks(self) -> Mapping[str, Check]:
        """The diagrams' checks, by command type, for ``Workspaces(checks=...)``."""
        return excalidraw_checks()
{%- endif %}

    def toolsets(self) -> list[AbstractToolset[Session[Any]]]:
        """The agent's tools for native files, while any app runs{% if use_diagrams %}; diagrams', with DIAGRAMS=on{% endif %}."""
        found: list[AbstractToolset[Session[Any]]] = []
        if self.native:
            found.append(native_file_tools(self.native))
{%- if use_diagrams %}
        if self.diagrams:
            found.append(
                diagram_tools(self.diagrams, blobs=self._blobs, integrations=self._integrations)
            )
{%- endif %}
        return found

    def instructions(self) -> list[str]:
        """The agent's instructions for native files, while any app runs."""
        return [FILE_INSTRUCTIONS] if self.native else []

    async def migrate(self, database: Database) -> None:
        """Upgrade the database to native files' tables, as its owner, even with no app running.

        Starting a worker later then needs no migration.
        """
        await migrate(database.owner, application_role=database.role)

    async def opened(self, tenant_id: str, workspace_id: str) -> None:
        """Note a workspace a person opened, to tend it: the libraries' ``on_open`` hook."""
        if _TENDING.get():
            return
        self._opened[(tenant_id, workspace_id)] = time.monotonic()

    def tend(self, workspaces: Workspaces{% if use_diagrams %}, storage: Storage{% endif %}) -> None:
        """Tend these workspaces{% if use_diagrams %}, on this storage,{% endif %} while the application runs."""
        self._workspaces = workspaces
{%- if use_diagrams %}
        self._storage = storage
{%- endif %}

    async def tend_once(self{% if use_diagrams %}, *, now: datetime | None = None{% endif %}) -> Tended:
        """Tend each workspace a person opened in the last :data:`TENDED`; what it did.

        Each is tended as :data:`TENDER`. One that fails is left, said in the log by its id and
        the error's type alone, for the next tending, and the rest are tended. Each process
        tends the workspaces it opened{% if use_diagrams %}: two that tend one workspace sweep and thin it alike,
        and a sweep that loses to another's is skipped as a diagram changed meanwhile is{% endif %}.
        """
        workspaces = self._workspaces
{%- if use_diagrams %}
        storage = self._storage
        if workspaces is None or storage is None:
{%- else %}
        if workspaces is None:
{%- endif %}
            return Tended()
{%- if use_diagrams %}
        now = now or datetime.now(UTC)
{%- endif %}
        done = Tended()
        token = _TENDING.set(True)
        try:
            for key in list(self._opened):
                done = await self._tend_one(key, done{% if use_diagrams %}, now, storage{% endif %}, workspaces)
        finally:
            _TENDING.reset(token)
        return done

    async def _tend_one(
        self,
        key: tuple[str, str],
        done: Tended,
{%- if use_diagrams %}
        now: datetime,
        storage: Storage,
{%- endif %}
        workspaces: Workspaces,
    ) -> Tended:
        """Tend one workspace, unless no person opened it in the last :data:`TENDED`."""
        # Read now, not from the pass's start: a person may have opened it meanwhile.
        if self._opened.get(key, 0.0) < time.monotonic() - TENDED.total_seconds():
            self._opened.pop(key, None)
            return done
        tenant_id, workspace_id = key
        try:
            ws = await workspaces.open(tenant_id, workspace_id, actor=TENDER)
{%- if use_diagrams %}
            swept = await sweep_tombstones(ws, now=now)
            thinned = await thin_revisions(
                storage,
                Scope(tenant_id, workspace_id),
                now=now,
                integrations=self._integrations,
            )
{%- endif %}
            collected = await self.native.collect(ws) if self.native else 0
        except Exception as error:
            # The id and the type alone: an error's words may quote what the workspace holds.
            LOGGER.warning(
                "files: workspace %s wasn't tended (%s); tried again next time",
                workspace_id,
                type(error).__name__,
            )
            return done
        return Tended(
            done.workspaces + 1,
{%- if use_diagrams %}
            done.swept + swept,
            done.thinned + thinned,
{%- endif %}
            done.collected + collected,
        )

    async def _tend(self) -> None:
        """Tend now, then about every :data:`TEND_EVERY`, until cancelled."""
        jitter = secrets.SystemRandom()
        while True:
            try:
                done = await self.tend_once()
            except Exception:
                LOGGER.exception("files: the workspaces weren't tended; tried again later")
            else:
                if {% if use_diagrams %}done.swept or done.thinned or {% endif %}done.collected:
                    LOGGER.info("files: tended %s", done)
            await asyncio.sleep(TEND_EVERY * jitter.uniform(0.5, 1.5))

    @contextlib.asynccontextmanager
    async def lifespan(self) -> AsyncGenerator[None]:
        """Ask each worker which app it runs, as the application starts; close them as it stops.

        Raises:
            RuntimeError: If a worker can't be reached, refuses the token, or runs another app, or
                another version, than its pin names.
        """
        async with contextlib.AsyncExitStack() as stack:
{%- if use_diagrams %}
            if self.diagrams:
                stack.push_async_callback(self.diagrams.aclose)
{%- endif %}
            tending = asyncio.create_task(self._tend())

            async def stop_tending() -> None:
                tending.cancel()
                with contextlib.suppress(asyncio.CancelledError):
                    await tending

            stack.push_async_callback(stop_tending)
            for craft, worker in self._workers.items():
                stack.push_async_callback(worker.aclose)
                try:
                    await worker.open()
                except (httpx.HTTPError, ValidationError) as error:
                    raise RuntimeError(
                        f"files-{craft}, the worker FILES_CRAFTS names, didn't answer: start it "
                        f"with the application, `make up`, or leave {craft} out ({error!r})"
                    ) from error
                if (worker.name, worker.version) != (craft, CRAFTS[craft]):
                    raise RuntimeError(
                        f"files-{craft} runs {worker.name} {worker.version}, not {craft} "
                        f"{CRAFTS[craft]}, as scripts/crafts pins it: rebuild it, `make up`"
                    )
            yield

    def mount(
        self, app: FastAPI, workspaces: Workspaces, *, resolve_actor: ResolveActor, prefix: str
    ) -> None:
{%- if use_diagrams %}
        """Add native files' routes beside artifactr's, while any app runs.

        And the routes of a diagram's images, which a person puts on its canvas, app or none.
        """
{%- else %}
        """Add native files' routes beside artifactr's, while any app runs."""
{%- endif %}
        if self.native is not None:
            uploads = self._uploads
            router = files_router(
                workspaces,
                self.native,
                resolve_actor=resolve_actor,
                uploads_per_minute=uploads.per_minute,
                uploads_at_once=uploads.at_once,
                uploads_per_tenant=uploads.per_tenant,
                uploads_each=uploads.each,
            )
            app.include_router(router, prefix=prefix)
{%- if use_diagrams %}
        app.include_router(
            diagrams_router(
                workspaces,
                self._blobs,
                resolve_actor=resolve_actor,
                integrations=self._integrations,
            ),
            prefix=prefix,
        )
{%- endif %}


def _stores(database: Database | None, settings: FilesSettings) -> tuple[Blobs, Checkouts]:
    """The files' bytes, held to the quotas, and check-outs: in the database, or in memory.

    In the database, they are kept apart by tenant as artifactr's tables are.
    """
    workspace, tenant = _quota(settings.workspace_quota), _quota(settings.tenant_quota)
    if database is None:
        blobs = InMemoryBlobs(workspace_quota=workspace, tenant_quota=tenant)
        return blobs, InMemoryCheckouts()
    rls = database.row_level_security
    return (
        SqlBlobs(
            database.engine,
            row_level_security=rls,
            workspace_quota=workspace,
            tenant_quota=tenant,
        ),
        SqlCheckouts(database.engine, row_level_security=rls),
    )


def _quota(held: Held | None) -> Quota | None:
    return None if held is None else Quota(bytes=held.bytes, files=held.files)
