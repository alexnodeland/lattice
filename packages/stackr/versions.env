# Versions stackr pins outside compose.yaml. Dependabot doesn't read this file:
# bump a version here by hand, then run `make dashboards` and `make smoke`.

# The libraries' Grafana dashboards, provisioned by release. scripts/fetch-dashboards
# downloads each pinned release's dashboard archive; an empty version is skipped.
# A *_SHA256 value, when set, must match the archive.
ARTIFACTR_DASHBOARDS_VERSION=
ARTIFACTR_DASHBOARDS_SHA256=
REFLEXR_DASHBOARDS_VERSION=
REFLEXR_DASHBOARDS_SHA256=
