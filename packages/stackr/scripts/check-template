#!/usr/bin/env python3
"""Check the application template without installing what it generates. Run by scripts/validate.

Usage: scripts/check-template [--keep DIR]

Renders every variant of the template (artifactr, reflexr or both, with and without evals) from
this checkout, working tree included, under the name in NAME, and checks each one:

- every Jinja expression was rendered: nothing is left of `{{ ... }}` or `{% ... %}`, apart
  from GitHub Actions' own `${{ ... }}`
- the libraries come from lattice, each from its own directory, all at one commit: the one the
  variant was rendered from (ADR-0018)
- the Python is formatted and passes lint, with the generated project's own ruff settings
- the YAML passes yamllint, and the shell scripts shellcheck
- the Compose file is valid for the app profile

The generated applications' types and tests need their dependencies installed: CI's template
job runs `make check` in each variant for that.
"""

from __future__ import annotations

import argparse
import itertools
import re
import subprocess
import sys
import tempfile
import tomllib
import warnings
from pathlib import Path

from copier import run_copy

ROOT = Path(__file__).resolve().parent.parent
LATTICE = ROOT.parent.parent
"""lattice's root, whose copier.yml points Copier at the template."""
VARIANTS = list(itertools.product(["artifactr", "reflexr", "both"], [True, False]))
LEFTOVER = re.compile(r"(?<!\$)\{\{|\{%|%\}")
TEXT = {".py", ".toml", ".yaml", ".yml", ".md", ".json", ".sh", ".example", ""}
ANSWERS = ".copier-answers.yml"
REPOSITORY = "https://github.com/alexnodeland/lattice"
NAME = "Acme Template Check At Max Len"
"""The name every variant is rendered with: its slug is 30 characters, the longest Copier
accepts, and its package sorts before `conftest`, so line lengths and import order are
checked at their limits."""


def render(libraries: str, evals: bool, destination: Path) -> str:
    """Render one variant, as `copier copy --defaults --vcs-ref HEAD` does; return its commit."""
    with warnings.catch_warnings():
        # A checkout with uncommitted changes renders them, from a commit Copier makes, with a
        # warning.
        warnings.simplefilter("ignore")
        worker = run_copy(
            str(LATTICE),
            destination,
            data={"project_name": NAME, "libraries": libraries, "evals": evals},
            defaults=True,
            vcs_ref="HEAD",
            quiet=True,
        )
    return str(worker.template.commit_hash)


def check_sources(app: Path, commit: str) -> list[str]:
    """Check that the libraries come from lattice's packages/, at the rendered commit."""
    sources = tomllib.loads((app / "pyproject.toml").read_text())["tool"]["uv"]["sources"]
    return [
        f"pyproject.toml: {name} isn't packages/<library> at {commit}: {source}"
        for name, source in sources.items()
        if source.get("git") != REPOSITORY
        or not str(source.get("subdirectory")).startswith("packages/")
        or source.get("rev") != commit
    ]


def run(label: str, command: list[str], cwd: Path) -> list[str]:
    """Run a check; return its output as a problem if it fails."""
    done = subprocess.run(command, cwd=cwd, capture_output=True, text=True, check=False)
    if done.returncode == 0:
        return []
    return [f"{label}:\n{done.stdout}{done.stderr}".rstrip()]


def check(app: Path, commit: str) -> list[str]:
    """Check one rendered application; return the problems found."""
    problems = check_sources(app, commit)
    files = [p for p in app.rglob("*") if p.is_file() and ".git" not in p.parts]
    for path in files:
        if path.suffix in TEXT or path.name.startswith("."):
            text = path.read_text()
            for number, line in enumerate(text.splitlines(), 1):
                if LEFTOVER.search(line):
                    problems.append(f"{path.relative_to(app)}:{number}: unrendered: {line.strip()}")
    problems += run("ruff format", ["ruff", "format", "--check", "--quiet", "."], app)
    problems += run("ruff check", ["ruff", "check", "--quiet", "."], app)
    # The answers file is Copier's to write, with the template's path in it.
    yaml = [str(p) for p in files if p.suffix in {".yaml", ".yml"} and p.name != ANSWERS]
    config = str(ROOT / ".yamllint.yaml")
    problems += run("yamllint", ["yamllint", "--strict", "-c", config, *yaml], app)
    scripts = [str(p) for p in files if p.suffix == ".sh"]
    problems += run("shellcheck", ["shellcheck", *scripts], app)
    compose = ["docker", "compose", "--profile", "app", "config", "--quiet"]
    problems += run("compose", compose, app)
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--keep", type=Path, help="render into this directory, and keep it")
    args = parser.parse_args()
    failures = 0
    with tempfile.TemporaryDirectory() as scratch:
        base = args.keep or Path(scratch)
        for libraries, evals in VARIANTS:
            name = f"{libraries}{'-evals' if evals else ''}"
            app = base / name
            commit = render(libraries, evals, app)
            problems = check(app, commit)
            for problem in problems:
                print(f"FAIL: {name}: {problem}", file=sys.stderr)
            if problems:
                failures += 1
            else:
                print(f"ok: {name}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
