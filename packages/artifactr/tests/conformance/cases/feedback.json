{
  "description": "Typed feedback: its types, targets and who may give it.",
  "cases": [
    {
      "name": "a person rates the agent's turn",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "runs": [
          {
            "id": "run_1",
            "thread_id": "thr_1",
            "status": "completed"
          }
        ]
      },
      "command": {
        "type": "give_feedback",
        "feedback_type": "helpfulness",
        "target": {
          "kind": "turn",
          "run_id": "run_1"
        },
        "value": {
          "rating": 4
        }
      },
      "expect": {
        "outcome": {
          "type": "recorded"
        },
        "events": [
          {
            "type": "feedback_given",
            "feedback_type": "helpfulness",
            "target": {
              "kind": "turn",
              "run_id": "run_1"
            },
            "value": {
              "rating": 4,
              "reason": null
            },
            "thread_id": "thr_1",
            "run_id": "run_1"
          }
        ]
      }
    },
    {
      "name": "feedback on a thread belongs to the thread",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "threads": [
          {
            "id": "thr_1",
            "title": "Launch",
            "mode": "edit"
          }
        ]
      },
      "command": {
        "type": "give_feedback",
        "feedback_type": "helpfulness",
        "target": {
          "kind": "thread",
          "thread_id": "thr_1"
        },
        "value": {
          "rating": 5,
          "reason": "quick"
        }
      },
      "expect": {
        "outcome": {
          "type": "recorded"
        },
        "events": [
          {
            "type": "feedback_given",
            "value": {
              "rating": 5,
              "reason": "quick"
            },
            "thread_id": "thr_1",
            "run_id": null
          }
        ]
      }
    },
