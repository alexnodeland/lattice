def test_a_rule_from_chat_posts_nothing_into_a_restricted_thread(
    client: TestClient, script: Script
) -> None:
    command(client, type="create_thread", thread_id="secret")
    restriction = {"on": {"kind": "thread", "workspace": "main", "id": "secret"}}
    restricted = client.post(f"/grantr/v1/tenants/{TENANT}/restrictions", json=restriction)
    assert restricted.status_code == 200, restricted.text
    proposal = drafted(client, script, "secret")
    command(client, type="respond_to_proposal", proposal_id=proposal, decision="accept")
    wait_for(lambda: stored(client, "chat:checkout-alerts"))

    fired = {"type": FIRED, "service": "checkout", "summary": "Payments fail"}
    assert client.post(f"{REFLEXR}/events", json={"event": fired}).status_code == 200

    def runs() -> list[dict[str, Any]]:
        return client.get(f"{REFLEXR}/runs", params={"rule": "chat:checkout-alerts"}).json()

    wait_for(lambda: [run["status"] for run in runs()] == ["dead"])
    [dead] = runs()
    # The thread is hidden from the rule, so artifactr refuses it as missing.
    assert (dead["reason"], dead["error"]) == ("not_found", "thread secret does not exist")
    assert "chat:checkout-alerts: An alert fired for checkout." not in notices(client, "secret")


def test_a_person_who_may_not_install_rules_puts_none_live(
    client: TestClient, script: Script
) -> None:
    grantr = f"/grantr/v1/tenants/{TENANT}"
    erin = {"kind": "user", "id": "erin"}
    assert client.post(f"{grantr}/members", json={"member": erin}).status_code == 201
    editor = {"role": "editor", "on": {"kind": "workspace", "workspace": "main"}, "to": erin}
    assert client.post(f"{grantr}/grants", json=editor).status_code == 201
    command(client, type="create_thread", thread_id="ops")
    proposal = drafted(client, script, "ops")
    frame = {
        "type": "command",
        "command_id": new_id("cmd"),
        "command": {"type": "respond_to_proposal", "proposal_id": proposal, "decision": "accept"},
    }
    accepted = client.post(f"{ARTIFACTR}/commands", json=frame, headers=bearer("erin"))
    assert accepted.json()["ok"], "an editor may accept a proposal"
    refusal = "Only a person who may install rules can install this one."
    wait_for(lambda: refusal in notices(client, "ops"))
    assert stored(client, "chat:checkout-alerts") is None
