# Versions stackr pins outside compose.yaml. Renovate doesn't read this file:
# bump a version here by hand, then run `make smoke`.

# The Supabase CLI, which runs local Supabase and pins its images. make uses an
# installed `supabase` when there is one, or runs this version through npx;
# CI installs this version. GoTrue's image (compose.yaml, and the AWS stack's
# locals.tf) must be the one this CLI runs: `scripts/check-config gotrue`
# checks it when this file, compose.yaml or locals.tf change.
SUPABASE_CLI_VERSION=2.118.0

# Excalidraw, which the diagrams worker draws with (stackr ADR-0049) and portalr's canvas will
# show diagrams in: one version for both, so what the worker draws is what people see.
# scripts/check-template holds the worker's package.json to it, and portalr's when it has one.
EXCALIDRAW_VERSION=0.18.1
