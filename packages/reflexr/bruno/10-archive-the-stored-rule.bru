meta {
  name: Archive the stored rule
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/workspaces/{{workspace}}/commands
  body: json
  auth: none
}

body:json {
  {
    "type": "command",
    "command_id": "archive-checkout-deploys",
    "command": {
      "type": "archive_rule",
      "rule": "team:checkout-deploys",
      "expected_version": 1
    }
  }
}

tests {
  test("version 2, archived", function () {
    expect(res.status).to.equal(200);
    expect(res.body.outcome.version).to.equal(2);
  });
}
