@contextlib.asynccontextmanager
async def serving(application: FastAPI) -> AsyncIterator[str]:
    """Serve an application on a free port in this event loop, and give its URL."""
    listener = socket.socket()
    listener.bind(("127.0.0.1", 0))
    config = uvicorn.Config(application, ws="websockets-sansio", log_level="warning")
    served = uvicorn.Server(config)
    task = asyncio.create_task(served.serve(sockets=[listener]))
    for _ in range(3000):  # thirty seconds at most
        if served.started:
            break
        await asyncio.sleep(0.01)
    yield f"http://127.0.0.1:{listener.getsockname()[1]}"
    served.should_exit = True
    await task


