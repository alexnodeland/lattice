def test_an_accepted_postmortem_scores_the_run_that_proposed_it(client: TestClient) -> None:
    alert(client, "checkout")
    resolve(client, "checkout")
    [proposal] = postmortems(client)
    command(client, type="respond_to_proposal", proposal_id=proposal["id"], decision="accept")

    def scored() -> list[dict[str, Any]]:
        found = client.get(f"{REFLEXR}/events", params={"type": "reflexr:feedback_given"})
        return found.json()

    wait_for(scored)
    [feedback] = scored()
    event = feedback["event"]
    assert event["value"] == {"outcome": "accepted", "proposal_id": proposal["id"]}
    params = {"rule": "{{ package_name }}:close-incident"}
    [closing] = client.get(f"{REFLEXR}/runs", params=params).json()
    assert event["target"] == {"kind": "run", "run_id": closing["id"]}
