#!/usr/bin/env python3
"""Check the application template without installing what it generates. Run by scripts/validate.

Usage: scripts/check-template [--keep DIR]

Renders every variant of the template (artifactr, reflexr or both, with and without evals, with
grantr or no access control, with portalr, which grantr needs, or without it, both without
relayr's bridge, both without artifactr's forms, and both hosted on a single host) from this
checkout, working tree included, under the name in NAME, and checks each one:

- every Jinja expression was rendered: nothing is left of `{{ ... }}` or `{% ... %}`, apart
  from GitHub Actions' own `${{ ... }}`
- the libraries' sources are exactly the ones the variant needs, each from its own directory of
  lattice's packages/, at the commit the variant was rendered from (ADR-0018)
- the Python is formatted and passes lint, with the generated project's own ruff settings
- the YAML passes yamllint, and the shell scripts shellcheck
- the Compose file is valid for the app profile, with the single host's overlay when it has one

The generated applications' types and tests need their dependencies installed: CI's template
job runs `make check` in each variant for that.
"""

from __future__ import annotations

import argparse
import itertools
import os
import re
import subprocess
import sys
import tempfile
import tomllib
import warnings
from pathlib import Path
from typing import NamedTuple

from copier import run_copy

ROOT = Path(__file__).resolve().parent.parent
LATTICE = ROOT.parent.parent
"""lattice's root, whose copier.yml points Copier at the template."""


class Variant(NamedTuple):
    """One way to render the template."""

    libraries: str
    evals: bool
    access: str
    bridge: bool  # whether relayr bridges both libraries
    hosting: str
    portal: bool  # portalr, which only grantr's access can have
    ui: bool  # artifactr's forms, artifactr.ui, which only artifactr can have

    @property
    def name(self) -> str:
        """The directory it is rendered into."""
        return (
            f"{self.libraries}{'-evals' if self.evals else ''}"
            f"{'' if self.access == 'grantr' else '-open'}"
            f"{'-unbridged' if self.libraries == 'both' and not self.bridge else ''}"
            f"{'' if self.hosting == 'none' else f'-{self.hosting}'}"
            f"{'-noportal' if self.access == 'grantr' and not self.portal else ''}"
            f"{'-noui' if self.libraries != 'reflexr' and not self.ui else ''}"
        )


VARIANTS = [
    Variant(
        libraries,
        evals,
        access,
        libraries == "both",
        "none",
        access == "grantr",
        libraries != "reflexr",
    )
    for libraries, evals, access in itertools.product(
        ["artifactr", "reflexr", "both"], [True, False], ["grantr", "none"]
    )
] + [
    Variant("both", True, "grantr", False, "none", True, True),
    Variant("both", True, "grantr", True, "host", True, True),
    Variant("both", True, "grantr", True, "none", False, True),
    Variant("both", True, "grantr", True, "none", True, False),
]
"""Every variant of the template."""
LEFTOVER = re.compile(r"(?<!\$)\{\{|\{%|%\}")
TEXT = {".py", ".toml", ".yaml", ".yml", ".md", ".json", ".sh", ".example", ""}
ANSWERS = ".copier-answers.yml"
REPOSITORY = "https://github.com/alexnodeland/lattice"
DIRECTORIES = {
    "artifactr-ai": "artifactr",
    "reflexr": "reflexr",
    "evalr": "evalr",
    "grantr": "grantr",
    "relayr-ai": "relayr",
    "portalr": "portalr",
}
"""Each library's distribution, and its directory in lattice's packages/."""
NAME = "Acme Template Check At Max Len"
"""The name every variant is rendered with: its slug is 30 characters, the longest Copier
accepts, and its package sorts before `conftest`, so line lengths and import order are
checked at their limits."""


def render(variant: Variant, destination: Path) -> str:
    """Render one variant, as `copier copy --defaults --vcs-ref HEAD` does; return its commit."""
    with warnings.catch_warnings():
        # A checkout with uncommitted changes renders them, from a commit Copier makes, with a
        # warning.
        warnings.simplefilter("ignore")
        worker = run_copy(
            str(LATTICE),
            destination,
            data={"project_name": NAME, **variant._asdict()},
            defaults=True,
            vcs_ref="HEAD",
            quiet=True,
        )
    return str(worker.template.commit_hash)


def expected_sources(variant: Variant, commit: str) -> dict[str, dict[str, str]]:
    """The `[tool.uv.sources]` a variant needs: each library it uses, from its directory of
    lattice's packages/, at the commit it was rendered from."""
    used = {
        "artifactr-ai": variant.libraries in {"artifactr", "both"},
        "reflexr": variant.libraries in {"reflexr", "both"},
        "evalr": variant.evals,
        "grantr": variant.access == "grantr",
        "relayr-ai": variant.bridge,
        "portalr": variant.access == "grantr" and variant.portal,
    }
    return {
        name: {"git": REPOSITORY, "subdirectory": f"packages/{DIRECTORIES[name]}", "rev": commit}
        for name, uses in used.items()
        if uses
    }


def check_sources(app: Path, expected: dict[str, dict[str, str]]) -> list[str]:
    """Check that the libraries' sources are exactly the ones the variant needs."""
    sources = tomllib.loads((app / "pyproject.toml").read_text())["tool"]["uv"]["sources"]
    if sources == expected:
        return []
    return [f"pyproject.toml: [tool.uv.sources] is {sources}, not {expected}"]


def run(label: str, command: list[str], cwd: Path, env: dict[str, str] | None = None) -> list[str]:
    """Run a check, with these variables added to the environment; return its output as a problem
    if it fails."""
    environment = {**os.environ, **(env or {})}
    done = subprocess.run(
        command, cwd=cwd, capture_output=True, text=True, check=False, env=environment
    )
    if done.returncode == 0:
        return []
    return [f"{label}:\n{done.stdout}{done.stderr}".rstrip()]


def check_bun(app: Path) -> list[str]:
    """Check that the image builds portalr's UIs with the Bun that lattice itself uses."""
    dockerfile = (app / "Dockerfile").read_text()
    found = re.search(
        r"^FROM oven/bun:([0-9.]+)@sha256:[0-9a-f]{64} AS portal-ui$", dockerfile, re.M
    )
    if found is None:
        return ["Dockerfile: the portal-ui stage isn't FROM oven/bun:<version>@sha256:<digest>"]
    wanted = re.search(r'^bun = "([0-9.]+)"$', (LATTICE / ".prototools").read_text(), re.M)
    if wanted is None or wanted[1] != found[1]:
        return [
            f"Dockerfile: Bun is {found[1]}, and lattice's .prototools says {wanted and wanted[1]}"
        ]
    return []


def check(app: Path, sources: dict[str, dict[str, str]]) -> list[str]:
    """Check one rendered application, which needs these sources; return the problems found."""
    problems = check_sources(app, sources)
    if (app / "scripts" / "build-portal-ui.sh").exists():
        problems += check_bun(app)
    files = [p for p in app.rglob("*") if p.is_file() and ".git" not in p.parts]
    for path in files:
        if path.suffix in TEXT or path.name.startswith("."):
            text = path.read_text()
            for number, line in enumerate(text.splitlines(), 1):
                if LEFTOVER.search(line):
                    problems.append(f"{path.relative_to(app)}:{number}: unrendered: {line.strip()}")
    problems += run("ruff format", ["ruff", "format", "--check", "--quiet", "."], app)
    problems += run("ruff check", ["ruff", "check", "--quiet", "."], app)
    # The answers file is Copier's to write, with the template's path in it.
    yaml = [str(p) for p in files if p.suffix in {".yaml", ".yml"} and p.name != ANSWERS]
    config = str(ROOT / ".yamllint.yaml")
    problems += run("yamllint", ["yamllint", "--strict", "-c", config, *yaml], app)
    scripts = [str(p) for p in files if p.suffix == ".sh"]
    problems += run("shellcheck", ["shellcheck", *scripts], app)
    compose = ["docker", "compose", "--profile", "app", "config", "--quiet"]
    problems += run("compose", compose, app)
    host = app / "deploy" / "host" / "compose.prod.yaml"
    if host.exists():
        overlay = ["docker", "compose", "-f", "compose.yaml", "-f", str(host), *compose[2:]]
        # The overlay asks for the image to run, and the domain the edge serves.
        needs = {"APP_IMAGE": "app:checked", "STACKR_DOMAIN": "example.com"}
        problems += run("compose, on a single host", overlay, app, needs)
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--keep", type=Path, help="render into this directory, and keep it")
    args = parser.parse_args()
    failures = 0
    with tempfile.TemporaryDirectory() as scratch:
        base = args.keep or Path(scratch)
        for variant in VARIANTS:
            name = variant.name
            app = base / name
            commit = render(variant, app)
            problems = check(app, expected_sources(variant, commit))
            for problem in problems:
                print(f"FAIL: {name}: {problem}", file=sys.stderr)
            if problems:
                failures += 1
            else:
                print(f"ok: {name}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
