"""Settings, read from the environment: the stack's ports, and a few of the application's own.

The ports are stackr's (its ``docs/architecture.md``): OpenTelemetry's ``OTEL_*`` for telemetry,
{%- if use_tracker %}
``DATABASE_URL`` for the database, ``AUTH_*`` for identity, ``LITELLM_*`` for the LLM gateway,
``LANGFUSE_*`` for evaluation data and ``TRACKER_*`` for the task tracker. Swapping what is
behind a port changes these settings, never the code.
{%- else %}
``DATABASE_URL`` for the database, ``AUTH_*`` for identity, ``LITELLM_*`` for the LLM gateway and
``LANGFUSE_*`` for evaluation data. Swapping what is behind a port changes these settings, never
the code.
{%- endif %}
"""

import json
import os
import re
from collections.abc import Mapping
from dataclasses import dataclass, field
from typing import Self, cast
{%- if use_tracker %}

from pydantic import ValidationError

from relayr.ledger import WorkspaceKey
from relayr.trackers import TrackerBinding, TrackerCredentials
{%- endif %}

SCHEMA_NAME = re.compile(r"^[a-z_][a-z0-9_]{0,62}$")
"""The PostgreSQL schemas the application accepts: plain lowercase identifiers."""


@dataclass(frozen=True)
class AuthSettings:
    """How access tokens are verified: the identity port.

    Attributes:
        jwks_url: The issuer's JSON Web Key Set, for asymmetrically signed tokens (ES256, RS256),
            as local Supabase issues them.
        jwt_secret: A shared secret, for HS256 tokens, as Supabase projects on the legacy JWT
            secret issue them.
        audience: The ``aud`` a token must carry.
        issuer: The ``iss`` a token must carry, when set.
{%- if access == 'grantr' %}
        service_role_key: Supabase's service role key, for the admin commands that find a user
            by their email; the issuer's admin API is asked.
        admin_url: Where that admin API is, when not at the issuer: on a single host, GoTrue's
            private address, since the edge refuses its admin API (stackr RFC-0004).
{%- else %}
        tenant_claim: Where the tenant is in the token's claims, as a dotted path.
{%- endif %}
    """

    jwks_url: str | None = None
    jwt_secret: str | None = field(default=None, repr=False)
    audience: str = "authenticated"
    issuer: str | None = None
{%- if access == 'grantr' %}
    service_role_key: str | None = field(default=None, repr=False)
    admin_url: str | None = None
{%- else %}
    tenant_claim: str = "app_metadata.tenant_id"
{%- endif %}


@dataclass(frozen=True)
class GatewaySettings:
    """How agents reach models: the LLM gateway port.

    Attributes:
        base_url: The gateway's OpenAI-compatible API.
        api_key: The key requests use when their tenant has none of its own.
        model: The model group agents ask for.
        tenant_keys: Each tenant's own key, for its team's budget and rate limits.
        guardrails: The gateway's guardrails every request asks for.
        mock_response: A reply the gateway sends instead of calling a model, for smoke tests;
            the gateway honours it only for keys whose team allows mocked responses.
    """

    base_url: str = "http://localhost:4400"
    api_key: str | None = None
    model: str = "default"
    tenant_keys: Mapping[str, str] = field(default_factory=dict[str, str])
    guardrails: tuple[str, ...] = ("pii-mask", "prompt-injection")
    mock_response: str | None = None


{% if use_tracker -%}
@dataclass(frozen=True)
class TrackerSettings:
    """Where rules' runs file work, and whose changes come back: the task tracker port, {% if tracker == 'plane' %}Plane{% else %}Vikunja{% endif %}.

    Each tenant has a tracker workspace and a tracker user of its own, ``relayr-<tenant>``, whose
    key reaches only the tenant's work: stackr's tracker guide provisions them, and its
    ``make tracker-check`` checks them.

    Attributes:
        credentials: Each tenant's tracker credentials: the tracker's URL, its user's key, its
            webhooks' secret{% if tracker == 'plane' %} and its workspace's slug{% endif %}.
        bindings: The tracker project each workspace files into and reads; a workspace without
            one files nothing.
{%- if tracker == 'plane' %}
        budget: How many requests a minute each tenant's key may make from this process: the 300
            stackr's recipe lets Plane take.
{%- else %}
        budget: How many requests a minute each tenant's key may make from this process; stackr's
            recipe sets Vikunja no limit.
{%- endif %}
    """

    credentials: Mapping[str, TrackerCredentials] = field(
        default_factory=dict[str, TrackerCredentials]
    )
    bindings: Mapping[WorkspaceKey, TrackerBinding] = field(
        default_factory=dict[WorkspaceKey, TrackerBinding]
    )
    budget: int = 300

    def __post_init__(self) -> None:
        for tenant, workspace in self.bindings:
            if tenant not in self.credentials:
                missing = f"TRACKER_CREDENTIALS has none for {tenant}"
                raise ValueError(f"TRACKER_BINDINGS binds {tenant}/{workspace}, and {missing}")


{% endif -%}
{% if use_files -%}
CRAFTS = {
{%- for name, craft in crafts.items() %}
    "{{ name }}": "{{ craft.version }}",
{%- endfor %}
}
"""The apps a worker runs, as ``FILES_CRAFTS`` names them, and the version each one's pin names."""

TOKEN = 32
"""The fewest characters a worker's token may have: ``make env``'s have 64."""
{%- if use_portal %}

EDITORS = { {%- for name, craft in crafts.items() if craft.editor %}"{{ name }}": {{ app_port + craft.editor }}{{ ", " if not loop.last }}{% endfor -%} }
"""The port each app's editor is published on, on this machine, for an app whose browser build
hands a file over, unless ``<APP>_EDITOR_PORT`` moves it: compose.yaml's ``files-<app>-editor``."""
{%- endif %}


@dataclass(frozen=True)
class Held:
    """The most a workspace's native files may hold, or a tenant's: artifactr's ``Quota``."""

    bytes: int
    files: int | None = None


@dataclass(frozen=True)
class Uploads:
    """How people's uploads and check-ins are held back: artifactr's defaults unless set.

    ``files_router`` and ``NativeFiles`` take them.
    """

    per_minute: int = 20
    """How many each person may start in a minute."""
    at_once: int = 8
    """How many the application takes at once, from every tenant: each is held in memory."""
    per_tenant: int | None = None
    """How many of them one tenant's people may have at once: half of ``at_once`` if unset."""
    each: int = 2
    """How many of them one person may have at once."""
    readings: int = 2
    """How many of a tenant's files its apps read at once."""

    def __post_init__(self) -> None:
        tenant = self.tenant
        if not 1 <= self.each <= tenant <= self.at_once:
            raise ValueError(
                "FILES_UPLOADS_EACH, FILES_UPLOADS_PER_TENANT and FILES_UPLOADS_AT_ONCE are each "
                f"at least the one before: not {self.each}, {tenant} and {self.at_once}"
            )

    @property
    def tenant(self) -> int:
        """A tenant's share, as ``files_router`` takes it: half the places, unless set."""
        each = min(self.each, self.at_once)
        return max(self.at_once // 2, each) if self.per_tenant is None else self.per_tenant


@dataclass(frozen=True)
class FilesSettings:
    """Native files: which crafting apps run, each in its worker{% if use_portal %}, and where people edit in them{% endif %}.

    Attributes:
        crafts: The apps whose workers run, ``files-<app>`` in the app profile: none by default,
            and then native files are off.
        tokens: Each running app's worker's token, ``FILES_<APP>_TOKEN``, which ``make env``
            generates: one for each, so no worker holds another's.
        uploads: How people's uploads and check-ins are held back (native files ADR-0017):
            each person's pace, the files read at once, the tenant's and the person's share of
            them, and each tenant's readings by its apps, ``FILES_UPLOADS_*`` and
            ``FILES_READINGS``.
        workspace_quota: The most each workspace's files may hold, ``FILES_WORKSPACE_QUOTA``
            as ``<bytes>`` or ``<bytes>,<files>``: none by default.
        tenant_quota: The most each tenant's files may hold, ``FILES_TENANT_QUOTA``: none by
            default.
{%- if use_portal %}
        editors: Each app's editor, by its integration, as people's browsers reach it: by default,
            for each app that runs and has one, its port on this machine.
{%- endif %}
    """

    crafts: tuple[str, ...] = ()
    tokens: Mapping[str, str] = field(default_factory=dict[str, str], repr=False)
    uploads: Uploads = field(default_factory=lambda: Uploads())
    workspace_quota: Held | None = None
    tenant_quota: Held | None = None
{%- if use_portal %}
    editors: Mapping[str, str] = field(default_factory=dict[str, str])
{%- endif %}

    def __post_init__(self) -> None:
        if unknown := sorted(set(self.crafts) - set(CRAFTS)):
            raise ValueError(
                f"FILES_CRAFTS names {', '.join(unknown)}: a worker runs {', '.join(CRAFTS)}"
            )
        for craft in self.crafts:
            if len(self.tokens.get(craft, "")) < TOKEN:
                raise ValueError(
                    f"FILES_CRAFTS needs FILES_{craft.upper()}_TOKEN, of at least {TOKEN} "
                    "characters, which `make env` generates"
                )

    @classmethod
    def from_environ(cls, env: Mapping[str, str]) -> Self:
        """Read native files' settings from ``FILES_*``."""
        crafts = _names(env.get("FILES_CRAFTS", ""))
{%- if use_portal %}
        loopback = {
            f"files:{name}": f"http://127.0.0.1:{env.get(f'{name.upper()}_EDITOR_PORT', port)}/"
            for name, port in EDITORS.items()
            if name in crafts
        }
        editors = (
            _json_object(env["FILES_EDITORS"], "FILES_EDITORS")
            if "FILES_EDITORS" in env
            else loopback
        )
{%- endif %}
        return cls(
            crafts=crafts,
            uploads=Uploads(
                per_minute=_whole(env, "FILES_UPLOADS_PER_MINUTE", Uploads.per_minute),
                at_once=_whole(env, "FILES_UPLOADS_AT_ONCE", Uploads.at_once),
                per_tenant=_whole(env, "FILES_UPLOADS_PER_TENANT", None),
                each=_whole(env, "FILES_UPLOADS_EACH", Uploads.each),
                readings=_whole(env, "FILES_READINGS", Uploads.readings),
            ),
            workspace_quota=_quota(env.get("FILES_WORKSPACE_QUOTA", ""), "FILES_WORKSPACE_QUOTA"),
            tenant_quota=_quota(env.get("FILES_TENANT_QUOTA", ""), "FILES_TENANT_QUOTA"),
            tokens={
                craft: token
                for craft in crafts
                if (token := env.get(f"FILES_{craft.upper()}_TOKEN"))
            },
{%- if use_portal %}
            editors={key: str(url) for key, url in editors.items()},
{%- endif %}
        )


{% endif -%}
{% if use_portal -%}
@dataclass(frozen=True)
class PortalSettings:
    """Where portalr's UIs sign in, and the tools its admin reads: the portal port.

    Without a Supabase URL and publishable key, the UIs can't sign anyone in, and the portal is
    not mounted. A tool without a URL is not configured; its card says so.

    Attributes:
        supabase_url: The Supabase project, as people's browsers reach it: its URL, or a path
            on this application's own origin that leads to it.
        supabase_key: The project's publishable key, which browsers send with every Supabase
            Auth call. Never the secret one: ``config.json`` is public.
        auth_url: Supabase's gateway, as this application reaches it, for inviting people by
            email: ``/auth/v1`` is under it. With ``AUTH_SERVICE_ROLE_KEY``, it enables
            invitations.
        ui_dir: A directory holding the built ``app`` and ``admin`` UIs, when portalr's
            package has none of its own, as an install from a repository hasn't.
        url: The portal's own origin, as people's browsers reach it: the one page that may frame
            mini apps' sandbox.
        apps_url: The origin mini apps run on, an origin of its own that this application
            answers with the sandbox alone; with ``url``. Without it, no app runs.
        tempo_url: Tempo's HTTP API, for traces.
        loki_url: Loki's HTTP API, for logs.
        prometheus_url: prom-label-proxy, in front of Prometheus, for metrics.
        langfuse_project: The Langfuse project's id, for scores and links; with
            ``LANGFUSE_BASE_URL`` and the project's keys.
        litellm_key: A key that reads each tenant's spend from LiteLLM, and does nothing else:
            stackr's ``make portal-key`` makes it, a view-only admin's, limited to the four routes
            the admin reads.
            Never the master key, which opens everything; with ``LITELLM_BASE_URL``.
        grafana_url: Grafana, as operators' browsers reach it, for deep links.
        required: Whether the application must not start without a Supabase project for the UIs
            to sign in to, rather than leave the portal off: set on a single host, where a
            portal that is silently off would be an application that looks deployed and isn't.
    """

    supabase_url: str | None = None
    supabase_key: str | None = None
    auth_url: str | None = None
    ui_dir: str | None = None
    url: str | None = None
    apps_url: str | None = None
    tempo_url: str | None = None
    loki_url: str | None = None
    prometheus_url: str | None = None
    langfuse_project: str | None = None
    litellm_key: str | None = field(default=None, repr=False)
    grafana_url: str | None = None
    required: bool = False

    @classmethod
    def from_environ(cls, env: Mapping[str, str]) -> Self:
        """Read the portal's settings from ``PORTAL_*``."""
        return cls(
            supabase_url=env.get("PORTAL_SUPABASE_URL"),
            supabase_key=env.get("PORTAL_SUPABASE_KEY"),
            auth_url=env.get("PORTAL_AUTH_URL"),
            ui_dir=env.get("PORTAL_UI_DIR"),
            url=env.get("PORTAL_URL"),
            apps_url=env.get("PORTAL_APPS_URL"),
            tempo_url=env.get("PORTAL_TEMPO_URL"),
            loki_url=env.get("PORTAL_LOKI_URL"),
            prometheus_url=env.get("PORTAL_PROMETHEUS_URL"),
            langfuse_project=env.get("PORTAL_LANGFUSE_PROJECT"),
            litellm_key=env.get("PORTAL_LITELLM_KEY"),
            grafana_url=env.get("PORTAL_GRAFANA_URL"),
            required=env.get("PORTAL_REQUIRED") == "true",
        )


{% endif -%}
@dataclass(frozen=True)
class Settings:
    """Everything the application reads from its environment.

    Attributes:
        service_name: The service's name in telemetry.
        environment: The deployment environment in telemetry; the Collector's when unset.
        host: The address to listen on.
        port: The port to listen on.
        database_url: A SQLAlchemy URL with an async driver. Without one, workspaces live in
            memory and are gone when the process stops.
        database_schema: The PostgreSQL schema the libraries' tables live in. A schema of its
            own keeps them out of ``public``, which Supabase's Data API serves.
        database_admin_url: The tables' owner, on the same database: with it, PostgreSQL keeps
            tenants apart itself, and ``database_url`` connects as a role that owns nothing,
            which ``make db-roles`` creates.
        auth: How access tokens are verified.
        gateway: How agents reach models.
{%- if use_tracker %}
        tracker: Where rules' runs file work, and whose changes come back.
{%- endif %}
{%- if use_files %}
        files: Native files: which crafting apps run, each in its worker.
{%- endif %}
        telemetry: Whether to export OpenTelemetry, to ``OTEL_EXPORTER_OTLP_ENDPOINT``.
        langfuse: Whether to use Langfuse, with the ``LANGFUSE_*`` keys, for trace attributes
            and scores.
{%- if use_portal %}
        portal: Where portalr's UIs sign in, and the tools its admin reads.
        langfuse_url: Langfuse, as this application reaches it.
        langfuse_keys: The project's public and secret keys, which portalr reads scores with.
{%- endif %}
    """

    service_name: str = "{{ project_slug }}"
    environment: str | None = None
    host: str = "127.0.0.1"
    port: int = {{ app_port }}
    database_url: str | None = None
    database_schema: str = "{{ package_name }}"
    database_admin_url: str | None = None
    auth: AuthSettings = field(default_factory=AuthSettings)
    gateway: GatewaySettings = field(default_factory=GatewaySettings)
{%- if use_tracker %}
    tracker: TrackerSettings = field(default_factory=TrackerSettings)
{%- endif %}
{%- if use_files %}
    files: FilesSettings = field(default_factory=FilesSettings)
{%- endif %}
    telemetry: bool = False
    langfuse: bool = False
{%- if use_portal %}
    portal: PortalSettings = field(default_factory=PortalSettings)
    langfuse_url: str | None = None
    langfuse_keys: tuple[str, str] | None = None
{%- endif %}

    def __post_init__(self) -> None:
        if self.database_admin_url and not self.database_url:
            raise ValueError("DATABASE_ADMIN_URL needs DATABASE_URL: the role the app works as")
        if not SCHEMA_NAME.match(self.database_schema):
            raise ValueError(
                f"DATABASE_SCHEMA must be a lowercase identifier, not {self.database_schema!r}"
            )

    @classmethod
    def from_environ(cls, environ: Mapping[str, str] | None = None) -> Self:
        """Read the settings from environment variables; empty ones count as unset."""
        env = {k: v for k, v in (os.environ if environ is None else environ).items() if v}
        auth = AuthSettings(
            jwks_url=env.get("AUTH_JWKS_URL"),
            jwt_secret=env.get("AUTH_JWT_SECRET"),
            audience=env.get("AUTH_AUDIENCE", AuthSettings.audience),
            issuer=env.get("AUTH_ISSUER"),
{%- if access == 'grantr' %}
            service_role_key=env.get("AUTH_SERVICE_ROLE_KEY"),
            admin_url=env.get("AUTH_ADMIN_URL"),
{%- else %}
            tenant_claim=env.get("AUTH_TENANT_CLAIM", AuthSettings.tenant_claim),
{%- endif %}
        )
        guardrails = env.get("LITELLM_GUARDRAILS", ",".join(GatewaySettings.guardrails))
        gateway = GatewaySettings(
            base_url=env.get("LITELLM_BASE_URL", GatewaySettings.base_url),
            api_key=env.get("LITELLM_API_KEY"),
            model=env.get("LITELLM_MODEL", GatewaySettings.model),
            tenant_keys=_tenant_keys(env.get("LITELLM_TENANT_KEYS", "{}")),
            guardrails=_names(guardrails),
            mock_response=env.get("LITELLM_MOCK_RESPONSE"),
        )
        return cls(
            service_name=env.get("OTEL_SERVICE_NAME", cls.service_name),
            environment=env.get("APP_ENVIRONMENT"),
            host=env.get("APP_HOST", cls.host),
            port=int(env.get("APP_PORT", cls.port)),
            database_url=env.get("DATABASE_URL"),
            database_schema=env.get("DATABASE_SCHEMA", cls.database_schema),
            database_admin_url=env.get("DATABASE_ADMIN_URL"),
            auth=auth,
            gateway=gateway,
{%- if use_tracker %}
            tracker=TrackerSettings(
                credentials=_tracker_credentials(env.get("TRACKER_CREDENTIALS", "{}")),
                bindings=_tracker_bindings(env.get("TRACKER_BINDINGS", "{}")),
                budget=int(env.get("TRACKER_BUDGET", TrackerSettings.budget)),
            ),
{%- endif %}
{%- if use_files %}
            files=FilesSettings.from_environ(env),
{%- endif %}
            telemetry="OTEL_EXPORTER_OTLP_ENDPOINT" in env,
            langfuse="LANGFUSE_PUBLIC_KEY" in env,
{%- if use_portal %}
            portal=PortalSettings.from_environ(env),
            langfuse_url=env.get("LANGFUSE_BASE_URL"),
            langfuse_keys=(
                (env["LANGFUSE_PUBLIC_KEY"], env["LANGFUSE_SECRET_KEY"])
                if "LANGFUSE_PUBLIC_KEY" in env and "LANGFUSE_SECRET_KEY" in env
                else None
            ),
{%- endif %}
        )


def _tenant_keys(text: str) -> dict[str, str]:
    """Parse ``LITELLM_TENANT_KEYS``: a JSON object from tenant ids to gateway keys."""
    try:
        keys: object = json.loads(text)
    except json.JSONDecodeError as error:
        raise ValueError("LITELLM_TENANT_KEYS must be a JSON object of tenant keys") from error
    if not isinstance(keys, dict):
        raise ValueError("LITELLM_TENANT_KEYS must be a JSON object of tenant keys")
    pairs = cast(dict[object, object], keys)
    return {str(tenant): str(key) for tenant, key in pairs.items()}


{% if use_tracker -%}
FIELDS = "base_url, api_key{% if tracker == 'plane' %}, webhook_secret and workspace{% else %} and webhook_secret{% endif %}"
"""What a tenant's tracker credentials must have."""


def _tracker_credentials(text: str) -> dict[str, TrackerCredentials]:
    """Parse ``TRACKER_CREDENTIALS``: a JSON object from tenant ids to their tracker credentials.
{% if tracker == 'plane' %}
    A tenant's are ``base_url``, ``api_key``, ``webhook_secret`` and ``workspace``, its Plane
    workspace's slug. The errors never quote them: they are secrets.
{%- else %}
    A tenant's are ``base_url``, ``api_key`` and ``webhook_secret``; ``expires_at``, when the
    token expires, is for stackr's ``make tracker-check``, which warns two weeks before. The
    errors never quote them: they are secrets.
{%- endif %}
    """
    credentials: dict[str, TrackerCredentials] = {}
    for tenant, entry in _json_object(text, "TRACKER_CREDENTIALS").items():
        try:
            credentials[tenant] = TrackerCredentials.model_validate(entry)
{%- if tracker == 'plane' %}
        except ValidationError:
            raise ValueError(f"TRACKER_CREDENTIALS of {tenant} must have {FIELDS}") from None
        if not credentials[tenant].workspace:
            raise ValueError(f"TRACKER_CREDENTIALS of {tenant} must have {FIELDS}")
{%- else %}
        except ValidationError:
            raise ValueError(f"TRACKER_CREDENTIALS of {tenant} must have {FIELDS}") from None
{%- endif %}
    return credentials


def _tracker_bindings(text: str) -> dict[WorkspaceKey, TrackerBinding]:
    """Parse ``TRACKER_BINDINGS``: a JSON object from ``<tenant>/<workspace>`` to a binding.

    A binding is the tracker ``project`` the workspace files into and reads, by the tracker's id,
    and what its items have unless a rule says: a ``state``, a ``priority`` and ``labels``.
    """
    bindings: dict[WorkspaceKey, TrackerBinding] = {}
    for name, entry in _json_object(text, "TRACKER_BINDINGS").items():
        tenant, _, workspace = name.partition("/")
        if not tenant or not workspace:
            raise ValueError(f"TRACKER_BINDINGS names {name!r}, not <tenant>/<workspace>")
        try:
            bindings[WorkspaceKey(tenant, workspace)] = TrackerBinding.model_validate(entry)
        except ValidationError as error:
            raise ValueError(f"TRACKER_BINDINGS of {name}: {error}") from error
    return bindings


{% endif -%}
{% if use_tracker or (use_files and use_portal) -%}
def _json_object(text: str, name: str) -> dict[str, object]:
    """Parse a setting that is a JSON object."""
    try:
        parsed: object = json.loads(text)
    except json.JSONDecodeError as error:
        raise ValueError(f"{name} must be a JSON object") from error
    if not isinstance(parsed, dict):
        raise ValueError(f"{name} must be a JSON object")
    return {str(key): value for key, value in cast(dict[object, object], parsed).items()}


{% endif -%}
{% if use_files -%}
WHOLE = re.compile(r"[0-9]+")
"""A whole number as a setting gives one: ASCII digits, and nothing else, not ``1_000`` or ``²``."""


def _quota(text: str, name: str) -> Held | None:
    """A quota, ``<bytes>`` or ``<bytes>,<files>``, or None if empty.

    Raises:
        ValueError: If it is neither.
    """
    if not text.strip():
        return None
    parts = text.strip().split(",")
    if len(parts) > 2 or not all(WHOLE.fullmatch(part) for part in parts):
        raise ValueError(f"{name} is <bytes> or <bytes>,<files>, each whole, not {text!r}")
    return Held(*(int(part) for part in parts))


def _whole[N: int | None](env: Mapping[str, str], name: str, default: N) -> int | N:
    """A setting that is a whole number of at least one, or its default if unset or empty.

    Raises:
        ValueError: If it is set to anything else, named by its variable.
    """
    text = env.get(name, "").strip()
    if not text:
        return default
    if not WHOLE.fullmatch(text) or int(text) < 1:
        raise ValueError(f"{name} is a whole number of at least 1, not {text!r}")
    return int(text)


{% endif -%}
def _names(text: str) -> tuple[str, ...]:
    """Parse a comma-separated list of names, where ``none`` is the empty list."""
    names = tuple(name.strip() for name in text.split(",") if name.strip())
    return () if names == ("none",) else names
