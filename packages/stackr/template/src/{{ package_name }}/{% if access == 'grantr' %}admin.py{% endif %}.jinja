"""The deployment's own commands: ``make tenant``, ``operator``, ``migrate-tenants``, ``db-roles``.

Each runs in process, on the database ``DATABASE_URL`` names, and is recorded in grantr's audit
log as made by no one (grantr ADR-0021). A user is named by their id, Supabase Auth's ``sub``, or
by their email, which Supabase Auth's admin API looks up with ``AUTH_SERVICE_ROLE_KEY``.
``db-roles`` creates the role ``DATABASE_URL`` connects as, as ``DATABASE_ADMIN_URL``'s: run it
before the application first starts with row-level security.

    {{ project_slug }}-admin operator alice@example.com
    {{ project_slug }}-admin tenant acme alice@example.com
    {{ project_slug }}-admin migrate-tenants
    {{ project_slug }}-admin db-roles
"""

import argparse
import asyncio
import base64
import hashlib
import hmac
import json
import os
import sys
import urllib.request
from collections.abc import Sequence
from dataclasses import dataclass
from itertools import groupby
from typing import Any, cast

from sqlalchemy import URL, Connection, make_url, text
from sqlalchemy.exc import DBAPIError
from sqlalchemy.ext.asyncio import create_async_engine

from grantr import Grants, Invalid
from grantr.core import MemberAdded, TenantCreated
from grantr.sql import SqlStorage, migrate

from {{ package_name }}.access import build_grants
from {{ package_name }}.database import create_schema, open_database
from {{ package_name }}.settings import Settings

PROGRAM = "{{ project_slug }}-admin"
"""The command's name."""

SCRAM_ITERATIONS = 4096
"""PostgreSQL's default for a SCRAM-SHA-256 verifier."""

PAGE = 200
"""How many users the admin API is asked for at a time."""


@dataclass(frozen=True)
class Account:
    """A Supabase Auth user, as the admin API lists them."""

    id: str
    email: str
    created_at: str
    tenant: str | None
    """The tenant in their token's claim, from before grantr: ``app_metadata.tenant_id``."""


class Users:
    """Supabase Auth's users, through its admin API.

    Args:
        issuer: Supabase Auth's URL, the tokens' ``iss``, such as
            ``http://127.0.0.1:54321/auth/v1``.
        key: The service role's key.
    """

    def __init__(self, issuer: str | None, key: str | None) -> None:
        self._issuer = issuer
        self._key = key

    async def find(self, who: str) -> str:
        """A user's id: ``who`` itself, unless it is an email, which is looked up.

        Raises:
            LookupError: If no user has that email.
        """
        if "@" not in who:
            return who
        for account in await self.accounts():
            if account.email.lower() == who.lower():
                return account.id
        raise LookupError(f"no user has the email {who}")

    async def accounts(self) -> list[Account]:
        """Every user, oldest first.

        Raises:
            LookupError: If the issuer or the service role's key isn't set.
        """
        if not self._issuer or not self._key:
            raise LookupError("set AUTH_ISSUER and AUTH_SERVICE_ROLE_KEY to find users by email")
        found: list[Account] = []
        page = 1
        while users := await asyncio.to_thread(self._page, page):
            found += [_account(user) for user in users]
            page += 1
        return sorted(found, key=lambda account: account.created_at)

    def _page(self, page: int) -> list[dict[str, Any]]:
        request = urllib.request.Request(
            f"{self._issuer}/admin/users?page={page}&per_page={PAGE}",
            headers={"apikey": str(self._key), "Authorization": f"Bearer {self._key}"},
        )
        with urllib.request.urlopen(request, timeout=30) as response:
            return cast(list[dict[str, Any]], json.load(response)["users"])


def _account(user: dict[str, Any]) -> Account:
    metadata = cast(dict[str, Any], user.get("app_metadata") or {})
    tenant = metadata.get("tenant_id")
    return Account(
        id=str(user["id"]),
        email=str(user.get("email") or ""),
        created_at=str(user.get("created_at") or ""),
        tenant=tenant if isinstance(tenant, str) and tenant else None,
    )


async def operator(grants: Grants, users: Users, who: str) -> str:
    """Make a user the deployment's first operator."""
    user = await users.find(who)
    await grants.first_operator(user)
    return f"{who} is the deployment's operator"


async def tenant(grants: Grants, users: Users, name: str, owner: str) -> str:
    """Create a tenant, with its owner; a tenant that exists is left as it is."""
    entries = await grants.provision_tenant(name, owner=await users.find(owner))
    return f"created {name}, owned by {owner}" if entries else f"{name} exists, and is unchanged"


async def migrate_tenants(grants: Grants, users: Users) -> str:
    """Move each user's tenant from their token's claim into grantr, and say who got what.

    A new tenant's earliest user becomes its owner, and the rest its admins, so no one loses
    what they could do; the owners narrow it afterwards. A tenant grantr holds already gains, as
    admins, the users who claim it and aren't its members yet.
    """
    lines: list[str] = []
    claimed = sorted(
        (account for account in await users.accounts() if account.tenant),
        key=lambda account: (account.tenant or "", account.created_at),
    )
    for name, group in groupby(claimed, key=lambda account: account.tenant or ""):
        accounts = list(group)
        emails = {account.id: account.email for account in accounts}
        entries = await grants.provision_tenant(
            name, owner=accounts[0].id, admins=[account.id for account in accounts]
        )
        added = ", ".join(
            emails[entry.event.member.id]
            for entry in entries
            if isinstance(entry.event, MemberAdded)
        )
        if any(isinstance(entry.event, TenantCreated) for entry in entries):
            lines.append(f"{name}: owner {accounts[0].email}; admins {added or 'no one'}")
        else:
            lines.append(f"{name}: exists; admins added: {added or 'no one'}")
    return "\n".join(lines) or "no user names a tenant"


async def run(arguments: Sequence[str], settings: Settings) -> str:
    """Carry out one command, and return what to print.

    Raises:
        SystemExit: If the arguments are wrong, or there is no database.
    """
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("operator", help="make a user the first operator").add_argument("user")
    new = commands.add_parser("tenant", help="create a tenant, with its owner")
    new.add_argument("name")
    new.add_argument("owner")
    commands.add_parser("migrate-tenants", help="move users' tenants from their tokens")
    commands.add_parser("db-roles", help="create the role DATABASE_URL connects as")
    parsed = parser.parse_args(arguments)
    if not settings.database_url:
        parser.error("set DATABASE_URL: the commands change the application's database")
    if parsed.command == "db-roles":
        url = make_url(settings.database_url)
        admin = make_url(settings.database_admin_url or "sqlite://")
        if admin.get_backend_name() != "postgresql" or not url.username or not url.password:
            parser.error(
                "set DATABASE_ADMIN_URL to PostgreSQL's tables' owner, and DATABASE_URL to the"
                " role the application works as, with its password"
            )
        if url.username == admin.username:
            parser.error("DATABASE_URL must name a role of its own, not the tables' owner")
        if url.database != admin.database:
            parser.error("DATABASE_URL and DATABASE_ADMIN_URL must name the same database")
        return await db_roles(admin, url.username, url.password, settings.database_schema)
    database = open_database(
        settings.database_url,
        schema=settings.database_schema,
        admin_url=settings.database_admin_url,
    )
    try:
        await create_schema(database.owner, settings.database_schema)
        await migrate(database.owner, application_role=database.role)
        storage = SqlStorage(
            database.engine,
            row_level_security=database.row_level_security,
            across_tenants=database.owner,
        )
        grants = build_grants(storage, name=settings.service_name)
        users = Users(
            settings.auth.admin_url or settings.auth.issuer, settings.auth.service_role_key
        )
        match parsed.command:
            case "operator":
                return await operator(grants, users, parsed.user)
            case "tenant":
                return await tenant(grants, users, parsed.name, parsed.owner)
            case _:
                return await migrate_tenants(grants, users)
    finally:
        await database.dispose()


async def db_roles(admin_url: URL, role: str, password: str, schema: str) -> str:
    """Create the role the application works as, which owns nothing, or set its password.

    Raises:
        Invalid: If PostgreSQL refuses, or the role is one row-level security doesn't hold.
    """
    owner = create_async_engine(admin_url)
    try:
        async with owner.begin() as connection:
            await connection.run_sync(create_role, role, password, schema)
    except DBAPIError as error:
        # Not the statement, which holds the password's verifier: what PostgreSQL said.
        raise Invalid(f"PostgreSQL refused the role: {type(error.orig).__name__}") from None
    except OSError as error:
        raise Invalid(f"PostgreSQL couldn't be reached: {type(error).__name__}") from None
    finally:
        await owner.dispose()
    return f"{role} can connect: start the application to grant it the tables"


def create_role(connection: Connection, role: str, password: str, schema: str) -> None:
    """Create the role the application works as, which owns nothing, or set its password.

    It runs as the tables' owner, which must be allowed to create roles. The password is sent
    as a SCRAM-SHA-256 verifier, never in the clear, as psql's password command does. Running it
    again sets the password again, so a changed ``DATABASE_URL`` takes effect. The role's
    ``search_path`` is its schema, in this database: a connection asks for it too, but a proxy
    that drops what a client asks for at its start, as Floci's RDS does, would leave the role
    without its tables.

    Raises:
        Invalid: If the role is a superuser, bypasses row-level security, or owns the schema
            or is a member of its owner's role.
    """
    preparer = connection.dialect.identifier_preparer
    quoted = preparer.quote(role)
    found = connection.scalar(text("SELECT 1 FROM pg_roles WHERE rolname = :role"), {"role": role})
    verb = "ALTER" if found else "CREATE"
    connection.exec_driver_sql(f"{verb} ROLE {quoted} LOGIN PASSWORD '{scram_verifier(password)}'")
    exempt = connection.scalar(
        text(
            "SELECT rolsuper OR rolbypassrls OR EXISTS (SELECT 1 FROM pg_namespace"
            " WHERE nspname = :schema AND pg_has_role(r.oid, nspowner, 'USAGE'))"
            " FROM pg_roles r WHERE rolname = :role"
        ),
        {"role": role, "schema": schema},
    )
    if exempt:
        raise Invalid(f"{role} owns the schema, or bypasses row-level security: name another")
    database = preparer.quote(connection.scalar(text("SELECT current_database()")))
    connection.exec_driver_sql(
        f"ALTER ROLE {quoted} IN DATABASE {database} SET search_path TO {preparer.quote(schema)}"
    )


def scram_verifier(password: str, *, salt: bytes | None = None) -> str:
    """A SCRAM-SHA-256 verifier of a password, as PostgreSQL stores it (RFC 5802, RFC 7677).

    The password must be printable ASCII, which SASLprep, as PostgreSQL applies it, leaves as it
    is; any other would need SASLprep's mappings to match what a client sends.

    Raises:
        Invalid: If the password isn't printable ASCII.
    """
    if not password.isascii() or not password.isprintable():
        raise Invalid("the password in DATABASE_URL must be printable ASCII")
    salt = salt or os.urandom(16)
    salted = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, SCRAM_ITERATIONS)
    client = hmac.digest(salted, b"Client Key", "sha256")
    server = hmac.digest(salted, b"Server Key", "sha256")
    stored = hashlib.sha256(client).digest()
    encode = base64.b64encode
    return (
        f"SCRAM-SHA-256${SCRAM_ITERATIONS}:{encode(salt).decode()}"
        f"${encode(stored).decode()}:{encode(server).decode()}"
    )


def main() -> None:
    """Run a command from the command line, with the settings in the environment."""
    try:
        sys.stdout.write(asyncio.run(run(sys.argv[1:], Settings.from_environ())) + "\n")
    except (Invalid, LookupError) as error:
        sys.exit(f"{PROGRAM}: {error}")
    except DBAPIError as error:
        # Not the statement: what PostgreSQL said, without what it was asked.
        sys.exit(f"{PROGRAM}: the database refused: {type(error.orig).__name__}")
