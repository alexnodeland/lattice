def test_the_agent_asks_a_form_whose_answer_is_checked(client: TestClient, script: Script) -> None:
    command(client, type="create_thread", thread_id="t1")
    script.steps += [call("ask_form", title="Launch", schema=LAUNCH), say("Friday it is.")]
    command(client, type="post_message", thread_id="t1", content="When do we launch?")
    wait_for(lambda: events(client, "run_paused"))
    [paused] = events(client, "run_paused")
    [request] = paused["event"]["requests"]
    assert request["tool_name"] == "ask_form"
    answer = {"run_id": paused["event"]["run_id"], "tool_call_id": request["tool_call_id"]}

    refused = command(client, type="answer_deferred", answer={"day": "Friday"}, **answer)
    assert (refused["ok"], refused["rejection"]["type"]) == (False, "validation_failed")
    assert command(client, type="answer_deferred", answer={"day": "2026-10-23"}, **answer)["ok"]
    wait_for(lambda: events(client, "run_ended"))
    [returned] = [p for p in script.requests[-1][-1].parts if isinstance(p, ToolReturnPart)]
    assert returned.content == {"day": "2026-10-23"}
{%- endif %}
