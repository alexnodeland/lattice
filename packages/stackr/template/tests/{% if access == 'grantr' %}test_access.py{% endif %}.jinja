@pytest.mark.parametrize(("read", "mcp", "tool"), PARTS)
def test_the_libraries_answer_refusals_over_rest(read: str, mcp: str, tool: str) -> None:
    with TestClient(app(Script())) as client:
        assert client.get(read, headers=signed()).status_code == 200
        assert client.get(read, headers=signed("carol")).status_code == 400
