meta {
  name: Spend, with LiteLLM down
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/portalr/v1/spend
  body: none
  auth: none
}

headers {
  x-user: alice
  x-tenant: acme
}

tests {
  test("LiteLLM isn't in this stack: its read alone is unavailable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("unavailable");
  });
}
