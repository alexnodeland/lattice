meta {
  name: traces, with Tempo down
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/portalr/v1/traces?start={{start}}&end={{end}}
  body: none
  auth: none
}

headers {
  x-user: alice
  x-tenant: acme
}

tests {
  test("unavailable, and nothing else fails", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("unavailable");
  });
}
