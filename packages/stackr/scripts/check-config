#!/usr/bin/env python3
"""Static checks that no service's own validator covers. Run by scripts/validate, but `gotrue`.

Usage: scripts/check-config {dashboards,supabase,litellm,aws,gotrue}

dashboards: every dashboard under deploy/grafana/dashboards is valid JSON, has
a unique uid and a title, and refers only to the data sources Grafana is
provisioned with (by uid), or to a dashboard variable.

supabase: supabase/config.toml's project_id differs from the Compose project's
name (the CLI labels its containers as a Compose project too), the Makefile
and compose.yaml use it, every Supabase container or network name in a tracked
file (the template's and the documentation's included) is the one it gives, and
every postgres image in compose.yaml has the major version local Supabase runs,
so both database adapters are the same PostgreSQL, and the single host's image
(deploy/host/postgres) is built from the one compose.yaml pins.

litellm: the gateway's config has no validator of its own, and the proxy
starts without a guardrail it can't load. Every model group a fallback names
exists, guardrails use integrations that need no licence and valid modes,
every `os.environ/` reference is set on the litellm service in compose.yaml,
and no key is written into the file.

gotrue: GoTrue's image in compose.yaml and in the AWS stack module
(deploy/aws/modules/stack/locals.tf) is the version the Supabase CLI pinned in
versions.env runs. The CLI's image pins are in its own repository, so this one
reads them over the network, so `make validate` stays offline, and CI runs it
(moon run stackr:gotrue) on a pull request whose own diff changes versions.env,
compose.yaml or locals.tf, and on none other. It tries twice, and a CLI
Dockerfile it can't read is a failure, never a pass.

aws: the AWS recipe's state host runs ClickHouse, Prometheus and
prom-label-proxy from a Compose file of its own (deploy/aws/state-host), since
Compose needs every variable of a file it reads. Its services are compose.yaml's
but for their ports and their data's paths on the host: the same images, users,
commands, health checks, settings and mount points. Its Prometheus
configuration is deploy/prometheus's, with the services' names in the private
namespace in place of Compose's. GoTrue's proxy, the edge's caddy_image, is the
single host's Caddy, and the images the stack module runs as they are, such as
GoTrue's and Langfuse's, are compose.yaml's, and each image deploy/<service>/
Dockerfile builds is on its service's image, as compose.yaml pins it, unless
compose.yaml builds that image itself, as it does Grafana's, when each image
it builds on is pinned by digest.
"""

from __future__ import annotations

import http.client
import json
import re
import subprocess
import sys
import time
import tomllib
import urllib.request
from collections.abc import Callable, Iterator
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parent.parent
GRAFANA = ROOT / "deploy" / "grafana"


def walk(node: Any) -> Iterator[dict[str, Any]]:
    """Yield every JSON object in a document, depth first."""
    if isinstance(node, dict):
        yield node
        for value in node.values():
            yield from walk(value)
    elif isinstance(node, list):
        for item in node:
            yield from walk(item)


def provisioned_uids() -> set[str]:
    """The uids of the data sources in Grafana's provisioning."""
    uids: set[str] = set()
    for path in (GRAFANA / "provisioning" / "datasources").glob("*.yaml"):
        document = yaml.safe_load(path.read_text()) or {}
        uids |= {source["uid"] for source in document.get("datasources", [])}
    return uids


def check_dashboards() -> list[str]:
    """Check every dashboard file; return the problems found."""
    problems: list[str] = []
    known = provisioned_uids()
    seen: dict[str, Path] = {}
    for path in sorted((GRAFANA / "dashboards").rglob("*.json")):
        name = path.relative_to(ROOT)
        before = len(problems)
        try:
            dashboard = json.loads(path.read_text())
        except json.JSONDecodeError as error:
            problems.append(f"{name}: invalid JSON: {error}")
            continue
        uid, title = dashboard.get("uid"), dashboard.get("title")
        if not uid or not title:
            problems.append(f"{name}: needs a uid and a title")
        elif uid in seen:
            problems.append(f"{name}: uid {uid!r} is also used by {seen[uid]}")
        else:
            seen[uid] = name
        for node in walk(dashboard):
            source = node.get("datasource")
            if isinstance(source, dict) and "uid" in source:
                ref = str(source["uid"])
                if ref not in known and not ref.startswith("$") and not ref.startswith("-- "):
                    problems.append(f"{name}: unknown data source uid {ref!r}")
        if len(problems) == before:
            print(f"ok: {name}")
    if not seen and not problems:
        print("none yet")
    return problems


def supabase_names() -> Iterator[tuple[str, str, str]]:
    """Every Supabase container or network name in a tracked file: where, its kind and project.

    CHANGELOG.md is left out: it is generated from commit messages, which can't change.
    """
    pattern = r"supabase_(db|kong|network)_[[:alnum:]_-]+"
    found = subprocess.run(
        ["git", "grep", "-I", "-n", "-o", "-E", pattern, "--", ":!CHANGELOG.md"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if found.returncode > 1:  # 1 is no match
        raise SystemExit(f"check-config: git grep: {found.stderr.strip()}")
    for line in found.stdout.splitlines():
        where, _, name = line.rpartition(":")
        _, kind, project = name.split("_", 2)
        yield where, kind, project


def check_supabase() -> list[str]:
    """Check that the Supabase project id and its names agree everywhere."""
    config = tomllib.loads((ROOT / "supabase" / "config.toml").read_text())
    project, major = config["project_id"], str(config["db"]["major_version"])
    compose_text = (ROOT / "compose.yaml").read_text()
    compose = yaml.safe_load(compose_text)
    makefile = (ROOT / "Makefile").read_text()
    network, host = f"supabase_network_{project}", f"supabase_db_{project}"
    problems: list[str] = []
    if project == compose["name"]:
        problems.append(f"project_id {project!r} is also the Compose project's name")
    if compose["networks"]["supabase"]["name"] != network:
        problems.append(f"compose.yaml's supabase network isn't {network}")
    if host not in compose_text:
        problems.append(f"compose.yaml doesn't refer to {host}")
    problems.extend(
        f"{where}: supabase_{kind}_{other} should be supabase_{kind}_{project}"
        for where, kind, other in supabase_names()
        if other != project
    )
    if f"SUPABASE_PROJECT := {project}" not in makefile:
        problems.append(f"the Makefile's SUPABASE_PROJECT isn't {project}")
    images = {
        service["image"]
        for service in compose["services"].values()
        if service.get("image", "").startswith("postgres:")
    }
    problems.extend(
        f"compose.yaml's {image} isn't PostgreSQL {major}, the major version local Supabase runs"
        for image in sorted(images)
        if image.removeprefix("postgres:").split(".")[0].split("-")[0] != major
    )
    dockerfile = (ROOT / "deploy" / "host" / "postgres" / "Dockerfile").read_text()
    base = re.search(r"^FROM (\S+)", dockerfile, re.M)
    if base is None or {base[1]} != images:
        pinned = ", ".join(sorted(images))
        problems.append(f"deploy/host/postgres/Dockerfile isn't built from {pinned}")
    if not problems:
        print(f"ok: project {project}, in every file's Supabase names; PostgreSQL {major}")
    return problems


# Guardrail integrations that run in the open-source proxy (ADR-0010).
OPEN_GUARDRAILS = {
    "litellm_content_filter",
    "presidio",
    "openai_moderation",
    "lakera_v2",
    "bedrock",
    "generic_guardrail_api",
}
GUARDRAIL_MODES = {"pre_call", "post_call", "during_call", "logging_only"}
ENV_REF = re.compile(r"^os\.environ/(\w+)$")


def check_litellm() -> list[str]:
    """Check the gateway's config against itself and compose.yaml."""
    gateway = ROOT / "deploy" / "litellm"
    config = yaml.safe_load((gateway / "config.yaml").read_text())
    compose = yaml.safe_load((ROOT / "compose.yaml").read_text())
    environment = set(compose["services"]["litellm"].get("environment") or {})
    problems: list[str] = []
    if config.get("include") != ["groups.yaml"]:
        problems.append("config.yaml must include groups.yaml, which compose.yaml mounts")

    # Each file of model groups holds the same groups, and only a model_list, which LiteLLM's
    # include extends config.yaml's with (it replaces any other key whole).
    groups = {path.stem: yaml.safe_load(path.read_text()) for path in gateway.glob("groups/*.yaml")}
    if set(groups) != {"providers", "upstream"}:
        problems.append(f"groups/ holds {sorted(groups)}, not providers and upstream")
    for name, chosen in groups.items():
        if set(chosen) != {"model_list"}:
            problems.append(f"groups/{name}.yaml holds more than a model_list")
        if not {"default", "fast"} <= {entry["model_name"] for entry in chosen["model_list"]}:
            problems.append(f"groups/{name}.yaml doesn't define both default and fast")
    entries = config.get("model_list", []) + [
        entry for chosen in groups.values() for entry in chosen.get("model_list", [])
    ]

    models = {entry["model_name"] for entry in entries}
    for entry in entries:
        params = entry.get("litellm_params") or {}
        if "model" not in params:
            problems.append(f"model {entry['model_name']!r} has no litellm_params.model")
        key = str(params.get("api_key", ""))
        if key and not ENV_REF.match(key) and (key.startswith("sk-") or len(key) > 20):
            problems.append(f"model {entry['model_name']!r} has a key in the file; use os.environ/")

    for fallback in (config.get("router_settings") or {}).get("fallbacks", []):
        for group, targets in fallback.items():
            for name in [group, *targets]:
                if name not in models:
                    problems.append(f"fallback names {name!r}, which isn't a model_name")

    names: set[str] = set()
    for guardrail in config.get("guardrails", []):
        name, params = guardrail.get("guardrail_name"), guardrail.get("litellm_params") or {}
        if name in names:
            problems.append(f"guardrail {name!r} is defined twice")
        names.add(name)
        if params.get("guardrail") not in OPEN_GUARDRAILS:
            problems.append(
                f"guardrail {name!r} uses {params.get('guardrail')!r}, not an open integration"
            )
        modes = params.get("mode")
        modes = modes if isinstance(modes, list) else [modes]
        if not set(modes) <= GUARDRAIL_MODES:
            problems.append(f"guardrail {name!r} has mode {params.get('mode')!r}")

    def references(node: Any) -> Iterator[str]:
        if isinstance(node, str) and (match := ENV_REF.match(node)):
            yield match[1]
        elif isinstance(node, dict):
            for value in node.values():
                yield from references(value)
        elif isinstance(node, list):
            for item in node:
                yield from references(item)

    for name in sorted(set(references([config, *groups.values()])) - environment):
        problems.append(f"os.environ/{name} isn't set on the litellm service in compose.yaml")
    if not ENV_REF.match(str((config.get("general_settings") or {}).get("master_key", ""))):
        problems.append("general_settings.master_key must come from os.environ/")

    if not problems:
        print(f"ok: {len(models)} model names, {len(names)} guardrails, every reference set")
    return problems


STATE_HOST = ROOT / "deploy" / "aws" / "state-host"
NAMESPACE = "stackr.internal"


# What the state host's services must keep from compose.yaml's: only their ports and their data's
# paths on the host differ.
STATE_HOST_KEYS = ("image", "user", "command", "entrypoint", "healthcheck")
STATE_HOST_EXTRA = {
    "clickhouse": {
        "environment": {"CLICKHOUSE_BACKUP_PASSWORD", "CLICKHOUSE_BACKUP_URL"},
        "mounts": {
            "/etc/clickhouse-server/users.d/backup-user.xml",
            "/etc/clickhouse-server/config.d/backups.xml",
        },
    },
    "prometheus": {"environment": set(), "mounts": {"/etc/prometheus/rules/alerts.yml"}},
}
"""What the state host adds to a service of compose.yaml's, and nothing more (ADR-0037): the
`backup` user and the `backups` named collection for ClickHouse, and the backups' alert rules for
Prometheus."""
STATE_HOST_LACKS = {
    "clickhouse": {
        "environment": {
            "CLICKHOUSE_ANALYTICS_WRITER_PASSWORD",
            "CLICKHOUSE_ANALYTICS_PASSWORD",
            "CLICKHOUSE_GRAFANA_PASSWORD",
        },
        "mounts": {
            "/etc/clickhouse-server/users.d/analytics-users.xml",
            "/etc/clickhouse-server/config.d/analytics.xml",
        },
    },
}
"""What the state host leaves out of a service of compose.yaml's, and nothing more: portalr's
analytics users and settings, since the AWS recipe doesn't run analytics yet (ADR-0044)."""
STATE_HOST_RULE_FILES = ["/etc/prometheus/rules/*.yml"]
"""The rule files the state host's Prometheus reads, which the single host's doesn't."""
EDGE = ROOT / "deploy" / "aws" / "modules" / "edge" / "variables.tf"
STACK = ROOT / "deploy" / "aws" / "modules" / "stack" / "locals.tf"
HOST_OVERLAY = ROOT / "deploy" / "host" / "compose.prod.yaml"


def volume_targets(service: dict[str, Any]) -> set[str]:
    """The paths a service's volumes are mounted at, inside its container."""
    return {volume.split(":")[1] for volume in service.get("volumes", [])}


def check_aws() -> list[str]:
    """Check that the AWS recipe's copies of the stack's settings follow the stack's."""
    stack = yaml.safe_load((ROOT / "compose.yaml").read_text())["services"]
    state = yaml.safe_load((STATE_HOST / "compose.yaml").read_text())["services"]
    problems: list[str] = []
    for name, service in state.items():
        where = f"deploy/aws/state-host's {name}"
        if name not in stack:
            problems.append(f"{where} isn't a service of compose.yaml")
            continue
        for key in STATE_HOST_KEYS:
            if service.get(key) != stack[name].get(key):
                problems.append(f"{where}: its {key} isn't compose.yaml's")
        extra = STATE_HOST_EXTRA.get(name, {"environment": set(), "mounts": set()})
        lacks = STATE_HOST_LACKS.get(name, {"environment": set(), "mounts": set()})
        added = {key: sorted(values) or "nothing" for key, values in extra.items()}
        if (
            set(service.get("environment", {}))
            != set(stack[name].get("environment", {})) - lacks["environment"] | extra["environment"]
        ):
            problems.append(
                f"{where}: its environment's settings aren't compose.yaml's,"
                f" with {added['environment']} more"
            )
        if (
            volume_targets(service)
            != volume_targets(stack[name]) - lacks["mounts"] | extra["mounts"]
        ):
            problems.append(
                f"{where}: its volumes aren't mounted where compose.yaml's are,"
                f" with {added['mounts']} more"
            )
    expected = yaml.safe_load((ROOT / "deploy" / "prometheus" / "prometheus.yml").read_text())
    expected["rule_files"] = STATE_HOST_RULE_FILES
    for job in expected["scrape_configs"]:
        for static in job.get("static_configs", []):
            static["targets"] = [
                target.replace(":", f".{NAMESPACE}:", 1)
                if not target.startswith("localhost:")
                else target
                for target in static["targets"]
            ]
    if yaml.safe_load((STATE_HOST / "prometheus.yml").read_text()) != expected:
        problems.append(
            "deploy/aws/state-host/prometheus.yml isn't deploy/prometheus/prometheus.yml, "
            f"with the services named in {NAMESPACE}, and the rule files {STATE_HOST_RULE_FILES}"
        )
    # The overlay's Compose tags (!override, !reset) aren't YAML that PyYAML reads.
    found = re.search(r"image: (caddy:\S+)", HOST_OVERLAY.read_text())
    caddy = found[1] if found else "(none in deploy/host/compose.prod.yaml)"
    if f'"{caddy}"' not in EDGE.read_text():
        problems.append(f"the edge's caddy_image isn't the single host's Caddy, {caddy}")
    images = {service["image"] for service in stack.values() if "image" in service}
    for image in re.findall(r'"([^"\s]+@sha256:[0-9a-f]{64})"', STACK.read_text()):
        if image not in images:
            problems.append(f"deploy/aws/modules/stack runs {image}, which compose.yaml doesn't")
    # Each thin image builds on its own service's image, as compose.yaml pins it.
    for dockerfile in sorted((ROOT / "deploy").glob("*/Dockerfile")):
        service = stack.get(dockerfile.parent.name)
        if service is None:
            continue
        text = dockerfile.read_text()
        where = dockerfile.relative_to(ROOT)
        # A service compose.yaml builds from this Dockerfile runs the thin image itself (ADR-0048):
        # each image it builds on, other than scratch and its own stages, is pinned by digest.
        if service.get("build", {}).get("dockerfile") == f"packages/stackr/{where}":
            stages = set(re.findall(r"^FROM \S+ AS (\S+)", text, re.MULTILINE))
            for base in re.findall(r"^FROM (\S+)", text, re.MULTILINE):
                stage = base.replace("${TARGETARCH}", "amd64")
                if base != "scratch" and stage not in stages and "@sha256:" not in base:
                    problems.append(f"{where} builds on {base}, which isn't pinned by digest")
            continue
        for base in re.findall(r"^FROM (\S+)", text, re.MULTILINE):
            if base != service["image"]:
                problems.append(f"{where} builds on {base}, not compose.yaml's {service['image']}")
    if not problems:
        print(f"ok: the state host runs {', '.join(state)} as compose.yaml does")
        print("ok: GoTrue's proxy runs the single host's Caddy")
        print("ok: the stack runs the upstream images compose.yaml pins")
        print("ok: each thin image builds on its service's image, as compose.yaml pins it")
    return problems


CLI_DOCKERFILE = (
    "https://raw.githubusercontent.com/supabase/cli/v{version}"
    "/apps/cli-go/pkg/config/templates/Dockerfile"
)
"""Where the Supabase CLI, at a version's tag, lists the images it runs."""
CLI_GOTRUE = re.compile(r"^FROM supabase/gotrue:([^@\s]+)(?:@\S+)? AS gotrue\s*$", re.MULTILINE)
"""The CLI's GoTrue pin: its tag, whether or not the CLI adds a digest."""
CLI_VERSION = re.compile(r"^SUPABASE_CLI_VERSION=([0-9][0-9A-Za-z.-]*)\s*$", re.MULTILINE)
"""The CLI's version, which goes into a URL's path: no `/`, `?` or `#`."""
STACK_GOTRUE = re.compile(r"^\s*gotrue\s*=\s*\"supabase/gotrue:([^@\"\s]+)", re.MULTILINE)
"""The AWS module's GoTrue pin, on its `gotrue =` line; compose.yaml's is read as YAML instead."""


def fetch_text(url: str, attempts: int = 2, pause: float = 2.0) -> str:
    """A page's text, read up to `attempts` times; raises OSError when none could be.

    A refused connection, an HTTP error, a body cut short and bytes that aren't text all count as
    a failed attempt, and get the retry.
    """
    request = urllib.request.Request(url, headers={"User-Agent": "stackr-check-config"})
    last: Exception | None = None
    for attempt in range(attempts):
        if attempt:
            time.sleep(pause)
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                return response.read().decode()
        except (OSError, http.client.HTTPException, UnicodeDecodeError) as error:
            last = error
    raise OSError(f"{url}: {last}") from last


def version_tuple(tag: str) -> tuple[int, ...] | None:
    """A tag such as v2.197.0 as numbers, or None when it isn't one."""
    parts = tag.removeprefix("v").split(".")
    return tuple(int(part) for part in parts) if all(part.isdigit() for part in parts) else None


def check_gotrue(root: Path = ROOT, fetch: Callable[[str], str] = fetch_text) -> list[str]:
    """Check that GoTrue's image is the one the pinned Supabase CLI runs."""
    versions = CLI_VERSION.search((root / "versions.env").read_text())
    if versions is None:
        return ["versions.env has no SUPABASE_CLI_VERSION, or one that isn't a version"]
    cli = versions[1]
    compose = yaml.safe_load((root / "compose.yaml").read_text())
    pins = {
        "compose.yaml": {
            service["image"].removeprefix("supabase/gotrue:").split("@")[0]
            for service in compose["services"].values()
            if service.get("image", "").startswith("supabase/gotrue:")
        },
        "deploy/aws/modules/stack/locals.tf": set(
            STACK_GOTRUE.findall((root / "deploy/aws/modules/stack/locals.tf").read_text())
        ),
    }
    problems = [f"{where} doesn't pin supabase/gotrue" for where, tags in pins.items() if not tags]
    url = CLI_DOCKERFILE.format(version=cli)
    try:
        dockerfile = fetch(url)
    except OSError as error:
        return [
            *problems,
            f"can't read the Supabase CLI {cli}'s image pins, so can't check: {error}",
        ]
    found = CLI_GOTRUE.search(dockerfile)
    if found is None:
        return [
            *problems,
            f"{url} has no `FROM supabase/gotrue:… AS gotrue`: the file may have moved",
        ]
    wanted = found[1]
    for where, tags in pins.items():
        for tag in sorted(tags - {wanted}):
            ours, theirs = version_tuple(tag), version_tuple(wanted)
            if ours is None or theirs is None:  # a tag such as v2.198.0-rc1: no direction to say
                advice = (
                    f"make them one: bump the CLI to one that runs {tag}, or set it to {wanted}"
                )
            elif ours > theirs:
                first = "bump the CLI first (SUPABASE_CLI_VERSION in versions.env)"
                advice = f"{first} to one that runs {tag}"
            else:
                advice = (
                    f"set its tag to {wanted}, keeping its @sha256 digest pin (Renovate can set"
                    " both), or bump the CLI back"
                )
            problems.append(
                f"{where} runs supabase/gotrue:{tag}, but the Supabase CLI {cli} runs {wanted}: "
                + advice
            )
    if not problems:
        print(f"ok: GoTrue is {wanted} in compose.yaml and the AWS module, as Supabase CLI {cli}")
    return problems


def main() -> int:
    checks = {
        "dashboards": check_dashboards,
        "supabase": check_supabase,
        "litellm": check_litellm,
        "aws": check_aws,
        "gotrue": check_gotrue,
    }
    if len(sys.argv) != 2 or sys.argv[1] not in checks:
        print(f"usage: scripts/check-config {{{','.join(checks)}}}", file=sys.stderr)
        return 2
    problems = checks[sys.argv[1]]()
    for problem in problems:
        print(f"FAIL: {problem}", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
