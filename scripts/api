#!/usr/bin/env bash
# A library's acceptance tests, against its reference application (stackr RFC-0003's phase 5,
# lattice ADR-0015). It starts the application from the package's compose.yaml, as a compose
# project of its own on ports the system picks, runs the package's Bruno collection and then
# Schemathesis over its committed OpenAPI document (configured in the root's schemathesis.toml),
# and stops the application however they end.
#
# Usage, from the package's directory, as its `api` task: scripts/api SERVICE
#   SERVICE  the reference application's compose service, docplan or oncall, which is also the
#            name of the collection's environment
set -euo pipefail
service=${1:?usage: scripts/api SERVICE}
package=$(basename "$PWD")
root=$(cd ../.. && pwd)
report="$root/.api-reports/$package"
export COMPOSE_PROFILES=app COMPOSE_PROJECT_NAME="$package-api"

stop() {
  local status=$?
  if ((status != 0)); then
    docker compose logs --no-color --tail=200 "$service"  # what the application said
  fi
  docker compose down --volumes
}
trap stop EXIT
docker compose down --volumes  # anything a run that was killed left behind
docker compose up --detach --build --wait --quiet-pull "$service"
base="http://$(docker compose port "$service" 8000)/v1"

(cd bruno && bun x --bun --no-install bru run --env "$service" --env-var "baseUrl=$base")

uv run --locked --group acceptance schemathesis --config-file "$root/schemathesis.toml" run \
  "schemas/$package.openapi.json" \
  --url "$base" \
  --header 'x-user: schemathesis' \
  --report junit \
  --report-dir "$report"
