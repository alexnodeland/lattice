{
  "components": {
    "schemas": {
      "DiagramFile": {
        "additionalProperties": false,
        "description": "An image a diagram shows: bytes in the blob store, named by their digest.\n\nThe shape of artifactr.files' ``Blob``, so that its blob store keeps them once images land.",
        "properties": {
          "media_type": {
            "minLength": 1,
            "title": "Media Type",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "size",
          "media_type"
        ],
        "title": "DiagramFile",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": true,
        "description": "One problem FastAPI found with a request's parameters or body.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Refused": {
        "description": "The body of a refused request.\n\n``detail`` is the rejection, the message of a resolver's refusal, or the problems FastAPI\nfound with the request.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RejectionDetail"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Refused",
        "type": "object"
      },
      "RejectionDetail": {
        "additionalProperties": true,
        "description": "A rejection, as REST sends it: its ``type``, its ``message`` and its typed details.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "message"
        ],
        "title": "RejectionDetail",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "artifactr diagrams",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/workspaces/{workspace_id}/diagrams/{artifact_id}/images": {
      "post": {
        "description": "Upload an image to put on a diagram: a PNG or a JPEG, at most 2 MiB, by its bytes.\n\nIts answer names it as the diagram will: by its digest, which an edit's `files` adds.",
        "operationId": "upload_workspaces__workspace_id__diagrams__artifact_id__images_post",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Artifact Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Workspace Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/jpeg": {},
            "image/png": {}
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagramFile"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "Refused"
          },
          "401": {
