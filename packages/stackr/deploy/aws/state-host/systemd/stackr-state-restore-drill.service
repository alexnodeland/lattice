# The state host's weekly restore drill for ClickHouse (ADR-0037): deploy/aws/state-host/restore-drill,
# after the backup. The user data installs it, with the checkout's path in place of @STACKR_DIR@.
# It wants the state services rather than requires them, so restarting stackr-state doesn't stop it.
[Unit]
Description=Restore the state host's latest ClickHouse backup beside it, check it, and report
Wants=stackr-state.service
After=stackr-state.service stackr-state-backup.service

[Service]
Type=oneshot
# 2h includes the up to 1h the drill may wait for the backup's lock (STATE_LOCK_WAIT), which leaves
# the drill less than the backup's 3h if both overrun.
TimeoutStartSec=2h
WorkingDirectory=@STACKR_DIR@/deploy/aws/state-host
# Only the Prometheus URL, not ClickHouse's passwords.
EnvironmentFile=/run/stackr/backup.env
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ExecStart=@STACKR_DIR@/deploy/aws/state-host/restore-drill
