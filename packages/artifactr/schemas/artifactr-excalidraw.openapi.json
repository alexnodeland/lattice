            "description": "Refused"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "Refused"
          }
        },
        "summary": "Upload",
        "x-lattice-command": "artifactr.edit_artifact"
      }
    },
    "/workspaces/{workspace_id}/diagrams/{artifact_id}/images/{sha256}": {
      "get": {
        "description": "An image the diagram names, by its digest, as its canvas shows it.",
