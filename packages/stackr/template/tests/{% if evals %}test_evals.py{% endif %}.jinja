"""The starter experiments run offline, and in Langfuse when asked."""

import runpy
import sys
from typing import Any

import pytest
from pydantic import BaseModel

from evalr import ExperimentResult
from evalr.core import ItemResult
from evalr.memory import InMemoryExperimentTracker

import evals.experiments
from evals.experiments import main, run, scripted, summary


async def test_the_experiments_run_offline() -> None:
    tracker = InMemoryExperimentTracker()
    results = await run(tracker, scripted())
    assert [result.name for result in results] == [
{%- if use_artifactr %}
        "notes-replies",
{%- endif %}
{%- if use_reflexr %}
        "ticket-triage",
{%- endif %}
{%- if use_relayr %}
        "incident-scenarios",
{%- endif %}
    ]
    for result in results:
        assert all(item.verdicts and not item.errors for item in result.items), result
{%- if use_artifactr %}
    replies = results[0].verdicts("rate_reply")
    assert {verdict.value.model_dump()["stars"] for verdict in replies.values()} == {5}
{%- endif %}
{%- if use_reflexr %}
    reviews = results[{% if use_relayr %}-2{% else %}-1{% endif %}].verdicts("review_triage")
    assert {verdict.value.model_dump()["correct"] for verdict in reviews.values()} == {True}
{%- endif %}
{%- if use_relayr %}
    incidents = {
        example: verdict.value.model_dump()
        for example, verdict in results[-1].verdicts("review_incident").items()
    }
    assert {example: v["outcome"] for example, v in incidents.items()} == {
        "as-proposed": "accepted",
        "edited": "edited",
        "rejected": "rejected",
    }
    assert incidents["edited"]["rewrite_rate"] > 0, "a person rewrote the timeline"
    assert incidents["as-proposed"]["rewrite_rate"] == 0


