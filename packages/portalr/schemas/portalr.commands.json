                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A run to link to.",
              "title": "Run Id"
            },
            "session_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A session to link to, in Langfuse.",
              "title": "Session Id"
            },
            "tenant_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A tenant whose traces to link to.",
              "title": "Tenant Id"
            },
            "trace_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A trace to link to, in Langfuse.",
              "title": "Trace Id"
            }
          },
          "type": "object"
        },
