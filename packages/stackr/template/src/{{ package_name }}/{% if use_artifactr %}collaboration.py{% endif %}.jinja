"""artifactr's surfaces: REST and the WebSocket at ``/artifactr/v1``, MCP at ``/artifactr/mcp/``.

People sign in with Supabase; {% if access == 'grantr' %}each request's user comes from its access token, and its tenant
from the request, as ``access.py`` checks; grantr says what they may do in it. A service
principal's key stands in for a token. MCP clients are external agents acting for the user whose
token they carry, or for no one with a key{% else %}each request's tenant and user come from its access token. MCP
clients are external agents acting for the user whose token they carry{% endif %}.
"""

import contextlib
from collections.abc import AsyncGenerator, Awaitable, Callable

from fastapi import FastAPI{% if access == 'grantr' %}, HTTPException{% endif %}
from mcp.server.mcpserver.exceptions import ToolError
from pydantic_ai.capabilities import AbstractCapability
from pydantic_ai.models import Model
from sqlalchemy.ext.asyncio import AsyncEngine
from starlette.requests import HTTPConnection

from artifactr import InMemoryStorage, Runner, Session, SystemActor, UserActor, Workspaces
{%- if use_relayr %}
from artifactr.agent import TurnContext
{%- endif %}
from artifactr.core import Actor, ExternalAgentActor, {% if access == 'grantr' %}Forbidden, {% endif %}TenantId
from artifactr.fastapi import Unauthorized, artifactr_router
{% if not use_relayr -%}
from artifactr.langfuse import langfuse_turn
{% endif -%}
from artifactr.litellm import LiteLLMGateway
from artifactr.mcp import ArtifactrMcp, McpContext
from artifactr.scores import FeedbackMirror, sync_score_configs
from artifactr.sql import SqlStorage, migrate
from artifactr.workspace import Authorize, Hidden
from evalr.langfuse import LangfuseScoreConfigStore, LangfuseScoreSink

{% if access == 'grantr' -%}
from {{ package_name }}.access import Refused
{% endif -%}
from {{ package_name }}.auth import Authenticate, RequireToken, Unauthenticated
from {{ package_name }}.gateway import Guardrails, TenantKeys
{%- if use_relayr %}
from {{ package_name }}.incidents import Timeline
{%- endif %}
from {{ package_name }}.notes import Note, Rating, build_note_agent
from {{ package_name }}.scores import Mirrors, {% if use_relayr %}OnOpen, {% endif %}opened, sync_configs
from {{ package_name }}.settings import GatewaySettings
from {{ package_name }}.telemetry import TelemetryHandle

PREFIX = "/artifactr"


class Collaboration:
    """artifactr in the application: workspaces of notes, the agent, and their surfaces.

    Args:
        name: The application's name, as MCP clients and the gateway's tags see it.
        authenticate: Says who each request comes from, and in which tenant.
        identify: Checks a request's credentials alone, for the MCP server's door.
        authorize: Whether an actor may take an action; without one, everything is allowed.
        hidden: The threads and artifacts an actor may not see; without one, nothing is hidden.
        model: The agent's model.
        gateway: The gateway's settings: tenant keys and guardrails.
        engine: The database; without one, workspaces live in memory.
        telemetry: OpenTelemetry, and Langfuse when it has a client.
{%- if use_relayr %}
        on_open: Called each time a workspace is opened, after the mirrors': relayr's followers.
        turn_context: Entered around each turn: relayr's Langfuse context, when Langfuse is on.
{%- endif %}
    """

    def __init__(
        self,
        *,
        name: str,
        authenticate: Authenticate,
        identify: Callable[[HTTPConnection], Awaitable[object]],
        authorize: Authorize | None = None,
        hidden: Hidden | None = None,
        model: Model,
        gateway: GatewaySettings,
        engine: AsyncEngine | None = None,
        telemetry: TelemetryHandle | None = None,
{%- if use_relayr %}
        on_open: OnOpen | None = None,
        turn_context: TurnContext | None = None,
{%- endif %}
    ) -> None:
        self._authenticate = authenticate
        self._identify = identify
        tracer_provider = telemetry.tracer_provider if telemetry else None
        meter_provider = telemetry.meter_provider if telemetry else None
        langfuse = telemetry.langfuse if telemetry else None
        self._langfuse = langfuse
        self._mirrors: Mirrors | None = None
        if langfuse is not None:
            sink = LangfuseScoreSink(langfuse)

            async def follow(tenant_id: str, workspace_id: str) -> None:
                workspace = await self.workspaces.open(tenant_id, workspace_id, actor=SystemActor())
                await FeedbackMirror(workspace, sink, cursor="langfuse").follow()

            self._mirrors = Mirrors(follow)
        self.workspaces = Workspaces(
            SqlStorage(engine) if engine else InMemoryStorage(),
            types=[Note{% if use_relayr %}, Timeline{% endif %}],
            authorize=authorize,
            hidden=hidden,
            on_open=opened(self._mirrors.watch if self._mirrors else None{% if use_relayr %}, on_open{% endif %}),
            tracer_provider=tracer_provider,
            meter_provider=meter_provider,
        )
        capabilities: list[AbstractCapability[Session[None]]] = [
            LiteLLMGateway(
                tenant_key=TenantKeys(gateway.tenant_keys),
                guardrails=Guardrails(gateway.guardrails).for_workspace,
                tags=[name],
            )
        ]
        if telemetry is not None:
            capabilities.append(telemetry.capability())
        self.runner = Runner[None](
            build_note_agent(model, capabilities=capabilities),
            app=None,
            agent_name="assistant",
            turn_context={% if use_relayr %}turn_context{% else %}langfuse_turn if langfuse else None{% endif %},
            tracer_provider=tracer_provider,
            meter_provider=meter_provider,
        )
        self.mcp = ArtifactrMcp(
            self.workspaces,
            self.runner,
            resolve=self._resolve_client,
            name=name,
        )
        self._tracer_provider = tracer_provider
        self._meter_provider = meter_provider

    async def migrate(self, engine: AsyncEngine) -> None:
        """Upgrade the database to artifactr's schema."""
        await migrate(engine)

    @contextlib.asynccontextmanager
    async def lifespan(self) -> AsyncGenerator[None]:
        """Run the MCP server; with Langfuse, create the score configs and mirror feedback.

        At shutdown the MCP server stops first, then the runner stops the agent's runs still
        going, each recording that it stopped, before the database closes.
        """
        if self._langfuse is not None:
            configs = LangfuseScoreConfigStore(self._langfuse)
            await sync_configs(sync_score_configs(configs, [Rating]))
        try:
            async with self.mcp.lifespan():
                yield
        finally:
            await self.runner.aclose()
            if self._mirrors is not None:
                await self._mirrors.aclose()

    def mount(self, app: FastAPI) -> None:
        """Add the REST and WebSocket routes and the MCP server to the application."""
        router = artifactr_router(
            self.workspaces,
            self.runner,
            resolve_actor=self._resolve_actor,
            tracer_provider=self._tracer_provider,
            meter_provider=self._meter_provider,
        )
        app.include_router(router, prefix=f"{PREFIX}/v1")
        mcp = self.mcp.http_app(streamable_http_path="/")
        app.mount(f"{PREFIX}/mcp", RequireToken(mcp, self._identify))

    async def _resolve_actor(self, connection: HTTPConnection) -> tuple[TenantId, Actor]:
        try:
            principal = await self._authenticate(connection)
        except Unauthenticated as error:
            raise Unauthorized(str(error)) from error
{%- if access == 'grantr' %}
        except Refused as refused:
            if refused.status == 403:
                raise Forbidden(str(refused)) from refused
            raise HTTPException(status_code=refused.status, detail=str(refused)) from refused
        if principal.service:
            return principal.tenant_id, ExternalAgentActor(client_id=principal.user_id)
{%- endif %}
        return principal.tenant_id, UserActor(id=principal.user_id, name=principal.name)

    async def _resolve_client(self, ctx: McpContext) -> tuple[TenantId, ExternalAgentActor]:
        request = ctx.request_context.request  # None for a client in process, without a token
        if request is None:
            raise ToolError("connect over HTTP")
{%- if access == 'grantr' %}
        try:
            principal = await self._authenticate(request)
        except Refused as refused:
            raise ToolError(str(refused)) from refused
        if principal.service:
            return principal.tenant_id, ExternalAgentActor(client_id=principal.user_id)
{%- else %}
        principal = await self._authenticate(request)
{%- endif %}
        return principal.tenant_id, ExternalAgentActor(
            client_id=principal.user_id,
            name=f"{principal.name} (MCP)",
            on_behalf_of=UserActor(id=principal.user_id, name=principal.name),
        )
