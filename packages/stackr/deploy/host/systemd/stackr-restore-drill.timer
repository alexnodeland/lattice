# Runs stackr-restore-drill.service on Sundays, after the backup. A run missed while the host
# was off runs when it starts.
[Unit]
Description=Restore stackr's latest backups beside it, check them, and report, weekly

[Timer]
OnCalendar=Sun *-*-* 05:00:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
