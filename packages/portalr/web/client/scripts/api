#!/usr/bin/env bash
# The client's acceptance tests, against docplan and oncall (portalr RFC-0001's phase 3). It
# starts each from its library's compose.yaml, as a compose project of its own on ports the
# system picks, runs Vitest's `api` project with their URLs, and stops them however it ends.
#
# Usage, from the client's directory, as its `api` task: scripts/api
set -euo pipefail
root=$(cd ../../../.. && pwd)
# shellcheck source=../../../../../scripts/compose-project.sh
source "$root/scripts/compose-project.sh"
export COMPOSE_PROFILES=app DOCPLAN_PORT=0 ARTIFACTR_PG_PORT=0 ONCALL_PORT=0 REFLEXR_PG_PORT=0

docplan_project=$(unique_project portalr-docplan)
oncall_project=$(unique_project portalr-oncall)
docplan=(docker compose --project-directory "$root/packages/artifactr" --project-name "$docplan_project")
oncall=(docker compose --project-directory "$root/packages/reflexr" --project-name "$oncall_project")

stop() {
  local status=$?
  if ((status != 0)); then
    "${docplan[@]}" logs --no-color --tail=100 docplan || true
    "${oncall[@]}" logs --no-color --tail=100 oncall || true
  fi
  "${docplan[@]}" down --volumes --rmi local
  "${oncall[@]}" down --volumes --rmi local
}
trap stop EXIT
"${docplan[@]}" up --detach --build --wait --quiet-pull docplan
"${oncall[@]}" up --detach --build --wait --quiet-pull oncall

ARTIFACTR_URL="http://$("${docplan[@]}" port docplan 8000)/v1" \
REFLEXR_URL="http://$("${oncall[@]}" port oncall 8000)/v1" \
  bun x --bun --no-install vitest run --project api
