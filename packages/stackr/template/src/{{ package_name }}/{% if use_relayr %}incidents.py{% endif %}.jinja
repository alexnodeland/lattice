"""The bridge's example: rules keep an incident's timeline, in a thread people work in.

Replace it with the application's own. relayr bridges the libraries both ways:

- An ``alert.fired`` event, published into reflexr in the application's namespace, fires
  ``open-incident``. Its run creates an incident thread in artifactr, a ``timeline`` artifact in
  it, and posts a notice.
- A person's message in that thread reaches reflexr as ``artifactr:message_posted`` and fires
  ``timeline-entry``, whose run adds the message to the timeline, keyed by the message's event,
  so a retried run rewrites its entry rather than adding another.

The runs act in artifactr as their rules' own participants, within their allowlists: the
timeline is written directly, everything else is a proposal or a notice.
"""

from collections.abc import Mapping
from typing import ClassVar

from pydantic import BaseModel, Field

from artifactr import Artifact, Workspaces, WritePolicy
from reflexr import Event, F, Rule, on, run
from reflexr.workspace import Action, Reaction
from relayr.events import MessagePosted
from relayr.outbound import Allowlist, Outbound, rule_actor

from {{ package_name }}.tickets import AppEvent


class AlertFired(AppEvent, name="alert.fired"):
    """Monitoring saw something wrong with a service."""

    service: str
    summary: str


class Entry(BaseModel):
    """One line of an incident's timeline."""

    source: str
    """Who or what it came from: the monitoring, or the person who wrote it."""

    text: str


class Timeline(Artifact, name="timeline"):
    """An incident's timeline, in its thread: entries keyed by the event each came from."""

    title: str
    thread_id: str
    entries: dict[str, Entry] = Field(default_factory=dict[str, Entry])


class IncidentResolved(AppEvent, name="incident.resolved"):
    """Monitoring, or a person, says a service's incident is over."""

    service: str
    summary: str


class FollowUp(BaseModel):
    """Something to do after an incident."""

    text: str
    owner: str | None = None


class Postmortem(Artifact, name="postmortem"):
    """What happened in an incident, drawn from its timeline, and what to do about it."""

    write_policy: ClassVar[WritePolicy] = "propose"

    title: str
    thread_id: str
    summary: str
    timeline: list[Entry] = Field(default_factory=list[Entry])
    follow_ups: list[FollowUp] = Field(default_factory=list[FollowUp])


EVENTS: list[type[Event]] = [AlertFired, IncidentResolved]
"""The example's own event types, beside the bridged ones."""

open_incident = Rule(
    name="{{ package_name }}:open-incident",
    description="An alert fired. Open an incident thread, with its timeline.",
    when=on(AlertFired),
    then=run("open-incident"),
)

timeline_entry = Rule(
    name="{{ package_name }}:timeline-entry",
    description="A person wrote in a thread. Add it to the thread's timeline, if it has one.",
    when=on(MessagePosted).where(F.author.kind.eq("user")).where(F.kind.eq("message")),
    then=run("timeline-entry"),
)

close_incident = Rule(
    name="{{ package_name }}:close-incident",
    description="An incident was resolved. Say so in its thread, and propose its postmortem.",
    when=on(IncidentResolved),
    then=run("close-incident"),
)

RULES = [open_incident, timeline_entry, close_incident]

ALLOWLISTS: Mapping[str, Allowlist] = {
    open_incident.name: Allowlist(create_threads=True, direct=frozenset({"timeline"})),
    timeline_entry.name: Allowlist(direct=frozenset({"timeline"})),
    # The resolution comes from monitoring, so its chain holds no thread: it names the incident's.
    close_incident.name: Allowlist(threads="any"),
}
"""What each rule may do in artifactr beyond proposals and notices in its chain's threads."""


def incident_actions(outbound: Outbound, workspaces: Workspaces) -> dict[str, Action[None]]:
    """The rules' actions, which act in artifactr through relayr's outbound adapter.

    Args:
        outbound: What the runs do in artifactr.
        workspaces: artifactr's workspaces, where ``timeline-entry`` finds a thread's timeline.
    """

    async def open_incident(reaction: Reaction[None]) -> None:
        [fired] = reaction.events
        assert isinstance(fired.event, AlertFired)
        alert = fired.event
        acting = outbound.acting(reaction)
        thread = await acting.create_thread(f"Incident: {alert.service}")
        entry = Entry(source="monitoring", text=alert.summary)
        timeline = Timeline(title=alert.service, thread_id=thread, entries={fired.id: entry})
        await acting.create(timeline, thread_id=thread)
        await acting.notice(f"Opened the timeline: {alert.summary}", thread_id=thread)

    async def timeline_entry(reaction: Reaction[None]) -> None:
        [said] = reaction.events
        assert isinstance(said.event, MessagePosted)
        message = said.event
        workspace = await workspaces.open(
            reaction.workspace.tenant_id,
            reaction.workspace.workspace_id,
            actor=rule_actor(reaction.run.rule),
        )
        acting = outbound.acting(reaction)
        for timeline in await workspace.artifacts(Timeline):
            if timeline.data.thread_id == message.thread_id:
                entry = Entry(source=message.author.display_name, text=message.content)
                await acting.edit(timeline.id, f"/entries/{said.id}", entry.model_dump())

    async def close_incident(reaction: Reaction[None]) -> None:
        [envelope] = reaction.events
        assert isinstance(envelope.event, IncidentResolved)
        resolved = envelope.event
        workspace = await workspaces.open(
            reaction.workspace.tenant_id,
            reaction.workspace.workspace_id,
            actor=rule_actor(reaction.run.rule),
        )
        timelines = await workspace.artifacts(Timeline)
        incidents = [t for t in timelines if t.data.title == resolved.service]
        if not incidents:
            return
        timeline = incidents[-1].data  # the service's latest incident
        thread = timeline.thread_id
        postmortem = Postmortem(
            title=f"Postmortem: {resolved.service}",
            thread_id=thread,
            summary=resolved.summary,
            timeline=list(timeline.entries.values()),
        )
        count = len(timeline.entries)
        drawn = f"the incident's timeline, {count} {'entry' if count == 1 else 'entries'}"
        why = f"Drawn from {drawn}, and from its resolution: {resolved.summary}"
        acting = outbound.acting(reaction)
        await acting.create(postmortem, thread_id=thread, rationale=why)
        closed = f"Resolved: {resolved.summary} Its postmortem is proposed for review."
        await acting.notice(closed, thread_id=thread)

    return {
        "open-incident": open_incident,
        "timeline-entry": timeline_entry,
        "close-incident": close_incident,
    }
