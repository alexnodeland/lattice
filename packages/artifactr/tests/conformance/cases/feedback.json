    {
      "name": "feedback on an earlier artifact version is workspace-scoped",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "artifacts": [
          {
            "id": "n1",
            "kind": "note",
            "version": 2,
            "data": {
              "text": "Ship Monday",
              "title": ""
            },
            "updated_by": {
              "kind": "agent",
              "thread_id": "thr_1",
              "run_id": "run_1"
            }
          }
        ]
      },
      "command": {
        "type": "give_feedback",
        "feedback_type": "accuracy",
        "target": {
          "kind": "artifact",
          "artifact_id": "n1",
          "version": 1
        },
        "value": {
          "correct": false
        }
      },
      "expect": {
        "outcome": {
          "type": "recorded"
        },
        "events": [
          {
            "type": "feedback_given",
            "target": {
              "kind": "artifact",
              "artifact_id": "n1",
              "version": 1
            },
            "value": {
              "correct": false,
              "verdict": "right",
              "tone": "formal",
              "confidence": 1.0
            },
            "thread_id": null,
            "run_id": null
          }
        ]
      }
    },
