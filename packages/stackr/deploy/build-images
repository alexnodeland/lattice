#!/usr/bin/env bash
# Builds stackr's thin images (RFC-0004, ADR-0034) for this machine's architecture, from lattice's
# root, and checks each: its configuration as the tool reads it, on one machine's settings and on
# the AWS recipe's, and that it starts and answers. Nothing is published, and nothing is reachable
# from outside: the checks run on a Docker network of their own, which publishes no port and has
# no route out.
#
# Usage: deploy/build-images [IMAGE...]   (all of them by default)

set -euo pipefail
cd "$(dirname "$0")/../../.."
images=("$@")
[[ ${#images[@]} -gt 0 ]] || images=(otel-collector tempo loki pyroscope grafana litellm)
# The helpers' images, as compose.yaml pins them: curl, which the checks ask from, and Valkey.
pinned() { sed -n "s|^ *image: \($1:.*\)$|\1|p" packages/stackr/compose.yaml | head -1; }
curl_image=$(pinned curlimages/curl)
valkey_image=$(pinned valkey/valkey)
network=stackr-images-$$
status=0
cleanup() {
  docker ps --all --quiet --filter "label=stackr-images=$network" | xargs -r docker rm --force >/dev/null
  docker network rm "$network" >/dev/null 2>&1 || true
}
trap cleanup EXIT
docker network create --internal "$network" >/dev/null

fail() {
  echo "FAIL: $*" >&2
  status=1
}

# Runs the image once, as the given arguments, and returns its exit code.
once() {
  docker run --rm --network none --label "stackr-images=$network" "$@"
}

# Starts the image on the network as NAME, and waits until URL answers from beside it.
answers() {
  local name=$1 url=$2
  shift 2
  docker run --detach --name "$network-$name" --network "$network" --network-alias "$name" \
    --label "stackr-images=$network" "$@" >/dev/null
  if docker run --rm --network "$network" --label "stackr-images=$network" "$curl_image" \
    --silent --fail --retry 60 --retry-delay 2 --retry-all-errors --max-time 5 --output /dev/null "$url"; then
    echo "ok: $name answers $url"
  else
    docker logs --tail 30 "$network-$name" >&2
    fail "$name never answered $url"
  fi
}

# What a service answers, asked from beside it.
ask() {
  docker run --rm --network "$network" --label "stackr-images=$network" "$curl_image" --silent --fail "$@"
}

# The AWS recipe's storage, as the stack gives it: S3, which the check can't reach.
s3=(--env S3_BUCKET=stackr-telemetry --env S3_REGION=us-east-1 --env S3_ENDPOINT=s3.us-east-1.amazonaws.com
  --env S3_INSECURE=false --env S3_PATH_STYLE=false)

for image in "${images[@]}"; do
  tag=stackr-$image:check
  echo "==> $tag"
  if ! docker build --quiet --file "packages/stackr/deploy/$image/Dockerfile" --tag "$tag" . >/dev/null; then
    fail "$image doesn't build"
    continue
  fi
  case $image in
    otel-collector)
      collector=(--env STACKR_ENVIRONMENT=check --env LANGFUSE_OTLP_AUTH=check
        --env "STACKR_TRACES_EXPORTERS=[otlp_grpc/tempo, otlp_http/langfuse]")
      once "${collector[@]}" "$tag" validate --config=/etc/otelcol-contrib/config.yaml || fail "$image's configuration"
      once "${collector[@]}" --env TEMPO_ADDRESS=tempo.stackr.internal --env PROMETHEUS_ADDRESS=prometheus.stackr.internal \
        --env LOKI_ADDRESS=loki.stackr.internal --env LANGFUSE_ADDRESS=langfuse-web.stackr.internal \
        "$tag" validate --config=/etc/otelcol-contrib/config.yaml || fail "$image's configuration, on AWS"
      answers otel-collector http://otel-collector:13133/ "${collector[@]}" "$tag"
      ;;
    tempo)
      once "$tag" -config.file=/etc/tempo/tempo.yaml -config.expand-env=true -config.verify=true || fail "$image's configuration"
      once "${s3[@]}" --env TEMPO_BACKEND=s3 --env S3_PREFIX=tempo "$tag" \
        -config.file=/etc/tempo/tempo.yaml -config.expand-env=true -config.verify=true || fail "$image's configuration, on S3"
      answers tempo http://tempo:3200/ready "$tag"
      ;;
    loki)
      once "$tag" -config.file=/etc/loki/loki.yaml -config.expand-env=true -verify-config || fail "$image's configuration"
      once "${s3[@]}" --env LOKI_OBJECT_STORE=aws --env S3_PREFIX=loki "$tag" \
        -config.file=/etc/loki/loki.yaml -config.expand-env=true -verify-config || fail "$image's configuration, on S3"
      answers loki http://loki:3100/ready "$tag"
      ;;
    pyroscope)
      # Pyroscope reads and checks its configuration before it prints its version.
      once "${s3[@]}" --env PYROSCOPE_BACKEND=s3 --env S3_PREFIX=pyroscope --env S3_BUCKET_LOOKUP_TYPE=virtual-hosted-style \
        "$tag" -config.file=/etc/pyroscope/config.yaml -config.expand-env=true -version >/dev/null ||
        fail "$image's configuration, on S3"
      answers pyroscope http://pyroscope:4040/ready "$tag"
      ;;
    grafana)
      # Its data sources at Compose's names, then at the AWS recipe's, and its dashboards.
      for names in compose aws; do
        settings=(--env GF_SECURITY_ADMIN_PASSWORD=check)
        suffix=
        if [[ $names == aws ]]; then
          suffix=.stackr.internal
          settings+=(--env "PROMETHEUS_ADDRESS=prometheus$suffix" --env "TEMPO_ADDRESS=tempo$suffix"
            --env "LOKI_ADDRESS=loki$suffix" --env "PYROSCOPE_ADDRESS=pyroscope$suffix")
        fi
        answers "grafana-$names" "http://grafana-$names:3000/api/health" "${settings[@]}" "$tag"
        provisioned=$(ask --user admin:check "http://grafana-$names:3000/api/datasources")
        for source in prometheus:9090 tempo:3200 loki:3100 pyroscope:4040; do
          uid=${source%%:*}
          [[ $provisioned == *"\"uid\":\"$uid\""*"\"url\":\"http://$uid$suffix:${source#*:}\""* ||
            $provisioned == *"\"url\":\"http://$uid$suffix:${source#*:}\""*"\"uid\":\"$uid\""* ]] ||
            fail "grafana's $uid data source isn't at http://$uid$suffix:${source#*:}"
        done
      done
      dashboards=$(ask --user admin:check 'http://grafana-compose:3000/api/search?type=dash-db')
      for folder in stackr artifactr reflexr; do
        [[ $dashboards == *"\"folderTitle\":\"$folder\""* ]] || fail "grafana has no $folder dashboards"
      done
      ;;
    litellm)
      # Its configuration caches in Valkey, which it needs to start.
      docker run --detach --name "$network-valkey" --network "$network" --network-alias valkey \
        --label "stackr-images=$network" "$valkey_image" >/dev/null
      answers litellm http://litellm:4000/health/liveliness --env LITELLM_MASTER_KEY=sk-check \
        --env REDIS_URL=redis://valkey:6379/1 "$tag"
      ;;
    *)
      fail "no check for $image"
      ;;
  esac
done
exit $status
