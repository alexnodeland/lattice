meta {
  name: A stale edit conflicts
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/workspaces/{{workspace}}/commands
  body: json
  auth: none
}

body:json {
  {
    "type": "command",
    "command_id": "edit-doc-again",
    "command": {
      "type": "edit_artifact",
      "artifact_id": "{{doc}}",
      "base_version": 1,
      "summary": "move to Monday",
      "patch": {
        "kind": "json_patch",
        "ops": [
          {
            "op": "replace",
            "path": "/text",
            "value": "Ship on Monday."
          }
        ]
      }
    }
  }
}

tests {
  test("it is a version conflict, with the versions", function () {
    expect(res.status).to.equal(409);
    expect(res.body.ok).to.equal(false);
    expect(res.body.rejection.type).to.equal("version_conflict");
    expect(res.body.rejection.base).to.equal(1);
    expect(res.body.rejection.head).to.equal(2);
  });
}
