"""Access tokens kept out of uvicorn's logs; the libraries keep them out of the spans."""

import io
import logging
import logging.config
from collections.abc import Iterator

import pytest

from {{ package_name }}.redaction import LOG_CONFIG, LOGGERS, RedactedLogs

QUERY = "tenant=acme&access_token=s3cret"


@pytest.fixture
def written() -> Iterator[io.StringIO]:
    """What uvicorn's handlers write, as the application configures its logging."""
    logging.config.dictConfig(LOG_CONFIG)
    buffer = io.StringIO()
    for name in ("uvicorn", *LOGGERS):
        for handler in logging.getLogger(name).handlers:
            if isinstance(handler, logging.StreamHandler):
                handler.setStream(buffer)
    yield buffer
    for name in ("uvicorn", *LOGGERS):
        logger = logging.getLogger(name)
        logger.handlers.clear()
        logger.filters.clear()


def test_uvicorn_logs_requests_and_websockets_without_their_tokens(written: io.StringIO) -> None:
    access = logging.getLogger("uvicorn.access")
    request = ("127.0.0.1:5000", "GET", f"/items?{QUERY}", "1.1", 200)
    access.info('%s - "%s %s HTTP/%s" %d', *request)
    error = logging.getLogger("uvicorn.error")
    error.info('%s - "WebSocket %s" [accepted]', "127.0.0.1:5000", f"/stream?{QUERY}")
    logged = written.getvalue()
    assert "s3cret" not in logged
    assert '"GET /items?tenant=acme&access_token=REDACTED HTTP/1.1" 200' in logged
    assert '"WebSocket /stream?tenant=acme&access_token=REDACTED" [accepted]' in logged


def test_a_handler_added_later_sees_no_token(written: io.StringIO) -> None:
    seen: list[str] = []

    class Seen(logging.Handler):
        def emit(self, record: logging.LogRecord) -> None:
            seen.append(record.getMessage())

    error = logging.getLogger("uvicorn.error")
    error.addHandler(Seen())
    error.info('%s - "WebSocket %s" [accepted]', "127.0.0.1:5000", f"/stream?{QUERY}")
    assert seen == [
        '127.0.0.1:5000 - "WebSocket /stream?tenant=acme&access_token=REDACTED" [accepted]'
    ]


def test_a_record_with_named_arguments_passes_as_it_is() -> None:
    named = logging.LogRecord(
        "app", logging.INFO, __file__, 0, "%(path)s", ({"path": QUERY},), None
    )
    assert RedactedLogs().filter(named)
    assert named.getMessage() == QUERY
