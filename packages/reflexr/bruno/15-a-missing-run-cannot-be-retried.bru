meta {
  name: A missing run cannot be retried
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/workspaces/{{workspace}}/commands
  body: json
  auth: none
}

body:json {
  {
    "type": "command",
    "command_id": "retry-missing",
    "command": {
      "type": "retry_run",
      "run_id": "run_missing"
    }
  }
}

tests {
  test("404, as the command's rejection", function () {
    expect(res.status).to.equal(404);
    expect(res.body.ok).to.equal(false);
    expect(res.body.rejection.type).to.equal("not_found");
  });
}
