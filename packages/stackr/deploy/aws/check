#!/usr/bin/env bash
# Tier 1 of the AWS recipe's checks (RFC-0004): everything that needs neither AWS nor Floci.
#
# Usage: deploy/aws/check
#   OpenTofu and TFLint come from lattice's .prototools, and checkov through uv. It needs Docker,
#   and ShellCheck for the rendered user data.
#
# OpenTofu's format; the two roots, envs/prod and envs/floci, validated against their own lock
# files, which are the tests' own, and envs/prod planned with its example against a mocked AWS;
# TFLint with AWS's ruleset; checkov over each module, with the skips and their reasons in that
# module's .checkov.yaml; the modules' tests, against a mocked AWS (tests/), which validate each
# module as they plan it, with the providers the committed lock file names; and the modules'
# templates, rendered: shellcheck over the state host's user data and Langfuse's worker's wait,
# and GoTrue's proxy, run in Docker (tests/auth-proxy); and the state host's backup alerts,
# checked and tested by promtool from the image the state host runs (ADR-0037).
# The providers download once, into TF_PLUGIN_CACHE_DIR. TFLint fetches its AWS ruleset from
# GitHub, with GITHUB_TOKEN when it is set.

set -euo pipefail
cd "$(dirname "$0")"

export TF_PLUGIN_CACHE_DIR=${TF_PLUGIN_CACHE_DIR:-$HOME/.terraform.d/plugin-cache}
mkdir -p "$TF_PLUGIN_CACHE_DIR"
# checkov's version, and the date its dependencies are resolved at.
source checkov.env
status=0
step() { printf '\n==> %s\n' "$*"; }
fail() {
  echo "FAIL: $*" >&2
  status=1
}
step "Format"
tofu fmt -check -recursive -diff . || fail "tofu fmt: run tofu fmt -recursive deploy/aws"

step "The providers, as the lock file names them"
tofu init -backend=false -input=false -lockfile=readonly >/dev/null || fail "tofu init: the lock file"

step "The roots, envs/prod and envs/floci, valid with their own lock files"
for root in envs/*/; do
  if tofu -chdir="$root" init -backend=false -input=false -lockfile=readonly >/dev/null &&
    tofu -chdir="$root" validate -no-color >/dev/null; then
    echo "ok: $root"
  else
    fail "tofu validate: $root"
  fi
done

step "envs/prod, planned with its example against a mocked AWS"
tofu -chdir=envs/prod test -no-color -var-file=prod.tfvars.example || fail "tofu test: envs/prod"

step "The roots' lock files, the same as the tests'"
for root in envs/*/; do
  cmp -s .terraform.lock.hcl "$root.terraform.lock.hcl" ||
    fail "$root.terraform.lock.hcl differs from .terraform.lock.hcl"
done

step "TFLint"
tflint --init --config "$PWD/.tflint.hcl" >/dev/null
tflint --recursive --config "$PWD/.tflint.hcl" || fail "tflint"

step "checkov, each module with its own skips"
# Each module's own files: with the directory, checkov would follow stack's calls into the other
# modules, and report their findings again without their skips.
for module in modules/*/; do
  if uvx --quiet --exclude-newer "$CHECKOV_RESOLVED_BEFORE" "checkov==$CHECKOV_VERSION" \
    --file "$module"*.tf --config-file "$module.checkov.yaml"; then
    echo "ok: $module"
  else
    fail "checkov: $module"
  fi
done

step "Tests, against a mocked AWS"
tofu test -no-color || fail "tofu test"

step "The templates, rendered"
rendered=$(mktemp -d)
trap 'rm -rf "$rendered"' EXIT
fixture=tests/fixtures/rendered
if tofu -chdir="$fixture" init -backend=false -input=false >/dev/null &&
  tofu -chdir="$fixture" apply -auto-approve -input=false -state="$rendered/state" \
    -var trusted_proxies=198.18.250.0/28 >/dev/null; then
  tofu -chdir="$fixture" output -state="$rendered/state" -raw user_data >"$rendered/user-data.sh"
  tofu -chdir="$fixture" output -state="$rendered/state" -raw caddyfile >"$rendered/Caddyfile"
  shellcheck --shell=bash "$rendered/user-data.sh" || fail "shellcheck: the state host's user data"
  # What the backups need of it: the timers installed and enabled, the bucket's URL for ClickHouse's
  # collection and the Prometheus the scripts report to, written for Compose and the units to read.
  for expected in \
    'systemctl enable --now stackr-state-backup.timer stackr-state-restore-drill.timer' \
    'https://stackr-backups-0123456789.s3.us-east-1.amazonaws.com/' \
    'CLICKHOUSE_BACKUP_PASSWORD=%s' 'STATE_PROMETHEUS_URL=http://%s:9090' '/run/stackr/backup.env' \
    "stackr-state-\$unit"; do
    grep -qF -- "$expected" "$rendered/user-data.sh" || fail "the state host's user data lacks: $expected"
  done
  tofu -chdir="$fixture" output -state="$rendered/state" -raw wait_for_langfuse >"$rendered/wait-for-langfuse.sh"
  shellcheck --shell=sh "$rendered/wait-for-langfuse.sh" || fail "shellcheck: Langfuse's worker's wait"
  tests/auth-proxy "$rendered/Caddyfile" || fail "GoTrue's proxy"
else
  fail "rendering the templates"
fi

step "The state host's backup alerts"
prometheus=$(sed -n 's|^ *image: \(prom/prometheus:.*\)$|\1|p' state-host/compose.yaml | head -1)
[[ -n $prometheus ]] || fail "state-host/compose.yaml pins no Prometheus"
promtool() { docker run --rm --entrypoint promtool -v "$PWD/state-host:/rules:ro" -w /rules "$prometheus" "$@"; }
promtool check rules alerts.yml || fail "promtool: the alerts"
promtool test rules alerts.test.yml || fail "promtool: the alerts' tests"

exit $status
