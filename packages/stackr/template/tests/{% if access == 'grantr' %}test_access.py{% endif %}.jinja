@pytest.mark.parametrize(("read", "mcp", "tool"), PARTS)
def test_the_libraries_answer_refusals_over_rest(read: str, mcp: str, tool: str) -> None:
    with TestClient(app(Script())) as client:
        assert client.get(read, headers=signed()).status_code == 200
        assert client.get(read, headers=signed("dave")).status_code == 400
        refused = client.get(read, headers=signed("alice", **{"X-Tenant": OTHER}))
        assert (refused.status_code, refused.json()["detail"]["type"]) == (403, "forbidden")


@pytest.mark.parametrize(("read", "mcp", "tool"), PARTS)
async def test_a_key_reads_over_rest_and_mcp(read: str, mcp: str, tool: str) -> None:
    grants = seeded()
    key = await with_key(grants)
    async with serving(app(Script(), grants=grants)) as server:
        async with httpx.AsyncClient(base_url=server) as client:
            response = await client.get(read, headers={"Authorization": f"Bearer {key}"})
            assert response.status_code == 200
        headers = {"Authorization": f"Bearer {key}"}
        async with (
            httpx2.AsyncClient(headers=headers) as http,
            Client(streamable_http_client(f"{server}{mcp}", http_client=http)) as client,
        ):
            assert not (await client.call_tool(tool, {"workspace_id": "main"})).is_error
        refused = {"Authorization": f"Bearer {token()}", "X-Tenant": OTHER}
        async with (
            httpx2.AsyncClient(headers=refused) as http,
            Client(streamable_http_client(f"{server}{mcp}", http_client=http)) as client,
        ):
            answer = await client.call_tool(tool, {"workspace_id": "main"})
            assert answer.is_error


async def test_grantrs_api_is_mounted_and_the_application_bootstrapped() -> None:
    grants = seeded()
    key = await with_key(grants)
    async with (
        serving(app(Script(), grants=grants)) as server,
        httpx.AsyncClient(base_url=f"{server}/grantr/v1") as client,
    ):
        me = await client.get("/me", headers=signed())
        assert me.json() == {
            "memberships": [{"tenant": TENANT, "user": "alice", "roles": ["member", "owner"]}]
        }
        assert (await client.get("/me", headers={"Authorization": "Bearer x"})).status_code == 401
        mine = await client.get("/me", headers={"Authorization": f"Bearer {key}"})
        assert mine.json() == {"tenant": TENANT, "roles": ["member"], "workspaces": ["main"]}
        thread = Resource(kind="thread", workspace="main", id="t1")
        assert await grants.check(OTHER, APPLICATION, RUNTIME, thread), "it acts in every tenant"
        assert not await grants.check(TENANT, APPLICATION, "grantr:grant", ON_TENANT)


def test_the_committed_access_matrix_is_current() -> None:
    expected = matrix(CATALOGS)
    assert (ROOT / "access.md").read_text() == expected, "run `make access-matrix`, and review it"


@pytest.mark.filterwarnings("ignore:.*found in sys.modules:RuntimeWarning")
def test_the_module_prints_the_matrix() -> None:
    output = io.StringIO()
    with redirect_stdout(output):
        runpy.run_module("{{ package_name }}.access", run_name="__main__")
    assert output.getvalue() == matrix(CATALOGS)
