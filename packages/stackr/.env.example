# stackr's local settings.
#
# `make env` (scripts/setup-env) copies this file to `.env` and replaces every
# `generate:...` value with a fresh secret. Running it again keeps the values
# already in `.env` and adds keys that are new here. Never commit `.env`.
#
# Everything here is for local development and single hosts.

# The host address published ports bind to. 127.0.0.1 keeps every service
# reachable from this machine only.
STACKR_BIND=127.0.0.1

# The deployment environment telemetry is labelled with
# (deployment.environment.name), when an application doesn't set its own.
STACKR_ENVIRONMENT=local

# --- the recipe: this machine, or a single host ---------------------------------
# How `make` runs the stack:
#   local  on this machine, for development (default)
#   host   a single host, behind Caddy (deploy/host/compose.prod.yaml), on the
#          postgres adapter with the auth profile: `deploy/host/bootstrap` sets it
STACKR_RECIPE=local
# On a single host, the domain Caddy serves: app.<domain> and auth.<domain>.
STACKR_DOMAIN=
# Empty for certificates from Let's Encrypt; `tls internal` for Caddy's own CA.
CADDY_TLS=
# The editors of the native files' apps the application runs, each at
# <app>.<domain>, with a DNS record of its own: `gridcraft.example.com,
# pdfcraft.example.com`. None by default.
STACKR_EDITOR_HOSTS=
# Where Caddy publishes 80 and 443, as STACKR_BIND is for the rest: this
# machine only by default. Set a LAN address, or 0.0.0.0, only on purpose: on
# the host users reach, `deploy/host/bootstrap` sets 0.0.0.0.
STACKR_EDGE_BIND=127.0.0.1
# On a single host, the S3-compatible bucket, off the host, that `make backup`
# (pgBackRest and ClickHouse's BACKUP) writes to and the restore drill reads.
# The endpoint is a host name, reached over HTTPS on the port, path-style.
BACKUP_S3_ENDPOINT=
BACKUP_S3_PORT=443
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The CA bundle, on this host, the store's certificate is checked against: the
# host's own, unless the store's certificate is signed by a CA of its own.
BACKUP_S3_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Encrypts PostgreSQL's backups before they leave the host. Without it, they
# can't be restored: keep it, with the rest of .env, somewhere off the host.
BACKUP_CIPHER_PASS=generate:token
# The ClickHouse user the backups and the restore drill run as.
CLICKHOUSE_BACKUP_PASSWORD=generate:hex

# --- observability ---------------------------------------------------------

# Grafana signs in as `admin` with this password.
GRAFANA_ADMIN_PASSWORD=generate:token

# Published ports. Applications send OTLP to the Collector on 4317 (gRPC) or
# 4318 (HTTP), and profiles to Pyroscope on 4040; portalr reads Prometheus
# through prom-label-proxy on 9091.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PYROSCOPE_PORT=4040
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROM_LABEL_PROXY_PORT=9091
TEMPO_PORT=3200
LOKI_PORT=3100

# --- database: the PostgreSQL port -------------------------------------------

# The PostgreSQL adapter the stack's services keep their databases on:
#   supabase  local Supabase, started by `make up` through its CLI (default)
#   postgres  plain PostgreSQL, the `postgres` profile
# db-init creates a role and a database for each service on either.
STACKR_DATABASE=supabase
# The plain PostgreSQL adapter's admin password and published port. Local
# Supabase's are fixed: `postgres`, on port 54322.
POSTGRES_ADMIN_PASSWORD=generate:hex
POSTGRES_PORT=55432

# --- identity: GoTrue, the auth profile ---------------------------------------
# Supabase's auth server alone, on the postgres adapter (local Supabase runs its
# own). AUTH_PUBLIC_URL is where users and applications reach it, and its tokens'
# issuer; on a single host, `https://auth.<your host>`.
AUTH_PORT=9999
AUTH_PUBLIC_URL=http://localhost:9999
# Where its emails send people back to: the application.
AUTH_SITE_URL=http://localhost:8800
AUTH_DB_PASSWORD=generate:hex
# The ES256 key set it signs tokens with, and the service role's key, a JWT
# signed with it for the admin API. Made together: to replace them, delete both.
AUTH_JWT_KEYS=generate:auth-keys
AUTH_SERVICE_ROLE_KEY=generate:auth-service-role:AUTH_JWT_KEYS
# GoTrue requires a shared secret too, though nothing is signed with it.
AUTH_JWT_SECRET=generate:hex
# The SMTP server GoTrue sends invitations and password resets through.
# Optional: without one, it sends no email.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SENDER=

# --- the Redis protocol, with Valkey -----------------------------------------

REDIS_PASSWORD=generate:hex

# --- object storage: the S3 port, with MinIO ---------------------------------

S3_ACCESS_KEY_ID=stackr
S3_SECRET_ACCESS_KEY=generate:hex
S3_REGION=auto
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- langfuse ----------------------------------------------------------------

LANGFUSE_PORT=3300
LANGFUSE_DB_PASSWORD=generate:hex
CLICKHOUSE_PASSWORD=generate:hex
# ClickHouse's admin, for operators, from inside its container only.
CLICKHOUSE_ADMIN_PASSWORD=generate:hex
# portalr's analytics (lattice RFC-0008, ADR-0044): the writer's and the reader's ClickHouse
# passwords, each limited to analytics.events, and how many days an event is kept.
CLICKHOUSE_ANALYTICS_WRITER_PASSWORD=generate:hex
CLICKHOUSE_ANALYTICS_PASSWORD=generate:hex
# Grafana's ClickHouse user's, which reads every tenant's analytics for operators' dashboards
# (ADR-0048).
CLICKHOUSE_GRAFANA_PASSWORD=generate:hex
ANALYTICS_RETENTION_DAYS=395
# ClickHouse's HTTP interface, on 127.0.0.1 only, for portalr's analytics in `make serve`.
CLICKHOUSE_HTTP_PORT=8123
# SALT and ENCRYPTION_KEY must never change once Langfuse has data.
LANGFUSE_SALT=generate:token
LANGFUSE_ENCRYPTION_KEY=generate:hex
LANGFUSE_NEXTAUTH_SECRET=generate:token

# Created on first start: an organisation and project, the project's API keys,
# and an admin user who signs in with this email and password.
LANGFUSE_INIT_ORG_ID=stackr
LANGFUSE_INIT_PROJECT_ID=stackr
LANGFUSE_PUBLIC_KEY=generate:uuid:pk-lf-
LANGFUSE_SECRET_KEY=generate:uuid:sk-lf-
LANGFUSE_ADMIN_EMAIL=admin@stackr.local
LANGFUSE_ADMIN_PASSWORD=generate:token

# The Collector's credentials for Langfuse's OTLP endpoint, derived from the
# project's keys.
LANGFUSE_OTLP_AUTH=basic-auth:LANGFUSE_PUBLIC_KEY:LANGFUSE_SECRET_KEY

# --- the LLM gateway: LiteLLM ------------------------------------------------

LITELLM_PORT=4400
# The master key administers the proxy (teams, keys, the admin UI at /ui, as
# `admin`); applications use team keys from scripts/create-tenant instead.
LITELLM_MASTER_KEY=generate:token:sk-
# Encrypts credentials the proxy stores; must never change.
LITELLM_SALT_KEY=generate:token
LITELLM_DB_PASSWORD=generate:hex

# Provider keys. A model whose key is empty fails; the others still work.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local model servers on this machine, as the gateway's container sees them.
LM_STUDIO_API_BASE=http://host.docker.internal:1234/v1
OMLX_API_BASE=http://host.docker.internal:4243/v1

# The model groups applications ask for, `default` and `fast`: providers (the
# provider models above) or upstream, another OpenAI-compatible gateway, such
# as one of your own in front of your own models (ADR-0047). For upstream, its
# URL and key, its models for the two groups, and, if its certificate is signed
# by an authority of your own, that authority's PEM file, a path on this
# machine: the gateway then trusts it alone.
STACKR_GATEWAY_MODELS=providers
STACKR_UPSTREAM_URL=
STACKR_UPSTREAM_API_KEY=
STACKR_UPSTREAM_DEFAULT_MODEL=
STACKR_UPSTREAM_FAST_MODEL=
STACKR_UPSTREAM_CA=

# --- task trackers: the opt-in recipes, trackers/ (lattice RFC-0004) ---------
# `make tracker-up TRACKER=plane` or `TRACKER=vikunja`, beside the stack.

# Plane's Community edition, at PLANE_URL, where people reach it, published on
# PLANE_PORT. Its API allows each key PLANE_API_KEY_RATE_LIMIT requests; its
# webhooks go only to PLANE_WEBHOOK_HOSTS, the application's name on the
# stackr network (Plane takes only a name with a dot in it).
PLANE_PORT=3800
PLANE_URL=http://localhost:3800
PLANE_SECRET_KEY=generate:token
PLANE_DB_PASSWORD=generate:hex
PLANE_MQ_PASSWORD=generate:hex
PLANE_API_KEY_RATE_LIMIT=300/minute
PLANE_WEBHOOK_HOSTS=app.stackr.internal
# Celery's worker processes, which deliver webhooks; one per CPU by default.
PLANE_WORKER_CONCURRENCY=2

# Vikunja, at VIKUNJA_URL, published on VIKUNJA_PORT. Sign-up stays off: the
# operator makes each tenant's user (the tracker guide).
VIKUNJA_PORT=3456
VIKUNJA_URL=http://localhost:3456
VIKUNJA_SECRET=generate:token
VIKUNJA_DB_PASSWORD=generate:hex
VIKUNJA_REGISTRATION=false
