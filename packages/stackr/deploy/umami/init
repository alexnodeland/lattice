#!/bin/sh
# Umami's accounts and website, on every start (stackr ADR-0050): idempotent, as umami-init runs it
# after Umami is up. .env is the source of truth for each password:
# - the admin's is UMAMI_ADMIN_PASSWORD, set from Umami's first password, `umami`, the first time;
#   a password changed in Umami's UI since is refused, and said, until .env names it again;
# - portalr's user, with a fixed id, has UMAMI_PORTALR_PASSWORD: made, or given it again by the
#   admin where it was rotated in .env;
# - portalr's website, owned by that user, with the fixed id UMAMI_WEBSITE_ID, so portalr may
#   delete a person's sessions in it.
# Passwords are sent in bodies, and a token in a header file, never on a command line or in a URL.
set -eu
url=${UMAMI_URL:-http://umami:3000}
portalr_user=7d1f0a3e-5b2c-4e8a-9c41-706f7274616c
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# A JSON field's string value, from an answer Umami gave.
field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }

# A value as a JSON string's contents: its backslashes and quotes escaped.
quoted() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# A request with a body from standard input, as a token's holder if one is named: the answer.
call() {
  method=$1 path=$2 token=${3:-}
  : >"$scratch/auth"
  [ -z "$token" ] || printf 'Authorization: Bearer %s\n' "$token" >"$scratch/auth"
  if [ "$method" = GET ]; then
    curl -fsS "$url$path" -H "@$scratch/auth"
  else
    curl -fsS -X "$method" "$url$path" -H 'Content-Type: application/json' -H "@$scratch/auth" \
      --data-binary @-
  fi
}

login() {
  printf '{"username":"%s","password":"%s"}' "$1" "$(quoted "$2")" |
    call POST /api/auth/login 2>/dev/null | field token
}

answered=false
for _ in $(seq 60); do
  if curl -fsS -o /dev/null "$url/api/heartbeat" 2>/dev/null; then
    answered=true
    break
  fi
  sleep 2
done
if [ "$answered" != true ]; then
  echo "umami-init: Umami didn't answer at $url in two minutes" >&2
  exit 1
fi

admin=$(login admin "$UMAMI_ADMIN_PASSWORD" || true)
if [ -z "$admin" ]; then
  first=$(login admin umami || true)
  if [ -z "$first" ]; then
    echo "umami-init: Umami's admin has neither UMAMI_ADMIN_PASSWORD nor Umami's first password;" \
      "if it was changed in Umami's UI, put that one in .env as UMAMI_ADMIN_PASSWORD" >&2
    exit 1
  fi
  printf '{"currentPassword":"umami","newPassword":"%s"}' "$(quoted "$UMAMI_ADMIN_PASSWORD")" |
    call POST /api/me/password "$first" >/dev/null
  admin=$(login admin "$UMAMI_ADMIN_PASSWORD")
  echo "umami-init: the admin's password is UMAMI_ADMIN_PASSWORD"
fi

portalr=$(login portalr "$UMAMI_PORTALR_PASSWORD" || true)
if [ -z "$portalr" ]; then
  if printf '{"password":"%s"}' "$(quoted "$UMAMI_PORTALR_PASSWORD")" |
    call POST "/api/users/$portalr_user" "$admin" >/dev/null 2>&1; then
    echo "umami-init: portalr's user has UMAMI_PORTALR_PASSWORD again"
  else
    printf '{"id":"%s","username":"portalr","password":"%s","role":"user"}' \
      "$portalr_user" "$(quoted "$UMAMI_PORTALR_PASSWORD")" | call POST /api/users "$admin" >/dev/null
    echo "umami-init: made portalr's user"
  fi
  portalr=$(login portalr "$UMAMI_PORTALR_PASSWORD")
fi

call GET "/api/websites/$UMAMI_WEBSITE_ID" "$portalr" >/dev/null 2>&1 ||
  {
    printf '{"id":"%s","name":"portalr","domain":"portalr.internal"}' "$UMAMI_WEBSITE_ID" |
      call POST /api/websites "$portalr" >/dev/null
    echo "umami-init: made portalr's website, $UMAMI_WEBSITE_ID"
  }
# Replay, on Umami's side: off unless UMAMI_REPLAY is true, which follows the privacy review's
# sign-off (portalr ADR-0077). Set on every run, so turning it off in .env turns it off here.
replay=false
[ "${UMAMI_REPLAY:-false}" = true ] && replay=true
printf '{"replayConfig":{"replayEnabled":%s,"heatmapEnabled":false}}' "$replay" |
  call POST "/api/websites/$UMAMI_WEBSITE_ID" "$portalr" >/dev/null
echo "umami-init: replay is $([ "$replay" = true ] && echo on || echo off) for portalr's website"
echo "umami-init: ready"
