async def test_a_user_is_found_by_their_email_or_named_by_their_id(issuer: str) -> None:
    users = Users(issuer, "service")
    assert await users.find("ALICE@example.com") == "u-alice"
    assert await users.find("u-someone") == "u-someone"
    with pytest.raises(LookupError, match="no user has the email"):
        await users.find("erin@example.com")
    with pytest.raises(LookupError, match="AUTH_SERVICE_ROLE_KEY"):
        await Users(issuer, None).find("alice@example.com")


