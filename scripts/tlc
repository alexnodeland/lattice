#!/usr/bin/env bash
# Model-checks a TLA+ spec with TLC, once for each configuration (lattice ADR-0025).
#
# Usage: scripts/tlc SPEC.tla CONFIG.cfg...   (each configuration beside the spec)
#
# TLC is tla2tools.jar from the tlaplus/tlaplus release VERSION, downloaded once into TLC_CACHE and
# checked against SHA256 before every run: a jar with other bytes never runs. Release 1.7.4's
# notes publish the jar's SHA-1, bee4a54f3ee3d4afc347c3240ec2d9e93b075104; the download that
# matched it is the one whose SHA-256 is pinned here. It needs Java 11 or later, which CI sets up.
# A violated property, or a run that can't finish, fails it.

set -euo pipefail

readonly VERSION=1.7.4
readonly SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
readonly URL="https://github.com/tlaplus/tlaplus/releases/download/v$VERSION/tla2tools.jar"

spec=$(realpath "${1:?usage: scripts/tlc SPEC.tla CONFIG.cfg...}")
shift
[[ $# -gt 0 ]] || { echo "tlc: name at least one configuration" >&2; exit 2; }

cache=${TLC_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/lattice-tlc}
jar="$cache/tla2tools-$VERSION.jar"
mkdir -p "$cache"
if [[ ! -f $jar ]]; then
  curl --fail --silent --show-error --location --retry 5 --retry-all-errors \
    --output "$jar.part" "$URL"
  mv "$jar.part" "$jar"
fi
if command -v sha256sum >/dev/null; then
  sum=$(sha256sum "$jar")
else
  sum=$(shasum -a 256 "$jar")
fi
if [[ ${sum%% *} != "$SHA256" ]]; then
  echo "tlc: $jar is not tla2tools.jar $VERSION (sha256 ${sum%% *}); removed" >&2
  rm -f "$jar"
  exit 1
fi

# TLC's states go to a directory of the run's own, never beside the spec.
meta=$(mktemp -d)
trap 'rm -rf "$meta"' EXIT
cd "$(dirname "$spec")"
for config in "$@"; do
  echo "tlc: $(basename "$spec") with $config"
  java -XX:+UseParallelGC -cp "$jar" tlc2.TLC -workers auto -cleanup \
    -metadir "$meta/${config%.cfg}" -config "$config" "$(basename "$spec")"
done
