TOKEN = "a-workers-token-of-32-characters-or-more"
WORDCRAFT = FilesSettings(crafts=("wordcraft",), tokens={"wordcraft": TOKEN})
ALICE = UserActor(id="alice", name="Alice")


class Stand(FakeApp):
    """The fake app, standing in for WordCraft at its pinned version."""

    name = "wordcraft"
    version = CRAFTS["wordcraft"]
    integration = "files:wordcraft"


def workers(token: str = TOKEN, app: FakeApp | None = None) -> httpx.ASGITransport:
    """WordCraft's worker, as the application reaches it, with the fake app for its CLI."""
    worker = worker_app(app or Stand(), token=token, limits=Limits())
    return httpx.ASGITransport(app=worker)


async def resolve_actor(_connection: HTTPConnection) -> tuple[TenantId, Actor]:
    return TENANT, ALICE


