#!/usr/bin/env bash
# Check scripts/dev without starting anything: against a fake `docker`, `make`, `uv` and `git
# fetch`, and a made-up stackr directory, it checks what each command runs, in what order, and
# what it refuses before anything starts (stackr ADR-0053). moon's `lattice:check-dev` runs it.
# `check` runs the checks' functions, which shellcheck can't follow.
# shellcheck disable=SC2329
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
status=0
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
# The made-up commit below has an author whatever this machine's git says.
export GIT_AUTHOR_NAME=check-dev GIT_AUTHOR_EMAIL=check-dev@localhost
export GIT_COMMITTER_NAME=check-dev GIT_COMMITTER_EMAIL=check-dev@localhost

check() {
  local what=$1
  shift
  if "$@"; then echo "ok: $what"; else echo "FAIL: $what"; status=1; fi
}
refused() { ! "$@" >"$scratch/out" 2>&1; }
said() { grep -qF "$1" "$scratch/out"; }
# Whether nothing was started: no make target but env, and no docker call.
nothing_started() { ! grep -v '^docker compose version$' "$scratch/calls" | grep -qE '^docker|^make .* up'; }

real_uv=$(command -v uv)
mkdir -p "$scratch/bin" "$scratch/stackr"
cp packages/stackr/copier.yml "$scratch/stackr/"
# docker, with a `stackr` PostgreSQL volume where FAKE_VOLUME says, which takes the password
# FAKE_PASSWORD, given to psql in its environment; FAKE_PSQL says what else psql answers, and
# FAKE_PG_UP=fail fails PostgreSQL's start. It stands for the logic alone: that a wrong password
# fails over the container's own address, and passes on its loopback, which the image trusts, was
# checked against a real PostgreSQL, which this check can't start.
cat >"$scratch/bin/docker" <<'FAKE'
#!/usr/bin/env bash
echo "docker $*" >>"$CALLS"
[[ $* == "context show" ]] && echo default
[[ $1 == volume && -n ${FAKE_VOLUME:-} ]] && echo stackr_postgres-data
[[ $* == *"up --detach --wait postgres" && ${FAKE_PG_UP:-} == fail ]] && exit 1
if [[ $* == *" exec "*psql* ]]; then
  if [[ -n ${FAKE_PSQL:-} ]]; then
    echo "$FAKE_PSQL" >&2
    exit 2
  fi
  [[ $* == *"-e PGPASSWORD "* && ${PGPASSWORD:-} == "${FAKE_PASSWORD:-}" ]] && exit 0
  echo 'psql: error: FATAL:  password authentication failed for user "postgres"' >&2
  exit 2
fi
exit 0
FAKE
cat >"$scratch/bin/make" <<'FAKE'
#!/usr/bin/env bash
echo "make $*" >>"$CALLS"
if [[ $4 == env && $3 == "$APP" ]]; then
  (umask 077 && : >"$APP/.env")
fi
exit 0
FAKE
# uv runs Python itself; Copier, the lock and stackr's scripts are made up, each call logged with
# its arguments. Copier records the commit as `git describe` says it, as Copier does.
# Without Copier where FAKE_NO_COPIER says, until stackr's dev group is synced.
cat >"$scratch/bin/uv" <<FAKE
#!/usr/bin/env bash
if [[ -n \${FAKE_NO_COPIER:-} && \$* == *"import copier"* && ! -e "$scratch/synced" ]]; then
  exit 1
fi
case "\$*" in
  *"python -c"*) exec "$real_uv" "\$@" ;;
  sync*) echo "uv \$*" >>"\$CALLS"; [[ -z \${FAKE_SYNC:-} ]] || exit 1; touch "$scratch/synced"; exit 0 ;;
esac
echo "uv \$*" >>"\$CALLS"
case "\$*" in
  *"copier copy"*)
    args=("\$@") dest="\${*: -1}"
    for ((i = 0; i < \${#args[@]}; i++)); do [[ \${args[i]} == --vcs-ref ]] && ref=\${args[i + 1]}; done
    mkdir -p "\$dest"
    [[ \${FAKE_RENDER:-} == fail ]] && exit 1
    printf '_commit: %s\n' "\$(git -C "$root" describe --tags --always "\$ref")" >"\$dest/.copier-answers.yml"
    printf 'name: portal\n' >"\$dest/compose.yaml"
    printf '[project]\nname = "portal"\n' >"\$dest/pyproject.toml"
    exit 0 ;;
  lock*) exit 0 ;;
  *scripts/create-tenant*) printf '%s' "\${FAKE_TENANT_KEY-sk-tenant-made-up}"; exit 0 ;;
  *scripts/create-portal-key*)
    [[ \${FAKE_PORTAL:-0} == 0 ]] && echo sk-portal-made-up
    exit "\${FAKE_PORTAL:-0}" ;;
  *scripts/wire-app*) cat >>"\$APP/.env"; exit 0 ;;
esac
exec "$real_uv" "\$@"
FAKE
# git as it is, but for fetch, which needs no network here, and origin, which has every commit
# but UNPUSHED.
cat >"$scratch/bin/git" <<FAKE
#!/usr/bin/env bash
[[ \$1 == fetch ]] && exit 0
if [[ \$1 == for-each-ref ]]; then
  [[ \$3 == "\${UNPUSHED:-}" ]] || echo "origin/main"
  exit 0
fi
exec "$(command -v git)" "\$@"
FAKE
chmod +x "$scratch/bin/"*

# A run of scripts/dev against the fakes, with a stackr .env on ADAPTER (none: no .env).
dev() {
  local adapter=$1
  shift
  rm -f "$scratch/stackr/.env"
  [[ $adapter == none ]] || echo "STACKR_DATABASE=$adapter" >"$scratch/stackr/.env"
  [[ -z ${STACK_EXTRA:-} ]] || echo "$STACK_EXTRA" >>"$scratch/stackr/.env"
  : >"$scratch/calls"
  env PATH="$scratch/bin:$PATH" CALLS="$scratch/calls" APP="$scratch/app" DEV_APP_DIR="$scratch/app" \
    DEV_STACKR_DIR="$scratch/stackr" "$@"
}
# up, with what it says in $scratch/out.
up() { dev postgres "$@" scripts/dev up >"$scratch/out" 2>&1; }
key() { sed -n "s/^$1=//p" "$scratch/app/.env" | head -n 1; }
fresh() { rm -rf "$scratch/app" "$scratch/app.rendering"; }

check "up refuses a stack on local Supabase" refused dev supabase scripts/dev up
check "and says so, before anything starts" said "chooses STACKR_DATABASE=supabase"
check "and starts nothing" nothing_started

unpushed=$(git commit-tree "HEAD^{tree}" -p HEAD -m "not pushed")
check "up refuses a commit that isn't on origin" refused dev none env DEV_REF="$unpushed" UNPUSHED="$unpushed" scripts/dev up
check "and says so" said "isn't on origin"
check "and starts nothing" nothing_started

check "up refuses an application whose generation failed" refused dev postgres env FAKE_RENDER=fail scripts/dev up
check "and starts nothing" nothing_started
check "and leaves no application, only what it was generating" test ! -e "$scratch/app" -a -d "$scratch/app.rendering"

check "up generates the application, and starts both" up
check "and removed what the failed run left" test ! -e "$scratch/app.rendering"
check "with stackr's stack on postgres" grep -qE \
  "^make -s -C $scratch/stackr up PROFILES=observability langfuse gateway auth analytics umami STACKR_DATABASE=postgres$" "$scratch/calls"
check "its keys and choices in its .env, mode 0600" test \
  "$(key LITELLM_API_KEY) $(key PORTAL_LITELLM_KEY) $(key DIAGRAMS) $(uv run python -c 'import os, sys; print(oct(os.stat(sys.argv[1]).st_mode & 0o777))' "$scratch/app/.env")" = \
  "sk-tenant-made-up sk-portal-made-up on 0o600"
check "every crafting app but Blender" test "$(key FILES_CRAFTS | tr , '\n' | grep -c .) $(key FILES_CRAFTS | grep -c blender)" = "10 0"
check "and db-roles before the start" grep -q "run --rm --no-deps -T app portal-admin db-roles" "$scratch/calls"
check "never printing a key" refused grep -q made-up "$scratch/out"
check "nor passing one as an argument" refused grep -q made-up "$scratch/calls"
check "and says nothing of a stale application" refused said "was generated from"

up
check "up again generates nothing and makes no key" refused grep -qE "copier|create-tenant|create-portal-key" "$scratch/calls"
check "and says nothing of a stale application" refused said "was generated from"
up env DEV_DIAGRAMS=off
check "and sets DIAGRAMS from DEV_DIAGRAMS" test "$(sed -n 's/^DIAGRAMS=//p' "$scratch/app/.env" | tail -n 1)" = off
up env DEV_REF=HEAD~1
check "an application from another commit is said, with copier update" said "copier update"

fresh
check "a key made before a later failure is kept" refused dev postgres env FAKE_PORTAL=1 scripts/dev up
check "in the application's .env" test "$(key LITELLM_API_KEY)" = sk-tenant-made-up
check "and the failure is said" said "making portalr's spend-read key failed"
check "up doesn't make that key again" up
check "but makes the one that failed" test "$(grep -c create-tenant "$scratch/calls") $(key PORTAL_LITELLM_KEY)" = "0 sk-portal-made-up"
fresh
check "up refuses a tenant key it can't read back" refused dev postgres env FAKE_TENANT_KEY= scripts/dev up
check "and says how to recover" said "delete the key"

fresh
check "up generates the application with no git identity on this machine" up env -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL \
  -u GIT_COMMITTER_NAME -u GIT_COMMITTER_EMAIL GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
check "and commits it" test -n "$(git -C "$scratch/app" rev-parse --verify --quiet HEAD)"
fresh
printf '[user]\n\temail = mine@example.test\n' >"$scratch/gitconfig"
check "up generates it with this machine's email and a name of its own" up env -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL \
  -u GIT_COMMITTER_NAME -u GIT_COMMITTER_EMAIL GIT_CONFIG_GLOBAL="$scratch/gitconfig" GIT_CONFIG_NOSYSTEM=1
check "and commits it as that email" test "$(git -C "$scratch/app" log -1 --format=%ae)" = mine@example.test

# up, with stackr's stack published on every interface.
lan_up() { STACK_EXTRA=STACKR_BIND=0.0.0.0 dev postgres "$@" scripts/dev up >"$scratch/out" 2>&1; }
check "up refuses a stack published beyond the loopback" refused lan_up
check "and says how to choose it" said "DEV_LAN=yes"
check "and starts nothing" nothing_started
check "up takes it with DEV_LAN=yes" lan_up env DEV_LAN=yes

fresh && mkdir -p "$scratch/app" && echo mine >"$scratch/app/notes"
check "up refuses a directory that isn't an application it generated" refused up
check "and says so, before anything starts" said "isn't an application make dev generated"
fresh && mkdir -p "$scratch/app.rendering" && echo mine >"$scratch/app.rendering/notes"
check "up refuses a .rendering it wasn't generating" refused up
check "and leaves it" test -f "$scratch/app.rendering/notes"
fresh && ln -s "$scratch/elsewhere" "$scratch/app"
check "up refuses a link for DEV_APP_DIR" refused up
check "and says so" said "is a link"
rm -f "$scratch/app"
check "up refuses DEV_APP_DIR around lattice" refused dev postgres env DEV_APP_DIR="$root/.." scripts/dev up
check "and says so" said "would hold lattice itself"

fresh && rm -f "$scratch/synced"
check "up installs stackr's dev group where Copier isn't" up env FAKE_NO_COPIER=1
check "with uv, beside what .venv has" grep -qx "uv sync --quiet --locked --inexact --package stackr --only-group dev" "$scratch/calls"
check "and runs no make install" refused grep -q "make .*install" "$scratch/calls"
fresh && rm -f "$scratch/synced"
check "up stops when stackr's dev group can't be installed" refused up env FAKE_NO_COPIER=1 FAKE_SYNC=fail
check "and says so" said "couldn't install stackr's dev group (offline?)"

# up, with a `stackr` PostgreSQL volume from an earlier stack, and .env's password for it.
volume_up() {
  STACK_EXTRA=POSTGRES_ADMIN_PASSWORD=pw-made-up dev postgres env FAKE_VOLUME=1 "$@" scripts/dev up >"$scratch/out" 2>&1
}
check "up refuses a stack volume made with another password" refused volume_up env FAKE_PASSWORD=other
check "and says the two ways out" said "use the .env that made it, or \`make dev-reset\`"
check "and says the PostgreSQL left running stops with make dev-down" said "\`make dev-down\` stops it"
check "having started PostgreSQL alone" test "$(grep -c "up --detach --wait postgres$" "$scratch/calls") $(grep -c "make .* up " "$scratch/calls")" = "1 0"
check "and never passed the password as an argument" refused grep -q pw-made-up "$scratch/calls"
check "signing in over the container's own address, not its loopback, which the image trusts" \
  test "$(grep -c 'hostname -i' "$scratch/calls") $(grep -c 'host 127.0.0.1' "$scratch/calls")" = "1 0"
check "up takes a stack volume its password opens" volume_up env FAKE_PASSWORD=pw-made-up
check "up says what psql said, when it isn't the password" refused volume_up env FAKE_PSQL="could not translate host name"
check "and doesn't blame the password" test "$(grep -c "could not translate host name" "$scratch/out") $(grep -c "another POSTGRES_ADMIN_PASSWORD" "$scratch/out")" = "1 0"
check "up stops when PostgreSQL doesn't start" refused volume_up env FAKE_PG_UP=fail
check "and says so" said "PostgreSQL didn't start"

fresh && up
dev postgres scripts/dev down >/dev/null 2>&1
check "down stops the application, then the stack, keeping their data" test \
  "$(grep -c -e --volumes -e ' -v' "$scratch/calls") $(sed -n 1p "$scratch/calls")" = "0 make -s -C $scratch/app down"

check "reset refuses without a terminal" refused dev postgres scripts/dev reset </dev/null
check "and calls no docker" test ! -s "$scratch/calls"
# A terminal, which pty gives it, and an answer.
in_terminal() {
  printf '%s\n' "$1" | dev postgres env COMPOSE_PROJECT_NAME=elsewhere \
    uv run python -c 'import pty, sys; sys.exit(pty.spawn(["scripts/dev", "reset"]) >> 8)'
}
in_terminal no >"$scratch/out" 2>&1 || true
check "reset deletes nothing unless told yes" refused grep -q down "$scratch/calls"
in_terminal yes >"$scratch/out" 2>&1
check "reset deletes the application's project, then the stack's, by name" test \
  "$(grep '^docker compose -p' "$scratch/calls" | tr '\n' '|')" = \
  "docker compose -p portal down --volumes|docker compose -p stackr down --volumes|"
check "and takes the gateway's keys out of the application's .env" test -z "$(key LITELLM_API_KEY)$(key PORTAL_LITELLM_KEY)"
up
check "so the next up makes new ones" test "$(grep -cE "create-tenant|create-portal-key" "$scratch/calls")" = 2
mv "$scratch/app/.env" "$scratch/env-elsewhere" && ln -s "$scratch/env-elsewhere" "$scratch/app/.env"
in_terminal yes >"$scratch/out" 2>&1
check "reset writes a linked .env where it points, and leaves the link" test -L "$scratch/app/.env" -a -z "$(sed -n 's/^LITELLM_API_KEY=//p' "$scratch/env-elsewhere")"
up
printf 'name: stackr\n' >"$scratch/app/compose.yaml"
in_terminal yes >"$scratch/out" 2>&1 || true
check "reset refuses an application named as the stack" said "which isn't an application's"
check "and deletes nothing" refused grep -q down "$scratch/calls"

exit $status
