# {{ project_name }} beside stackr's stack, in the `app` profile: `make up`, or
#
#   docker compose --profile app up --detach --build --wait
#
# Start the stack first (`make up` in stackr): it creates the two networks the application
# joins, `stackr` and local Supabase's, where it reaches the stack's services by name. The
# settings come from .env, except the stack's addresses on its networks, from stackr.env.
{%- if use_files %}
#
# Native files: each crafting app FILES_CRAFTS names runs in a worker of its own, files-<app>-worker,
# in the profile files-<app>, which `make up` adds for each (stackr ADR-0043). A worker is on a
# network of its own, files-<app>, which has no route out, with its relay alone, files-<app>: the
# application reaches the relay on the `files` network, with the worker's own token, and the relay
# passes the connection on. A worker can reach its relay, which reaches only it, and never the
# application (ADR-0046). Needs Compose 2.20 or later.
{%- if use_portal %} An
# app whose browser build hands a file over has its editor too, files-<app>-editor, published on
# this machine's loopback, on a port of its own: an origin of its own, which the portal frames.
{%- endif %}
{%- endif %}
{%- if use_diagrams %}
#
# Diagrams: with DIAGRAMS=on, `make up` starts the diagrams worker, diagrams-worker, in the
# profile `diagrams` (stackr ADR-0049): Excalidraw in headless Chromium, which draws the agent's
# Mermaid and skeletons and renders diagrams. It is on a network of its own, diagrams, with no
# route out, with its relay alone, `diagrams`, which the application reaches on `files`, as a
# native file's worker is.
{%- endif %}

name: {{ project_slug }}
{%- if use_files %}

# A worker: the app's pinned CLI behind its token, under the worker's limits on each call, and
# the container's own, read-only, with nothing to write but its tmpfs, which runs nothing. An init
# reaps what a call leaves, and the worker kills it, and empties /tmp, after each call.
x-files-worker: &files-worker
  restart: unless-stopped
  init: true
  read_only: true
  tmpfs:
    # Each call's directory: the file sent, the one saved, and what the app inflates.
    - /tmp:size=${FILES_WORKER_TMPFS:-1g},mode=1777,noexec,nosuid,nodev
  user: "10002"
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  mem_limit: ${FILES_WORKER_MEMORY:-3g}
  memswap_limit: ${FILES_WORKER_MEMORY:-3g}
  cpus: ${FILES_WORKER_CPUS:-2}
  pids_limit: 128
  healthcheck:
    test:
      - CMD
      - python
      - -c
      - >-
        import os, urllib.request as u;
        u.urlopen(u.Request('http://127.0.0.1:8080/', headers={'Authorization':
        'Bearer ' + os.environ['WORKER_TOKEN']}), timeout=3)
    interval: 5s
    timeout: 5s
    retries: 30
    start_period: 10s

# A relay: socat, passing each connection from the application on to one worker, and nothing else.
# It holds no secret, and runs nothing of the worker's; a worker reaching it reaches only itself.
x-files-relay: &files-relay
  image: alpine/socat:1.8.1.1@sha256:7f9a06753033f2b7de18edc2353f2c15153413d95a039163c6db270fc7a6c3b0
  restart: unless-stopped
  init: true
  read_only: true
  user: "10004"
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  mem_limit: 64m
  memswap_limit: 64m
  pids_limit: 32
{%- if use_portal %}

# An editor: the app's browser build, as released, and lattice's shim. It holds no secret; its
# network, which publishes its port, has a route out, which nothing in it uses.
x-files-editor: &files-editor
  restart: unless-stopped
  init: true
  read_only: true
  user: "10003"
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  mem_limit: 256m
  memswap_limit: 256m
  pids_limit: 64
  environment:
    # The portal's origin, the only one that may frame the editor.
    PORTAL_URL: ${PORTAL_URL:-http://127.0.0.1:${APP_PORT:-{{ app_port }}}}
  networks: [editors]
  healthcheck:
    test:
      - CMD
      - python
      - -c
      - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3)
    interval: 5s
    timeout: 5s
    retries: 30
{%- endif %}
{%- endif %}

services:
  app:
    profiles: [app]
    build: .
    image: {{ project_slug }}:local
    restart: unless-stopped
{%- if use_reflexr %}
    # Docker's default, stated for DRAIN in app.py and STOP_GRACE in automation.py, which must end within it.
    stop_grace_period: 10s
{%- endif %}
    # A later file's value replaces an earlier one's.
    env_file:
      - path: .env
        required: false
      - stackr.env
    # Set here, over .env, which holds this machine's values for `make serve`.
    environment:
      APP_HOST: 0.0.0.0
      APP_PORT: "8000"
{%- if use_portal %}
      PORTAL_UI_DIR: /ui
      # The kit .env names, in the image's copy of brand/ (brand/kit there is /brand/kit here).
      PORTAL_BRAND_DIR: ${PORTAL_BRAND_DIR:+/${PORTAL_BRAND_DIR}}
{%- endif %}
{%- if use_files %}
      # The apps `make up` starts a worker for, from .env or `make up FILES=...`.
      FILES_CRAFTS: ${FILES_CRAFTS:-}
{%- endif %}
{%- if use_diagrams %}
      # Whether `make up` starts the diagrams worker, from .env or `make up DIAGRAMS=on`.
      DIAGRAMS: ${DIAGRAMS:-off}
{%- endif %}
    ports:
      - ${APP_BIND:-127.0.0.1}:${APP_PORT:-{{ app_port }}}:8000
{%- if use_portal and hosting != 'host' %}
      # Mini apps' origin, the same application answering a second port: PORTAL_APPS_URL in .env
      # names it, and must agree with APPS_PORT. Without PORTAL_APPS_URL the port answers as the
      # application does, and runs no app.
      - ${APP_BIND:-127.0.0.1}:${APPS_PORT:-{{ app_port + 1 }}}:8000
{%- endif %}
{%- if use_tracker and tracker == 'plane' %}
    networks:
      stackr:
        # Plane sends webhooks only to a name with a dot in it, which stackr's recipe allows.
        aliases: [app.stackr.internal]
      supabase: {}
{%- if use_files %}
      files: {}
{%- endif %}
{%- elif use_files %}
    networks: [stackr, supabase, files]
{%- else %}
    networks: [stackr, supabase]
{%- endif %}
{%- if use_files %}
    # The relays FILES_CRAFTS starts, each after its worker answers, before the application asks
    # it which app it runs; one that isn't started is passed over.
    depends_on:
{%- for name in crafts %}
      files-{{ name }}:
        condition: service_started
        required: false
{%- endfor %}
{%- if use_diagrams %}
      diagrams:
        condition: service_started
        required: false
{%- endif %}
{%- endif %}
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 30s
{%- if use_files %}
{%- for name, craft in crafts.items() %}

  files-{{ name }}-worker:
    <<: *files-worker
    profiles: [files-{{ name }}]
    build:
      context: .
      target: files-worker
      args:
        CRAFT: {{ name }}
        VERSION: "{{ craft.version }}"
{%- if craft.packages %}
        PACKAGES: >-
{%- for package in craft.packages %}
          {{ package }}
{%- endfor %}
{%- endif %}
{%- if craft.source %}
        SOURCE: {{ craft.source }}
        SOURCE_SHA256: {{ craft.source_sha256 }}
{%- endif %}
{%- if craft.platform %}
      # Its release is built for this platform alone: elsewhere it runs emulated.
      platforms: [{{ craft.platform }}]
    platform: {{ craft.platform }}
{%- endif %}
    image: {{ project_slug }}-files-{{ name }}:local
{%- if craft.memory %}
    # Its CLI needs {{ craft.memory }} GiB of address space, which its limits and its container's
    # memory are raised to, above the call's tmpfs.
    mem_limit: ${{ '{' }}FILES_{{ name | upper }}_MEMORY:-{{ craft.memory + 2 }}g}
    memswap_limit: ${{ '{' }}FILES_{{ name | upper }}_MEMORY:-{{ craft.memory + 2 }}g}
{%- endif %}
    environment:
      WORKER_TOKEN: ${{ '{' }}FILES_{{ name | upper }}_TOKEN:-}
{%- if craft.memory %}
      WORKER_LIMITS: '${{ '{' }}FILES_{{ name | upper }}_LIMITS:-{"memory": {{ craft.memory * 1073741824 }}}}'
{%- else %}
      WORKER_LIMITS: ${FILES_WORKER_LIMITS:-}
{%- endif %}
      # The image the worker runs in, which each file's provenance records: `make up` sets it.
      WORKER_BUILD: ${{ '{' }}FILES_{{ name | upper }}_BUILD:-}
    networks: [files-{{ name }}]

  files-{{ name }}:
    <<: *files-relay
    profiles: [files-{{ name }}]
    command: ["TCP-LISTEN:8080,fork,reuseaddr,max-children=16", "TCP:files-{{ name }}-worker:8080"]
    depends_on:
      files-{{ name }}-worker:
        condition: service_healthy
    networks: [files, files-{{ name }}]
{%- if use_portal and craft.editor %}

  files-{{ name }}-editor:
    <<: *files-editor
    profiles: [files-{{ name }}]
    build:
      context: .
      target: files-editor
      args: {CRAFT: {{ name }}}
    image: {{ project_slug }}-files-{{ name }}-editor:local
    ports:
      - ${APP_BIND:-127.0.0.1}:${{ '{' }}{{ name | upper }}_EDITOR_PORT:-{{ app_port + craft.editor }}}:8000
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if use_diagrams %}

  # The diagrams worker: one warm Chromium, one job at a time, each within its deadline. It runs
  # as a native file's worker does: read-only, with nothing to write but its tmpfs, no
  # capabilities, under its own limits, on its own network with no route out.
  diagrams-worker:
    profiles: [diagrams]
    build:
      context: .
      target: diagrams-worker
    image: {{ project_slug }}-diagrams:local
    restart: unless-stopped
    init: true
    read_only: true
    tmpfs:
      # Chromium's profile and its shared memory, which --disable-dev-shm-usage puts here.
      - /tmp:size=256m,mode=1777,noexec,nosuid,nodev
    user: "10005"
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: ${DIAGRAMS_MEMORY:-1g}
    memswap_limit: ${DIAGRAMS_MEMORY:-1g}
    cpus: ${DIAGRAMS_CPUS:-1}
    pids_limit: 256
    environment:
      WORKER_TOKEN: ${DIAGRAMS_TOKEN:-}
      # The image the worker runs in: `make up` sets it.
      WORKER_BUILD: ${DIAGRAMS_BUILD:-}
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - >-
          fetch('http://127.0.0.1:8080/healthz').then((r) => process.exit(r.ok ? 0 : 1),
          () => process.exit(1))
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 20s
    networks: [diagrams]

  diagrams:
    <<: *files-relay
    profiles: [diagrams]
    command: ["TCP-LISTEN:8080,fork,reuseaddr,max-children=16", "TCP:diagrams-worker:8080"]
    depends_on:
      diagrams-worker:
        condition: service_healthy
    networks: [files, diagrams]
{%- endif %}

networks:
  stackr:
    external: true
  supabase:
    name: supabase_network_stackr-supabase
    external: true
{%- if use_files %}
  # The application's side of the relays: the application and the relays alone.
  files:
    internal: true
  # Each worker's network: the worker and its relay, with no route out of it.
{%- for name in crafts %}
  files-{{ name }}:
    internal: true
    # No address for the host on it, so a worker reaches nothing of the host's either.
    driver_opts:
      com.docker.network.bridge.inhibit_ipv4: "true"
{%- endfor %}
{%- if use_diagrams %}
  # The diagrams worker's network: the worker and its relay, with no route out of it.
  diagrams:
    internal: true
    driver_opts:
      com.docker.network.bridge.inhibit_ipv4: "true"
{%- endif %}
{%- if use_portal %}
  # The editors': a network of their own, which only publishes their ports.
  editors: {}
{%- endif %}
{%- endif %}
