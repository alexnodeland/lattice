  "commands": {
    "portalr.create_tenant": {
      "capability": {
        "description": "Create a tenant, and invite its first owner by email, for operators.",
        "effects": [
          "sends_out"
        ],
        "gate": {
          "action": "grantr:create_tenant",
          "different_approver": false,
          "integration": null
        },
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "owner_email": {
              "description": "Its first owner's email, whom Supabase invites.",
              "maxLength": 254,
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "title": "Owner Email",
              "type": "string"
            },
            "tenant": {
              "description": "The new tenant's id.",
              "title": "Tenant",
              "type": "string"
            }
          },
          "required": [
            "tenant",
            "owner_email"
          ],
          "type": "object"
        },
        "limits": [],
        "name": "portalr.create_tenant",
        "output_schema": null,
        "provider": "command",
        "reversibility": "compensable",
        "risk_class": null,
        "tier": "write",
        "version": "1.0.0"
      },
      "exposure": "tool",
      "resource": null,
      "route": "/portalr/admin/deployment/tenants",
      "surfaces": [
        "acp",
        "mcp",
        "portalr",
        "webmcp"
      ],
      "toolset": "admin"
    },
    "portalr.deployment_links": {
