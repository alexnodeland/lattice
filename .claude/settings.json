{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(moon run:*)",
      "Bash(moon project:*)",
      "Bash(moon projects:*)",
      "Bash(moon query:*)",
      "Bash(moon task:*)",
      "Bash(make check)",
      "Bash(make install)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run deptry:*)",
      "Bash(uv run zensical build:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(uv tree:*)",
      "Bash(bun install)",
      "Bash(bun x --bun --no-install biome:*)",
      "Bash(bun x --bun --no-install tsc:*)",
      "Bash(bun x --bun --no-install vitest:*)",
      "Bash(bun x --bun --no-install knip:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(docker compose ls:*)"
    ],
    "deny": [
      "Edit(**/CHANGELOG.md)",
      "Write(**/CHANGELOG.md)",
      "Read(**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/adr-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
