{
  "uid": "artifactr-agent",
  "title": "artifactr / Agent and LLM",
  "description": "Model usage, cost and latency; run outcomes; tool failures.",
  "tags": [
    "artifactr"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "artifactr dashboards",
      "type": "dashboards",
      "tags": [
        "artifactr"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total, job)",
          "refId": "job"
        },
        "definition": "label_values(artifactr_commands_total, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total{job=~\"$job\"}, artifactr_tenant_id)",
          "refId": "tenant"
        },
        "definition": "label_values(artifactr_commands_total{job=~\"$job\"}, artifactr_tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Models",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tokens by model",
      "description": "Tokens per second, from pydantic-ai's gen_ai.client.token.usage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}} {{gen_ai_token_type}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Cost by model",
      "description": "Estimated spend per second, from pydantic-ai's operation.cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(operation_cost_sum{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Time to first chunk",
      "description": "How long streamed model responses take to start.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_time_to_first_chunk_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{gen_ai_request_model}} p95",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens by tenant",
      "description": "Tokens per second by tenant, from runs' recorded usage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_tenant_id, gen_ai_token_type) (rate(artifactr_tokens_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_tenant_id}} {{gen_ai_token_type}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Runs and tools",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Failed runs by reason",
      "description": "Runs that failed for a typed reason, such as a gateway's guardrail block.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_run_reason) (rate(artifactr_runs_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_run_status=\"failed\", artifactr_run_reason!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_run_reason}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Run segments by status",
      "description": "Run segments that completed, paused, were stopped or failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_run_status) (rate(artifactr_runs_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_run_status}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Turn duration",
      "description": "Exemplars link to the turn's trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(artifactr_turn_duration_seconds_bucket{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "interval": "1m",
          "exemplar": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(artifactr_turn_duration_seconds_bucket{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "interval": "1m",
          "exemplar": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tool failure rate",
      "description": "The share of each tool's calls that ended in an error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (gen_ai_tool_name) (rate(artifactr_tool_calls_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_tool_status=\"error\"}[$__rate_interval]))) / clamp_min(sum by (gen_ai_tool_name) (rate(artifactr_tool_calls_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{gen_ai_tool_name}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tool retries",
      "description": "Calls answered with a retry: a rejection, or the tool's own ModelRetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_tool_name) (rate(artifactr_tool_calls_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_tool_status=\"retry\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      }
    }
  ]
}
