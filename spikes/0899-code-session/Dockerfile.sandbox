# Spike #899, throwaway: the sandbox image (opencode and one ACP agent, git, ripgrep).
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g opencode-ai@1.19.5 @agentclientprotocol/claude-agent-acp@0.99.1
RUN useradd -m agent
USER agent
WORKDIR /home/agent
