def test_main_says_what_the_database_refused(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    async def refused(arguments: object, settings: object) -> str:
        raise DBAPIError("ALTER ROLE app PASSWORD 'secret'", None, ValueError("denied"))

    monkeypatch.setattr(admin, "run", refused)
    monkeypatch.setattr("sys.argv", ["admin", "db-roles"])
