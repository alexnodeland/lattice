# Runs stackr-backup.service nightly; a run missed while the host was off runs at its next start.
[Unit]
Description=Back up stackr's PostgreSQL and ClickHouse to the backups' bucket, nightly

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
