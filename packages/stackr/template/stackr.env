# The stack's addresses on its networks, `stackr` and local Supabase's, for the application
# running on them: in the app profile (compose.yaml), and in the dev container while stackr's
# stack runs (.devcontainer/initialize.sh). They replace the addresses .env has for this machine.

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LITELLM_BASE_URL=http://litellm:4000
LANGFUSE_BASE_URL=http://langfuse-web:3000
# Local Supabase's Auth, unless STACK_AUTH_JWKS_URL names another, such as stackr's GoTrue.
AUTH_JWKS_URL=${STACK_AUTH_JWKS_URL:-http://supabase_kong_stackr-supabase:8000/auth/v1/.well-known/jwks.json}
# Local Supabase's PostgreSQL, unless STACK_DATABASE_URL, which Compose fills in, names another.
DATABASE_URL=${STACK_DATABASE_URL:-postgresql+asyncpg://postgres:postgres@supabase_db_stackr-supabase:5432/postgres}
# The tables' owner, for row-level security, when STACK_DATABASE_ADMIN_URL names one.
DATABASE_ADMIN_URL=${STACK_DATABASE_ADMIN_URL:-}
# The tools portalr's admin reads, on the stack's network (the portal, if the application has one).
# These are set whether or not it does: an application without a portal never reads them.
PORTAL_TEMPO_URL=http://tempo:3200
PORTAL_LOKI_URL=http://loki:3100
PORTAL_PROMETHEUS_URL=http://prom-label-proxy:8080
# Local Supabase's gateway, for invitations, unless STACK_PORTAL_AUTH_URL names another.
PORTAL_AUTH_URL=${STACK_PORTAL_AUTH_URL:-http://supabase_kong_stackr-supabase:8000}
