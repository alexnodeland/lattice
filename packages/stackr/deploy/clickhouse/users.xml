<!-- ClickHouse's users (stackr ADR-0031), in place of the one the image would make. `admin` is the
     operators', from inside the container only: every privilege, and the named collections, such
     as a single host's `backups`. `langfuse` is Langfuse's: every privilege on its own database,
     where it runs its migrations, and reading the system tables, and nothing else. Their passwords come from the environment. -->
<clickhouse>
  <users>
    <default remove="remove"/>
    <admin>
      <password from_env="CLICKHOUSE_ADMIN_PASSWORD"/>
      <networks>
        <ip>127.0.0.1</ip>
        <ip>::1</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>1</access_management>
      <named_collection_control>1</named_collection_control>
      <show_named_collections>1</show_named_collections>
      <show_named_collections_secrets>1</show_named_collections_secrets>
    </admin>
    <langfuse>
      <password from_env="CLICKHOUSE_LANGFUSE_PASSWORD"/>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT ALL ON default.*</query>
        <!-- Its background migrations read the system tables, such as system.parts. -->
        <query>GRANT SELECT ON system.*</query>
      </grants>
    </langfuse>
  </users>
</clickhouse>
