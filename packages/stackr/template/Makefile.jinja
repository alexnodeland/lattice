# {{ project_name }}: everyday commands. `make` lists them.
#
# Everything runs through uv, so the versions used are the ones in uv.lock. The app profile
# needs Docker with Compose v2 and stackr's stack running (`make up` in stackr).

.DEFAULT_GOAL := help
UV ?= uv
COMPOSE ?= docker compose

# Images build and run natively: a DOCKER_DEFAULT_PLATFORM set for other work would build them
# for another architecture, under emulation.
unexport DOCKER_DEFAULT_PLATFORM

# Local commands read .env, when there is one. They take a setting's first line, and Compose its
# last, so a setting set twice differs between them: each is named, to keep one line.
ENV_FILE := $(if $(wildcard .env),--env-file .env)
TWICE := $(shell sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' .env 2>/dev/null | sort | uniq -d)
$(if $(TWICE),$(warning .env sets $(TWICE) more than once: local commands read the first line, the app profile the last))
{%- if use_files %}

# Native files: the crafting apps whose workers run, FILES_CRAFTS in .env, or
# `make up FILES="wordcraft gridcraft"`, which the application is told too. Each is a profile.
comma := ,
space := $() $()
FILES ?= $(subst $(comma),$(space),$(shell sed -n 's/^FILES_CRAFTS=//p' .env 2>/dev/null | tail -n 1))
export FILES_CRAFTS := $(subst $(space),$(comma),$(strip $(FILES)))
PROFILES := --profile app $(foreach craft,$(FILES),--profile files-$(craft))
# Each worker is told the ID of the image it runs in, which each file's provenance records.
WORKER_BUILDS = $(foreach craft,$(FILES),FILES_$(shell echo $(craft) | tr a-z A-Z)_BUILD=$$(docker images --quiet --no-trunc {{ project_slug }}-files-$(craft):local))
{%- if use_diagrams %}
# Diagrams: the diagrams worker runs with DIAGRAMS=on, in .env or `make up DIAGRAMS=on`, which the
# application is told too (stackr ADR-0049).
DIAGRAMS ?= $(or $(shell sed -n 's/^DIAGRAMS=//p' .env 2>/dev/null | tail -n 1),off)
export DIAGRAMS
# On or off, in any case, as the application reads it.
ifeq ($(shell echo '$(DIAGRAMS)' | tr '[:upper:]' '[:lower:]'),on)
PROFILES += --profile diagrams
WORKER_BUILDS += DIAGRAMS_BUILD=$$(docker images --quiet --no-trunc {{ project_slug }}-diagrams:local)
endif
{%- endif %}
{%- else %}
PROFILES := --profile app
{%- endif %}

.PHONY: help install env fmt lint typecheck test check serve {% if evals %}evals evals-langfuse {% endif %}{% if access == 'grantr' %}first-run tenant operator migrate-tenants db-roles access-matrix {% endif %}{% if use_portal %}portal-ui brand tailnet tailnet-off {% endif %}up down logs clean

help: ## List the available commands
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z_-]+:.*## / {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

install: ## Install the dependencies and the git hooks
	@git rev-parse --git-dir >/dev/null 2>&1 || { echo 'make install: the git hooks need a git repository, and there is none here; run `git init` first' >&2; exit 1; }
	$(UV) sync --all-groups
	$(UV) run pre-commit install --hook-type pre-commit --hook-type commit-msg

# Each secret is the machine's own, from openssl: a worker's token, and any `generate:hex` value,
# such as the portal's analytics key; .env is readable by its owner alone.
env: ## Create .env from .env.example, with its secrets generated, if there is none
	@test -f .env && echo ".env exists; compare it with .env.example" || ( \
		command -v openssl >/dev/null || { echo "make env: the secrets need openssl" >&2; exit 1; }; \
		umask 077 && cp .env.example .env.new && \
		for name in $$(sed -n -e 's/^\(FILES_[A-Z]*_TOKEN\)=$$/\1/p' -e 's/^\([A-Z0-9_]*\)=generate:hex$$/\1/p' .env.example); do \
			secret=$$(openssl rand -hex 32) && \
			sed -e "s/^$${name}=$$/$${name}=$$secret/" -e "s/^$${name}=generate:hex$$/$${name}=$$secret/" .env.new > .env.next && \
			mv .env.next .env.new || exit 1; \
		done && mv .env.new .env && echo "created .env")

fmt: ## Format the code and apply safe lint fixes
	$(UV) run ruff format .
	$(UV) run ruff check --fix .

lint: ## Check formatting and lint rules
	$(UV) run ruff format --check .
	$(UV) run ruff check .

typecheck: ## Type-check, strictly
	$(UV) run pyright

test: ## Run the tests with the 100% branch-coverage gate
	$(UV) run pytest --cov --cov-report=term-missing

check: lint typecheck test ## Run everything CI runs

{%- if use_files %}
# On this machine the workers, on their internal network, can't be reached: native files need `make up`.
serve: FILES_CRAFTS =
{%- endif %}
serve: ## Serve the application on this machine, with the settings in .env{% if use_files %}, and native files off{% endif %}
	$(UV) run $(ENV_FILE) {{ project_slug }}
{%- if evals %}

evals: ## Run the starter experiments offline, with a scripted model
	$(UV) run{% if use_relayr %} --group evals{% endif %} python -m evals

evals-langfuse: ## Run them in Langfuse, with the gateway's model, as .env configures them
	$(UV) run{% if use_relayr %} --group evals{% endif %} $(ENV_FILE) python -m evals --langfuse
{%- endif %}

{%- if access == 'grantr' %}

first-run: ## The first person in, with a tenant and a workspace: make first-run EMAIL=alice@example.com
	@if [ -z "$(EMAIL)" ]; then echo "usage: make first-run EMAIL=<email> [TENANT=home] [WORKSPACE=main]"; exit 2; fi
	$(UV) run $(ENV_FILE) {{ project_slug }}-admin first-run $(EMAIL) --tenant $(or $(TENANT),home) --workspace $(or $(WORKSPACE),main)

tenant: ## Create a tenant, with its owner: make tenant NAME=acme OWNER=alice@example.com (or a user id)
	@if [ -z "$(NAME)" ] || [ -z "$(OWNER)" ]; then echo "usage: make tenant NAME=<tenant> OWNER=<email or user id>"; exit 2; fi
	$(UV) run $(ENV_FILE) {{ project_slug }}-admin tenant $(NAME) $(OWNER)

operator: ## Make a user the deployment's first operator: make operator EMAIL=alice@example.com
	@if [ -z "$(EMAIL)" ]; then echo "usage: make operator EMAIL=<email or user id>"; exit 2; fi
	$(UV) run $(ENV_FILE) {{ project_slug }}-admin operator $(EMAIL)

migrate-tenants: ## Move each user's tenant from their token's claim into grantr; it can run again
	$(UV) run $(ENV_FILE) {{ project_slug }}-admin migrate-tenants

db-roles: ## Create the role DATABASE_URL connects as, with DATABASE_ADMIN_URL, before the app first starts; it can run again
	$(UV) run $(ENV_FILE) {{ project_slug }}-admin db-roles

access-matrix: ## Write every role against every action to access.md, to review and commit
	$(UV) run python -m {{ package_name }}.access > access.md
{%- endif %}

{%- if use_portal %}

portal-ui: ## Build portalr's UIs, from the commit uv.lock pins it at, into .portal-ui; then set PORTAL_UI_DIR to it
	scripts/build-portal-ui.sh .portal-ui

BRAND_FROM ?= template
brand: ## Start a brand kit in brand/kit (BRAND_FROM: template, nightshade or calm), or check the one there
	@if [ -f brand/kit/brand.json ]; then \
		$(UV) run portalr brand validate brand/kit; \
	else \
		$(UV) run portalr brand init brand/kit --from $(BRAND_FROM); \
	fi

# The tailnet: `tailscale serve` puts the application on this machine's tailnet name, over HTTPS,
# for your tailnet only; its ports stay on 127.0.0.1. The portal signs in on that origin as on
# this one, with PORTAL_SUPABASE_URL=/ (the default). Mini apps' port, where PORTAL_APPS_URL names
# their origin, and each running editor's are served beside it, each on the same port there, and
# PORTAL_EXTRA_URLS in .env names the tailnet origin, for `make up` to apply (portalr ADR-0084).
TAILNET_PORT ?= 443
TAILNET = UV="$(UV)" scripts/tailnet.sh
dotenv = $(shell sed -n 's/^$(1)=//p' .env 2>/dev/null | tail -n 1)
APP_URL = http://127.0.0.1:$(or $(call dotenv,APP_PORT),{{ app_port }})
{%- if hosting != 'host' %}
TAILNET_BESIDE = $(if $(call dotenv,PORTAL_APPS_URL),$(or $(call dotenv,APPS_PORT),{{ app_port + 1 }}))
{%- if use_files %}
{%- for name, craft in crafts.items() if craft.editor %}
TAILNET_BESIDE += $(if $(filter {{ name }},$(FILES)),$(or $(call dotenv,{{ name | upper }}_EDITOR_PORT),{{ app_port + craft.editor }}))
{%- endfor %}
{%- endif %}
# What the next `make up` would refuse beside the tailnet name: an apps' origin or an editor that
# isn't a port of this machine's loopback, so has no port to be beside it.
TAILNET_REFUSED = $(strip \
	$(if $(filter-out http://127.0.0.1:%,$(call dotenv,PORTAL_APPS_URL)),PORTAL_APPS_URL isn't http://127.0.0.1:<port>) \
	$(if $(call dotenv,FILES_EDITORS),FILES_EDITORS names the editors elsewhere) \
	$(if $(call dotenv,FILES_EDITOR_DOMAIN),FILES_EDITOR_DOMAIN puts the editors at an edge))
{%- else %}
# A single host has one origin for the portal, its edge: no tailnet name beside it.
TAILNET_BESIDE =
TAILNET_REFUSED = this application is on a single host, whose edge is its one origin
{%- endif %}

tailnet: ## Serve the application, its mini apps and editors (FILES, or FILES_CRAFTS in .env) on your tailnet only, over HTTPS (TAILNET_PORT, 443)
	@$(if $(TAILNET_REFUSED),echo "make tailnet: nothing changed: $(TAILNET_REFUSED); see https://lattice.alexnodeland.com/stackr/guides/single-host/#signing-in-to-the-portal" >&2; exit 1,true)
	$(TAILNET) on $(TAILNET_PORT) $(APP_URL) $(strip $(TAILNET_BESIDE))

tailnet-off: ## Stop serving them on your tailnet: with the same TAILNET_PORT and FILES as `make tailnet`
	$(TAILNET) off $(TAILNET_PORT) $(APP_URL) $(strip $(TAILNET_BESIDE))
{%- endif %}

up: ## Build and start the application in the app profile, beside stackr's stack{% if use_files %}, with FILES' workers{% endif %}
{%- if use_files %}
	$(COMPOSE) $(PROFILES) build
	$(WORKER_BUILDS) $(COMPOSE) $(PROFILES) up --detach --wait
{%- else %}
	$(COMPOSE) $(PROFILES) up --detach --build --wait
{%- endif %}

down: ## Stop the application{% if use_files %}, and every worker{% endif %}
	$(COMPOSE) --profile {% if use_files %}'*'{% else %}app{% endif %} down

logs: ## Follow the application's logs
	$(COMPOSE) $(PROFILES) logs --follow --tail=100

clean: ## Remove caches
	rm -rf .pytest_cache .ruff_cache .coverage coverage.xml htmlcov dist
	find . -name __pycache__ -type d -prune -not -path './.venv/*' -exec rm -rf {} +
