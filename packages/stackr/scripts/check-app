#!/usr/bin/env bash
# Generate one application from the template, from lattice's root, and run the checks its own CI
# runs: lint, strict types, and the tests with 100% coverage. It installs the libraries from this
# checkout, so a change to a library is checked with the template's (ADR-0018).
# scripts/check-template checks every variant without installing it; CI's Template job runs this
# once per variant.
#
# Usage: scripts/check-app
#   TEMPLATE_LIBRARIES   artifactr, reflexr or both (default: both)
#   TEMPLATE_EVALS       true or false (default: true)
#   TEMPLATE_ACCESS      grantr or none (default: grantr)
#   TEMPLATE_PYTHON      the application's Python version (default: 3.12)
#   TEMPLATE_BRIDGE      true or false, for both libraries: relayr's bridge (default: true)
#   TEMPLATE_PORTAL      true or false, with grantr: portalr's UIs and router (default: true)
#   TEMPLATE_TRACKER     none, plane or vikunja, with the bridge: relayr's task tracker (default: none)
#   TEMPLATE_UI          true or false, with artifactr: artifactr's forms and dashboards, artifactr.ui (default: true)
#   TEMPLATE_FILES       true or false, with artifactr: native files, each app's worker and editor (default: true)
#   TEMPLATE_DIAGRAMS    true or false, with native files: Excalidraw's diagrams (default: true)
set -euo pipefail
cd "$(dirname "$0")/.."

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
uv run copier copy --quiet --defaults --vcs-ref HEAD \
  --data libraries="${TEMPLATE_LIBRARIES:-both}" \
  --data evals="${TEMPLATE_EVALS:-true}" \
  --data access="${TEMPLATE_ACCESS:-grantr}" \
  --data bridge="${TEMPLATE_BRIDGE:-true}" \
  --data portal="${TEMPLATE_PORTAL:-true}" \
  --data tracker="${TEMPLATE_TRACKER:-none}" \
  --data ui="${TEMPLATE_UI:-true}" \
  --data native_files="${TEMPLATE_FILES:-true}" \
  --data diagrams="${TEMPLATE_DIAGRAMS:-true}" \
  --data python_version="${TEMPLATE_PYTHON:-3.12}" \
  --data libraries_path="$(dirname "$PWD")" \
  ../.. "$scratch/app"
# The application is outside lattice, where a version manager's shim (proto's, in CI) finds no
# .prototools to choose a uv by, so it runs the uv binary that runs here. uv run exports its path.
PATH="$(dirname "$(uv run --no-project printenv UV)"):$PATH"
cd "$scratch/app"
uv sync --all-groups
make check
