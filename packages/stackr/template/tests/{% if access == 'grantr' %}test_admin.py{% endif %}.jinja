class Admin(BaseHTTPRequestHandler):
    """Supabase Auth's ``/admin/users``, two users a page, for the service role's key only; and
    a new account, which it refuses a short password, and fails with nothing to say for
    ``broken@``."""

    users: list[dict[str, Any]] = USERS
    created: ClassVar[list[dict[str, Any]]] = []

    def do_GET(self) -> None:
        url = urlparse(self.path)
        page = int(parse_qs(url.query)["page"][0])
        allowed = self.headers["apikey"] == "service" and url.path == "/auth/v1/admin/users"
        body = json.dumps({"users": self.users[(page - 1) * 2 : page * 2]}).encode()
        self.send_response(200 if allowed else 401)
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        body = json.loads(self.rfile.read(int(self.headers["content-length"])))
        assert self.headers["apikey"] == "service"
        assert self.path == "/auth/v1/admin/users"
        if body["email"].startswith("broken@"):
            self.send_response(500)
            self.end_headers()
            return
        short = len(body["password"]) < 6
        answer = {"msg": "Password should be at least 6 characters."} if short else {"id": "u-new"}
        if not short:
            self.created.append(body)
        self.send_response(422 if short else 200)
        self.end_headers()
        self.wfile.write(json.dumps(answer).encode())

    def log_message(self, format: str, *args: Any) -> None:
        pass


@pytest.fixture
def issuer(monkeypatch: pytest.MonkeyPatch) -> Iterator[str]:
    monkeypatch.setattr(Admin, "created", [])
    server = ThreadingHTTPServer(("127.0.0.1", 0), Admin)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    yield f"http://127.0.0.1:{server.server_address[1]}/auth/v1"
    server.shutdown()
    server.server_close()


