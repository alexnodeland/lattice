"""reflexr's surfaces: REST and the WebSocket at ``/reflexr/v1``, MCP at ``/reflexr/mcp/``.

Producers publish events with a Supabase access token; the tenant and user come from it. The
reactor evaluates the rules and runs their actions while the application is up.
"""

import asyncio
import contextlib
import logging
from collections.abc import AsyncGenerator
from datetime import timedelta
from typing import Any, cast

from fastapi import FastAPI
from mcp.server.mcpserver import Context
from pydantic_ai.capabilities import AbstractCapability
from pydantic_ai.models import Model
from sqlalchemy.ext.asyncio import AsyncEngine
from starlette.requests import HTTPConnection, Request

from reflexr import Actor, ExternalAgentActor, SystemActor, UserActor
from reflexr.core import TenantId
from reflexr.fastapi import Unauthorized, reflexr_router
from reflexr.langfuse import LangfuseScoreConfigs, LangfuseScores, langfuse_run
from reflexr.litellm import LiteLLMGateway
from reflexr.mcp import ReflexrMcp
from reflexr.scores import FeedbackMirror, sync_score_configs
from reflexr.sql import SqlStorage, migrate
from reflexr.workspace import InMemoryStorage, Reaction, Reactor, Workspaces

from {{ package_name }}.auth import RequireToken, TokenVerifier, Unauthenticated
from {{ package_name }}.gateway import Guardrails, TenantKeys, model_settings
from {{ package_name }}.scores import Mirrors, sync_configs
from {{ package_name }}.settings import GatewaySettings
from {{ package_name }}.telemetry import Telemetry
from {{ package_name }}.tickets import (
    EVENTS,
    RULES,
    TriageReview,
    build_triage_agent,
    triage_action,
)

PREFIX = "/reflexr"

log = logging.getLogger(__name__)


class Automation:
    """reflexr in the application: workspaces of events, the rules, the reactor and surfaces.

    Args:
        name: The application's name, as MCP clients and the gateway's tags see it.
        verifier: Verifies access tokens.
        model: The agents' model.
        gateway: The gateway's settings: tenant keys, guardrails, a mocked reply.
        engine: The database; without one, workspaces live in memory.
        telemetry: OpenTelemetry, and Langfuse when it has a client.
        poll_interval: How often the reactor looks for work.
    """

    def __init__(
        self,
        *,
        name: str,
        verifier: TokenVerifier,
        model: Model,
        gateway: GatewaySettings,
        engine: AsyncEngine | None = None,
        telemetry: Telemetry | None = None,
        poll_interval: timedelta = timedelta(seconds=1),
    ) -> None:
        self._verifier = verifier
        self._poll_interval = poll_interval
        self.workspaces = Workspaces(
            SqlStorage(engine) if engine else InMemoryStorage(),
            events=EVENTS,
            rules=RULES,
            tracer_provider=telemetry.tracer_provider if telemetry else None,
            meter_provider=telemetry.meter_provider if telemetry else None,
        )
        capabilities: list[AbstractCapability[Reaction[None]]] = [
            LiteLLMGateway(
                tenant_key=TenantKeys(gateway.tenant_keys),
                guardrails=Guardrails(gateway.guardrails).for_rule,
                tags=[name],
            )
        ]
        if telemetry is not None:
            capabilities.append(telemetry.capability())
        langfuse = telemetry.langfuse if telemetry else None
        self._langfuse = langfuse
        agent = build_triage_agent(
            model, capabilities=capabilities, model_settings=model_settings(gateway)
        )
        self.reactor = Reactor[None](
            self.workspaces,
            actions={"triage": triage_action(agent)},
            run_context=langfuse_run if langfuse else None,
        )
        self.mcp = ReflexrMcp(self.workspaces, resolve=self._resolve_client, name=name)
        self._mirrors: Mirrors | None = None
        if langfuse is not None:
            scores = LangfuseScores(langfuse)

            async def follow(tenant_id: str, workspace_id: str) -> None:
                workspace = await self.workspaces.open(tenant_id, workspace_id, actor=SystemActor())
                await FeedbackMirror(workspace, scores).follow()

            self._mirrors = Mirrors(follow)

    async def migrate(self, engine: AsyncEngine) -> None:
        """Upgrade the database to reflexr's schema."""
        await migrate(engine)

    @contextlib.asynccontextmanager
    async def lifespan(self) -> AsyncGenerator[None]:
        """Run the MCP server and the reactor; with Langfuse, create score configs and mirror."""
        async with self.mcp.lifespan():
            if self._langfuse is not None:
                configs = LangfuseScoreConfigs(self._langfuse)
                await sync_configs(sync_score_configs(configs, [TriageReview]))
            work = asyncio.create_task(self.reactor.serve(poll_interval=self._poll_interval))
            try:
                yield
            finally:
                await _stop(work)
                if self._mirrors is not None:
                    await self._mirrors.aclose()

    def mount(self, app: FastAPI) -> None:
        """Add the REST and WebSocket routes and the MCP server to the application."""
        router = reflexr_router(
            self.workspaces,
            resolve_actor=self._resolve_actor,
            authorize=self._mirrors.authorize if self._mirrors else None,
        )
        app.include_router(router, prefix=f"{PREFIX}/v1")
        mcp = self.mcp.http_app(streamable_http_path="/")
        app.mount(f"{PREFIX}/mcp", RequireToken(mcp, self._verifier))

    async def _resolve_actor(self, connection: HTTPConnection) -> tuple[TenantId, Actor]:
        try:
            principal = await self._verifier.authenticate(connection)
        except Unauthenticated as error:
            raise Unauthorized(str(error)) from error
        return principal.tenant_id, UserActor(id=principal.user_id, name=principal.name)

    async def _resolve_client(self, ctx: Context[Any, Any]) -> tuple[TenantId, ExternalAgentActor]:
        # The server is mounted over HTTP, behind RequireToken: every call has its request.
        principal = await self._verifier.authenticate(cast(Request, ctx.request_context.request))
        return principal.tenant_id, ExternalAgentActor(
            client_id=principal.user_id, name=f"{principal.name} (MCP)"
        )


async def _stop(work: asyncio.Task[Any]) -> None:
    """Stop the reactor; a run it was executing is attempted again when its lease lapses.

    A reactor stopped in the middle of a transaction can fail as it stops, such as with
    SQLite's "database is locked"; that is logged, and the application stops anyway.
    """
    work.cancel()
    try:
        await work
    except asyncio.CancelledError:
        pass
    except Exception as error:
        log.warning("the reactor stopped with an error: %r", error)
