meta {
  name: The workspace's schedules
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/workspaces/{{workspace}}/schedules
  body: none
  auth: none
}

tests {
  test("the heartbeat check's ticks", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map((s) => s.schedule)).to.include("heartbeat-check");
  });
}
