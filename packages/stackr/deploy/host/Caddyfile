# stackr's edge on a single host (RFC-0004): the application at app.<domain>, GoTrue at
# auth.<domain>, each at its own root, and the editors of the native files' apps the application
# runs at <app>.<domain>, the names STACKR_EDITOR_HOSTS lists (ADR-0046). CADDY_TLS is empty for
# certificates from Let's Encrypt, or `tls internal` for Caddy's own CA.
{
	servers {
		# HTTP/1.1 and HTTP/2 only: HTTP/3 would need 443/udp published and let through ufw.
		protocols h1 h2
	}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# GoTrue behind the application's /auth/v1, which GoTrue does not have: the prefix comes off.
(gotrue) {
	uri strip_prefix /auth/v1
	reverse_proxy gotrue:9999
}

app.{$STACKR_DOMAIN} {
	{$CADDY_TLS}
	import headers
	# portalr's UIs sign in with supabase-js, which reaches Supabase Auth at <url>/auth/v1. The
	# portal's URL is this host, so the browser stays on one origin (the CSP's connect-src 'self',
	# and no CORS: GoTrue answers a preflight with no Access-Control headers). Only the three calls
	# its sign-in makes reach GoTrue, by exact method and path: supabase-js's signInWithPassword
	# and a session's refresh are POST /token, getUser is GET /user, signOut is POST /logout.
	# Nothing else under
	# /auth/v1 is GoTrue's to the internet: not the admin API, not signup, invite or recover.
	# Whatever is not one of these is answered 404 here, whatever its spelling.
	@sign_in {
		method POST
		path /auth/v1/token
	}
	@read_user {
		method GET
		path /auth/v1/user
	}
	@sign_out {
		method POST
		path /auth/v1/logout
	}
	handle @sign_in {
		import gotrue
	}
	handle @read_user {
		import gotrue
	}
	handle @sign_out {
		import gotrue
	}
	@gotrue_other path /auth/v1 /auth/v1/*
	handle @gotrue_other {
		respond 404
	}
	# In depth: a path with an admin segment is never the application's (portalr's admin UI, at
	# /portalr/admin/, is). GoTrue's admin API is for the application's commands, on the private
	# network.
	@admin {
		path_regexp (?i)(^|/)admin(/|$)
		not path /portalr/*
	}
	handle @admin {
		respond 404
	}
	handle {
		# The template's app service, in its app profile on the stackr network.
		reverse_proxy app:8000
	}
}

auth.{$STACKR_DOMAIN} {
	{$CADDY_TLS}
	import headers
	# GoTrue's admin API is for the application's admin commands, on the private network.
	handle /admin/* {
		respond 404
	}
	# Caddy replaces X-Forwarded-For from clients with their address, which GoTrue's per-address
	# rate limits read (GOTRUE_RATE_LIMIT_HEADER).
	reverse_proxy gotrue:9999
}

# The editors: each app's browser build, which only the portal at app.<domain> may frame, as the
# editor's own header says. Only the names listed are served, so a certificate is asked for each
# only when its app runs; with none listed, compose.prod.yaml's editors.localhost stands in,
# which Caddy's own CA signs and nothing asks for. An editor is reached by its app's name, its name's first label.
{$STACKR_EDITOR_HOSTS} {
	{$CADDY_TLS}
	import headers
	@editor header_regexp editor Host ^(gridcraft|pdfcraft|cadcraft)\.
	handle @editor {
		reverse_proxy files-{re.editor.1}-editor:8000
	}
	handle {
		respond 404
	}
}
