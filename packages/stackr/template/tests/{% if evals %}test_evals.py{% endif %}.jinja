def test_a_failed_example_is_reported() -> None:
    failed: ExperimentResult[BaseModel] = ExperimentResult(
        name="x",
        run_name="x #1",
        dataset="x",
        dataset_version="0",
        items=(ItemResult("broken", None, errors=("task: RuntimeError: boom",)),),
        url="http://langfuse/runs/1",
    )
    assert summary(failed).splitlines() == [
        "x #1: 1 examples of x",
        "  broken: task: RuntimeError: boom",
        "  http://langfuse/runs/1",
    ]


def test_they_run_in_langfuse_with_the_gateways_model(monkeypatch: pytest.MonkeyPatch) -> None:
    flushed: list[bool] = []

    class Langfuse:
        def flush(self) -> None:
            flushed.append(True)

    trackers: list[Any] = []

    def tracker(client: Any) -> InMemoryExperimentTracker:
        trackers.append(client)
        return InMemoryExperimentTracker()

    monkeypatch.setattr(evals.experiments, "Langfuse", Langfuse)
    monkeypatch.setattr(evals.experiments, "LangfuseExperimentTracker", tracker)
    monkeypatch.setattr(evals.experiments, "gateway_model", lambda settings: scripted())
    assert main(["--langfuse"]) == 0
    assert len(trackers) == 1
    assert flushed == [True]


def test_the_module_runs_as_a_command(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(sys, "argv", ["python -m evals"])
    with pytest.raises(SystemExit) as exited:
        runpy.run_module("evals", run_name="__main__")
    assert exited.value.code == 0
