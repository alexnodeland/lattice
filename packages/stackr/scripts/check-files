#!/usr/bin/env bash
# Check native files' workers and editors as an application from the template runs them (stackr
# ADR-0043): each app's image, built from its pinned release, run by the application's own
# compose.yaml, with nothing else of the application or the stack.
#
# Usage: scripts/check-files [APP...] [diagrams]   (default: every app a worker runs, and diagrams)
#
# For each app, its worker:
# - runs as compose.yaml says, each value as configured: read-only, as user 10002, with no
#   capabilities added and all dropped, no new privileges, not privileged, under an init, with
#   its memory, swap, CPUs and processes limited, no mount but its tmpfs, which runs nothing, no
#   device, no port published, and on its own internal network alone, with its relay
# - reaches nothing outside it: no name resolves, host.docker.internal included; and TCP to a
#   public IPv4 and IPv6 address, UDP to a public resolver and the cloud metadata address each
#   fail; and the network is made with no address for the host on it (inhibit_ipv4). (ICMP
#   can't be tried: the worker has no CAP_NET_RAW.)
# - answers a probe through its relay, from the application's side (scripts/_files_probe.py): its
#   release's licences and notices
#   in its image; the app at its pinned version, behind its own token; a new file made, read and
#   rendered; and hostile files refused within their deadline; and, for an app whose licence asks
#   for it, the offer of its source
# - leaves nothing from one call to the next: a process its user started and a file in /tmp
#   before the probe's calls are gone after them
# Its relay, socat: as configured, read-only, as user 10004, on the worker's network and the
# application's side alone; and the worker's network holds the worker and its relay, nothing else.
# And its editor, for an app whose build hands a file over: as configured, read-only, as user
# 10003, published on 127.0.0.1 alone, serving the build and lattice's shim, which only the
# portal may frame.
#
# And the diagrams worker (stackr ADR-0049), unless only apps are named: as configured,
# read-only, as user 10005, under 1 GiB, on its own internal network with its relay alone; it
# reaches nothing outside it, the application's side of its relay and the application's name
# included; and it answers a probe through its relay, from a native file's worker's image, which
# has artifactr's converter (scripts/_diagrams_probe.py): Mermaid, skeletons, checked SVGs and
# PNGs, a diagram at its 2,000 elements within the deadline, and typed refusals; and it isn't
# killed for its memory meanwhile.
#
# The application is generated at HEAD, whose libraries its image installs from GitHub, so HEAD
# must be pushed and the working tree clean, as `scripts/smoke app` needs. Everything it makes is
# named stackr-files-check, and removed by that name when it ends.

set -euo pipefail
cd "$(dirname "$0")/.."
unset DOCKER_DEFAULT_PLATFORM

readonly name=stackr-files-check
status=0
scratch=$(mktemp -d)
app_dir=$scratch/$name
apps=()
diagrams=0
for named in "$@"; do
  if [[ $named == diagrams ]]; then diagrams=1; else apps+=("$named"); fi
done
kept=()
if (($# == 0)); then
  diagrams=1
  read -ra apps <<<"$(uv run python -c "import yaml; print(*yaml.safe_load(open('copier.yml'))['crafts']['default'])")"
fi
if ((diagrams && ${#apps[@]} == 0)); then
  echo "check-files: the diagrams worker's probe runs in an app's worker's image: name an app too" >&2
  exit 2
fi
# An app's version, or another of its fields, as copier.yml has it.
field_of() {
  uv run python -c "import sys, yaml; print(yaml.safe_load(open('copier.yml'))['crafts']['default'][sys.argv[1]].get(sys.argv[2], ''))" "$1" "$2"
}

log() { printf '%s\n' "$*"; }
check() {
  local what=$1
  shift
  if "$@"; then log "ok: $what"; else log "FAIL: $what"; status=1; fi
}
same() { [[ $1 == "$2" ]] || { log "  is:     $1"; log "  wanted: $2"; return 1; }; }
compose() { docker compose --project-name "$name" --project-directory "$app_dir" "$@"; }
upper() { tr '[:lower:]' '[:upper:]' <<<"$1"; }

cleanup() {
  if [[ -f $app_dir/compose.yaml ]]; then
    compose --profile '*' down --volumes --remove-orphans --timeout 5 >/dev/null 2>&1 || true
    for app in "${apps[@]}"; do
      docker rm -f "$name-probe-$app" >/dev/null 2>&1 || true
      docker image rm "$name-files-$app:local" "$name-files-$app-editor:local" >/dev/null 2>&1 || true
    done
    docker rm -f "$name-probe-diagrams" >/dev/null 2>&1 || true
    docker image rm "$name-diagrams:local" >/dev/null 2>&1 || true
  fi
  rm -rf "$scratch"
}
trap cleanup EXIT

log "files: Docker Engine $(docker version --format '{{.Server.Version}}'), Compose $(docker compose version --short)"
# Unless named, an app whose release is built for another platform than this Docker's is passed
# over: it would run emulated, if at all (Blender's, x86_64 alone, on arm64).
platform="linux/$(docker version --format '{{.Server.Arch}}')"
for app in "${apps[@]}"; do
  built=$(field_of "$app" platform)
  if (($# == 0)) && [[ -n $built && $built != "$platform" ]]; then
    log "files: passed over: $app is built for $built alone, and this Docker is $platform"
  else
    kept+=("$app")
  fi
done
apps=("${kept[@]}")
log "files: generating $name from the template, and building ${apps[*]}"
if ! uv run copier copy --quiet --defaults --vcs-ref HEAD --data project_name="$name" \
  --data libraries=artifactr --data evals=false ../.. "$app_dir" 2>/dev/null ||
  ! uv lock --quiet --directory "$app_dir"; then
  log "FAIL: generating it from the template, with the libraries at HEAD, which must be pushed, with a clean working tree"
  exit 1
fi
(
  umask 077
  cat "$app_dir/.env.example"
  printf 'FILES_CRAFTS=%s\n' "$(IFS=,; printf '%s' "${apps[*]}")"
  for app in "${apps[@]}"; do
    printf 'FILES_%s_TOKEN=%s\n' "$(upper "$app")" "$(openssl rand -hex 32)"
    # Each editor on a port Docker chooses, on this machine's loopback.
    printf '%s_EDITOR_PORT=0\n' "$(upper "$app")"
  done
  printf 'DIAGRAMS_TOKEN=%s\n' "$(openssl rand -hex 32)"
) >"$app_dir/.env"

profiles=()
services=()
for app in "${apps[@]}"; do
  profiles+=(--profile "files-$app")
  services+=("files-$app-worker" "files-$app")
  if compose "${profiles[@]}" config --services | grep -qx "files-$app-editor"; then
    services+=("files-$app-editor")
  fi
done
if ((diagrams)); then
  profiles+=(--profile diagrams)
  services+=(diagrams-worker diagrams)
fi
if ! compose "${profiles[@]}" up --detach --build --wait --wait-timeout 300 "${services[@]}"; then
  log "FAIL: the workers and editors started and answered their health checks"
  compose "${profiles[@]}" logs --no-color --tail=100 || true
  exit 1
fi
log "ok: ${services[*]} started and answered their health checks"

# A container's posture, as Docker runs it.
posture() {
  docker inspect "$1" | jq -r '.[0] | .HostConfig as $h | [
    "read-only=\($h.ReadonlyRootfs)", "user=\(.Config.User)", "privileged=\($h.Privileged)",
    "cap-add=\($h.CapAdd // [] | join(","))", "cap-drop=\($h.CapDrop // [] | join(","))",
    "security=\($h.SecurityOpt // [] | join(","))", "init=\($h.Init)",
    "memory=\($h.Memory)", "swap=\($h.MemorySwap)", "cpus=\($h.NanoCpus)", "pids=\($h.PidsLimit)",
    "pid-mode=\($h.PidMode)", "mounts=\(.Mounts | length)", "devices=\($h.Devices // [] | length)",
    "tmpfs=\($h.Tmpfs // {} | to_entries | map("\(.key):\(.value)") | join(","))",
    "network=\($h.NetworkMode)", "networks=\(.NetworkSettings.Networks | keys | join(","))"
  ] | join(" ")'
}
setting() { docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$1" | sed -n "s/^$2=//p"; }

# Run inside the worker, given where the host's address would be on its network, and the
# worker's own: nothing outside the network answers, nor the host on it.
egress='
import socket, sys
host, own = sys.argv[1], sys.argv[2]
def refused(what, attempt):
    try:
        attempt()
    except OSError as error:
        print(f"  refused: {what}: {error}")
        return True
    print(f"  REACHED: {what}")
    return False
def tcp(family, host, port):
    with socket.socket(family, socket.SOCK_STREAM) as s:
        s.settimeout(5)
        s.connect((host, port))
def udp_dns():
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(5)
        s.sendto(bytes.fromhex("abcd01000001000000000000076578616d706c6503636f6d0000010001"), ("1.1.1.1", 53))
        s.recvfrom(512)
results = [
    refused("resolving github.com", lambda: socket.getaddrinfo("github.com", 443)),
    refused("resolving host.docker.internal", lambda: socket.getaddrinfo("host.docker.internal", 80)),
    refused("TCP to 1.1.1.1:443", lambda: tcp(socket.AF_INET, "1.1.1.1", 443)),
    refused("TCP to [2606:4700:4700::1111]:443", lambda: tcp(socket.AF_INET6, "2606:4700:4700::1111", 443)),
    refused("UDP DNS to 1.1.1.1:53", udp_dns),
    refused("TCP to 169.254.169.254:80", lambda: tcp(socket.AF_INET, "169.254.169.254", 80)),
]
if host == own:
    print(f"  passed over: {host}, where the host would be, is the worker itself")
else:
    try:
        tcp(socket.AF_INET, host, 80)
    except ConnectionRefusedError as answered:
        print(f"  REACHED: {host}, where the host would be, answered: {answered}")
        results.append(False)
    except OSError as error:
        print(f"  refused: TCP to {host}:80, where the host would be: {error}")
sys.exit(0 if all(results) else 1)
'
# Run inside the diagrams worker, in Node, which is all it has, given where the host's address
# would be on its network, and the relay's on the application's side: none of them answers, and
# no name resolves, the application's included.
reach='
const net = require("node:net");
const dgram = require("node:dgram");
const dns = require("node:dns").promises;
const [host, beyond] = process.argv.slice(1);
const tcp = (address, port) => new Promise((done, fail) => {
  const socket = net.connect({ host: address, port, timeout: 5000 });
  socket.on("connect", () => { socket.destroy(); done(); });
  socket.on("timeout", () => { socket.destroy(); fail(new Error("timed out")); });
  socket.on("error", fail);
});
const udp = () => new Promise((done, fail) => {
  const socket = dgram.createSocket("udp4");
  const timer = setTimeout(() => { socket.close(); fail(new Error("timed out")); }, 5000);
  socket.on("message", () => { clearTimeout(timer); socket.close(); done(); });
  socket.on("error", (error) => { clearTimeout(timer); socket.close(); fail(error); });
  socket.send(Buffer.from("abcd01000001000000000000076578616d706c6503636f6d0000010001", "hex"), 53, "1.1.1.1");
});
const attempts = [
  ["resolving github.com", () => dns.lookup("github.com")],
  ["resolving app, the application", () => dns.lookup("app")],
  ["resolving host.docker.internal", () => dns.lookup("host.docker.internal")],
  ["TCP to 1.1.1.1:443", () => tcp("1.1.1.1", 443)],
  ["TCP to [2606:4700:4700::1111]:443", () => tcp("2606:4700:4700::1111", 443)],
  ["UDP DNS to 1.1.1.1:53", udp],
  ["TCP to 169.254.169.254:80", () => tcp("169.254.169.254", 80)],
  // Refused is an answer: something is at the host'"'"'s address, as the worker'"'"'s check has it.
  ["TCP to " + host + ":80, where the host would be", () => tcp(host, 80).catch((error) => {
    if (error.code === "ECONNREFUSED") return;
    throw error;
  })],
  ["TCP to " + beyond + ":8080, the relay on the application side", () => tcp(beyond, 8080)],
];
(async () => {
  let all = true;
  for (const [what, attempt] of attempts) {
    try { await attempt(); console.log("  REACHED: " + what); all = false; }
    catch (error) { console.log("  refused: " + what + ": " + error.message); }
  }
  process.exit(all ? 0 : 1);
})();
'
# Run inside the worker: what was planted is there (`there`), or gone (`gone`).
left='
import os, sys
strays = [p for p in os.listdir("/proc") if p.isdigit() and open(f"/proc/{p}/cmdline", "rb").read().split(b"\0")[0] == b"sleep"]
planted = sorted(os.listdir("/tmp"))
print(f"  processes: {strays}; in /tmp: {planted}")
there = bool(strays) and planted == ["planted", "sealed"]
sys.exit(0 if there == (sys.argv[1] == "there") and (there or not strays and not planted) else 1)
'

for app in "${apps[@]}"; do
  container=$(compose ps --quiet "files-$app-worker")
  relay=$(compose ps --quiet "files-$app")
  network="${name}_files-$app"
  # 3 GiB, or, for an app that names the GiB its CLI needs, that and 2 GiB more.
  gib=$(field_of "$app" memory)
  memory=$((3 << 30))
  if [[ -n $gib ]]; then memory=$(((gib + 2) << 30)); fi
  check "$app's network is internal" \
    same "$(docker network inspect --format '{{.Internal}}' "$network")" true
  check "$app's worker runs as compose.yaml says" same "$(posture "$container")" \
    "read-only=true user=10002 privileged=false cap-add= cap-drop=ALL security=no-new-privileges:true init=true memory=$memory swap=$memory cpus=2000000000 pids=128 pid-mode= mounts=0 devices=0 tmpfs=/tmp:size=1g,mode=1777,noexec,nosuid,nodev network=$network networks=$network"
  check "$app's relay runs as compose.yaml says" same "$(posture "$relay")" \
    "read-only=true user=10004 privileged=false cap-add= cap-drop=ALL security=no-new-privileges:true init=true memory=67108864 swap=67108864 cpus=0 pids=32 pid-mode= mounts=0 devices=0 tmpfs= network=${name}_files networks=${name}_files,$network"
  check "$app's network holds its worker and its relay alone" same \
    "$(docker network inspect --format '{{range .Containers}}{{println .Name}}{{end}}' "$network" | grep -v '^$' | sort | tr '\n' ' ')" \
    "$(docker inspect --format '{{.Name}}' "$container" "$relay" | tr -d / | sort | tr '\n' ' ')"
  check "$app's worker publishes no port" \
    same "$(docker inspect --format '{{len .HostConfig.PortBindings}}' "$container")" 0
  check "$app's network gives the host no address on it" same \
    "$(docker network inspect --format '{{index .Options "com.docker.network.bridge.inhibit_ipv4"}}' "$network")" true
  # Where the host's address would be: Docker's gateway, or else the subnet's first address.
  host=$(docker network inspect --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}' "$network")
  if [[ ! $host =~ ^[0-9.]+$ ]]; then
    subnet=$(docker network inspect --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$network")
    host="${subnet%.*/*}.1"
  fi
  own=$(docker inspect --format "{{(index .NetworkSettings.Networks \"$network\").IPAddress}}" "$container")
  check "$app's worker reaches nothing outside its network, nor the host on it" \
    docker exec "$container" python -I -c "$egress" "$host" "$own"

  # A process its user leaves in a session of its own, a file for the next call, and a
  # directory none may list, before the probe's calls.
  docker exec --detach --user 10002 "$container" setsid sleep 600
  docker exec --user 10002 "$container" sh -c \
    'echo planted >/tmp/planted && mkdir /tmp/sealed && echo filler >/tmp/sealed/f && chmod 000 /tmp/sealed'
  check "$app's worker holds what was planted, before the probe's calls" \
    docker exec "$container" python -I -c "$left" there
  WORKER_TOKEN=$(setting "$container" WORKER_TOKEN)
  export WORKER_TOKEN
  version=$(field_of "$app" version)
  check "$app's worker answers its probe, through its relay" \
    docker run --rm --name "$name-probe-$app" --network "${name}_files" --read-only --tmpfs /tmp \
    --env WORKER_TOKEN --volume "$PWD/scripts/_files_probe.py:/probe.py:ro" --entrypoint python \
    "$name-files-$app:local" -I /probe.py "http://files-$app:8080" "$app" "$version"
  unset WORKER_TOKEN
  source=$(field_of "$app" source)
  if [[ -n $source ]]; then
    check "$app's image offers its source, $source" \
      grep -qF "$source" <<<"$(docker exec "$container" cat /opt/craft/SOURCE-OFFER)"
  fi
  check "$app's worker kept nothing of one call for the next" \
    docker exec "$container" python -I -c "$left" gone

  if [[ " ${services[*]} " == *" files-$app-editor "* ]]; then
    editor=$(compose ps --quiet "files-$app-editor")
    check "$app's editor runs as compose.yaml says" same "$(posture "$editor")" \
      "read-only=true user=10003 privileged=false cap-add= cap-drop=ALL security=no-new-privileges:true init=true memory=268435456 swap=268435456 cpus=0 pids=64 pid-mode= mounts=0 devices=0 tmpfs= network=${name}_editors networks=${name}_editors"
    published=$(compose port "files-$app-editor" 8000)
    check "$app's editor is published on this machine's loopback alone ($published)" \
      same "${published%:*}" 127.0.0.1
    portal=$(setting "$editor" PORTAL_URL)
    shim=$(curl --silent --show-error --fail --dump-header - --output /dev/null \
      "http://$published/.lattice/shim.html") || shim=""
    check "$app's editor serves lattice's shim, which only the portal, $portal, may frame" \
      grep -qiF "frame-ancestors $portal" <<<"$shim"
  fi
done

if ((diagrams)); then
  container=$(compose ps --quiet diagrams-worker)
  relay=$(compose ps --quiet diagrams)
  network="${name}_diagrams"
  check "the diagrams worker's network is internal" \
    same "$(docker network inspect --format '{{.Internal}}' "$network")" true
  check "the diagrams worker runs as compose.yaml says" same "$(posture "$container")" \
    "read-only=true user=10005 privileged=false cap-add= cap-drop=ALL security=no-new-privileges:true init=true memory=1073741824 swap=1073741824 cpus=1000000000 pids=256 pid-mode= mounts=0 devices=0 tmpfs=/tmp:size=256m,mode=1777,noexec,nosuid,nodev network=$network networks=$network"
  check "the diagrams worker's relay runs as compose.yaml says" same "$(posture "$relay")" \
    "read-only=true user=10004 privileged=false cap-add= cap-drop=ALL security=no-new-privileges:true init=true memory=67108864 swap=67108864 cpus=0 pids=32 pid-mode= mounts=0 devices=0 tmpfs= network=${name}_files networks=${name}_diagrams,${name}_files"
  check "the diagrams worker's network holds it and its relay alone" same \
    "$(docker network inspect --format '{{range .Containers}}{{println .Name}}{{end}}' "$network" | grep -v '^$' | sort | tr '\n' ' ')" \
    "$(docker inspect --format '{{.Name}}' "$container" "$relay" | tr -d / | sort | tr '\n' ' ')"
  check "the diagrams worker publishes no port" \
    same "$(docker inspect --format '{{len .HostConfig.PortBindings}}' "$container")" 0
  check "the diagrams worker's network gives the host no address on it" same \
    "$(docker network inspect --format '{{index .Options "com.docker.network.bridge.inhibit_ipv4"}}' "$network")" true
  host=$(docker network inspect --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}' "$network")
  if [[ ! $host =~ ^[0-9.]+$ ]]; then
    subnet=$(docker network inspect --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$network")
    host="${subnet%.*/*}.1"
  fi
  # The relay's address on the application's side, where the application is too.
  beyond=$(docker inspect --format "{{(index .NetworkSettings.Networks \"${name}_files\").IPAddress}}" "$relay")
  check "the diagrams worker reaches nothing outside its network: the internet, the host, the application's side" \
    docker exec "$container" node -e "$reach" "$host" "$beyond"
  WORKER_TOKEN=$(setting "$container" WORKER_TOKEN)
  export WORKER_TOKEN
  check "the diagrams worker answers its probe, through its relay" \
    docker run --rm --name "$name-probe-diagrams" --network "${name}_files" --read-only --tmpfs /tmp \
    --env WORKER_TOKEN --volume "$PWD/scripts/_diagrams_probe.py:/probe.py:ro" --entrypoint python \
    "$name-files-${apps[0]}:local" -I /probe.py "http://diagrams:8080"
  unset WORKER_TOKEN
  check "the diagrams worker wasn't killed for its memory, nor restarted" same \
    "$(docker inspect --format '{{.State.OOMKilled}} {{.RestartCount}}' "$container")" "false 0"
  log "the diagrams worker's page asked for $(compose logs --no-color diagrams-worker | grep -c 'refused a request out' || true) address(es) out of it, each refused"
fi

exit $status
