meta {
  name: Scores, with Langfuse down
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/portalr/v1/scores?start={{start}}&end={{end}}
  body: none
  auth: none
}

headers {
  x-user: alice
  x-tenant: acme
}

tests {
  test("Langfuse isn't in this stack: its read alone is unavailable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("unavailable");
  });
}
