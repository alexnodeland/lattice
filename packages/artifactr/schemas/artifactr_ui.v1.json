            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "StringProperty",
      "type": "object"
    },
    "Submission": {
      "additionalProperties": false,
      "description": "The values a person sent to a form, or to an app, against the version they saw.\n\nIt answers one of the two, ``form_id`` or ``app_id``. A ``many`` form's and an app's carry\nthe ``nonce`` their id is derived from. People never edit one.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "form_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nonce": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonce"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "values"
      ],
      "title": "Submission",
      "type": "object"
    },
    "TablePanel": {
      "additionalProperties": false,
      "description": "A table: its columns, and up to :data:`MAX_TABLE_ROWS` rows keyed by them.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Key"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "maxItems": 500,
          "title": "Rows",
          "type": "array"
        },
        "type": {
          "const": "table",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "columns",
        "rows"
      ],
      "title": "TablePanel",
      "type": "object"
    },
    "TextPanel": {
      "additionalProperties": false,
      "description": "Markdown, which portalr renders without raw HTML.",
