def test_each_running_apps_editor_is_on_this_machine_by_default() -> None:
    crafts = ("wordcraft", "gridcraft", "pdfcraft")
    environ = {"FILES_CRAFTS": ",".join(crafts)}
    environ |= {f"FILES_{craft.upper()}_TOKEN": TOKEN for craft in crafts}
    assert Settings.from_environ(environ).files.editors == {
        "files:gridcraft": "http://127.0.0.1:{{ app_port + crafts.gridcraft.editor }}/",
        "files:pdfcraft": "http://127.0.0.1:{{ app_port + crafts.pdfcraft.editor }}/",
    }
    environ["PDFCRAFT_EDITOR_PORT"] = "9903"
    moved = Settings.from_environ(environ).files.editors
    assert moved["files:pdfcraft"] == "http://127.0.0.1:9903/"
    tailnet = {"files:gridcraft": "https://my-machine.example.ts.net:8802/"}
    environ["FILES_EDITORS"] = '{"files:gridcraft": "https://my-machine.example.ts.net:8802/"}'
    assert Settings.from_environ(environ).files.editors == tailnet


@pytest.mark.parametrize("editors", ["https://my-machine.example.ts.net:8802/", "[]"])
def test_editors_elsewhere_are_a_json_object(editors: str) -> None:
    with pytest.raises(ValueError, match="FILES_EDITORS must be a JSON object"):
        Settings.from_environ({"FILES_EDITORS": editors})


def test_the_portal_tells_the_app_where_each_editor_is(script: Script) -> None:
    editors = {"files:gridcraft": "http://127.0.0.1:{{ app_port + crafts.gridcraft.editor }}/"}
    portal = PortalSettings(supabase_url="http://127.0.0.1:54321", supabase_key="sb_publishable_x")
    config = replace(settings(), files=replace(WORDCRAFT, editors=editors), portal=portal)
    with TestClient(app(script, config, workers=workers())) as client:
        assert client.get("/portalr/config.json").json()["editors"] == editors


def build(tmp_path: Path) -> Path:
    """A browser build's directory, as small as one can be."""
    (tmp_path / "index.html").write_text("<!doctype html><title>GridCraft</title>")
    return tmp_path


def test_an_editor_serves_the_build_and_lattices_shim(tmp_path: Path) -> None:
    from {{ package_name }}.editor import editor_from_environment

    environ = {
        "EDITOR_APP": "gridcraft",
        "EDITOR_BUILD": str(build(tmp_path)),
        "PORTAL_URL": "http://127.0.0.1:{{ app_port }}",
    }
    with TestClient(editor_from_environment(environ)) as client:
        page = client.get("/")
        shim = client.get("/.lattice/shim.html")
    assert page.status_code == shim.status_code == 200
    assert "frame-ancestors" in page.headers["content-security-policy"]


def test_the_editors_module_serves_it(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    served: list[tuple[str, int]] = []

    def run(_app: Any, *, host: str, port: int) -> None:
        served.append((host, port))

    monkeypatch.setattr(uvicorn, "run", run)
    monkeypatch.setenv("EDITOR_APP", "gridcraft")
    monkeypatch.setenv("EDITOR_BUILD", str(build(tmp_path)))
    monkeypatch.setenv("PORTAL_URL", "http://127.0.0.1:{{ app_port }}")
    monkeypatch.delitem(sys.modules, "{{ package_name }}.editor", raising=False)
    runpy.run_module("{{ package_name }}.editor", run_name="__main__")
    assert served == [("0.0.0.0", 8000)]
