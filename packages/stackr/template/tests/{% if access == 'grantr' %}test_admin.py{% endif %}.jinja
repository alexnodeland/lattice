async def test_a_user_is_found_by_their_email_or_named_by_their_id(issuer: str) -> None:
    users = Users(issuer, "service")
    assert await users.find("ALICE@example.com") == "u-alice"
    assert await users.find("u-someone") == "u-someone"
    with pytest.raises(LookupError, match="no user has the email"):
        await users.find("erin@example.com")
    with pytest.raises(LookupError, match="AUTH_SERVICE_ROLE_KEY"):
        await Users(issuer, None).find("alice@example.com")


async def test_the_first_operator_and_a_tenant(config: Settings) -> None:
    assert await run(["operator", "alice@example.com"], config) == (
        "alice@example.com is the deployment's operator"
    )
    assert await run(["tenant", "acme", "u-bob"], config) == "created acme, owned by u-bob"
    assert await run(["tenant", "acme", "u-carol"], config) == "acme exists, and is unchanged"


def never() -> str:
    raise AssertionError("no password is asked for an account that exists")


async def test_the_first_person_in_has_an_account_a_tenant_and_a_workspace(
    config: Settings,
) -> None:
    done = await run(["first-run", "erin@example.com"], config, password=lambda: "a-password")
    assert done == (
        "made an account for erin@example.com\n"
        "erin@example.com is the deployment's operator\n"
        "created home, owned by erin@example.com, with the workspace main"
    )
    assert Admin.created == [
        {"email": "erin@example.com", "password": "a-password", "email_confirm": True}
    ]
    engine = create_async_engine(str(config.database_url))
    try:
        grants = build_grants(SqlStorage(engine), name=config.service_name)
        assert await grants.workspaces("home", User(id="u-new")) == ["main"], "the app lists it"
    finally:
        await engine.dispose()


