"""Native files: files in an app's own format, kept as artifacts (lattice RFC-0003).

Each app ``FILES_CRAFTS`` names runs in a worker of its own, ``files-<app>-worker``: its pinned
CLI, under the worker's limits, in a read-only container on a network of its own, which has no
route out (stackr ADR-0043). This application calls it through its relay, ``files-<app>``, on the
``files`` network, with the worker's own token, ``FILES_<APP>_TOKEN``; the worker never reaches
this application (stackr ADR-0046). With no app named,
native files are off: no route is mounted, and the agent has no tools for them.

- ``/artifactr/v1/workspaces/{w}/files/...``: a file's head, check-out and check-in, and each
  version's bytes, words and pages, beside artifactr's routes
- the agent's tools: ``read_native``, ``read_review``, ``find_commands`` and ``edit_native``

Each app is an integration of its own, ``files:<app>``, switched per workspace like any other.
{%- if use_diagrams %}

Diagrams, Excalidraw's, are kept beside them: their images in the same store. With
``DIAGRAMS=on``, the agent draws and renders them through the diagrams worker, ``diagrams``, on
the ``files`` network as a native file's worker is (stackr ADR-0049): ``read_diagram``,
``draw_mermaid``, ``draw`` and ``edit_elements``. Diagrams are the integration ``excalidraw``,
off in every workspace until switched on.
{%- endif %}
"""

import contextlib
from collections.abc import AsyncGenerator, Mapping
from typing import Any, Final

import httpx
from fastapi import FastAPI
from pydantic import JsonValue, ValidationError
from pydantic_ai.toolsets import AbstractToolset

from artifactr import {% if use_diagrams %}Artifact, {% endif %}Session, Workspaces
{%- if use_diagrams %}
from artifactr.excalidraw import (
    Diagram,
    WorkerConverter,
    diagram_tools,
    excalidraw_checks,
    excalidraw_key_of,
)
{%- endif %}
{%- if use_diagrams %}
from artifactr.excalidraw.fastapi import diagrams_router
{%- endif %}
from artifactr.fastapi import ResolveActor
from artifactr.files import (
{%- for name in ((crafts.values() | map(attribute='type') | list) + ['App', 'Blobs', 'Checkouts', 'InMemoryBlobs', 'InMemoryCheckouts', 'NativeFile', 'NativeFiles']) | sort %}
    {{ name }},
{%- endfor %}
)
from artifactr.files.blobs import Quota
from artifactr.files.fastapi import files_router
from artifactr.files.sql import SqlBlobs, SqlCheckouts, migrate
from artifactr.files.tools import native_file_tools
from artifactr.files.worker import Worker
{%- if use_diagrams %}
from artifactr.workspace import Check
{%- endif %}
from lattice_core.integrations import Integrations

from {{ package_name }}.database import Database
from {{ package_name }}.settings import CRAFTS, FilesSettings, Held

TYPES: Final[Mapping[str, type[NativeFile]]] = {
{%- for name, craft in crafts.items() %}
    "{{ name }}": {{ craft.type }},
{%- endfor %}
}
"""The native type each app keeps."""


def worker_url(craft: str) -> str:
    """Where an app's worker answers: its relay, on the ``files`` network."""
    return f"http://files-{craft}:8080"
{%- if use_diagrams %}


DIAGRAMS_URL: Final = "http://diagrams:8080"
"""Where the diagrams worker answers: its relay, on the ``files`` network."""
{%- endif %}


class Files:
    """Native files in the application: each app's worker, the files' stores, routes and tools.

    Args:
        settings: Which apps run, and the token their workers let in.
        integrations: Whether each app is on in a workspace.
        database: The database; without one, the files' bytes and check-outs live in memory.
        transport: How requests reach the workers; HTTP by default. Tests pass the workers
            themselves.
    """

    def __init__(
        self,
        settings: FilesSettings,
        *,
        integrations: Integrations,
        database: Database | None = None,
        transport: httpx.AsyncBaseTransport | None = None,
    ) -> None:
        self._workers = {
            craft: Worker.at(worker_url(craft), token=settings.tokens[craft], transport=transport)
            for craft in settings.crafts
        }
        self._uploads = settings.uploads
        self._integrations = integrations
        blobs, checkouts = _stores(database, settings)
        self._blobs = blobs
        self.native: NativeFiles | None = None
        if self._workers:
            apps: dict[type[NativeFile], App] = {
                TYPES[craft]: worker for craft, worker in self._workers.items()
            }
            self.native = NativeFiles(
                blobs,
                checkouts,
                apps,
                integrations=integrations,
                readings=settings.uploads.readings,
{%- if use_diagrams %}
                # Diagrams name images in the same store, which its collection keeps.
                naming=(Diagram,),
{%- endif %}
            )
{%- if use_diagrams %}
        self.diagrams = (
            WorkerConverter.at(DIAGRAMS_URL, token=settings.diagrams_token, transport=transport)
            if settings.diagrams
            else None
        )
{%- endif %}

    @property
    def types(self) -> list[type[{% if use_diagrams %}Artifact{% else %}NativeFile{% endif %}]]:
        """The native types of the apps that run{% if use_diagrams %}, and diagrams{% endif %}."""
        return [{% if use_diagrams %}Diagram, {% endif %}*(TYPES[craft] for craft in self._workers)]

    def key_of(self, kind: str, data: Mapping[str, JsonValue]) -> str | None:
        """The integration that governs an artifact: its app's, for a native file."""
{%- if use_diagrams %}
        if diagram := excalidraw_key_of(kind, data):
            return diagram
{%- endif %}
        return self.native.key_of(kind, data) if self.native else None
{%- if use_diagrams %}

    def checks(self) -> Mapping[str, Check]:
        """The diagrams' checks, by command type, for ``Workspaces(checks=...)``."""
        return excalidraw_checks()
{%- endif %}

    def toolsets(self) -> list[AbstractToolset[Session[Any]]]:
        """The agent's tools for native files, while any app runs{% if use_diagrams %}; diagrams', with DIAGRAMS=on{% endif %}."""
        found: list[AbstractToolset[Session[Any]]] = []
        if self.native:
            found.append(native_file_tools(self.native))
{%- if use_diagrams %}
        if self.diagrams:
            found.append(
                diagram_tools(self.diagrams, blobs=self._blobs, integrations=self._integrations)
            )
{%- endif %}
        return found

    async def migrate(self, database: Database) -> None:
        """Upgrade the database to native files' tables, as its owner, even with no app running.

        Starting a worker later then needs no migration.
        """
        await migrate(database.owner, application_role=database.role)

    @contextlib.asynccontextmanager
    async def lifespan(self) -> AsyncGenerator[None]:
        """Ask each worker which app it runs, as the application starts; close them as it stops.

        Raises:
            RuntimeError: If a worker can't be reached, refuses the token, or runs another app, or
                another version, than its pin names.
        """
        async with contextlib.AsyncExitStack() as stack:
{%- if use_diagrams %}
            if self.diagrams:
                stack.push_async_callback(self.diagrams.aclose)
{%- endif %}
            for craft, worker in self._workers.items():
                stack.push_async_callback(worker.aclose)
                try:
                    await worker.open()
                except (httpx.HTTPError, ValidationError) as error:
                    raise RuntimeError(
                        f"files-{craft}, the worker FILES_CRAFTS names, didn't answer: start it "
                        f"with the application, `make up`, or leave {craft} out ({error!r})"
                    ) from error
                if (worker.name, worker.version) != (craft, CRAFTS[craft]):
                    raise RuntimeError(
                        f"files-{craft} runs {worker.name} {worker.version}, not {craft} "
                        f"{CRAFTS[craft]}, as scripts/crafts pins it: rebuild it, `make up`"
                    )
            yield

    def mount(
        self, app: FastAPI, workspaces: Workspaces, *, resolve_actor: ResolveActor, prefix: str
    ) -> None:
{%- if use_diagrams %}
        """Add native files' routes beside artifactr's, while any app runs.

        And the routes of a diagram's images, which a person puts on its canvas, app or none.
        """
{%- else %}
        """Add native files' routes beside artifactr's, while any app runs."""
{%- endif %}
        if self.native is not None:
            uploads = self._uploads
            router = files_router(
                workspaces,
                self.native,
                resolve_actor=resolve_actor,
                uploads_per_minute=uploads.per_minute,
                uploads_at_once=uploads.at_once,
                uploads_per_tenant=uploads.per_tenant,
                uploads_each=uploads.each,
            )
            app.include_router(router, prefix=prefix)
{%- if use_diagrams %}
        app.include_router(
            diagrams_router(
                workspaces,
                self._blobs,
                resolve_actor=resolve_actor,
                integrations=self._integrations,
            ),
            prefix=prefix,
        )
{%- endif %}


def _stores(database: Database | None, settings: FilesSettings) -> tuple[Blobs, Checkouts]:
    """The files' bytes, held to the quotas, and check-outs: in the database, or in memory.

    In the database, they are kept apart by tenant as artifactr's tables are.
    """
    workspace, tenant = _quota(settings.workspace_quota), _quota(settings.tenant_quota)
    if database is None:
        blobs = InMemoryBlobs(workspace_quota=workspace, tenant_quota=tenant)
        return blobs, InMemoryCheckouts()
    rls = database.row_level_security
    return (
        SqlBlobs(
            database.engine,
            row_level_security=rls,
            workspace_quota=workspace,
            tenant_quota=tenant,
        ),
        SqlCheckouts(database.engine, row_level_security=rls),
    )


def _quota(held: Held | None) -> Quota | None:
    return None if held is None else Quota(bytes=held.bytes, files=held.files)
