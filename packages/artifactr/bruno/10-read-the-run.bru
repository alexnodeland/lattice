meta {
  name: Read the run
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/workspaces/{{workspace}}/runs/{{run}}
  body: none
  auth: none
}

tests {
  test("it is the thread's run", function () {
    expect(res.status).to.equal(200);
    expect(res.body.thread_id).to.equal(bru.getEnvVar("thread"));
  });
}
