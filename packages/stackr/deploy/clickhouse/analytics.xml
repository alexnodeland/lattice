<!-- The server's settings for portalr's analytics (stackr ADR-0044): the custom setting a read
     names its tenant with, which the row policy in analytics-users.xml reads; and, in any
     statement that is logged, the masking of the tenant setting's value and of the ids compared
     with tenant_id or distinct_id, one or an IN list. Other literals aren't masked. -->
<clickhouse>
  <custom_settings_prefixes>SQL_</custom_settings_prefixes>
  <query_masking_rules>
    <rule>
      <name>analytics tenant setting</name>
      <regexp>SQL_portalr_tenant\s*=\s*'[^']*'</regexp>
      <replace>SQL_portalr_tenant = '***'</replace>
    </rule>
    <rule>
      <name>analytics ids compared</name>
      <regexp>(tenant_id|distinct_id)\s*=\s*'[^']*'</regexp>
      <replace>\1 = '***'</replace>
    </rule>
    <rule>
      <name>analytics ids listed</name>
      <regexp>(tenant_id|distinct_id)\s+(?i:IN)\s*\([^)]*\)</regexp>
      <replace>\1 IN ('***')</replace>
    </rule>
  </query_masking_rules>
</clickhouse>
