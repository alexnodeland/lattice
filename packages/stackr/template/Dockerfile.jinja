# {{ project_name }}'s image, as the app profile runs it: `make up` builds it.
#
# lattice's libraries come from GitHub at the revisions uv.lock pins, so the build needs git
# and the network. The runtime image holds only the virtual environment{% if use_portal %} and portalr's UIs{% endif %}.
{%- if use_files %}
#
# Native files add two targets, built for one crafting app each (CRAFT, and the VERSION its pin
# names), which compose.yaml's files-<app> services build: `files-worker`, the app's CLI behind
# the worker, and `files-editor`, its browser build on an origin of its own.
{%- endif %}

{% if use_portal -%}
# portalr's UIs, which its wheel carries and a git install of it does not: built from the lattice
# commit uv.lock pins portalr at (scripts/build-portal-ui.sh reads it from there). Bun is lattice's
# own (its .prototools); to bump it, change the tag and the digest together
# (`docker buildx imagetools inspect oven/bun:<tag>`), or run `copier update`. Replace this stage
# with portalr's wheel once it is on PyPI.
FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598 AS portal-ui
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY uv.lock ./
COPY scripts/build-portal-ui.sh scripts/
RUN --mount=type=cache,target=/root/.bun/install/cache scripts/build-portal-ui.sh /ui

{% endif -%}
FROM ghcr.io/astral-sh/uv:0.12-python{{ python_version }}-trixie-slim AS build

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0

# The dependencies first, so they stay cached until uv.lock changes.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project

COPY README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

{%- if use_files %}


# A crafting app's release, fetched as scripts/crafts pins it and checked against its SHA-256
# before anything of it is unpacked (scripts/craft).
FROM python:{{ python_version }}-slim-trixie AS craft
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
ARG CRAFT
ENV CRAFT=${CRAFT} CRAFT_CACHE=/cache
COPY scripts/craft scripts/
COPY scripts/crafts/${CRAFT}.sha256 scripts/crafts/

# Its CLI, for this build's Linux, x86_64 or aarch64, with all its release unpacked beside it:
# its libraries, and its licences and notices, which travel with it. /opt/craft/cli is the CLI.
# Everyone may read it, and run what its release made runnable; no one but root may change it.
FROM craft AS craft-cli
RUN cli=$(scripts/craft "${CRAFT}" cli) \
    && cp -R "${cli%/bin/*}" /opt/craft \
    && ln -s "bin/${cli##*/}" /opt/craft/cli \
    && chmod -R a+rX,go-w /opt/craft
{%- if use_portal %}

# Its browser build, unmodified, as its brand's licence asks.
FROM craft AS craft-web
RUN web=$(scripts/craft "${CRAFT}" web) && cp -R "${web}" /opt/web && chmod -R a+rX,go-w /opt/web
{%- endif %}


# The worker: the app's four calls over HTTP, one at a time, its CLI under the worker's limits.
# compose.yaml runs it read-only, on a network with no route out.
FROM python:{{ python_version }}-slim-trixie AS files-worker
ARG CRAFT
ARG VERSION
RUN useradd --no-create-home --uid 10002 worker
COPY --from=build /app/.venv /app/.venv
COPY --from=craft-cli /opt/craft /opt/craft
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WORKER_APP=${CRAFT} \
    WORKER_CLI=/opt/craft/cli \
    WORKER_VERSION=${VERSION} \
    WORKER_HOST=0.0.0.0 \
    WORKER_PORT=8080 \
    WORKER_SWEEP=1
USER worker
EXPOSE 8080
CMD ["python", "-m", "artifactr.files.worker"]
{%- if use_portal %}


# The editor: the app's browser build, as released, with lattice's shim, which the portal frames.
FROM python:{{ python_version }}-slim-trixie AS files-editor
ARG CRAFT
RUN useradd --no-create-home --uid 10003 editor
COPY --from=build /app/.venv /app/.venv
COPY --from=craft-web /opt/web /opt/web
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    EDITOR_APP=${CRAFT} \
    EDITOR_BUILD=/opt/web
USER editor
EXPOSE 8000
CMD ["python", "-m", "{{ package_name }}.editor"]
{%- endif %}
{%- endif %}


FROM python:{{ python_version }}-slim-trixie

RUN useradd --create-home --uid 10001 app
COPY --from=build --chown=app:app /app/.venv /app/.venv
{%- if use_portal %}
COPY --from=portal-ui --chown=app:app /ui /ui
{%- endif %}

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000 \
    OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=healthz{% if use_portal %} \
    PORTAL_UI_DIR=/ui{% endif %}

USER app
EXPOSE 8000
CMD ["{{ project_slug }}"]
