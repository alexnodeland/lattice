#!/usr/bin/env python3
"""Wire an application from the template to the running stack: its `.env`, from stackr's.

Usage: scripts/wire-app APP_DIR [--analytics] [--umami] < extra settings

The application's `.env` (which `make env` there makes first) is given what it reads from the
stack, as the app profile reaches it:

- Langfuse's keys, stackr's own project's, and that project's id for the portal's scores.
- The database, by the adapter: local Supabase's PostgreSQL, or plain PostgreSQL's on the
  postgres adapter (STACKR_DB_HOST and STACKR_DB_ADMIN_PASSWORD name another, as `make` does).
  STACK_DATABASE_URL is the role the application works as, which owns nothing, with a password
  of its own, kept from an earlier run; STACK_DATABASE_ADMIN_URL is the tables' owner.
- On the postgres adapter, GoTrue (the auth profile): its issuer, its keys and its admin API, the
  service role's key, and a placeholder publishable key, since GoTrue asks for none. Invitations
  need Supabase's gateway, which GoTrue alone hasn't, so PORTAL_AUTH_URL is left as it is.
- With --analytics, the analytics profile's two ClickHouse passwords, and ClickHouse on the
  loopback for `make serve` (the app profile reaches it by name: stackr.env).
- With --umami, portalr's website and its user's password in Umami (ADR-0050).

Lines `KEY=VALUE` on stdin are set last, over these: a key the gateway printed once, or a
setting of the caller's own. Secrets are read from files and stdin, never from arguments, and
nothing is printed but the names of what was set.

Each setting is one line: one already there is replaced where it is, and a new one is appended,
so `make` (a setting's first line) and Compose (its last) read the same. The file is written
mode 0600, and running this again with the same input leaves it as it was.
"""

from __future__ import annotations

import argparse
import os
import re
import secrets
import sys
import tomllib
from pathlib import Path

from _env import LINE, ROOT, read_env, settings

# Local Supabase's PostgreSQL, as the stack's services reach it, and its fixed admin password.
SUPABASE_DB = ("supabase_db_stackr-supabase", "postgres")
GOTRUE = "http://gotrue:9999"
# Any name does: GoTrue alone asks for no publishable key, and the browser is given it.
PUBLISHABLE = "sb_publishable_local"
PASSWORD = re.compile(r"^postgresql\+asyncpg://[^:]+:(?P<password>[^@]+)@")


def database(stack: dict[str, str], role: str, current: str | None) -> dict[str, str]:
    """The database's two URLs, as the app profile reaches them, by the stack's adapter."""
    if stack.get("STACKR_DATABASE") == "postgres":
        host, admin = "postgres", stack["POSTGRES_ADMIN_PASSWORD"]
    else:
        host, admin = SUPABASE_DB
    host = os.environ.get("STACKR_DB_HOST") or host
    admin = os.environ.get("STACKR_DB_ADMIN_PASSWORD") or admin
    kept = PASSWORD.match(current or "")
    password = kept["password"] if kept else secrets.token_hex(16)
    return {
        "STACK_DATABASE_URL": f"postgresql+asyncpg://{role}:{password}@{host}:5432/postgres",
        "STACK_DATABASE_ADMIN_URL": f"postgresql+asyncpg://postgres:{admin}@{host}:5432/postgres",
    }


def wired(app: Path, stack: dict[str, str], *, analytics: bool, umami: bool) -> dict[str, str]:
    """What the application reads from the stack, by its adapter and the profiles asked for."""
    current = read_env(app / ".env")
    name = tomllib.loads((app / "pyproject.toml").read_text())["project"]["name"]
    values = {
        "LANGFUSE_PUBLIC_KEY": stack["LANGFUSE_PUBLIC_KEY"],
        "LANGFUSE_SECRET_KEY": stack["LANGFUSE_SECRET_KEY"],
        "PORTAL_LANGFUSE_PROJECT": stack["LANGFUSE_INIT_PROJECT_ID"],
        **database(stack, f"{name.replace('-', '_')}_app", current.get("STACK_DATABASE_URL")),
    }
    if stack.get("STACKR_DATABASE") == "postgres":
        values |= {
            "AUTH_ISSUER": stack["AUTH_PUBLIC_URL"],
            "AUTH_SERVICE_ROLE_KEY": stack["AUTH_SERVICE_ROLE_KEY"],
            "STACK_AUTH_JWKS_URL": f"{GOTRUE}/.well-known/jwks.json",
            "STACK_AUTH_ADMIN_URL": GOTRUE,
            "PORTAL_SUPABASE_KEY": current.get("PORTAL_SUPABASE_KEY") or PUBLISHABLE,
        }
    if analytics:
        values |= {
            "PORTAL_ANALYTICS_URL": f"http://127.0.0.1:{stack['CLICKHOUSE_HTTP_PORT']}",
            "PORTAL_ANALYTICS_WRITER_PASSWORD": stack["CLICKHOUSE_ANALYTICS_WRITER_PASSWORD"],
            "PORTAL_ANALYTICS_PASSWORD": stack["CLICKHOUSE_ANALYTICS_PASSWORD"],
        }
    if umami:
        values |= {
            "PORTAL_UMAMI_WEBSITE_ID": stack["UMAMI_WEBSITE_ID"],
            "PORTAL_UMAMI_PASSWORD": stack["UMAMI_PORTALR_PASSWORD"],
        }
    return values


def write(path: Path, values: dict[str, str]) -> None:
    """Set each value on its key's one line, where it is, or on a new line at the end; mode 0600.

    A key that was set twice keeps its first line, the one `make` reads, and loses the others.
    """
    lines, seen = [], set()
    for line in path.read_text().splitlines():
        match = LINE.match(line.strip())
        key = match["key"] if match else None
        if key in values:
            if key in seen:
                continue
            seen.add(key)
            line = f"{key}={values[key]}"
        lines.append(line)
    lines += [f"{key}={value}" for key, value in values.items() if key not in seen]
    staged = path.with_name(f"{path.name}.wiring")
    fd = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write("\n".join(lines).rstrip() + "\n")
    staged.replace(path)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("app", type=Path, help="the application's directory")
    parser.add_argument("--analytics", action="store_true", help="with the analytics profile")
    parser.add_argument("--umami", action="store_true", help="with the umami profile")
    parser.add_argument("--stack", type=Path, default=ROOT, help=argparse.SUPPRESS)
    args = parser.parse_args()
    env = args.app / ".env"
    if not env.exists():
        raise SystemExit(f"wire-app: {env} isn't there: run `make env` in {args.app} first")
    given = [] if sys.stdin.isatty() else sys.stdin.read().splitlines()
    extra = {m["key"]: m["value"] for m in map(LINE.match, given) if m}
    # The adapter `make` chose, as it runs this, over the stack's .env.
    stack = settings(args.stack) | {
        key: os.environ[key] for key in ("STACKR_DATABASE",) if os.environ.get(key)
    }
    values = wired(args.app, stack, analytics=args.analytics, umami=args.umami) | extra
    write(env, values)
    print(f"wire-app: set {', '.join(values)} in {env}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
