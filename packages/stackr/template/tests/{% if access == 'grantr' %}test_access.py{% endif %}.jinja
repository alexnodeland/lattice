def access(grants: Grants) -> Access:
    verifier = TokenVerifier(audience="authenticated", secret=SECRET)
    return Access(name=APPLICATION.id, verifier=verifier, grants=grants)


def request(**headers: str) -> HTTPConnection:
    raw = [(k.lower().encode(), v.encode()) for k, v in headers.items()]
    return HTTPConnection({"type": "http", "headers": raw, "query_string": b""})


def signed(user: str = "alice", **headers: str) -> dict[str, str]:
    return {"Authorization": f"Bearer {token(user)}", **headers}


async def with_key(grants: Grants) -> str:
    """A key for ``ci``, a service principal of acme, which may view its workspaces."""
    ci = ServicePrincipal(id="ci")
    await grants.add_member(TENANT, ci, by=User(id="alice"))
    workspace = Resource(kind="workspace", workspace="main")
    await grants.grant(TENANT, "viewer", on=workspace, to=ci, by=User(id="alice"))
    key, _ = await grants.issue_key(TENANT, ci, by=User(id="alice"))
    return key


async def test_a_users_only_tenant_needs_no_naming() -> None:
    principal = await access(seeded()).authenticate(request(Authorization=f"Bearer {token()}"))
    assert principal == Principal(tenant_id=TENANT, user_id="alice", name="alice@example.com")


async def test_a_blank_tenant_is_no_tenant() -> None:
    blank = request(Authorization=f"Bearer {token()}", **{"X-Tenant": ""})
    assert (await access(seeded()).authenticate(blank)).tenant_id == TENANT


async def test_a_user_in_several_tenants_names_one() -> None:
    with pytest.raises(Refused, match="X-Tenant") as refused:
        await access(seeded()).authenticate(request(Authorization=f"Bearer {token('carol')}"))
    assert refused.value.status == 400
    named = request(Authorization=f"Bearer {token('carol')}", **{"X-Tenant": "globex"})
    assert (await access(seeded()).authenticate(named)).tenant_id == "globex"


async def test_a_user_in_no_tenant_is_refused() -> None:
    with pytest.raises(Refused, match="isn't a member of any tenant") as refused:
        await access(seeded()).authenticate(request(Authorization=f"Bearer {token('dave')}"))
    assert refused.value.status == 403


async def test_a_tenant_its_user_isnt_in_is_refused() -> None:
    elsewhere = request(Authorization=f"Bearer {token()}", **{"X-Tenant": OTHER})
    with pytest.raises(Refused, match="isn't a member of initech") as refused:
        await access(seeded()).authenticate(elsewhere)
    assert refused.value.status == 403


async def test_a_websocket_names_its_tenant_in_the_query() -> None:
    connection = HTTPConnection(
        {
            "type": "websocket",
            "headers": [],
            "query_string": f"access_token={token('carol')}&tenant={OTHER}".encode(),
        }
    )
    assert (await access(seeded()).authenticate(connection)).tenant_id == OTHER


async def test_a_key_is_its_tenants_and_no_others() -> None:
    grants = seeded()
    key = await with_key(grants)
    principal = await access(grants).authenticate(request(Authorization=f"Bearer {key}"))
    assert principal == Principal(tenant_id=TENANT, user_id="ci", name="ci", service=True)
    elsewhere = request(Authorization=f"Bearer {key}", **{"X-Tenant": OTHER})
    with pytest.raises(Refused, match="another tenant"):
        await access(grants).authenticate(elsewhere)
    forged = key[:-1] + ("1" if key.endswith("0") else "0")
    with pytest.raises(Unauthenticated, match="key is not valid"):
        await access(grants).identify(request(Authorization=f"Bearer {forged}"))
    in_the_url = HTTPConnection(
        {"type": "websocket", "headers": [], "query_string": f"access_token={key}".encode()}
    )
    with pytest.raises(Unauthenticated, match="Authorization header"):
        await access(grants).identify(in_the_url)
