  "openapi": "3.1.0",
  "paths": {
    "/relayr/v1/trackers/{tenant}/{tracker}": {
      "post": {
        "description": "Verify a tracker's webhook, and make the followers of the project it names poll now.",
        "operationId": "nudge_relayr_v1_trackers__tenant___tracker__post",
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Tenant",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tracker",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Tracker",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "Refused"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "Refused"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Nudge a tracker project's follower",
        "tags": [
          "relayr"
        ]
      }
    },
