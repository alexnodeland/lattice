            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "message"
        ],
        "title": "RejectionDetail",
        "type": "object"
      },
      "RunId": {
        "type": "string"
      },
      "SystemActor": {
        "description": "The application itself, for automated changes.",
        "properties": {
          "kind": {
            "const": "system",
            "default": "system",
            "title": "Kind",
            "type": "string"
