#!/usr/bin/env python3
"""Check the application template without installing what it generates. Run by scripts/validate.

Usage: scripts/check-template [--keep DIR]

Renders every variant of the template (artifactr, reflexr or both, with and without evals, with
grantr or no access control, with portalr, which grantr needs, or without it, both without
relayr's bridge, both without artifactr's forms, both without native files, both without
diagrams, both hosted on a single host, and both filing in Plane or Vikunja) from this checkout,
working tree included, under the name in NAME, and checks each one:

- every Jinja expression was rendered: nothing is left of `{{ ... }}` or `{% ... %}`, apart
  from GitHub Actions' own `${{ ... }}`
- the libraries' sources are exactly the ones the variant needs, each from its own directory of
  lattice's packages/, at the commit the variant was rendered from (ADR-0018)
- the Python is formatted and passes lint, with the generated project's own ruff settings
- the YAML passes yamllint, and the shell scripts shellcheck
- the Compose file is valid for the app profile, with the single host's overlay when it has one,
  and with every profile, native files' workers and editors among them

It checks the diagrams worker's pins once, too: one Excalidraw, versions.env's, in the worker
and in portalr's UIs once they show diagrams; Mermaid's converter, the one Excalidraw depends on;
and the Playwright image whose Chromium the worker drives, at its playwright-core's version.

And the release pins: the template's crafting apps are lattice's own, each pinned
by the same file as scripts/crafts, fetched by the same scripts/craft, at the version its pin
names (lattice RFC-0003's release-pin check), so a worker's CLI and its editor's build are one
release, the one lattice's tests ran; and each app has an editor, or says why it has none.

The generated applications' types and tests need their dependencies installed: CI's template
job runs `make check` in each variant for that.
"""

from __future__ import annotations

import argparse
import itertools
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
import warnings
from pathlib import Path
from typing import NamedTuple

import yaml
from copier import run_copy

ROOT = Path(__file__).resolve().parent.parent
LATTICE = ROOT.parent.parent
"""lattice's root, whose copier.yml points Copier at the template."""


class Variant(NamedTuple):
    """One way to render the template."""

    libraries: str
    evals: bool
    access: str
    bridge: bool  # whether relayr bridges both libraries
    hosting: str
    portal: bool  # portalr, which only grantr's access can have
    ui: bool  # artifactr's forms, artifactr.ui, which only artifactr can have
    tracker: str = "none"  # the task tracker relayr files in, which only the bridge can have
    native_files: bool = True  # native files' workers and editors, which only artifactr can have
    diagrams: bool = True  # diagrams and their worker, which only native files can have

    @property
    def name(self) -> str:
        """The directory it is rendered into."""
        return (
            f"{self.libraries}{'-evals' if self.evals else ''}"
            f"{'' if self.access == 'grantr' else '-open'}"
            f"{'-unbridged' if self.libraries == 'both' and not self.bridge else ''}"
            f"{'' if self.hosting == 'none' else f'-{self.hosting}'}"
            f"{'-noportal' if self.access == 'grantr' and not self.portal else ''}"
            f"{'-noui' if self.libraries != 'reflexr' and not self.ui else ''}"
            f"{'' if self.tracker == 'none' else f'-{self.tracker}'}"
            f"{'-nofiles' if self.libraries != 'reflexr' and not self.native_files else ''}"
            f"{'-nodiagrams' if self.native_files and not self.diagrams else ''}"
        )


VARIANTS = [
    Variant(
        libraries,
        evals,
        access,
        libraries == "both",
        "none",
        access == "grantr",
        libraries != "reflexr",
    )
    for libraries, evals, access in itertools.product(
        ["artifactr", "reflexr", "both"], [True, False], ["grantr", "none"]
    )
] + [
    Variant("both", True, "grantr", False, "none", True, True),
    Variant("both", True, "grantr", True, "host", True, True),
    Variant("both", True, "grantr", True, "none", False, True),
    Variant("both", True, "grantr", True, "none", True, False),
    Variant("both", True, "grantr", True, "none", True, True, native_files=False),
    Variant("both", True, "grantr", True, "none", True, True, diagrams=False),
    Variant("both", True, "grantr", True, "none", True, True, "plane"),
    Variant("both", True, "none", True, "none", False, True, "vikunja"),
]
"""Every variant of the template."""
RELEASE = re.compile(r"[-_](\d+\.\d+\.\d+)-")
"""A release's version, in the name of one of its assets."""
LEFTOVER = re.compile(r"(?<!\$)\{\{|\{%|%\}")
TEXT = {".py", ".toml", ".yaml", ".yml", ".md", ".json", ".sh", ".example", ""}
ANSWERS = ".copier-answers.yml"
REPOSITORY = "https://github.com/alexnodeland/lattice"
DIRECTORIES = {
    "artifactr-ai": "artifactr",
    "reflexr": "reflexr",
    "evalr": "evalr",
    "grantr": "grantr",
    "relayr-ai": "relayr",
    "portalr": "portalr",
    "lattice-core-ai": "lattice-core",
}
"""Each library's distribution, and its directory in lattice's packages/."""
NAME = "Acme Template Check At Max Len"
"""The name every variant is rendered with: its slug is 30 characters, the longest Copier
accepts, and its package sorts before `conftest`, so line lengths and import order are
checked at their limits."""


def render(variant: Variant, destination: Path) -> str:
    """Render one variant, as `copier copy --defaults --vcs-ref HEAD` does; return its commit."""
    with warnings.catch_warnings():
        # A checkout with uncommitted changes renders them, from a commit Copier makes, with a
        # warning.
        warnings.simplefilter("ignore")
        worker = run_copy(
            str(LATTICE),
            destination,
            data={"project_name": NAME, **variant._asdict()},
            defaults=True,
            vcs_ref="HEAD",
            quiet=True,
        )
    return str(worker.template.commit_hash)


def expected_sources(variant: Variant, commit: str) -> dict[str, dict[str, str]]:
    """The `[tool.uv.sources]` a variant needs: each library it uses, from its directory of
    lattice's packages/, at the commit it was rendered from."""
    used = {
        "artifactr-ai": variant.libraries in {"artifactr", "both"},
        "reflexr": variant.libraries in {"reflexr", "both"},
        "evalr": variant.evals,
        "grantr": variant.access == "grantr",
        "relayr-ai": variant.bridge,
        "portalr": variant.access == "grantr" and variant.portal,
        "lattice-core-ai": (variant.libraries != "reflexr" and (variant.ui or variant.native_files))
        or (variant.bridge and variant.tracker != "none")
        # The portal reads its other origins with lattice_core.origins (portalr ADR-0084).
        or (variant.access == "grantr" and variant.portal),
    }
    return {
        name: {"git": REPOSITORY, "subdirectory": f"packages/{DIRECTORIES[name]}", "rev": commit}
        for name, uses in used.items()
        if uses
    }


def check_sources(app: Path, expected: dict[str, dict[str, str]]) -> list[str]:
    """Check that the libraries' sources are exactly the ones the variant needs."""
    sources = tomllib.loads((app / "pyproject.toml").read_text())["tool"]["uv"]["sources"]
    if sources == expected:
        return []
    return [f"pyproject.toml: [tool.uv.sources] is {sources}, not {expected}"]


SINGLE_HOST = {"APP_IMAGE": "app:checked", "STACKR_DOMAIN": "example.com"}
"""What the single host's overlay asks for: the image to run, and the domain the edge serves."""


def run(label: str, command: list[str], cwd: Path, env: dict[str, str] | None = None) -> list[str]:
    """Run a check, with these variables added to the environment; return its output as a problem
    if it fails."""
    environment = {**os.environ, **(env or {})}
    done = subprocess.run(
        command, cwd=cwd, capture_output=True, text=True, check=False, env=environment
    )
    if done.returncode == 0:
        return []
    return [f"{label}:\n{done.stdout}{done.stderr}".rstrip()]


def check_brand_dir(app: Path, compose: list[str]) -> list[str]:
    """Check Compose gives the application the kit .env names, in the image, and none without."""
    problems: list[str] = []
    wanted = {"brand/acme": "PORTAL_BRAND_DIR: /brand/acme", "": 'PORTAL_BRAND_DIR: ""'}
    for named, said in wanted.items():
        done = subprocess.run(
            compose,
            cwd=app,
            capture_output=True,
            text=True,
            check=False,
            env={**os.environ, "PORTAL_BRAND_DIR": named, **SINGLE_HOST},
        )
        if said not in done.stdout:
            problems.append(f"compose: PORTAL_BRAND_DIR={named!r} doesn't give {said}")
    return problems


def check_bun(app: Path) -> list[str]:
    """Check that the image builds portalr's UIs with the Bun that lattice itself uses."""
    dockerfile = (app / "Dockerfile").read_text()
    found = re.search(
        r"^FROM oven/bun:([0-9.]+)@sha256:[0-9a-f]{64} AS portal-ui$", dockerfile, re.M
    )
    if found is None:
        return ["Dockerfile: the portal-ui stage isn't FROM oven/bun:<version>@sha256:<digest>"]
    wanted = re.search(r'^bun = "([0-9.]+)"$', (LATTICE / ".prototools").read_text(), re.M)
    if wanted is None or wanted[1] != found[1]:
        return [
            f"Dockerfile: Bun is {found[1]}, and lattice's .prototools says {wanted and wanted[1]}"
        ]
    return []


def check_crafts() -> list[str]:
    """Check that the template's crafting apps are pinned and fetched as lattice's own are."""
    ours = ROOT / "template" / "{% if use_files %}scripts{% endif %}"
    theirs = LATTICE / "scripts"
    crafts = yaml.safe_load((ROOT / "copier.yml").read_text())["crafts"]["default"]
    problems = []
    if (ours / "craft").read_bytes() != (theirs / "craft").read_bytes():
        problems.append("the template's scripts/craft isn't lattice's")
    pinned = sorted(path.stem for path in (ours / "crafts").glob("*.sha256"))
    if pinned != sorted(crafts):
        problems.append(f"the template pins {pinned}, and copier.yml's crafts are {sorted(crafts)}")
    # The single host's edge serves the editors of exactly the apps that have one.
    caddyfile = (ROOT / "deploy" / "host" / "Caddyfile").read_text()
    served = re.search(r"\^\(([a-z|]+)\)\\\.", caddyfile)
    editors = sorted(name for name, craft in crafts.items() if craft.get("editor"))
    if served is None or sorted(served[1].split("|")) != editors:
        problems.append(f"deploy/host/Caddyfile's editors aren't copier.yml's: {editors}")
    # Each app has an editor or says why it has none: a release with no browser build has none,
    # and one with a build has none only for want of a bridge (artifactr's tests hold copier.yml's
    # editors to its registry's bridges, and those to the pinned builds).
    for name, craft in crafts.items():
        assets = (theirs / "crafts" / f"{name}.sha256").read_text().split()[1::2]
        built = any(asset.startswith(f"{name}-web-") for asset in assets)
        if craft.get("editor"):
            if not built or "no_editor" in craft:
                problems.append(f"copier.yml's {name} has an editor, so a build and no no_editor")
        elif craft.get("no_editor") != ("no host bridge" if built else "no browser build"):
            problems.append(f"copier.yml's {name} needs an editor, or no_editor saying why not")
    for name, craft in crafts.items():
        pin = Path("crafts", f"{name}.sha256")
        if (ours / pin).read_bytes() != (theirs / pin).read_bytes():
            problems.append(f"the template's scripts/{pin} isn't lattice's")
        versions = set(RELEASE.findall((theirs / pin).read_text()))
        if versions != {craft["version"]}:
            problems.append(f"copier.yml's {name} is {craft['version']}; its pin is {versions}")
    return problems


WORKER = ROOT / "workers" / "diagrams"
"""The diagrams worker, which the template's image builds from lattice's own commit."""
PLAYWRIGHT_IMAGE = re.compile(
    r"^FROM mcr\.microsoft\.com/playwright:v([0-9.]+)-noble@sha256:[0-9a-f]{64} "
    r"AS diagrams-worker$",
    re.M,
)


def check_diagrams() -> list[str]:
    """Check the diagrams worker's pins: one Excalidraw, and one Playwright with its Chromium.

    Excalidraw is versions.env's EXCALIDRAW_VERSION in the worker, and in portalr's UIs once they
    show diagrams; Mermaid's converter is the one that Excalidraw depends on; and the image's
    Playwright, whose Chromium the worker drives, is the version of the playwright-core it pins.
    """
    problems = []
    pinned = re.search(r"^EXCALIDRAW_VERSION=(\S+)$", (ROOT / "versions.env").read_text(), re.M)
    wanted = pinned[1] if pinned else None
    worker = json.loads((WORKER / "package.json").read_text())["dependencies"]
    manifests = [WORKER / "package.json", *LATTICE.glob("packages/portalr/web/*/package.json")]
    for manifest in manifests:
        found = json.loads(manifest.read_text())
        version = {**found.get("dependencies", {}), **found.get("devDependencies", {})}.get(
            "@excalidraw/excalidraw"
        )
        if (version is not None or manifest.parent == WORKER) and version != wanted:
            where = manifest.relative_to(LATTICE)
            problems.append(f"{where}'s Excalidraw is {version}; versions.env's is {wanted}")
    lock = (LATTICE / "bun.lock").read_text()
    depends = re.search(
        r'"@excalidraw/excalidraw": \["@excalidraw/excalidraw@[^"]+", "", \{[^\n]*?'
        r'"@excalidraw/mermaid-to-excalidraw": "([^"]+)"',
        lock,
    )
    mermaid = worker.get("@excalidraw/mermaid-to-excalidraw")
    if depends is None:
        problems.append(
            "bun.lock has no entry for @excalidraw/excalidraw that names its "
            "mermaid-to-excalidraw: has the lock's format changed?"
        )
    elif mermaid != depends[1]:
        problems.append(
            f"the worker's mermaid-to-excalidraw is {mermaid}; Excalidraw's is {depends[1]}"
        )
    dockerfile = (ROOT / "template" / "Dockerfile.jinja").read_text()
    image = PLAYWRIGHT_IMAGE.search(dockerfile)
    driver = worker.get("playwright-core")
    if image is None or image[1] != driver:
        problems.append(
            f"Dockerfile's Playwright image is {image and image[1]}; the worker's "
            f"playwright-core is {driver}"
        )
    argument = re.search(r"^ARG PLAYWRIGHT=(\S+)$", dockerfile, re.M)
    if argument is None or argument[1] != driver:
        problems.append(
            f"Dockerfile's ARG PLAYWRIGHT is {argument and argument[1]}, which the build checks "
            f"the worker's playwright-core against; it is {driver}"
        )
    return problems


def stage(dockerfile: str, name: str) -> str:
    """A Dockerfile's stage, from its FROM ... AS name to the next FROM."""
    found = re.search(rf"^FROM [^\n]* AS {name}\n(.*?)(?=^FROM |\Z)", dockerfile, re.M | re.S)
    return found[1] if found else ""


def check_fetches() -> list[str]:
    """The build-time fetches that are tried again keep their pins (stackr ADR-0051).

    The files worker's resolve is tried again, and still under uv.lock's versions; the Grafana
    image's ClickHouse plugin is fetched with bounded tries and checked against a sha256 for each
    architecture it is built for, and for no other.
    """
    problems = []
    worker = stage((ROOT / "template" / "Dockerfile.jinja").read_text(), "worker-venv")
    for needed in ("uv export --locked", "--constraint /tmp/locked.txt", "for attempt in 1 2 3"):
        if needed not in worker:
            problems.append(f"Dockerfile's worker-venv stage has no `{needed}`")
    plugin = stage((ROOT / "deploy" / "grafana" / "Dockerfile").read_text(), "clickhouse-plugin")
    arms = dict(re.findall(r"^\s*(amd64|arm64)\) sha256=([0-9a-f]{64}) ;;", plugin, re.M))
    if sorted(arms) != ["amd64", "arm64"]:
        problems.append(
            f"Grafana's plugin stage pins a sha256 for {sorted(arms)}, not amd64 and arm64"
        )
    if not re.search(r"^\s*\*\) echo .* exit 1 ;;", plugin, re.M):
        problems.append("Grafana's plugin stage has no `*)` arm refusing another architecture")
    for needed in ("sha256sum -c -", "--max-time", "--retry"):
        if needed not in plugin:
            problems.append(f"Grafana's plugin stage has no `{needed}`")
    return problems


FEEDBACK_SENT = re.compile(r"""feedback_type:\s*["']([\w-]+)["']""")


def check_feedback(app: Path) -> list[str]:
    """Check that the feedback types portalr's UIs send are defined by the rendered application.

    A type the application doesn't define is refused by the server, and the person is told only
    that a thumb wasn't given; so every `feedback_type: "..."` the UIs send is looked for among
    the names the example modules register.
    """
    if not (list(app.glob("src/*/portal.py"))):
        return []
    sent: set[str] = set()
    for folder in ("app", "client"):
        for path in (LATTICE / "packages" / "portalr" / "web" / folder / "src").rglob("*.ts*"):
            if ".test." not in path.name and "test" not in path.parts:
                sent |= set(FEEDBACK_SENT.findall(path.read_text()))
    defined = set()
    for module in ("notes.py", "tickets.py"):
        for path in app.glob(f"src/*/{module}"):
            defined |= set(re.findall(r'name="([\w-]+)", targets', path.read_text()))
    return [
        f"portalr's UIs send {name!r} feedback, which the application doesn't define"
        for name in sorted(sent - defined)
    ]


def check(app: Path, sources: dict[str, dict[str, str]]) -> list[str]:
    """Check one rendered application, which needs these sources; return the problems found."""
    problems = check_sources(app, sources) + check_feedback(app)
    if (app / "scripts" / "build-portal-ui.sh").exists():
        problems += check_bun(app)
    files = [p for p in app.rglob("*") if p.is_file() and ".git" not in p.parts]
    for path in files:
        if path.suffix in TEXT or path.name.startswith("."):
            text = path.read_text()
            for number, line in enumerate(text.splitlines(), 1):
                if LEFTOVER.search(line):
                    problems.append(f"{path.relative_to(app)}:{number}: unrendered: {line.strip()}")
    problems += run("ruff format", ["ruff", "format", "--check", "--quiet", "."], app)
    problems += run("ruff check", ["ruff", "check", "--quiet", "."], app)
    # The answers file is Copier's to write, with the template's path in it.
    yaml = [str(p) for p in files if p.suffix in {".yaml", ".yml"} and p.name != ANSWERS]
    config = str(ROOT / ".yamllint.yaml")
    problems += run("yamllint", ["yamllint", "--strict", "-c", config, *yaml], app)
    scripts = [str(p) for p in files if p.suffix == ".sh"]
    problems += run("shellcheck", ["shellcheck", *scripts], app)
    compose = ["docker", "compose", "--profile", "app", "config", "--quiet"]
    problems += run("compose", compose, app)
    every = ["docker", "compose", "--profile", "*", "config", "--quiet"]
    problems += run("compose, with every profile", every, app)
    if (app / "brand").is_dir():
        problems += check_brand_dir(app, compose[:-1])
    host = app / "deploy" / "host" / "compose.prod.yaml"
    if host.exists():
        overlay = ["docker", "compose", "-f", "compose.yaml", "-f", str(host), *compose[2:]]
        problems += run("compose, on a single host", overlay, app, SINGLE_HOST)
        if (app / "brand").is_dir():
            problems += check_brand_dir(app, overlay[:-1])
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--keep", type=Path, help="render into this directory, and keep it")
    args = parser.parse_args()
    failures = 0
    for problem in check_crafts():
        print(f"FAIL: release pins: {problem}", file=sys.stderr)
        failures += 1
    for problem in check_diagrams():
        print(f"FAIL: diagrams' pins: {problem}", file=sys.stderr)
        failures += 1
    for problem in check_fetches():
        print(f"FAIL: fetches' pins: {problem}", file=sys.stderr)
        failures += 1
    with tempfile.TemporaryDirectory() as scratch:
        base = args.keep or Path(scratch)
        for variant in VARIANTS:
            name = variant.name
            app = base / name
            commit = render(variant, app)
            problems = check(app, expected_sources(variant, commit))
            for problem in problems:
                print(f"FAIL: {name}: {problem}", file=sys.stderr)
            if problems:
                failures += 1
            else:
                print(f"ok: {name}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
