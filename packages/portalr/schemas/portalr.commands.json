    "portalr.list_traces": {
      "capability": {
        "description": "List the tenant's traces in a window, newest first, optionally of one kind of span.",
        "effects": [
          "reads_private"
        ],
        "gate": {
          "action": "portalr:read_telemetry",
          "different_approver": false,
          "integration": null
        },
        "input_schema": {
          "$defs": {
            "Id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "type": "string"
            }
          },
          "description": "Which of a tenant's traces to find: a thread's, a run's, an analytics session's, or any.\n\nA search by analytics session reads at most ``MOST_DAYS``: a session lasts hours.",
          "properties": {
            "analytics_session": {
              "anyOf": [
                {
                  "pattern": "^\\d{1,12}-[0-9a-f]{16}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Analytics Session"
            },
            "end": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            },
            "limit": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "run": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "session": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "limits": [],
        "name": "portalr.list_traces",
        "output_schema": null,
        "provider": "command",
        "reversibility": "none",
        "risk_class": null,
        "tier": "read",
        "version": "1.0.0"
      },
      "exposure": "tool",
      "resource": null,
      "route": "/portalr/admin/t/{tenant}/traces",
      "surfaces": [
        "acp",
        "mcp",
        "portalr",
        "webmcp"
      ],
      "toolset": "admin"
    },
