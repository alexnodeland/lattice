    "portalr.read_usage": {
      "capability": {
        "description": "Read the tenant's use of models over a span of time, by model, person or workspace.",
        "effects": [
          "reads_private"
        ],
        "gate": {
          "action": "portalr:read_spend",
          "different_approver": false,
          "integration": null
        },
        "input_schema": {
          "$defs": {
            "WorkspaceName": {
              "pattern": "^[^\\x00]{1,256}$",
              "type": "string"
            }
          },
          "description": "Which usage to read: a window of at most ``MOST_DAYS``, and the workspaces to split it by.\n\nLiteLLM sums by whole UTC day, so the window is read as the days it touches: its first and\nlast days are whole days, whatever time of day it starts or ends. Today, the last day of a\nwindow that ends now, is a part of a day, set beside a whole day's share of the budget.\n``workspaces`` are asked after once each, in the order given.",
          "properties": {
            "end": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            },
            "workspaces": {
              "items": {
                "$ref": "#/$defs/WorkspaceName"
              },
              "maxItems": 50,
              "title": "Workspaces",
              "type": "array"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "limits": [],
        "name": "portalr.read_usage",
        "output_schema": null,
        "provider": "command",
        "reversibility": "none",
        "risk_class": null,
        "tier": "read",
        "version": "1.0.0"
      },
      "exposure": "tool",
      "resource": null,
      "route": "/portalr/admin/t/{tenant}/usage",
      "surfaces": [
        "acp",
        "mcp",
        "portalr",
        "webmcp"
      ],
      "toolset": "admin"
    }
