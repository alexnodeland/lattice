#!/usr/bin/env python3
"""Wire an application from the template to the running stack: its `.env`, from stackr's.

Usage: scripts/wire-app APP_DIR [--analytics] [--umami] [--langfuse-project] [--stdin]

The application's `.env` (which `make env` there makes first) is given what it reads from the
stack, as the app profile reaches it:

- Langfuse's keys, stackr's own project's; with --langfuse-project, that project's id too, which
  turns on the portal's reads of its scores.
- The database, by the adapter: local Supabase's PostgreSQL, or plain PostgreSQL's on the
  postgres adapter, unless STACKR_DB_HOST and STACKR_DB_ADMIN_PASSWORD name another, as `make`
  does. STACK_DATABASE_URL is the role the application works as, which owns nothing, with a
  password of its own, kept from an earlier run; STACK_DATABASE_ADMIN_URL is the tables' owner.
- On the postgres adapter, GoTrue (the auth profile): its issuer, its keys and its admin API, the
  service role's key, and a placeholder publishable key, since GoTrue asks for none. On local
  Supabase, GoTrue's addresses are emptied, so a file wired for the other adapter doesn't keep
  them. Invitations need Supabase's gateway, which GoTrue alone hasn't, so PORTAL_AUTH_URL is
  left as it is.
- With --analytics, the analytics profile's two ClickHouse passwords, and ClickHouse on the
  loopback for `make serve` (the app profile reaches it by name: stackr.env).
- With --umami, portalr's website and its user's password in Umami (ADR-0050).

With --stdin, lines `KEY=VALUE` read from stdin are set last, over these: a key the gateway
printed once, or a setting of the caller's own. Secrets are read from files and stdin, never
from arguments, and nothing is printed but the names of what was set. A value with `$` or a
line break in it is refused, since Compose would read `$` as the start of a variable; any other
is written as it is given. A stack whose `.env` still has a `generate:` placeholder is refused:
`make env` in stackr makes its secrets first.

Each setting is one line: one already there is replaced where it is, and a new one is appended,
so `make` (a setting's first line) and Compose (its last) read the same; what was there is read
as Compose reads it, its last line, which the first position then holds alone. The file is
written mode 0600, through a file of its own made beside it, and running this again with the
same input leaves it as it was. --stack names another stack's directory, for scripts/check-make.
"""

from __future__ import annotations

import argparse
import contextlib
import os
import secrets
import sys
import tempfile
import tomllib
from pathlib import Path
from urllib.parse import quote, urlsplit

from _env import LINE, ROOT, read_env, settings

# Local Supabase's PostgreSQL, as the stack's services reach it, and its fixed admin password.
SUPABASE_DB = ("supabase_db_stackr-supabase", "postgres")
GOTRUE = "http://gotrue:9999"
# Any name does: GoTrue alone asks for no publishable key, and the browser is given it.
PUBLISHABLE = "sb_publishable_local"


def database(stack: dict[str, str], postgres: bool, role: str, current: str) -> dict[str, str]:
    """The database's two URLs, as the app profile reaches them, by the stack's adapter."""
    host, admin = ("postgres", stack["POSTGRES_ADMIN_PASSWORD"]) if postgres else SUPABASE_DB
    host = os.environ.get("STACKR_DB_HOST") or host
    admin = os.environ.get("STACKR_DB_ADMIN_PASSWORD") or admin
    password = urlsplit(current).password or secrets.token_hex(16)
    return {
        "STACK_DATABASE_URL": f"postgresql+asyncpg://{role}:{password}@{host}:5432/postgres",
        "STACK_DATABASE_ADMIN_URL": (
            f"postgresql+asyncpg://postgres:{quote(admin, safe='')}@{host}:5432/postgres"
        ),
    }


def wired(app: Path, stack: dict[str, str], flags: argparse.Namespace) -> dict[str, str]:
    """What the application reads from the stack, by its adapter and the profiles asked for."""
    current = read_env(app / ".env")
    name = tomllib.loads((app / "pyproject.toml").read_text(encoding="utf-8"))["project"]["name"]
    postgres = stack.get("STACKR_DATABASE") == "postgres"
    role = f"{name.replace('-', '_')}_app"
    values = {
        "LANGFUSE_PUBLIC_KEY": stack["LANGFUSE_PUBLIC_KEY"],
        "LANGFUSE_SECRET_KEY": stack["LANGFUSE_SECRET_KEY"],
        **database(stack, postgres, role, current.get("STACK_DATABASE_URL", "")),
    }
    if flags.langfuse_project:
        values["PORTAL_LANGFUSE_PROJECT"] = stack["LANGFUSE_INIT_PROJECT_ID"]
    if postgres:
        values |= {
            "AUTH_ISSUER": stack["AUTH_PUBLIC_URL"],
            "AUTH_SERVICE_ROLE_KEY": stack["AUTH_SERVICE_ROLE_KEY"],
            "STACK_AUTH_JWKS_URL": f"{GOTRUE}/.well-known/jwks.json",
            "STACK_AUTH_ADMIN_URL": GOTRUE,
            "PORTAL_SUPABASE_KEY": current.get("PORTAL_SUPABASE_KEY") or PUBLISHABLE,
        }
    else:
        values |= {"STACK_AUTH_JWKS_URL": "", "STACK_AUTH_ADMIN_URL": ""}
    if flags.analytics:
        values |= {
            "PORTAL_ANALYTICS_URL": f"http://127.0.0.1:{stack['CLICKHOUSE_HTTP_PORT']}",
            "PORTAL_ANALYTICS_WRITER_PASSWORD": stack["CLICKHOUSE_ANALYTICS_WRITER_PASSWORD"],
            "PORTAL_ANALYTICS_PASSWORD": stack["CLICKHOUSE_ANALYTICS_PASSWORD"],
        }
    if flags.umami:
        values |= {
            "PORTAL_UMAMI_WEBSITE_ID": stack["UMAMI_WEBSITE_ID"],
            "PORTAL_UMAMI_PASSWORD": stack["UMAMI_PORTALR_PASSWORD"],
        }
    return values


def write(path: Path, values: dict[str, str]) -> None:
    """Set each value on its key's one line, where it is, or on a new line at the end; mode 0600.

    A key that was set twice keeps its first line, the one `make` reads, and loses the others.
    """
    lines, seen = [], set()
    for line in path.read_text(encoding="utf-8").splitlines():
        match = LINE.match(line.strip())
        key = match["key"] if match else None
        if key in values:
            if key in seen:
                continue
            seen.add(key)
            line = f"{key}={values[key]}"
        lines.append(line)
    lines += [f"{key}={value}" for key, value in values.items() if key not in seen]
    # A file of its own, made mode 0600 and never one that was there, then put in .env's place.
    fd, staged = tempfile.mkstemp(dir=path.parent, prefix=".env.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            out.write("\n".join(lines).rstrip() + "\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(staged, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(staged)
        raise


def refused(values: dict[str, str], stack: dict[str, str]) -> str | None:
    """Why the values can't be written, if they can't."""
    placeholders = sorted(key for key, value in stack.items() if value.startswith("generate:"))
    if placeholders:
        return f"stackr's .env has no {', '.join(placeholders)}: run `make env` in stackr first"
    bad = sorted(key for key, value in values.items() if "$" in value or "\n" in value)
    if bad:
        return f"{', '.join(bad)} has `$` or a line break, which .env can't hold as it is"
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("app", type=Path, help="the application's directory")
    parser.add_argument("--analytics", action="store_true", help="with the analytics profile")
    parser.add_argument("--umami", action="store_true", help="with the umami profile")
    parser.add_argument(
        "--langfuse-project", action="store_true", help="the portal reads Langfuse's scores"
    )
    parser.add_argument("--stdin", action="store_true", help="read KEY=VALUE lines from stdin")
    parser.add_argument("--stack", type=Path, default=ROOT, help="the stack's directory")
    args = parser.parse_args()
    env = args.app / ".env"
    if not env.exists():
        raise SystemExit(f"wire-app: {env} isn't there: run `make env` in {args.app} first")
    given = sys.stdin.read().splitlines() if args.stdin else []
    extra = {m["key"]: m["value"] for m in (LINE.match(line.strip()) for line in given) if m}
    # The stack's settings as Compose reads them: one set in the environment over its .env, as a
    # single host's AUTH_PUBLIC_URL may be, and the adapter `make` chose.
    stack = settings(args.stack)
    stack |= {key: os.environ[key] for key in stack if os.environ.get(key)}
    if why := refused(extra, stack):
        raise SystemExit(f"wire-app: {why}")
    values = wired(args.app, stack, args) | extra
    if why := refused(values, {}):
        raise SystemExit(f"wire-app: {why}")
    write(env, values)
    print(f"wire-app: set {', '.join(values)} in {env}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
