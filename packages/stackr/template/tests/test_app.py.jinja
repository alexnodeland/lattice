def test_telemetry_is_configured_only_with_an_endpoint(monkeypatch: pytest.MonkeyPatch) -> None:
    configured: list[tuple[list[str], dict[str, Any]]] = []

    def record(*contributions: Any, **options: Any) -> None:
        configured.append(([contribution.name for contribution in contributions], options))

    monkeypatch.setattr({{ package_name }}.telemetry, "configure_telemetry", record)
    assert configure(Settings()) is None
    configure(Settings(telemetry=True, environment="staging"))
    configure(Settings(telemetry=True, langfuse=True))
    [(contributions, options), (_, with_langfuse)] = configured
    assert contributions == [{% if libraries == 'both' %}"reflexr"{% endif %}{% if use_relayr %}, "relayr"{% endif %}]
    assert options["service_name"] == "{{ project_slug }}"
    assert options["environment"] == "staging"
    # Langfuse gets scores only: stackr's Collector sends it the traces.
    assert (options["langfuse"], with_langfuse["langfuse"]) == (None, "scores")


def test_main_serves_with_telemetry(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    served: dict[str, Any] = {}
    shut_down: list[bool] = []

    class Handle:
        tracer_provider = meter_provider = langfuse = None

        def capability(self) -> Instrumentation:
            return Instrumentation(settings=InstrumentationSettings())

        def instrument_app(self, app: object) -> None:
            served["app"] = "instrumented"

        def instrument_engine(self, engine: AsyncEngine) -> None:
            served["engine"] = "instrumented"

        def shutdown(self) -> None:
            shut_down.append(True)

    monkeypatch.setattr({{ package_name }}.app, "configure", lambda settings: Handle())
    monkeypatch.setattr(uvicorn, "run", lambda app, **options: served.update(options))
    monkeypatch.setenv("AUTH_JWT_SECRET", "secret")
    monkeypatch.setenv("APP_HOST", "127.0.0.1")
    monkeypatch.setenv("APP_PORT", "9000")
    monkeypatch.setenv("DATABASE_URL", f"sqlite+aiosqlite:///{tmp_path / 'app.db'}")
    {{ package_name }}.app.main()
    assert served == {
        "app": "instrumented",
        "engine": "instrumented",
        "host": "127.0.0.1",
        "port": 9000,
        "timeout_graceful_shutdown": DRAIN,
    }
    assert shut_down == [True]


def test_main_serves_without_telemetry(monkeypatch: pytest.MonkeyPatch) -> None:
    served: dict[str, Any] = {}
    monkeypatch.setattr(uvicorn, "run", lambda app, **options: served.update(options))
    monkeypatch.setenv("AUTH_JWT_SECRET", "secret")
    for unset in ("APP_HOST", "APP_PORT", "OTEL_EXPORTER_OTLP_ENDPOINT"):
        monkeypatch.delenv(unset, raising=False)
    {{ package_name }}.app.main()
