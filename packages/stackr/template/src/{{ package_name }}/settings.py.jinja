@dataclass(frozen=True)
class Settings:
    """Everything the application reads from its environment.

    Attributes:
        service_name: The service's name in telemetry.
        environment: The deployment environment in telemetry; the Collector's when unset.
        host: The address to listen on.
        port: The port to listen on.
        database_url: A SQLAlchemy URL with an async driver. Without one, workspaces live in
            memory and are gone when the process stops.
        database_schema: The PostgreSQL schema the libraries' tables live in. A schema of its
            own keeps them out of ``public``, which Supabase's Data API serves.
        database_admin_url: The tables' owner, on the same database: with it, PostgreSQL keeps
            tenants apart itself, and ``database_url`` connects as a role that owns nothing,
            which ``make db-roles`` creates.
        auth: How access tokens are verified.
        gateway: How agents reach models.
{%- if use_artifactr %}
        agent_writes_direct: ``AGENT_WRITES_DIRECT``: the kinds whose agents' writes apply
            directly in Auto, the ceiling a tenant's and a workspace's admins only narrow; each
            type's own policy when unset, in which notes apply and native files wait for review.
{%- endif %}
{%- if use_tracker %}
        tracker: Where rules' runs file work, and whose changes come back.
{%- endif %}
{%- if use_files %}
        files: Native files: which crafting apps run, each in its worker.
{%- endif %}
        telemetry: Whether to export OpenTelemetry, to ``OTEL_EXPORTER_OTLP_ENDPOINT``.
        langfuse: Whether to use Langfuse, with the ``LANGFUSE_*`` keys, for trace attributes
            and scores.
{%- if use_portal %}
        portal: Where portalr's UIs sign in, and the tools its admin reads.
        langfuse_url: Langfuse, as this application reaches it.
        langfuse_keys: The project's public and secret keys, which portalr reads scores with.
{%- endif %}
    """

    service_name: str = "{{ project_slug }}"
    environment: str | None = None
    host: str = "127.0.0.1"
    port: int = {{ app_port }}
    database_url: str | None = None
    database_schema: str = "{{ package_name }}"
    database_admin_url: str | None = None
    auth: AuthSettings = field(default_factory=AuthSettings)
    gateway: GatewaySettings = field(default_factory=GatewaySettings)
{%- if use_artifactr %}
    agent_writes_direct: tuple[str, ...] | None = None
{%- endif %}
{%- if use_tracker %}
    tracker: TrackerSettings = field(default_factory=TrackerSettings)
{%- endif %}
{%- if use_files %}
    files: FilesSettings = field(default_factory=FilesSettings)
{%- endif %}
    telemetry: bool = False
    langfuse: bool = False
{%- if use_portal %}
    portal: PortalSettings = field(default_factory=PortalSettings)
    langfuse_url: str | None = None
    langfuse_keys: tuple[str, str] | None = None
{%- endif %}

    def __post_init__(self) -> None:
        if self.database_admin_url and not self.database_url:
            raise ValueError("DATABASE_ADMIN_URL needs DATABASE_URL: the role the app works as")
        if not SCHEMA_NAME.match(self.database_schema):
            raise ValueError(
                f"DATABASE_SCHEMA must be a lowercase identifier, not {self.database_schema!r}"
            )

    @classmethod
    def from_environ(cls, environ: Mapping[str, str] | None = None) -> Self:
        """Read the settings from environment variables; empty ones count as unset."""
        env = {k: v for k, v in (os.environ if environ is None else environ).items() if v}
        auth = AuthSettings(
            jwks_url=env.get("AUTH_JWKS_URL"),
            jwt_secret=env.get("AUTH_JWT_SECRET"),
            audience=env.get("AUTH_AUDIENCE", AuthSettings.audience),
            issuer=env.get("AUTH_ISSUER"),
{%- if access == 'grantr' %}
            service_role_key=env.get("AUTH_SERVICE_ROLE_KEY"),
            admin_url=env.get("AUTH_ADMIN_URL"),
{%- else %}
            tenant_claim=env.get("AUTH_TENANT_CLAIM", AuthSettings.tenant_claim),
{%- endif %}
        )
        guardrails = env.get("LITELLM_GUARDRAILS", ",".join(GatewaySettings.guardrails))
        gateway = GatewaySettings(
            base_url=env.get("LITELLM_BASE_URL", GatewaySettings.base_url),
            api_key=env.get("LITELLM_API_KEY"),
            model=env.get("LITELLM_MODEL", GatewaySettings.model),
            tenant_keys=_tenant_keys(env.get("LITELLM_TENANT_KEYS", "{}")),
            guardrails=_names(guardrails),
            mock_response=env.get("LITELLM_MOCK_RESPONSE"),
            first_output_seconds=_wait(env, "LITELLM_FIRST_OUTPUT_SECONDS", 120.0),
            no_output_seconds=_wait(env, "LITELLM_NO_OUTPUT_SECONDS", 120.0),
            local_first_output_seconds=_wait(env, "LITELLM_LOCAL_FIRST_OUTPUT_SECONDS", 300.0),
            local_no_output_seconds=_wait(env, "LITELLM_LOCAL_NO_OUTPUT_SECONDS", 300.0),
            local_models=_names(env.get("LITELLM_LOCAL_MODELS", "")),
            hosted_models=_names(env.get("LITELLM_HOSTED_MODELS", "")),
            tool_seconds=_seconds(env, "AGENT_TOOL_SECONDS", 600.0, none=True),
            models=_models(env.get("LITELLM_MODELS", "[]")),
            allowed_models=_names(
                env.get("LITELLM_MODELS_ALLOWED", ",".join(GatewaySettings.allowed_models))
            ),
        )
        return cls(
            service_name=env.get("OTEL_SERVICE_NAME", cls.service_name),
            environment=env.get("APP_ENVIRONMENT"),
            host=env.get("APP_HOST", cls.host),
            port=int(env.get("APP_PORT", cls.port)),
            database_url=env.get("DATABASE_URL"),
            database_schema=env.get("DATABASE_SCHEMA", cls.database_schema),
            database_admin_url=env.get("DATABASE_ADMIN_URL"),
            auth=auth,
            gateway=gateway,
{%- if use_artifactr %}
            agent_writes_direct=(
                _names(env["AGENT_WRITES_DIRECT"]) if "AGENT_WRITES_DIRECT" in env else None
            ),
{%- endif %}
{%- if use_tracker %}
            tracker=TrackerSettings(
                credentials=_tracker_credentials(env.get("TRACKER_CREDENTIALS", "{}")),
                bindings=_tracker_bindings(env.get("TRACKER_BINDINGS", "{}")),
                budget=int(env.get("TRACKER_BUDGET", TrackerSettings.budget)),
            ),
{%- endif %}
{%- if use_files %}
            files=FilesSettings.from_environ(env),
{%- endif %}
            telemetry="OTEL_EXPORTER_OTLP_ENDPOINT" in env,
            langfuse="LANGFUSE_PUBLIC_KEY" in env,
{%- if use_portal %}
            portal=PortalSettings.from_environ(env),
            langfuse_url=env.get("LANGFUSE_BASE_URL"),
            langfuse_keys=(
                (env["LANGFUSE_PUBLIC_KEY"], env["LANGFUSE_SECRET_KEY"])
                if "LANGFUSE_PUBLIC_KEY" in env and "LANGFUSE_SECRET_KEY" in env
                else None
            ),
{%- endif %}
        )


def _tenant_keys(text: str) -> dict[str, str]:
    """Parse ``LITELLM_TENANT_KEYS``: a JSON object from tenant ids to gateway keys."""
    try:
        keys: object = json.loads(text)
    except json.JSONDecodeError as error:
        raise ValueError("LITELLM_TENANT_KEYS must be a JSON object of tenant keys") from error
    if not isinstance(keys, dict):
        raise ValueError("LITELLM_TENANT_KEYS must be a JSON object of tenant keys")
    pairs = cast(dict[object, object], keys)
    return {str(tenant): str(key) for tenant, key in pairs.items()}


def _models(text: str) -> tuple[ModelInfo, ...]:
    """Parse ``LITELLM_MODELS``: a JSON list of the models beyond ``default`` and ``fast``.

    Each is an object with an ``id``, the gateway's model group, and a ``label``, and, if it
    says so, its ``family``, and ``local`` and ``reasoning`` as booleans. One that lists
    ``default`` or ``fast`` says how the picker shows it.
    """
    try:
        parsed: object = json.loads(text)
    except json.JSONDecodeError as error:
        raise ValueError("LITELLM_MODELS must be a JSON list of models") from error
    if not isinstance(parsed, list):
        raise ValueError("LITELLM_MODELS must be a JSON list of models")
    listed: list[ModelInfo] = []
    for entry in cast(list[object], parsed):
        if not isinstance(entry, dict):
            raise ValueError("each of LITELLM_MODELS is an object with an id and a label")
        fields = cast(dict[str, object], entry)
        model, label = fields.get("id"), fields.get("label")
        family = fields.get("family", "")
        local, reasoning = fields.get("local", False), fields.get("reasoning", False)
        if not (isinstance(model, str) and model and isinstance(label, str) and label):
            raise ValueError("each of LITELLM_MODELS is an object with an id and a label")
        if not (
            isinstance(family, str) and isinstance(local, bool) and isinstance(reasoning, bool)
        ):
            raise ValueError(f"LITELLM_MODELS' {model}: family is text, local and reasoning bool")
        listed.append(
            ModelInfo(id=model, label=label, family=family, local=local, reasoning=reasoning)
        )
    named = {model.id for model in listed}
    return (*(model for model in ALWAYS if model.id not in named), *listed)


{% if use_tracker -%}
FIELDS = "base_url, api_key{% if tracker == 'plane' %}, webhook_secret and workspace{% else %} and webhook_secret{% endif %}"
"""What a tenant's tracker credentials must have."""


def _tracker_credentials(text: str) -> dict[str, TrackerCredentials]:
    """Parse ``TRACKER_CREDENTIALS``: a JSON object from tenant ids to their tracker credentials.
{% if tracker == 'plane' %}
    A tenant's are ``base_url``, ``api_key``, ``webhook_secret`` and ``workspace``, its Plane
    workspace's slug. The errors never quote them: they are secrets.
{%- else %}
    A tenant's are ``base_url``, ``api_key`` and ``webhook_secret``; ``expires_at``, when the
    token expires, is for stackr's ``make tracker-check``, which warns two weeks before. The
    errors never quote them: they are secrets.
{%- endif %}
    """
    credentials: dict[str, TrackerCredentials] = {}
    for tenant, entry in _json_object(text, "TRACKER_CREDENTIALS").items():
        try:
            credentials[tenant] = TrackerCredentials.model_validate(entry)
{%- if tracker == 'plane' %}
        except ValidationError:
            raise ValueError(f"TRACKER_CREDENTIALS of {tenant} must have {FIELDS}") from None
        if not credentials[tenant].workspace:
            raise ValueError(f"TRACKER_CREDENTIALS of {tenant} must have {FIELDS}")
{%- else %}
        except ValidationError:
            raise ValueError(f"TRACKER_CREDENTIALS of {tenant} must have {FIELDS}") from None
{%- endif %}
    return credentials


def _tracker_bindings(text: str) -> dict[WorkspaceKey, TrackerBinding]:
    """Parse ``TRACKER_BINDINGS``: a JSON object from ``<tenant>/<workspace>`` to a binding.

    A binding is the tracker ``project`` the workspace files into and reads, by the tracker's id,
    and what its items have unless a rule says: a ``state``, a ``priority`` and ``labels``.
    """
    bindings: dict[WorkspaceKey, TrackerBinding] = {}
    for name, entry in _json_object(text, "TRACKER_BINDINGS").items():
        tenant, _, workspace = name.partition("/")
        if not tenant or not workspace:
            raise ValueError(f"TRACKER_BINDINGS names {name!r}, not <tenant>/<workspace>")
        try:
            bindings[WorkspaceKey(tenant, workspace)] = TrackerBinding.model_validate(entry)
        except ValidationError as error:
            raise ValueError(f"TRACKER_BINDINGS of {name}: {error}") from error
    return bindings


{% endif -%}
{% if use_tracker or use_portal -%}
def _json_object(text: str, name: str) -> dict[str, object]:
    """Parse a setting that is a JSON object."""
    try:
        parsed: object = json.loads(text)
    except json.JSONDecodeError as error:
        raise ValueError(f"{name} must be a JSON object") from error
    if not isinstance(parsed, dict):
        raise ValueError(f"{name} must be a JSON object")
    return {str(key): value for key, value in cast(dict[object, object], parsed).items()}


{% endif -%}
{% if use_files -%}
WHOLE = re.compile(r"[0-9]+")
"""A whole number as a setting gives one: ASCII digits, and nothing else, not ``1_000`` or ``²``."""


def _quota(text: str, name: str) -> Held | None:
    """A quota, ``<bytes>`` or ``<bytes>,<files>``, or None if empty.

    Raises:
        ValueError: If it is neither.
    """
    if not text.strip():
        return None
    parts = text.strip().split(",")
    if len(parts) > 2 or not all(WHOLE.fullmatch(part) for part in parts):
        raise ValueError(f"{name} is <bytes> or <bytes>,<files>, each whole, not {text!r}")
    return Held(*(int(part) for part in parts))


def _whole[N: int | None](env: Mapping[str, str], name: str, default: N) -> int | N:
    """A setting that is a whole number of at least one, or its default if unset or empty.

    Raises:
        ValueError: If it is set to anything else, named by its variable.
    """
    text = env.get(name, "").strip()
    if not text:
        return default
    if not WHOLE.fullmatch(text) or int(text) < 1:
        raise ValueError(f"{name} is a whole number of at least 1, not {text!r}")
    return int(text)
{%- if use_diagrams %}


def _switch(text: str, name: str) -> bool:
    """A setting that is ``on`` or ``off``, off if empty.

    Raises:
        ValueError: If it is anything else, named by its variable.
    """
    said = text.strip().lower() or "off"
    if said not in {"on", "off"}:
        raise ValueError(f"{name} is on or off, not {text!r}")
    return said == "on"
{%- endif %}


{% endif -%}
{% if use_portal -%}
def _extra_urls(env: Mapping[str, str]) -> tuple[str, ...]:
    """The portal's other origins, ``PORTAL_EXTRA_URLS``: none where it is empty.

    Each is kept as a browser compares it, once, and never ``PORTAL_URL`` itself.
    """
    named = env.get("PORTAL_EXTRA_URLS", "")
    if not named.strip():
        return ()
    return origins(named, what="PORTAL_EXTRA_URLS", canonical=env.get("PORTAL_URL") or None)


def _links(env: Mapping[str, str]) -> dict[str, str]:
    """Each connected app's address, ``PORTAL_LINKS``, by its integration: none where it is empty.

    The site checks each, as the application starts (portalr ADR-0088).
    """
    named = env.get("PORTAL_LINKS", "")
    if not named.strip():
        return {}
    return {key: str(url) for key, url in _json_object(named, "PORTAL_LINKS").items()}


{% endif -%}
def _seconds(
    env: Mapping[str, str], name: str, default: float, *, none: bool = False
) -> float | None:
    """Parse a wait in seconds, which must be positive; with ``none``, ``none`` is no wait."""
    text = env.get(name)
    if not text:
        return default
    if none and text.strip().lower() == "none":
        return None
    try:
        seconds = float(text)
    except ValueError:
        raise ValueError(f"{name} must be a number of seconds") from None
    if seconds <= 0:
        raise ValueError(f"{name} must be a number of seconds")
    return seconds


def _wait(env: Mapping[str, str], name: str, default: float) -> float:
    """Parse a wait that is always some seconds."""
    seconds = _seconds(env, name, default)
    assert seconds is not None, "without `none`, a wait is seconds"
    return seconds


def _names(text: str) -> tuple[str, ...]:
    """Parse a comma-separated list of names, where ``none`` is the empty list."""
    names = tuple(name.strip() for name in text.split(",") if name.strip())
    return () if names == ("none",) else names
