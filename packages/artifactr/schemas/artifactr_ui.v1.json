          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "items": {
          "$ref": "#/$defs/Choices"
        },
        "maxItems": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxitems"
        },
        "minItems": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minitems"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "array",
          "title": "Type",
          "type": "string"
        },
        "uniqueItems": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uniqueitems"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "ArrayProperty",
      "type": "object"
    },
    "ArtifactId": {
      "type": "string"
    },
    "BooleanProperty": {
      "additionalProperties": false,
      "description": "A yes or no, as a switch unless its hint asks for a checkbox.",
