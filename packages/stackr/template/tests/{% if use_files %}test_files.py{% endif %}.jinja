from conftest import TENANT, Script, app, bearer, settings

TOKEN = "a-workers-token-of-32-characters-or-more"
WORDCRAFT = FilesSettings(crafts=("wordcraft",), tokens={"wordcraft": TOKEN})
ALICE = UserActor(id="alice", name="Alice")


class Stand(FakeApp):
    """The fake app, standing in for WordCraft at its pinned version."""

    name = "wordcraft"
    version = CRAFTS["wordcraft"]
    integration = "files:wordcraft"


def workers(token: str = TOKEN, app: FakeApp | None = None) -> httpx.ASGITransport:
    """WordCraft's worker, as the application reaches it, with the fake app for its CLI."""
    worker = worker_app(app or Stand(), token=token, limits=Limits())
    return httpx.ASGITransport(app=worker)


async def resolve_actor(_connection: HTTPConnection) -> tuple[TenantId, Actor]:
    return TENANT, ALICE


def test_native_files_are_off_until_an_app_runs() -> None:
    files = Files(FilesSettings(), integrations=Defaults())
    assert (files.native, files.types, files.toolsets()) == (None, [], [])
    assert files.key_of("word_document", {}) is None
    application = FastAPI()
    files.mount(application, Workspaces(InMemoryStorage()), resolve_actor=resolve_actor, prefix="")
    assert not application.routes[4:], "only FastAPI's own routes"


async def test_a_file_is_read_by_its_apps_worker_and_served_beside_artifactr() -> None:
    files = Files(WORDCRAFT, integrations=Defaults(), transport=workers())
    assert files.types == [WordDocument]
    assert files.native is not None
    workspaces = Workspaces(InMemoryStorage(), types=files.types)
    application = FastAPI()
    files.mount(application, workspaces, resolve_actor=resolve_actor, prefix="/artifactr/v1")
    async with files.lifespan():
        assert files.key_of("word_document", {}) == "files:wordcraft"
        assert [toolset.id for toolset in files.toolsets()] == [None]
        ws = await workspaces.open(TENANT, "main", actor=ALICE)
        made = await FakeApp().apply(None, [], deadline=5)
        await files.native.upload(
            ws, WordDocument, "brief.docx", once(made.content), media_type=DOCX, artifact_id="a1"
        )
        transport = httpx.ASGITransport(app=application)
        async with httpx.AsyncClient(transport=transport, base_url="http://app") as client:
            head = await client.get("/artifactr/v1/workspaces/main/files/a1")
    assert head.status_code == 200
    assert (head.json()["name"], head.json()["enabled"]) == ("brief.docx", True)


async def test_a_worker_that_doesnt_answer_says_which_one() -> None:
    files = Files(WORDCRAFT, integrations=Defaults(), transport=workers(token="another"))
    with pytest.raises(RuntimeError, match="files-wordcraft, the worker FILES_CRAFTS names"):
        async with files.lifespan():
            pass


async def test_a_worker_that_runs_another_app_or_version_than_its_pin_is_refused() -> None:
    files = Files(WORDCRAFT, integrations=Defaults(), transport=workers(app=FakeApp()))
    with pytest.raises(RuntimeError, match=r"files-wordcraft runs fake 1\.0, not wordcraft"):
        async with files.lifespan():
            pass


async def test_the_files_bytes_and_check_outs_live_in_the_database(tmp_path: Path) -> None:
    database = open_database(f"sqlite+aiosqlite:///{tmp_path / 'app.db'}", schema="main")
    files = Files(WORDCRAFT, integrations=Defaults(), database=database, transport=workers())
    await files.migrate(database)
    assert files.native is not None
    await database.dispose()


def test_the_application_mounts_native_files_while_an_app_runs(script: Script) -> None:
    config = replace(settings(), files=WORDCRAFT)
    with TestClient(app(script, config, workers=workers()), headers=bearer()) as client:
        missing = client.get("/artifactr/v1/workspaces/main/files/a_missing")
    assert missing.status_code == 404
    assert missing.json() != {"detail": "Not Found"}, "artifactr's refusal, not a missing route"


@pytest.mark.parametrize(
    ("environ", "refusal"),
    [
        ({"FILES_CRAFTS": "wordcraft,filmcraft"}, "names filmcraft: a worker runs wordcraft"),
        ({"FILES_CRAFTS": "wordcraft"}, "needs FILES_WORDCRAFT_TOKEN, of at least 32"),
        ({"FILES_CRAFTS": "wordcraft", "FILES_WORDCRAFT_TOKEN": "short"}, "of at least 32"),
    ],
)
def test_native_files_settings_are_refused_unless_they_hold(
    environ: dict[str, str], refusal: str
) -> None:
    with pytest.raises(ValueError, match=refusal):
        Settings.from_environ(environ)


def test_no_app_runs_by_default() -> None:
    assert Settings.from_environ({}).files == FilesSettings()
