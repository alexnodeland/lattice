# Runs stackr-restore-drill.service weekly; a run missed while the host was off runs at its next start.
[Unit]
Description=Restore stackr's latest backups beside it, check them, and report, weekly

[Timer]
OnCalendar=Sun *-*-* 05:00:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
