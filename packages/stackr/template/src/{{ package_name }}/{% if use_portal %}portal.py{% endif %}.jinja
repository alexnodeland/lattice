)

from {{ package_name }}.access import Access
from {{ package_name }}.database import Database
from {{ package_name }}.settings import Settings

PREFIX = "/portalr"

LOGGER = logging.getLogger(__name__)

OFF = "the portal is off: PORTAL_SUPABASE_URL and PORTAL_SUPABASE_KEY are unset"
UNFRAMED = "PORTAL_APPS_URL needs PORTAL_URL, the portal's own origin, which alone frames the apps"
PLAIN = "PORTAL_SUPABASE_URL is not an https address"
NOWHERE = "PORTAL_SUPABASE_URL is this origin, which passes sign-in on: set AUTH_ISSUER"

SIGN_IN: Final = {"token": "POST", "user": "GET", "logout": "POST"}
"""Supabase Auth's calls the UIs make to sign in, stay signed in and sign out, by path: the only
ones passed on, as stackr's edge passes them on a single host."""

SENT: Final = ("apikey", "authorization", "content-type")
"""The headers of a sign-in call passed on to Supabase Auth."""

KEPT: Final = ("content-type", "cache-control")
"""The headers of Supabase Auth's answer passed back."""

LARGEST: Final = 64 * 1024
"""The largest body of a sign-in call passed on, in bytes: an email and a password, or a refresh
token, are far less."""


def sign_in(base: str, client: httpx.AsyncClient) -> APIRouter:
    """Supabase Auth's three sign-in calls on this origin, each passed to ``base``.

    ``base`` is where Supabase Auth's paths are, such as ``http://gotrue:9999`` or a gateway's
    ``/auth/v1``. Nothing but the calls' query, body and three headers is sent, and nothing but
    the answer's status, body and two headers comes back; neither is logged. A body larger than
    ``LARGEST`` is refused, and not passed on.
    """
    router = APIRouter(include_in_schema=False)
    for name, method in SIGN_IN.items():
        router.add_api_route(
            f"/auth/v1/{name}", _passed(f"{base}/{name}", client), methods=[method]
        )
    return router


def _passed(url: str, client: httpx.AsyncClient) -> Callable[[Request], Awaitable[Response]]:
    async def call(request: Request) -> Response:
        headers = {name: value for name in SENT if (value := request.headers.get(name))}
        body = bytearray()
        async for chunk in request.stream():
            body += chunk
            if len(body) > LARGEST:
                raise HTTPException(413, f"a sign-in call's body is at most {LARGEST} bytes")
        try:
            answer = await client.request(
                request.method,
                url,
                params=request.url.query,
                headers=headers,
                content=bytes(body),
            )
        except httpx.HTTPError as error:
            reason = f"Supabase Auth didn't answer: {type(error).__name__}"
            raise HTTPException(502, reason) from None
        kept = {name: value for name in KEPT if (value := answer.headers.get(name))}
        return Response(answer.content, status_code=answer.status_code, headers=kept)

    return call


def analytics(settings: Settings, clients: list[httpx.AsyncClient]) -> Analytics | None:
    """The portal's product analytics on ClickHouse, where the settings name it whole; else None.

    Events are written as ClickHouse's writer, and read as its reader, each with its own client,
    added to ``clients`` for the portal to close (lattice RFC-0008, stackr ADR-0044).
    """
    portal = settings.portal
    url, key = portal.analytics_url, portal.analytics_key
    writer_password, reader_password = portal.analytics_writer_password, portal.analytics_password
    if not (url and key and writer_password and reader_password):
        return None
    writer = httpx.AsyncClient(auth=("portalr_analytics_writer", writer_password))
    reader = httpx.AsyncClient(auth=("portalr_analytics", reader_password))
    clients.extend((writer, reader))
    return Analytics(url, bytes.fromhex(key), writer=writer, reader=reader)


def readers(settings: Settings, clients: list[httpx.AsyncClient]) -> Readers:
    """The tools the settings name, each read at its address.

    The clients made are added to ``clients``, for the portal to close.
    """
    portal = settings.portal
    langfuse = None
    if settings.langfuse_url and portal.langfuse_project and settings.langfuse_keys:
        client = httpx.AsyncClient(auth=settings.langfuse_keys)
        clients.append(client)
        langfuse = Langfuse(settings.langfuse_url, project=portal.langfuse_project, client=client)
    litellm = None
    if portal.litellm_key:
        client = httpx.AsyncClient(headers={"Authorization": f"Bearer {portal.litellm_key}"})
        clients.append(client)
        litellm = LiteLLM(settings.gateway.base_url, client=client)
    return Readers(
        tempo=Tempo(portal.tempo_url) if portal.tempo_url else None,
        loki=Loki(portal.loki_url) if portal.loki_url else None,
        prometheus=Prometheus(portal.prometheus_url) if portal.prometheus_url else None,
        langfuse=langfuse,
        litellm=litellm,
        grafana=Grafana(portal.grafana_url) if portal.grafana_url else None,
        analytics=analytics(settings, clients),
    )


def invitations(settings: Settings, clients: list[httpx.AsyncClient]) -> Invite:
    """Invite people by email through Supabase Auth's admin API.

    That needs this application to have its secret key and the gateway's address; otherwise
    every invitation fails, and says why.
    """
    url, key = settings.portal.auth_url, settings.auth.service_role_key
    if not url or not key:

        async def unavailable(_email: str) -> str:
            raise InviteFailed("invitations need PORTAL_AUTH_URL and AUTH_SERVICE_ROLE_KEY")

        return unavailable
    client = httpx.AsyncClient()
    clients.append(client)
    return SupabaseInvite(url=url.rstrip("/"), secret_key=key, client=client)


def people(settings: Settings, clients: list[httpx.AsyncClient]) -> People | None:
    """Name people by email, through Supabase Auth's admin API, for the UIs to show.

    It needs what invitations need: the gateway's address and this application's secret key,
    which stay here (the key is sent to the gateway only, in a header, and neither is logged or
    given to the browser). Without them there is no people route, and the UIs show a short id.
    The emails are kept in memory for a few minutes, and are logged nowhere.
    """
    url, key = settings.portal.auth_url, settings.auth.service_role_key
    if not url or not key:
        return None
    client = httpx.AsyncClient()
    clients.append(client)
    return SupabasePeople(url=url.rstrip("/"), secret_key=key, client=client)


class Portal:
    """portalr in the application: its router, its UIs, and the tools it reads.

    Args:
        access: grantr in the application, which says who the caller is and what they may do.
        settings: The settings; the portal's are ``settings.portal``.
    """

    def __init__(
        self, *, access: Access, settings: Settings, database: Database | None = None
    ) -> None:
        self._access = access
        self._settings = settings
        self._database = database
        self._clients: list[httpx.AsyncClient] = []

    @property
    def grants(self) -> Grants:
        """grantr, which the portal asks before every read."""
        return self._access.grants

    @property
    def site(self) -> Site | None:
        """The Supabase project the UIs sign in to, or None where it isn't named.{% if use_tracker %}

        relayr's tracker reads are on this origin, at their own ``/relayr/v1`` paths.
        {% endif %}"""
        portal = self._settings.portal
        if portal.supabase_url and portal.supabase_key:
            return Site(
                supabase_url=portal.supabase_url,
                supabase_key=portal.supabase_key,
{%- if use_tracker %}
                surfaces=Surfaces(relayr=""),
{%- endif %}
                apps=portal.apps_url,
{%- if use_files %}
                editors=dict(self._settings.files.editors),
{%- endif %}
                brand=Path(portal.brand_dir) if portal.brand_dir else None,
            )
        return None

    @property
    def configured(self) -> bool:
        """Whether the UIs have a Supabase project to sign in to."""
        return self.site is not None

    async def migrate(self, database: Database) -> None:
        """Upgrade portalr's one table, people's answers to analytics, as the tables' owner."""
        await migrate_consent(database.owner, application_role=database.role)

    @contextlib.asynccontextmanager
    async def lifespan(self) -> AsyncGenerator[None]:
        """Close the clients the portal made, when the application stops."""
        try:
            yield
        finally:
            for client in self._clients:
                await client.aclose()

    def mount(self, app: FastAPI) -> None:
        """Add the router and the UIs, and mini apps' sandbox, as the settings name them.

        The router and the UIs are added if a Supabase project is named, and the sandbox, on
        an origin of its own, if the apps' origin is.

        On this origin (``/``), Supabase Auth's sign-in calls are passed on here too.

        Raises:
            ValueError: If none is, or it is not at an https address, and the settings say the
                application must have the portal; or it is this origin, and Supabase Auth's
                address isn't set; or the apps' origin is named without the portal's.
        """
        portal = self._settings.portal
        if portal.apps_url and not portal.url:
            raise ValueError(UNFRAMED)
        site = self.site
        if site is None:
            if portal.required:
                raise ValueError(f"{OFF}, and PORTAL_REQUIRED says the application needs it")
            LOGGER.info(OFF)
            return
        if portal.required and not site.supabase_url.startswith("https://"):
            raise ValueError(f"{PLAIN}, and PORTAL_REQUIRED says the application needs one")
        if site.supabase_url == "/":
            auth = self._settings.auth
            base = auth.admin_url or auth.issuer
            if not base:
                raise ValueError(NOWHERE)
            client = httpx.AsyncClient(timeout=10)
            self._clients.append(client)
            app.include_router(sign_in(base.rstrip("/"), client))
        tools = readers(self._settings, self._clients)
        relay = None
        if tools.analytics is not None and self._database is not None:
            # Each replica counts a person's pace apart (lattice RFC-0008).
            consent = SqlConsent(self._database.engine)
            relay = Relay(tools.analytics, consent, InMemoryRateLimiter())
        router = portalr_router(
            resolve_actor=self._access.caller,
            grants=self.grants,
            readers=tools,
            relay=relay,
            invite=invitations(self._settings, self._clients),
            people=people(self._settings, self._clients),
            site=site,
            ui=Path(portal.ui_dir) if portal.ui_dir else UI,
        )
        app.include_router(router, prefix=PREFIX)
        if portal.apps_url and portal.url:
            app.add_middleware(
                SandboxOrigin,
                apps=portal.apps_url,
                portal=portal.url,
                root=Path(portal.ui_dir) if portal.ui_dir else UI,
            )
