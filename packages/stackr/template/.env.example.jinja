# {{ project_name }}'s settings, for running it on this machine against stackr's stack.
#
# `make env` copies this file to .env, which is gitignored; fill in the keys there. `make serve`
# and `make evals-langfuse` read .env, and so does the app profile (`make up`), which replaces
# the stack's addresses with their names on its network (stackr.env). Tests read none of it.
# Put a value with spaces in double quotes.

# --- the application -----------------------------------------------------------

APP_HOST=127.0.0.1
APP_PORT={{ app_port }}
{%- if hosting == 'host' %}
# On a single host (deploy/host/compose.prod.yaml): the image to run, as this application's CI
# publishes it, such as ghcr.io/<owner>/{{ project_slug }}:<version>.
APP_IMAGE=
{%- if use_portal %}
# The domain stackr's edge serves (its STACKR_DOMAIN): the portal's sign-in is at https://app.<domain>.
STACKR_DOMAIN=
{%- endif %}
{%- endif %}
# The deployment environment in telemetry; stackr's Collector labels telemetry without one.
APP_ENVIRONMENT=

# --- telemetry: OTLP over HTTP to stackr's Collector ---------------------------

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME={{ project_slug }}
# How often metrics are exported, in milliseconds.
OTEL_METRIC_EXPORT_INTERVAL=10000
# Health checks aren't traced.
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=healthz

# --- evaluation data: Langfuse --------------------------------------------------

# The keys of a Langfuse project: stackr's own are LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY
# in its .env. Traces reach Langfuse through the Collector; the application uses these keys for
# trace attributes, feedback scores and experiments. Without a public key, Langfuse is off.
LANGFUSE_BASE_URL=http://localhost:3300
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- the database: PostgreSQL ------------------------------------------------------

# Local Supabase's PostgreSQL. Without a URL, workspaces live in memory.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
# The schema the libraries' tables live in, outside the `public` schema Supabase's API serves.
DATABASE_SCHEMA={{ package_name }}
# With the tables' owner here, PostgreSQL keeps tenants apart itself, under the libraries' own
# scoping: DATABASE_URL then connects as a role that owns nothing, such as
# postgresql+asyncpg://{{ package_name }}_app:<a password>@127.0.0.1:54322/postgres,
# which {% if access == 'grantr' %}`make db-roles` creates{% else %}you create{% endif %} before the application first starts, and the owner migrates the
# tables and grants that role them.
DATABASE_ADMIN_URL=

# --- identity: Supabase Auth's access tokens --------------------------------------------

# Local Supabase signs access tokens with ES256 and publishes its keys here.
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
AUTH_AUDIENCE=authenticated
# For HS256 tokens, signed with a project's legacy JWT secret: set it to accept them too.
AUTH_JWT_SECRET=
{%- if access == 'grantr' %}
# Supabase's service role key, for `make tenant`, `make operator` and `make migrate-tenants` to
# find users by their email. A request names its tenant (X-Tenant), and grantr says whether the
# user is a member: the token says only who they are.
AUTH_SERVICE_ROLE_KEY=
# Where the admin API is, when not at AUTH_ISSUER: on a single host behind stackr's edge, which
# refuses it, GoTrue's private address, http://gotrue:9999.
AUTH_ADMIN_URL=
{%- else %}
# Where the tenant is in a token's claims. Set app_metadata.tenant_id on each user with
# Supabase's admin API (service role), so users can't choose their own tenant.
AUTH_TENANT_CLAIM=app_metadata.tenant_id
{%- endif %}

{%- if use_portal %}

# --- the portal: portalr's UIs and the tools its admin reads ----------------------------

# The Supabase project the UIs sign in to, as people's browsers reach it, and its PUBLISHABLE key
# (`supabase status`; with GoTrue alone, which asks for none, any name such as sb_publishable_local):
# never the secret one, since the browser is given it. `/` is this application's own origin, which
# passes the three sign-in calls on to Supabase Auth (AUTH_ADMIN_URL, or AUTH_ISSUER), so the
# portal signs in wherever the application is reached, such as on a tailnet. Without them the
# portal is off{% if hosting == 'host' %}. On a single host the URL is the application's own,
# https://app.<STACKR_DOMAIN>, where the edge serves GoTrue's sign-in calls (deploy/host/compose.prod.yaml
# sets it, and PORTAL_REQUIRED: the application won't start without the key, or at a plain-http
# address), and invitations are off{% endif %}.
PORTAL_SUPABASE_URL=/
PORTAL_SUPABASE_KEY=
# Supabase's gateway as this application reaches it, with AUTH_SERVICE_ROLE_KEY: invitations.
PORTAL_AUTH_URL=http://127.0.0.1:54321
# The built UIs, for `make serve`, since an install from lattice's repository has none: `make
# portal-ui` writes .portal-ui. The app profile serves the image's own, whatever this says.
PORTAL_UI_DIR=
# The deployment's brand kit (lattice RFC-0007): `make brand` starts one in brand/kit, and checks
# it once it's there. Set this to brand/kit to serve it; empty for portalr's own look. In the
# image it is read under / (brand/kit is /brand/kit), so a kit to serve from the image is in brand/. The image
# carries a copy of brand/, so the app profile and a host serve the kit it was built with: a
# changed kit needs a new image, which `make up` builds.
PORTAL_BRAND_DIR=
# Mini apps run on an origin of their own, which this application answers with their sandbox and
# nothing else: locally, a second port on 127.0.0.1, which `make up` publishes beside APP_PORT
# (APPS_PORT; `make serve` listens on one port, so apps run under `make up`). PORTAL_URL is the
# portal's own origin, the one page that may frame them: open the portal there. Leave
# PORTAL_APPS_URL empty and no app runs; a workspace switches ui:mini-apps on in the admin.
{%- if hosting == 'host' %}
# On a single host, the edge doesn't serve an apps' origin yet: leave them empty.
PORTAL_URL=
PORTAL_APPS_URL=
{%- else %}
PORTAL_URL=http://127.0.0.1:{{ app_port }}
PORTAL_APPS_URL=http://127.0.0.1:{{ app_port + 1 }}
{%- endif %}
# The tools the admin reads, each at its address; leave one empty to leave it out.
PORTAL_TEMPO_URL=http://localhost:3200
PORTAL_LOKI_URL=http://localhost:3100
# prom-label-proxy, in front of Prometheus, which keeps each tenant to its own metrics.
PORTAL_PROMETHEUS_URL=http://localhost:9091
# The Langfuse project's id (from its URL), for scores; with LANGFUSE_BASE_URL and its keys.
PORTAL_LANGFUSE_PROJECT=
# A key that reads each tenant's spend from the gateway and does nothing else: `make portal-key`
# in stackr makes it, a view-only admin's, limited to the four routes the admin reads. Never the
# gateway's master key, which opens everything and must not reach an application.
PORTAL_LITELLM_KEY=
# Grafana, as operators' browsers reach it, for deep links.
PORTAL_GRAFANA_URL=http://localhost:3000
{%- endif %}

# --- the LLM gateway: stackr's LiteLLM proxy --------------------------------------------

LITELLM_BASE_URL=http://localhost:4400
# The model group agents ask for: `default` falls back across providers.
LITELLM_MODEL=default
# A tenant's key: `make tenant NAME=acme` in stackr prints one. Requests use it when their
# tenant has no key of its own in LITELLM_TENANT_KEYS, a JSON object such as {"acme": "sk-..."}.
LITELLM_API_KEY=
LITELLM_TENANT_KEYS={}
# The gateway's guardrails every request asks for, comma-separated, or `none`.
LITELLM_GUARDRAILS=pii-mask,prompt-injection
# For smoke tests only: the gateway answers with this text instead of calling a model, for keys
# whose team allows mocked responses.
LITELLM_MOCK_RESPONSE=
{%- if use_tracker %}
{%- if tracker == 'plane' %}

# --- the task tracker: Plane, from stackr's recipe -----------------------------------------
{%- else %}

# --- the task tracker: Vikunja, from stackr's recipe ---------------------------------------
{%- endif %}

# Each tenant's tracker credentials, a JSON object by tenant, as stackr's tracker guide provisions
# them: the tracker's URL as the application reaches it (links to items are made from it too),
# the key of the tenant's own tracker user, relayr-<tenant>, and its webhooks' secret, with
{%- if tracker == 'plane' %}
# the tenant's workspace slug:
#   {"acme": {"base_url": "http://localhost:3800", "api_key": "plane_api_...",
#             "webhook_secret": "...", "workspace": "acme"}}
# In the app profile the URL is http://plane-proxy, Plane's proxy on the stackr network.
{%- else %}
# when the token expires, which stackr's `make tracker-check` warns of two weeks before:
#   {"acme": {"base_url": "http://localhost:3456", "api_key": "tk_...",
#             "webhook_secret": "...", "expires_at": "2027-04-01"}}
# In the app profile the URL is http://vikunja:3456, Vikunja on the stackr network.
{%- endif %}
TRACKER_CREDENTIALS={}
# The tracker project each workspace files into and reads, a JSON object by <tenant>/<workspace>:
#   {"acme/main": {"project": "<the project's id>", "labels": ["lattice"]}}
TRACKER_BINDINGS={}
# How many requests a minute each tenant's key may make from this process.
TRACKER_BUDGET=300
{%- endif %}
{%- if use_files %}

# --- native files: each crafting app's worker{% if use_portal %} and editor{% endif %} -------------------------------------

# The apps whose workers run, comma-separated, such as wordcraft,gridcraft,pdfcraft: `make up`
# starts files-<app> for each. Empty, native files are off. Each worker reads files you needn't
# trust, in a container with no route out (stackr ADR-0043).
FILES_CRAFTS=
# Each worker's token, its own, which only the application and that worker hold: `make env`
# generates them. Like every setting here, a worker's is in its container's environment, which
# `docker inspect` shows to whoever may run Docker.
{%- for name in crafts %}
FILES_{{ name | upper }}_TOKEN=
{%- endfor %}
# Each worker container's own limits: its memory, CPUs and tmpfs, where each call's files are.
FILES_WORKER_MEMORY=3g
FILES_WORKER_CPUS=2
FILES_WORKER_TMPFS=1g
# The limits on each call, artifactr's defaults unless set here, as JSON, such as
# {"render": 5, "memory": 1073741824}: its deadlines, the CLI's CPU seconds, address space and
# largest file, and the largest reply.
FILES_WORKER_LIMITS=
# How people's uploads and check-ins are held back, artifactr's defaults unless set (native files
# ADR-0017): each person's starts a minute; the files read at once, from every tenant, each held
# in memory; a tenant's share of them (half, unset) and a person's; and each tenant's files its
# apps read at once.
FILES_UPLOADS_PER_MINUTE=20
FILES_UPLOADS_AT_ONCE=8
FILES_UPLOADS_PER_TENANT=
FILES_UPLOADS_EACH=2
FILES_READINGS=2
# The most each workspace's, and each tenant's, files may hold: <bytes> or <bytes>,<files>, such
# as 2147483648,1000. Empty, none.
FILES_WORKSPACE_QUOTA=
FILES_TENANT_QUOTA=
{%- if use_portal %}
# Where each app's editor is, by its integration, as people's browsers reach it: by default,
# http://127.0.0.1:<port>/ for each app that runs and has one, on its port on this machine
# ({% for name, craft in crafts.items() if craft.editor %}{{ name | upper }}_EDITOR_PORT, {{ app_port + craft.editor }}{{ "; " if not loop.last }}{% endfor %}).
# Reached another way, such as on a tailnet, a JSON object:
#   {"files:gridcraft": "https://my-machine.tailnet.ts.net:8802/"}
# with PORTAL_URL as people reach the portal there: the only page that may frame an editor. It
# must be the portal's origin exactly: http://localhost:{{ app_port }} is not http://127.0.0.1:{{ app_port }}.
# APP_BIND publishes the editors where it publishes the application: anything but 127.0.0.1 puts
# them on that network too, to anyone who can reach it.
FILES_EDITORS=
{%- endif %}
{%- endif %}
