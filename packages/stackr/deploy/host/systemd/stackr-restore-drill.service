# A single host's restore-drill (RFC-0004). deploy/host/bootstrap installs it with the checkout's path.
[Unit]
Description=Restore stackr's latest backups beside it, check them, and report
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=@STACKR_DIR@
ExecStart=@STACKR_DIR@/deploy/host/restore-drill
