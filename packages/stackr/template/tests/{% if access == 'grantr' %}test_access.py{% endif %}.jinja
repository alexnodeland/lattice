def test_a_key_cant_pass_for_a_code_rule() -> None:
    """No principal can take a code rule's id, so no key acts as one (grantr ADR-0028)."""
    with pytest.raises(ValidationError):
        ServicePrincipal(id=rule_actor(TRIAGE).client_id)


async def test_a_key_issued_over_the_api_acts_as_its_principal_not_the_application() -> None:
    grants = seeded()
    await grants.add_member(TENANT, ServicePrincipal(id="ci"), by=User(id="alice"))
    async with (
        serving(app(Script(), grants=grants)) as server,
        httpx.AsyncClient(base_url=server) as client,
    ):
        keys = f"/grantr/v1/tenants/{TENANT}/keys"
        spoof = {"principal": rule_actor(TRIAGE).client_id}
        assert (await client.post(keys, json=spoof, headers=signed())).status_code == 422
        issued = await client.post(keys, json={"principal": "ci"}, headers=signed())
        key = issued.json()["key"]
        threads = await client.get(
            f"{WORKSPACE}/threads", headers={"Authorization": f"Bearer {key}"}
        )
        assert threads.status_code == 403, "ci, a member with no role, isn't the application"
