{
  "description": "Proposing changes, and accepting or rejecting proposals.",
  "cases": [
    {
      "name": "a person proposes an edit explicitly",
      "actor": {
        "kind": "user",
        "id": "bob"
      },
      "given": {
        "artifacts": [
          {
            "id": "note_1",
            "kind": "note",
            "version": 1,
            "data": {
              "title": "Plan",
              "text": "Ship v1 on Friday."
            },
            "updated_by": {
              "kind": "user",
              "id": "alice",
              "name": "Alice"
            }
          }
        ]
      },
      "command": {
        "type": "propose_change",
        "proposal_id": "prp_b",
        "change": {
          "type": "edit_artifact",
          "artifact_id": "note_1",
          "base_version": 1,
          "patch": {
            "kind": "text_edits",
            "field": "text",
            "edits": [
              {
                "old": "Friday",
                "new": "Monday"
              }
            ]
          },
          "proposal_id": "prp_new"
        },
        "rationale": "Monday is safer"
      },
      "expect": {
        "outcome": {
          "type": "proposed",
          "proposal_id": "prp_b"
        },
        "events": [
          {
            "type": "proposal_created",
            "proposal_id": "prp_b",
            "rationale": "Monday is safer",
            "thread_id": null
          }
        ],
        "proposals": [
          {
            "id": "prp_b",
            "status": "pending",
            "proposed_by": {
              "kind": "user",
              "id": "bob"
            },
            "rationale": "Monday is safer"
          }
        ]
      }
    },
    {
