{
  "description": "Creating, editing and archiving artifacts, including write policies.",
  "cases": [
    {
      "name": "a person creates an artifact",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "note_2",
        "kind": "note",
        "data": {
          "title": "Ideas",
          "text": "- one"
        }
      },
      "expect": {
        "outcome": {
          "type": "applied",
          "artifact_id": "note_2",
          "version": 1
        },
        "events": [
          {
            "type": "artifact_created",
            "artifact_id": "note_2",
            "kind": "note",
            "version": 1,
            "data": {
              "title": "Ideas",
              "text": "- one"
            },
            "thread_id": null,
            "run_id": null,
            "proposal_id": null
          }
        ],
        "artifacts": [
          {
            "id": "note_2",
            "version": 1,
            "archived": false,
            "updated_by": {
              "kind": "user",
              "id": "alice",
              "name": "Alice"
            }
          }
        ],
        "revisions": [
          {
            "artifact_id": "note_2",
            "version": 1,
            "patch": null,
            "actor": {
              "kind": "user",
              "id": "alice",
              "name": "Alice"
            }
          }
        ]
      }
    },
    {
      "name": "creating fills in defaults before storing",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "note_2",
        "kind": "note",
        "data": {}
      },
      "expect": {
        "outcome": {
          "type": "applied"
        },
        "events": [
          {
            "type": "artifact_created",
            "data": {
              "title": "",
              "text": ""
            }
          }
        ]
      }
    },
    {
      "name": "an unknown artifact type is rejected",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "x_1",
        "kind": "spreadsheet",
        "data": {}
      },
      "expect": {
        "rejection": {
          "type": "not_found",
          "entity": "artifact type",
          "id": "spreadsheet"
        }
      }
    },
    {
      "name": "data that does not validate is rejected",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "note_2",
        "kind": "note",
        "data": {
          "title": 5
        }
      },
      "expect": {
        "rejection": {
          "type": "validation_failed",
          "message": "invalid note data"
        }
      }
    },
    {
      "name": "an existing artifact id is rejected",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "artifacts": [
          {
            "id": "note_1",
            "kind": "note",
            "version": 1,
            "data": {
              "title": "Plan",
              "text": "Ship v1 on Friday."
            },
            "updated_by": {
              "kind": "user",
              "id": "alice",
              "name": "Alice"
            }
          }
        ]
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "note_1",
        "kind": "note",
        "data": {}
      },
      "expect": {
        "rejection": {
          "type": "invalid_state"
        }
      }
    },
    {
      "name": "the agent creates a direct artifact in an edit-mode thread",
      "actor": {
        "kind": "agent",
        "thread_id": "thr_1",
        "run_id": "run_1"
      },
      "given": {
        "threads": [
          {
            "id": "thr_1",
            "title": "Launch",
            "mode": "edit"
          }
        ]
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "note_2",
        "kind": "note",
        "data": {
          "text": "draft"
        }
      },
      "expect": {
        "outcome": {
          "type": "applied",
          "version": 1
        },
        "events": [
          {
            "type": "artifact_created",
            "thread_id": "thr_1",
            "run_id": "run_1"
          }
        ],
        "artifacts": [
          {
            "updated_by": {
              "kind": "agent",
              "thread_id": "thr_1",
              "run_id": "run_1"
            }
          }
        ]
      }
    },
    {
      "name": "the agent's creation of a propose-policy artifact becomes a proposal",
      "actor": {
        "kind": "agent",
        "thread_id": "thr_1",
        "run_id": "run_1"
      },
      "given": {
        "threads": [
          {
            "id": "thr_1",
            "title": "Launch",
            "mode": "edit"
          }
        ]
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "list_2",
        "kind": "checklist",
        "data": {
          "title": "Beta"
        },
        "proposal_id": "prp_1"
      },
      "expect": {
        "outcome": {
          "type": "proposed",
          "proposal_id": "prp_1"
        },
        "events": [
          {
            "type": "proposal_created",
            "proposal_id": "prp_1",
            "thread_id": "thr_1",
            "run_id": "run_1",
            "change": {
              "type": "create_artifact",
              "artifact_id": "list_2",
              "kind": "checklist"
            }
          }
        ],
        "proposals": [
          {
            "id": "prp_1",
            "status": "pending",
            "thread_id": "thr_1",
            "proposed_by": {
              "kind": "agent",
              "thread_id": "thr_1",
              "run_id": "run_1"
            }
          }
        ],
        "artifacts": []
      }
    },
    {
      "name": "an external agent's creation of a propose-policy artifact becomes a proposal",
      "actor": {
        "kind": "external_agent",
        "client_id": "claude-code"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "list_2",
        "kind": "checklist",
        "data": {},
        "proposal_id": "prp_1"
      },
      "expect": {
        "outcome": {
          "type": "proposed"
        },
        "events": [
          {
            "type": "proposal_created",
            "thread_id": null,
            "run_id": null
          }
        ]
      }
    },
    {
      "name": "a person's creation of a propose-policy artifact applies directly",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "list_2",
        "kind": "checklist",
        "data": {}
      },
      "expect": {
        "outcome": {
          "type": "applied",
          "version": 1
        }
      }
    },
    {
      "name": "the agent's thread must exist",
      "actor": {
        "kind": "agent",
        "thread_id": "thr_x"
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "note_2",
        "kind": "note",
        "data": {}
      },
      "expect": {
        "rejection": {
          "type": "not_found",
          "entity": "thread",
          "id": "thr_x"
        }
      }
    },
    {
      "name": "a proposal id that already exists is rejected",
      "actor": {
        "kind": "agent",
        "thread_id": "thr_1",
        "run_id": "run_1"
      },
      "given": {
        "threads": [
          {
            "id": "thr_1",
            "title": "Launch",
            "mode": "edit"
          }
        ],
        "proposals": [
          {
            "id": "prp_1",
            "change": {
              "type": "archive_artifact",
              "artifact_id": "note_1",
              "base_version": 1,
              "proposal_id": "prp_1"
            },
            "proposed_by": {
              "kind": "agent",
              "thread_id": "thr_1",
              "run_id": "run_1"
            },
            "status": "rejected"
          }
        ]
      },
      "command": {
        "type": "create_artifact",
        "artifact_id": "list_2",
        "kind": "checklist",
        "data": {},
        "proposal_id": "prp_1"
      },
      "expect": {
        "rejection": {
          "type": "invalid_state",
          "message": "proposal prp_1 already exists"
        }
      }
    },
    {
      "name": "a person edits text with an anchored replacement",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "artifacts": [
          {
            "id": "note_1",
            "kind": "note",
            "version": 1,
            "data": {
              "title": "Plan",
              "text": "Ship v1 on Friday."
            },
            "updated_by": {
              "kind": "user",
              "id": "alice",
              "name": "Alice"
            }
          }
        ]
      },
      "command": {
        "type": "edit_artifact",
        "artifact_id": "note_1",
        "base_version": 1,
        "patch": {
          "kind": "text_edits",
          "field": "text",
          "edits": [
            {
              "old": "Friday",
              "new": "Monday"
            }
          ]
        },
        "proposal_id": "prp_new"
      },
      "expect": {
        "outcome": {
          "type": "applied",
          "artifact_id": "note_1",
          "version": 2
        },
        "events": [
          {
            "type": "artifact_changed",
            "artifact_id": "note_1",
            "kind": "note",
            "version": 2,
            "summary": "edited text (1 replacement)",
            "patch": {
              "kind": "text_edits",
              "field": "text",
              "edits": [
                {
                  "old": "Friday",
                  "new": "Monday"
                }
              ]
            },
            "proposal_id": null
          }
        ],
        "artifacts": [
          {
            "id": "note_1",
            "version": 2,
            "data": {
              "title": "Plan",
              "text": "Ship v1 on Monday."
            }
          }
        ],
        "revisions": [
          {
            "version": 2,
            "patch": {
              "kind": "text_edits",
              "field": "text",
              "edits": [
                {
                  "old": "Friday",
                  "new": "Monday"
                }
              ]
            },
            "data": {
              "title": "Plan",
              "text": "Ship v1 on Monday."
            }
          }
        ]
      }
    },
    {
      "name": "an edit's own summary is used",
