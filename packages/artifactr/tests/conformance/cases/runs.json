    {
      "name": "a question is answered",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "runs": [
          {
            "id": "run_p",
            "thread_id": "thr_1",
            "status": "paused",
            "pending": [
              {
                "tool_call_id": "call_q",
                "tool_name": "ask_user",
                "kind": "question",
                "args": {
                  "question": "Which day?"
                }
              },
              {
                "tool_call_id": "call_a",
                "tool_name": "delete_note",
                "kind": "approval",
                "args": {
                  "id": "note_1"
                }
              }
            ],
            "answers": {}
          }
        ]
      },
      "command": {
        "type": "answer_deferred",
        "run_id": "run_p",
        "tool_call_id": "call_q",
        "answer": "Monday"
      },
      "expect": {
        "outcome": {
          "type": "recorded"
        },
        "events": [
          {
            "type": "deferred_answered",
            "run_id": "run_p",
            "thread_id": "thr_1",
            "tool_call_id": "call_q",
            "answer": "Monday",
            "approved": null
          }
        ],
        "runs": [
          {
            "id": "run_p",
            "status": "paused",
            "answers": {
              "call_q": {
                "answer": "Monday",
                "approved": null
              }
            }
          }
        ]
      }
    },
