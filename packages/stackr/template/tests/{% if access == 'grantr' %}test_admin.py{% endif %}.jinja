async def test_db_roles_creates_the_role_as_the_owner(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    created: list[tuple[str, str, str]] = []
    sqlite = f"sqlite+aiosqlite:///{tmp_path / 'app.db'}"
    monkeypatch.setattr(admin, "create_async_engine", lambda url: create_async_engine(sqlite))
    monkeypatch.setattr(admin, "create_role", lambda _, *arguments: created.append(arguments))
    done = await run(["db-roles"], Settings(database_url=APP, database_admin_url=OWNER))
    assert done == "my_app can connect: start the application to grant it the tables"
    assert created == [("my_app", "secret", "{{ package_name }}")]


