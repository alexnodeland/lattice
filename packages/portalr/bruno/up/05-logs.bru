meta {
  name: An owner's logs
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/portalr/v1/logs?start={{start}}&end={{end}}
  body: none
  auth: none
}

headers {
  x-user: alice
  x-tenant: acme
}

tests {
  test("acme's logs, read from Loki, and only theirs", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
    expect(res.body.data.records.length).to.be.greaterThan(0);
    // No line is in the read: each is asked for by its id, one at a time.
    res.body.data.records.forEach((record) => expect(record.line).to.equal(null));
    expect(JSON.stringify(res.body)).not.to.contain("globex's record");
  });
}
