{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/stub",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (through the egress proxy)",
      "options": { "baseURL": "http://proxy:8081/v1", "apiKey": "added-by-the-egress-proxy" },
      "models": { "stub": { "name": "stub" } }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": { "*": "ask", "git push*": "deny" },
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  "autoupdate": false,
  "share": "disabled"
}
