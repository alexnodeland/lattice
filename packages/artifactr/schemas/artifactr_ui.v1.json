          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ChoiceProperty",
      "type": "object"
    },
    "Choices": {
      "additionalProperties": false,
      "description": "A choice among strings: an ``enum``, or ``oneOf`` labelled choices; ``type`` is implied.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "oneOf": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Choice"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oneof"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "string",
          "default": "string",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Choices",
      "type": "object"
    },
    "Dashboard": {
      "additionalProperties": false,
      "description": "A snapshot of figures in panels, which the agent writes, true ``as_of`` a moment.\n\nEach update is a new version; a dashboard is at most :data:`MAX_DASHBOARD_BYTES`.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "panels": {
          "items": {
            "discriminator": {
              "mapping": {
                "bar": "#/$defs/ChartPanel",
                "donut": "#/$defs/DonutPanel",
                "form": "#/$defs/FormPanel",
                "line": "#/$defs/ChartPanel",
                "stat": "#/$defs/StatPanel",
                "table": "#/$defs/TablePanel",
                "text": "#/$defs/TextPanel"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StatPanel"
              },
              {
                "$ref": "#/$defs/ChartPanel"
              },
              {
                "$ref": "#/$defs/DonutPanel"
              },
              {
                "$ref": "#/$defs/TablePanel"
              },
              {
                "$ref": "#/$defs/TextPanel"
              },
              {
                "$ref": "#/$defs/FormPanel"
              }
            ]
          },
          "title": "Panels",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "as_of"
      ],
      "title": "Dashboard",
      "type": "object"
    },
    "DonutPanel": {
      "additionalProperties": false,
      "description": "A whole in parts: the largest three in the chart's inks, the rest folded into \"Other\".",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/Part"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "type": {
          "const": "donut",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "parts"
      ],
      "title": "DonutPanel",
      "type": "object"
    },
    "FieldHints": {
      "additionalProperties": false,
      "description": "How one property is shown: its widget, a placeholder and help, all plain text.",
      "properties": {
        "help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help"
