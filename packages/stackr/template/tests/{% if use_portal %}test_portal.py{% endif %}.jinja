def test_a_persons_analytics_session_is_on_each_requests_server_span(
    script: Script, ui: Path, tmp_path: Path
) -> None:
    named = replace(
        with_portal(ui_dir=str(ui), **ANALYTICS),
        database_url=f"sqlite+aiosqlite:///{tmp_path / 'app.db'}",
    )
    exporter = InMemorySpanExporter()
    provider = TracerProvider()
    provider.add_span_processor(SimpleSpanProcessor(exporter))
    application = app(script, named)
    # As telemetry.instrument_app does, after the portal is mounted: the stamp runs inside it.
    FastAPIInstrumentor.instrument_app(application, tracer_provider=provider)
    try:
        with TestClient(application) as client:
            headers = bearer("alice")
            client.put("/portalr/v1/analytics/consent", json={"given": True}, headers=headers)
            signed = client.post("/portalr/v1/analytics/session", headers=headers).json()["session"]
            exporter.clear()
            stamped = {**headers, "x-portalr-analytics-session": signed}
            client.get("/", headers=stamped)
            client.get("/portalr/v1/analytics/consent", headers=stamped)
            # Another person's session, or none, is no stamp.
            client.get("/", headers={**bearer("bob"), "x-portalr-analytics-session": signed})
            client.get("/", headers=headers)
    finally:
        FastAPIInstrumentor.uninstrument_app(application)
    servers = [s for s in exporter.get_finished_spans() if s.kind.name == "SERVER"]
    nonce = signed.partition(".")[0]
    assert [(s.attributes or {}).get("portalr.analytics.session") for s in servers] == [
        nonce,
        nonce,
        None,
        None,
    ]


