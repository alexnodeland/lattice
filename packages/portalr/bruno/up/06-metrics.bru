meta {
  name: An owner's failed turns
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/portalr/v1/metrics?metric=failed_turns&start={{start}}&end={{end}}&step=300
  body: none
  auth: none
}

headers {
  x-user: alice
  x-tenant: acme
}

tests {
  // Each point counts the failed turns in the five minutes before it: the seed's samples are a
  // minute apart, and an increase needs two in its step.
  test("acme's failures, read through prom-label-proxy", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
    expect(res.body.data.some((point) => point.value > 0)).to.equal(true);
  });
}
