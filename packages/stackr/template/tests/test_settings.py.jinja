def test_an_empty_environment_gives_the_defaults() -> None:
    settings = Settings.from_environ({})
    assert settings == Settings()
    assert (settings.database_url, settings.telemetry, settings.langfuse) == (None, False, False)
    assert settings.gateway.guardrails == ("pii-mask", "prompt-injection")
{%- if access == 'grantr' %}
    assert settings.auth.service_role_key is None
{%- else %}
    assert settings.auth.tenant_claim == "app_metadata.tenant_id"
{%- endif %}


def test_every_setting_comes_from_its_variable() -> None:
    settings = Settings.from_environ(
        {
            "OTEL_SERVICE_NAME": "renamed",
            "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4318",
            "APP_ENVIRONMENT": "staging",
            "APP_HOST": "0.0.0.0",
            "APP_PORT": "9000",
            "DATABASE_URL": "postgresql+asyncpg://postgres:postgres@db:5432/postgres",
            "DATABASE_SCHEMA": "renamed_schema",
            "DATABASE_ADMIN_URL": "postgresql+asyncpg://owner:secret@db:5432/postgres",
            "AUTH_JWKS_URL": "http://auth/jwks.json",
            "AUTH_JWT_SECRET": "secret",
            "AUTH_AUDIENCE": "api",
            "AUTH_ISSUER": "http://auth",
{%- if access == 'grantr' %}
            "AUTH_SERVICE_ROLE_KEY": "service-role",
            "AUTH_ADMIN_URL": "http://gotrue:9999",
{%- else %}
            "AUTH_TENANT_CLAIM": "tenant",
{%- endif %}
            "LITELLM_BASE_URL": "http://litellm:4000",
            "LITELLM_API_KEY": "sk-default",
            "LITELLM_MODEL": "fast",
            "LITELLM_TENANT_KEYS": '{"acme": "sk-acme"}',
            "LITELLM_GUARDRAILS": "pii-mask, ",
            "LITELLM_MOCK_RESPONSE": "ok",
            "LITELLM_NO_OUTPUT_SECONDS": "45",
            "LITELLM_LOCAL_MODELS": "default, slow",
            "LANGFUSE_PUBLIC_KEY": "pk-lf-1",
{%- if use_tracker %}
            "TRACKER_CREDENTIALS": json.dumps({"acme": CREDENTIALS}),
            "TRACKER_BINDINGS": '{"acme/main": {"project": "ops", "labels": ["lattice"]}}',
            "TRACKER_BUDGET": "60",
{%- endif %}
        }
    )
    assert settings == Settings(
        service_name="renamed",
        environment="staging",
        host="0.0.0.0",
        port=9000,
        database_url="postgresql+asyncpg://postgres:postgres@db:5432/postgres",
        database_schema="renamed_schema",
        database_admin_url="postgresql+asyncpg://owner:secret@db:5432/postgres",
        auth=AuthSettings(
            jwks_url="http://auth/jwks.json",
            jwt_secret="secret",
            audience="api",
            issuer="http://auth",
{%- if access == 'grantr' %}
            service_role_key="service-role",
            admin_url="http://gotrue:9999",
{%- else %}
            tenant_claim="tenant",
{%- endif %}
        ),
        gateway=GatewaySettings(
            base_url="http://litellm:4000",
            api_key="sk-default",
            model="fast",
            tenant_keys={"acme": "sk-acme"},
            guardrails=("pii-mask",),
            mock_response="ok",
            no_output_seconds=45.0,
            local_models=("default", "slow"),
        ),
{%- if use_tracker %}
        tracker=TrackerSettings(
            credentials={"acme": TrackerCredentials.model_validate(CREDENTIALS)},
            bindings={
                WorkspaceKey("acme", "main"): TrackerBinding(project="ops", labels=("lattice",))
            },
            budget=60,
        ),
{%- endif %}
        telemetry=True,
        langfuse=True,
    )


def test_empty_variables_count_as_unset() -> None:
    settings = Settings.from_environ({"DATABASE_URL": "", "LITELLM_GUARDRAILS": ""})
    assert settings.database_url is None
    assert settings.gateway.guardrails == ("pii-mask", "prompt-injection")


def test_guardrails_can_be_turned_off() -> None:
    assert Settings.from_environ({"LITELLM_GUARDRAILS": "none"}).gateway.guardrails == ()


@pytest.mark.parametrize("seconds", ["soon", "0", "-5"])
def test_a_wait_must_be_a_positive_number_of_seconds(seconds: str) -> None:
    with pytest.raises(ValueError, match="LITELLM_NO_OUTPUT_SECONDS must be a number of seconds"):
        Settings.from_environ({"LITELLM_NO_OUTPUT_SECONDS": seconds})


@pytest.mark.parametrize("keys", ["not json", '["sk-acme"]'])
def test_tenant_keys_must_be_a_json_object(keys: str) -> None:
    with pytest.raises(ValueError, match="LITELLM_TENANT_KEYS"):
        Settings.from_environ({"LITELLM_TENANT_KEYS": keys})


@pytest.mark.parametrize("schema", ["Public", "has space", 'quote"d', ""])
def test_the_schema_must_be_a_plain_identifier(schema: str) -> None:
    with pytest.raises(ValueError, match="DATABASE_SCHEMA"):
        Settings(database_schema=schema)


def test_the_tables_owner_needs_the_role_the_app_works_as() -> None:
    with pytest.raises(ValueError, match="DATABASE_ADMIN_URL needs DATABASE_URL"):
        Settings(database_admin_url="postgresql+asyncpg://owner:secret@db/postgres")
{%- if use_tracker %}


@pytest.mark.parametrize(
    ("name", "value"),
    [
        ("TRACKER_CREDENTIALS", "not json"),
        ("TRACKER_CREDENTIALS", '["acme"]'),
        ("TRACKER_BINDINGS", '{"acme": {"project": "ops"}}'),
        ("TRACKER_BINDINGS", '{"acme/main": {"labels": []}}'),
    ],
)
def test_the_tracker_settings_must_be_json_objects_of_their_shape(name: str, value: str) -> None:
    with pytest.raises(ValueError, match=name):
        Settings.from_environ({name: value})


def test_a_tenants_credentials_are_never_quoted_when_they_are_wrong() -> None:
    wrong = {"acme": {"api_key": "a-secret-key", "webhook_secret": "a-secret"}}
    with pytest.raises(ValueError, match="TRACKER_CREDENTIALS of acme must have") as refused:
        Settings.from_environ({"TRACKER_CREDENTIALS": json.dumps(wrong)})
    assert "a-secret" not in str(refused.value)
    assert refused.value.__cause__ is None


{%- if tracker == 'plane' %}


def test_plane_credentials_name_the_tenants_workspace() -> None:
    nameless = {"acme": {**CREDENTIALS, "workspace": ""}}
    fields = "base_url, api_key, webhook_secret and workspace"
    with pytest.raises(ValueError, match=f"TRACKER_CREDENTIALS of acme must have {fields}"):
        Settings.from_environ({"TRACKER_CREDENTIALS": json.dumps(nameless)})
{%- endif %}


def test_a_bound_workspace_needs_its_tenants_credentials() -> None:
    with pytest.raises(ValueError, match="binds acme/main, and TRACKER_CREDENTIALS has none"):
        Settings.from_environ({"TRACKER_BINDINGS": '{"acme/main": {"project": "ops"}}'})
{%- endif %}
