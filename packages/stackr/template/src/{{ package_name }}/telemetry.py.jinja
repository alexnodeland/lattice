"""The telemetry port: OpenTelemetry to the Collector, and Langfuse for trace attributes and scores.

Telemetry is on when ``OTEL_EXPORTER_OTLP_ENDPOINT`` is set (stackr's Collector takes OTLP over
HTTP on port 4318), so the application and its tests run without the stack. Langfuse is on
when ``LANGFUSE_PUBLIC_KEY`` is set too.{% if libraries == 'both' %} artifactr's ``configure_telemetry`` sets up the
one handle both libraries use.{% endif %}

Traces reach Langfuse through the Collector, which sends it every trace (stackr's ADR-0007), so
the Langfuse client exports no spans of its own; it still sets each turn's and run's session,
user and tags on the spans, and sends feedback as scores.

FastAPI and HTTP clients are instrumented, the database driver is not: the libraries poll their
storage (the reactor, subscriptions, the feedback mirrors), and each poll's queries would be a
trace of its own, many a second. The libraries' own spans still time their commits and runs.
"""

from importlib.metadata import version

from opentelemetry.sdk.trace import ReadableSpan

from {% if use_artifactr %}artifactr{% else %}reflexr{% endif %}.otel import Instrumented, TelemetryHandle, configure_telemetry

from {{ package_name }}.settings import Settings

INSTRUMENTED: tuple[Instrumented, ...] = ("fastapi", "httpx")
"""The libraries the application's telemetry instruments."""


def configure(settings: Settings) -> TelemetryHandle | None:
    """Set up OpenTelemetry, and Langfuse, as the settings ask; or nothing."""
    if not settings.telemetry:
        return None
    return configure_telemetry(
        service_name=settings.service_name,
        service_version=version("{{ project_slug }}"),
        environment=settings.environment,
        instrument=INSTRUMENTED,
        langfuse=settings.langfuse,
        langfuse_options={"should_export_span": through_the_collector},
    )


def through_the_collector(span: ReadableSpan) -> bool:
    """Langfuse's span filter: none, since the Collector sends Langfuse every trace."""
    del span
    return False
