CRAFTS = {
{%- for name, craft in crafts.items() %}
    "{{ name }}": "{{ craft.version }}",
{%- endfor %}
}
"""The apps a worker runs, as ``FILES_CRAFTS`` names them, and the version each one's pin names."""

TOKEN = 32
"""The fewest characters a worker's token may have: ``make env``'s have 64."""
{%- if use_portal %}

EDITORS = { {%- for name, craft in crafts.items() if craft.editor %}"{{ name }}": {{ app_port + craft.editor }}{{ ", " if not loop.last }}{% endfor -%} }
"""The port each app's editor is published on, on this machine, for an app whose browser build
hands a file over, unless ``<APP>_EDITOR_PORT`` moves it: compose.yaml's ``files-<app>-editor``."""
