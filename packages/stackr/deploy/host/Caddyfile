# stackr's edge on a single host (RFC-0004): the application at app.<domain>, and GoTrue at
# auth.<domain>, each at its own root. CADDY_TLS is empty for certificates from Let's Encrypt,
# or `tls internal` for Caddy's own CA.
{
	servers {
		# HTTP/1.1 and HTTP/2 only: HTTP/3 would need 443/udp published and let through ufw.
		protocols h1 h2
	}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

app.{$STACKR_DOMAIN} {
	{$CADDY_TLS}
	import headers
	# The template's app service, in its app profile on the stackr network.
	reverse_proxy app:8000
}

auth.{$STACKR_DOMAIN} {
	{$CADDY_TLS}
	import headers
	# GoTrue's admin API is for the application's admin commands, on the private network.
	handle /admin/* {
		respond 404
	}
	# supabase-js, in portalr's UIs, reaches Supabase Auth at <url>/auth/v1; GoTrue alone serves at
	# its root. The same refusal of the admin API holds under the prefix.
	handle_path /auth/v1/* {
		handle /admin/* {
			respond 404
		}
		reverse_proxy gotrue:9999
	}
	# Caddy replaces X-Forwarded-For from clients with their address, which GoTrue's per-address
	# rate limits read (GOTRUE_RATE_LIMIT_HEADER).
	reverse_proxy gotrue:9999
}
