    ("email", "said"),
    [("erin@example.com", "Password should be at least 6 characters."), ("broken@x.com", "500")],
)
async def test_an_account_supabase_refuses_says_why(
    config: Settings, email: str, said: str
) -> None:
    with pytest.raises(Invalid, match="Supabase Auth refused the account") as refused:
        await run(["first-run", email], config, password=lambda: "short")
    assert str(refused.value).endswith(said)
    assert "short" not in str(refused.value), "never what it was sent"


