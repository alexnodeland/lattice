      ],
      "title": "FormPanel",
      "type": "object"
    },
    "FormRequest": {
      "additionalProperties": false,
      "description": "What ``ask_form`` asks: the arguments its paused request carries, as portalr reads them.\n\nThe request's ``args`` hold these as the model called the tool; the tool checked them before\nthe run paused, and the answer is checked against ``schema``.",
      "properties": {
        "schema": {
          "$ref": "#/$defs/FormSchema"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "schema"
      ],
      "title": "FormRequest",
      "type": "object"
    },
    "FormSchema": {
      "additionalProperties": false,
      "description": "A form: a JSON Schema 2020-12 object in the subset, compiled once to check values.\n\nValidating one refuses, by name, every keyword outside the subset, a property the subset\ndoesn't hold, more than :data:`MAX_PROPERTIES` properties, a name outside the pattern, a\n``required`` name that isn't a property, a ``default`` its property doesn't take, and bounds\nno value meets. ``additionalProperties`` is false, written or not. A form with no\nproperties is a button. Its size counts towards its form's, :data:`MAX_SCHEMA_BYTES`.",
      "properties": {
        "additionalProperties": {
          "const": false,
          "default": false,
          "title": "Additionalproperties",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "properties": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/StringProperty"
              },
              {
                "$ref": "#/$defs/ChoiceProperty"
              },
              {
                "$ref": "#/$defs/NumberProperty"
              },
              {
                "$ref": "#/$defs/BooleanProperty"
              },
              {
                "$ref": "#/$defs/ArrayProperty"
              }
            ]
          },
          "default": {},
          "maxProperties": 50,
          "title": "Properties",
          "type": "object"
        },
        "required": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "additionalProperties"
      ],
      "title": "FormSchema",
      "type": "object"
    },
    "JsonValue": {},
