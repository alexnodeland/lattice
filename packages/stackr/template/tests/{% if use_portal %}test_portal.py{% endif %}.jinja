def test_make_env_generates_each_secret_marked_so(tmp_path: Path) -> None:
    (tmp_path / ".env.example").write_text(
        "PORTAL_ANALYTICS_KEY=generate:hex\nS3_KEY_2=generate:hex\nPLAIN=kept\n"
    )
    subprocess.run(["make", "-s", "-f", str(MAKEFILE), "-C", str(tmp_path), "env"], check=True)
    made = dict(line.split("=", 1) for line in (tmp_path / ".env").read_text().splitlines())
    assert re.fullmatch(r"[0-9a-f]{64}", made["PORTAL_ANALYTICS_KEY"])
    assert re.fullmatch(r"[0-9a-f]{64}", made["S3_KEY_2"])
    assert made["PORTAL_ANALYTICS_KEY"] != made["S3_KEY_2"]
    assert made["PLAIN"] == "kept"


def test_a_deletion_owed_is_done_as_the_application_starts_again(
    script: Script,
    ui: Path,
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    caplog: pytest.LogCaptureFixture,
) -> None:
    named = replace(
        with_portal(ui_dir=str(ui), **{**ANALYTICS, "analytics_url": "http://127.0.0.1:9"}),
        database_url=f"sqlite+aiosqlite:///{tmp_path / 'app.db'}",
    )
    with TestClient(app(script, named)) as client:
        headers = bearer("alice")
        client.put("/portalr/v1/analytics/consent", json={"given": True}, headers=headers)
        said = client.put("/portalr/v1/analytics/consent", json={"given": False}, headers=headers)
        assert said.json() == {"given": False, "deleted": False}, "ClickHouse isn't there"

    async def forgotten(*_: object) -> bool:
        return True

    monkeypatch.setattr(Analytics, "forget", forgotten)
    with caplog.at_level(logging.INFO), TestClient(app(script, named)) as client:
        # The deletions owed are done beside the start: by the time a request is answered.
        for _ in range(50):
            if "deleted the events of 1 people owed it" in caplog.text:
                break
            client.get("/healthz")
            time.sleep(0.01)
    assert "deleted the events of 1 people owed it" in caplog.text


def test_a_pass_that_fails_is_logged_and_the_application_still_stops(
    script: Script,
    ui: Path,
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    caplog: pytest.LogCaptureFixture,
) -> None:
    async def unreadable(*_: object, **__: object) -> int:
        raise RuntimeError("the database went away")

    monkeypatch.setattr(Relay, "settle_owed", unreadable)
    named = replace(
        with_portal(ui_dir=str(ui), **ANALYTICS),
        database_url=f"sqlite+aiosqlite:///{tmp_path / 'app.db'}",
    )
    with caplog.at_level(logging.ERROR), TestClient(app(script, named)) as client:
        for _ in range(50):
            if "the deletions owed weren't read" in caplog.text:
                break
            client.get("/healthz")
            time.sleep(0.01)
    assert "the deletions owed weren't read" in caplog.text
