{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "moonrepo": true,
  "ignoreBinaries": ["noop", "uv"],
  "ignoreDependencies": ["@usebruno/cli"],
  "workspaces": {
    "packages/portalr/web/notices": {
      "entry": ["scripts/*.ts"]
    },
    "packages/portalr/web/app": {
      "entry": ["bdd/steps/*.ts"]
    },
    "packages/portalr/web/admin": {
      "entry": ["bdd/steps/*.ts"]
    },
    "packages/portalr/web/ui": {
      "entry": ["csp/main.tsx", "csp/vite.config.ts"]
    }
  }
}
