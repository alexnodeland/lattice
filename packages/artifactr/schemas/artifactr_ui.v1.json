      "title": "BooleanProperty",
      "type": "object"
    },
    "ChartPanel": {
      "additionalProperties": false,
      "description": "A bar or line chart: rows indexed by ``index``, and up to :data:`MAX_SERIES` series.",
      "properties": {
        "index": {
          "$ref": "#/$defs/Key"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/Key"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Series",
          "type": "array"
