#!/usr/bin/env bash
# The instance role's temporary credentials, from IMDSv2, for the state host's ClickHouse backups
# (ADR-0037). It runs on the host's own network, the one hop IMDS answers: the services'
# containers can't reach IMDS, so ClickHouse is handed these per backup, not given the role.
#
# Usage: imds-credentials          prints four lines: the access key id, the secret, the token, and
#                                  when they expire, in seconds since the epoch
#   IMDS_ENDPOINT                  http://169.254.169.254 unless a test stands in for IMDS

set -euo pipefail
endpoint=${IMDS_ENDPOINT:-http://169.254.169.254}
fetch() { curl --silent --show-error --fail --max-time 5 "$@"; }
# The session token goes in a header read from a process substitution, not in curl's arguments.

token=$(fetch --request PUT --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' "$endpoint/latest/api/token")
get() {
  fetch --header @<(printf 'X-aws-ec2-metadata-token: %s\n' "$token") \
    "$endpoint/latest/meta-data/iam/security-credentials/$1"
}
roles=$(get "")
role=${roles%%$'\n'*}
[[ -n $role ]] || { echo "imds-credentials: the instance has no role" >&2; exit 1; }
credentials=$(get "$role")
jq --exit-status --raw-output '
  select(.Code == "Success") | .AccessKeyId, .SecretAccessKey, .Token, (.Expiration | fromdateiso8601)' <<<"$credentials" ||
  { echo "imds-credentials: IMDS didn't return credentials for $role" >&2; exit 1; }
