    database = tmp_path / "app.db"
    named = replace(
        with_portal(ui_dir=str(ui), **ANALYTICS), database_url=f"sqlite+aiosqlite:///{database}"
    )
    grants = seeded()
    with TestClient(app(script, named, grants=grants)) as client:
        remove = functools.partial(
            grants.remove_member, TENANT, User(id="bob"), by=User(id="alice")
        )
        # On the application's own loop, where its database engine runs.
        assert client.portal is not None
        client.portal.call(remove)
    # No ClickHouse answers here, so the deletion is owed, to be tried again (portalr ADR-0075).
    with sqlite3.connect(database) as connection:
        owed = connection.execute(
            "SELECT user_id, tenant_id FROM portalr_analytics_removals_owed"
        ).fetchall()
    assert owed == [("bob", TENANT)]


