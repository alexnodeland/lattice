{
  "uid": "artifactr-workspace",
  "title": "artifactr / Workspace",
  "description": "One workspace: commands, changes, turns, tools and feedback.",
  "tags": [
    "artifactr"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "artifactr dashboards",
      "type": "dashboards",
      "tags": [
        "artifactr"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total, job)",
          "refId": "job"
        },
        "definition": "label_values(artifactr_commands_total, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total{job=~\"$job\"}, artifactr_tenant_id)",
          "refId": "tenant"
        },
        "definition": "label_values(artifactr_commands_total{job=~\"$job\"}, artifactr_tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}, artifactr_workspace_id)",
          "refId": "workspace"
        },
        "definition": "label_values(artifactr_commands_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}, artifactr_workspace_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Commands by type",
      "description": "Commands committed per second, by type.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_command_type) (rate(artifactr_commands_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_workspace_id=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_command_type}}",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rejections",
      "description": "Commands the rules rejected, by reason, such as version conflicts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_rejection) (rate(artifactr_commands_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_workspace_id=~\"$workspace\", artifactr_outcome=\"rejected\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_rejection}}",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Artifact changes",
      "description": "Artifacts created, changed and archived, by kind and by who.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_artifact_kind, artifactr_actor_kind) (rate(artifactr_artifact_changes_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_workspace_id=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_artifact_kind}} by {{artifactr_actor_kind}}",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Turns by outcome",
      "description": "Completed, paused, stopped and failed turns.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_turn_outcome) (rate(artifactr_turns_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_workspace_id=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_turn_outcome}}",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tool calls",
      "description": "The agent's tool calls, by tool and how they ended.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_tool_name, artifactr_tool_status) (rate(artifactr_tool_calls_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_workspace_id=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_tool_name}} {{artifactr_tool_status}}",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Feedback",
      "description": "Feedback given, by type and by people or evaluators.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_feedback_type, artifactr_actor_kind) (rate(artifactr_feedback_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_workspace_id=~\"$workspace\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_feedback_type}} by {{artifactr_actor_kind}}",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
