meta {
  name: metrics, with prom-label-proxy down
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/portalr/v1/metrics?metric=turn_latency&start={{start}}&end={{end}}
  body: none
  auth: none
}

headers {
  x-user: alice
  x-tenant: acme
}

tests {
  test("unavailable, and nothing else fails", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("unavailable");
  });
}
