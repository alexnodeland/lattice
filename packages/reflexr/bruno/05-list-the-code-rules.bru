meta {
  name: List the code rules
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/rules
  body: none
  auth: none
}

tests {
  test("oncall's rules", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map((r) => r.name)).to.include.members(["oncall:triage", "oncall:runbook", "oncall:silence"]);
  });
}
