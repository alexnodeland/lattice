        "widget": {
          "anyOf": [
            {
              "enum": [
                "textarea",
                "select",
                "checkbox"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Widget"
        }
      },
      "required": [],
      "title": "FieldHints",
      "type": "object"
    },
    "Form": {
      "additionalProperties": false,
      "description": "A form that takes submissions without a run waiting.\n\nIt is for a poll, a sign-up, or a form that outlives its run. A submission names the version\nit was made against; an edit of the form makes a new one, so a submission made against an\nearlier one is refused as changed. Only its author, or whom the application's ``is_admin``\nallows, changes its ``schema`` or ``closed``.",
      "properties": {
        "closed": {
          "default": false,
          "title": "Closed",
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/$defs/FormSchema"
        },
        "submissions": {
          "default": "once",
          "enum": [
            "once",
            "per_person",
            "many"
          ],
          "title": "Submissions",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "schema"
      ],
      "title": "Form",
      "type": "object"
    },
    "FormPanel": {
      "additionalProperties": false,
      "description": "A form artifact, by its id, shown to submit in place: a form with no fields is a button.",
      "properties": {
        "form_id": {
          "$ref": "#/$defs/ArtifactId"
