#!/bin/sh
# Umami's accounts and website, on every start (stackr ADR-0050): idempotent, as umami-init runs
# it after Umami is up. Umami starts with an admin whose password is `umami`; this gives it
# UMAMI_ADMIN_PASSWORD, makes portalr's user, and the website portalr's relay sends to, owned by
# portalr's user, with the fixed id UMAMI_WEBSITE_ID, so portalr may delete a person's sessions in
# it. Passwords come from the environment and are sent in bodies, never in a command line or URL.
set -eu
url=${UMAMI_URL:-http://umami:3000}

# A JSON field's string value, from an answer Umami gave.
field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }

# POST a body read from standard input, as a user's token, if given; print the answer.
post() {
  if [ -n "${2:-}" ]; then
    curl -fsS -X POST "$url$1" -H 'Content-Type: application/json' -H "Authorization: Bearer $2" --data-binary @-
  else
    curl -fsS -X POST "$url$1" -H 'Content-Type: application/json' --data-binary @-
  fi
}

login() {
  printf '{"username":"%s","password":"%s"}' "$1" "$2" | post /api/auth/login 2>/dev/null | field token
}

for _ in $(seq 60); do
  curl -fsS -o /dev/null "$url/api/heartbeat" && break
  sleep 2
done

admin=$(login admin "$UMAMI_ADMIN_PASSWORD" || true)
if [ -z "$admin" ]; then
  first=$(login admin umami || true)
  [ -n "$first" ] || { echo "umami-init: the admin's password is neither UMAMI_ADMIN_PASSWORD nor Umami's first" >&2; exit 1; }
  printf '{"currentPassword":"umami","newPassword":"%s"}' "$UMAMI_ADMIN_PASSWORD" | post /api/me/password "$first" >/dev/null
  admin=$(login admin "$UMAMI_ADMIN_PASSWORD")
  echo "umami-init: the admin's password is UMAMI_ADMIN_PASSWORD"
fi

portalr=$(login portalr "$UMAMI_PORTALR_PASSWORD" || true)
if [ -z "$portalr" ]; then
  printf '{"username":"portalr","password":"%s","role":"user"}' "$UMAMI_PORTALR_PASSWORD" | post /api/users "$admin" >/dev/null
  portalr=$(login portalr "$UMAMI_PORTALR_PASSWORD")
  echo "umami-init: made portalr's user"
fi

if ! curl -fsS -o /dev/null -H "Authorization: Bearer $portalr" "$url/api/websites/$UMAMI_WEBSITE_ID" 2>/dev/null; then
  printf '{"id":"%s","name":"portalr","domain":"portalr.internal"}' "$UMAMI_WEBSITE_ID" | post /api/websites "$portalr" >/dev/null
  echo "umami-init: made portalr's website, $UMAMI_WEBSITE_ID"
fi
echo "umami-init: ready"
