        "type": {
          "enum": [
            "bar",
            "line"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "index",
        "series",
        "rows"
      ],
      "title": "ChartPanel",
      "type": "object"
    },
    "Choice": {
      "additionalProperties": false,
