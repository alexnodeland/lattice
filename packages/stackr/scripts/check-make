#!/usr/bin/env bash
# Check what `make up` refuses, and the gateway's model groups' check, without starting anything:
# scripts/binding-probe against a fake `docker` for each shape an engine publishes in, the
# STACKR_GATEWAY_MODELS guard, the umami profile's adapter (ADR-0050), what scripts/wire-app
# writes for a made-up stack and application, and scripts/check-config's hold on deploy/litellm/groups/
# (ADR-0045). scripts/validate runs it.

set -euo pipefail
cd "$(dirname "$0")/.."
status=0
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

check() {
  local what=$1
  shift
  if "$@"; then echo "ok: $what"; else echo "FAIL: $what"; status=1; fi
}
refused() { ! "$@" >"$scratch/out" 2>&1; }
said() { grep -qF "$1" "$scratch/out"; }

# A docker that runs the probe, or fails to (FAKE_RUN=fail), and says it published at FAKE_PORTS.
mkdir "$scratch/bin"
cat >"$scratch/bin/docker" <<'FAKE'
#!/usr/bin/env bash
case $1 in
  run) [[ ${FAKE_RUN:-} != fail ]] ;;
  inspect) printf '%b\n' "$FAKE_PORTS" ;;
esac
FAKE
chmod +x "$scratch/bin/docker"
probe() { PATH="$scratch/bin:$PATH" FAKE_PORTS=$1 FAKE_RUN=${2:-} scripts/binding-probe net 127.0.0.1; }

check "the probe passes a port published at STACKR_BIND alone" probe '127.0.0.1'
check "the probe refuses every interface, as Docker Desktop 29 publishes" refused probe '0.0.0.0\n::'
check "and says there is no override, and the postgres adapter" said "no setting to start it anyway"
check "the probe refuses STACKR_BIND with every IPv6 interface beside it" refused probe '127.0.0.1\n::'
check "the probe refuses a port published nowhere, and says so" refused probe ''
check "and says where" said "Docker publishes on net at nothing"
check "the probe refuses, closed, when it can't run" refused probe '' fail
check "and says why" said "Couldn't run the probe"

check "make refuses a STACKR_GATEWAY_MODELS that isn't providers or upstream" \
  refused make --no-print-directory -n up STACKR_GATEWAY_MODELS=elsewhere
check "and names it" said "STACKR_GATEWAY_MODELS must be providers or upstream"
quietly() { "$@" >/dev/null 2>&1; }
check "make refuses upstream without its address and models" \
  refused make --no-print-directory -n help STACKR_GATEWAY_MODELS=upstream STACKR_UPSTREAM_URL=
check "and names them" said "needs STACKR_UPSTREAM_URL STACKR_UPSTREAM_DEFAULT_MODEL STACKR_UPSTREAM_FAST_MODEL"
check "make takes upstream with them" quietly make --no-print-directory -n help \
  STACKR_GATEWAY_MODELS=upstream STACKR_UPSTREAM_URL=http://gateway/v1 \
  STACKR_UPSTREAM_DEFAULT_MODEL=big STACKR_UPSTREAM_FAST_MODEL=small

check "make refuses the umami profile beside local Supabase" \
  refused make --no-print-directory -n up STACKR_DATABASE=supabase PROFILES=umami
check "and says why" said "the umami profile is for the postgres adapter"
make --no-print-directory -n up STACKR_DATABASE=postgres PROFILES=umami >"$scratch/out" 2>&1 || true
check "make starts plain PostgreSQL with the umami profile alone" said "profile postgres"

# make up refuses a stackr-umami that isn't internal: a docker that says the network exists,
# and isn't (FAKE_INTERNAL), and fails anything else.
cat >"$scratch/bin/docker" <<'FAKE'
#!/usr/bin/env bash
if [[ $1 == network && $2 == inspect && $* == *Internal* ]]; then echo "$FAKE_INTERNAL"; exit 0; fi
exit 1
FAKE
check "make up refuses a stackr-umami that isn't internal" \
  refused env PATH="$scratch/bin:$PATH" FAKE_INTERNAL=false make --no-print-directory up STACKR_DATABASE=postgres PROFILES=umami
check "and says how to fix it" said "stackr-umami isn't internal"

# make up pulls the pinned images first, trying again after a registry's error: a docker whose
# networks are as make wants them, whose `compose pull` fails until try FAKE_PULL_OK, and whose
# `compose up` passes, and a `sleep` that doesn't. It counts its pulls in $scratch/pulls.
cat >"$scratch/bin/docker" <<'FAKE'
#!/usr/bin/env bash
if [[ $1 == network && $2 == inspect ]]; then
  if [[ $* == *Internal* ]]; then echo true; else echo 127.0.0.1; fi
  exit 0
fi
if [[ $1 == compose && $* == *" pull "* ]]; then
  echo pull >>"$FAKE_PULLS"
  (($(grep -c "^pull" "$FAKE_PULLS") >= FAKE_PULL_OK))
  exit
fi
[[ $1 == compose ]]
FAKE
cat >"$scratch/bin/sleep" <<'FAKE'
#!/bin/sh
echo "slept $1" >>"$FAKE_PULLS"
FAKE
chmod +x "$scratch/bin/sleep"
pulls() {
  rm -f "$scratch/pulls"
  env PATH="$scratch/bin:$PATH" FAKE_PULLS="$scratch/pulls" FAKE_PULL_OK="$1" \
    make --no-print-directory up STACKR_DATABASE=postgres PROFILES=observability
}
check "make up pulls again after two failed pulls, and starts the stack" quietly pulls 3
check "having waited 20s, then 40s" grep -qzF $'pull\nslept 20\npull\nslept 40\npull\n' "$scratch/pulls"
check "make up stops after three failed pulls" refused pulls 4
check "and says so" said "the stack's images didn't pull, after 3 tries"

# scripts/wire-app on a made-up stack and application: what it sets, by the adapter, one line a
# key, mode 0600, the same again on a second run, never a secret on its output, and the settings
# the smoke test gives it on stdin over the rest.
mkdir -p "$scratch/wire/stack" "$scratch/wire/app"
cp .env.example "$scratch/wire/stack/"
echo STACKR_DATABASE=postgres >"$scratch/wire/stack/.env"
uv run scripts/setup-env --example "$scratch/wire/stack/.env.example" --env-file "$scratch/wire/stack/.env" 2>/dev/null
printf '[project]\nname = "demo-app"\n' >"$scratch/wire/app/pyproject.toml"
printf '# the app\nAPP_PORT=8800\nLITELLM_API_KEY=\nAPP_PORT=9900\nPORTAL_SUPABASE_KEY=\n' >"$scratch/wire/app/.env"
wire() { uv run scripts/wire-app "$scratch/wire/app" --stack "$scratch/wire/stack" --stdin "$@" >"$scratch/wired" 2>&1; }
app_setting() { sed -n "s/^$1=//p" "$scratch/wire/app/.env"; }
stack_setting() { sed -n "s/^$1=//p" "$scratch/wire/stack/.env"; }
mode() { uv run python -c 'import os, sys; print(oct(os.stat(sys.argv[1]).st_mode & 0o777))' "$1"; }
staged() { find "$scratch/wire/app" -name '.env.*' | grep -q .; }
printf 'LITELLM_API_KEY=sk-made-up\nAPP_PORT=8801\n' | wire --analytics --umami --langfuse-project
check "wire-app writes .env mode 0600" test "$(mode "$scratch/wire/app/.env")" = 0o600
check "and leaves no file of its own beside it" refused staged
check "and sets each key once" test -z "$(sed -n 's/^\([A-Z_]*\)=.*/\1/p' "$scratch/wire/app/.env" | sort | uniq -d)"
check "on its line, where it was" test "$(sed -n 2p "$scratch/wire/app/.env")" = APP_PORT=8801
check "with what stdin gives it over the rest" test "$(app_setting LITELLM_API_KEY)" = sk-made-up
check "and prints no secret" refused grep -qF -e sk-made-up -e "$(stack_setting LANGFUSE_SECRET_KEY)" "$scratch/wired"
check "GoTrue's addresses, on the postgres adapter" test "$(app_setting STACK_AUTH_JWKS_URL) $(app_setting STACK_AUTH_ADMIN_URL) $(app_setting AUTH_ISSUER)" = \
  "http://gotrue:9999/.well-known/jwks.json http://gotrue:9999 $(stack_setting AUTH_PUBLIC_URL)"
check "and the database and GoTrue as this machine reaches them, for the local commands" test \
  "$(app_setting DATABASE_ADMIN_URL) $(app_setting AUTH_ADMIN_URL)" = \
  "postgresql+asyncpg://postgres:$(stack_setting POSTGRES_ADMIN_PASSWORD)@127.0.0.1:$(stack_setting POSTGRES_PORT)/postgres http://127.0.0.1:$(stack_setting AUTH_PORT)"
check "the application's role, the same on both" test \
  "$(app_setting DATABASE_URL | sed 's/@.*//')" = "$(app_setting STACK_DATABASE_URL | sed 's/@.*//')"
check "a placeholder for the publishable key GoTrue asks none for" test "$(app_setting PORTAL_SUPABASE_KEY)" = sb_publishable_local
check "plain PostgreSQL, as its owner" grep -qE \
  "^STACK_DATABASE_ADMIN_URL=postgresql\+asyncpg://postgres:$(stack_setting POSTGRES_ADMIN_PASSWORD)@postgres:5432/postgres$" "$scratch/wire/app/.env"
check "the analytics and Umami passwords, and ClickHouse on the loopback, asked for" test \
  "$(app_setting PORTAL_ANALYTICS_PASSWORD) $(app_setting PORTAL_UMAMI_PASSWORD) $(app_setting PORTAL_ANALYTICS_URL)" = \
  "$(stack_setting CLICKHOUSE_ANALYTICS_PASSWORD) $(stack_setting UMAMI_PORTALR_PASSWORD) http://127.0.0.1:$(stack_setting CLICKHOUSE_HTTP_PORT)"
check "and Langfuse's project, asked for" test "$(app_setting PORTAL_LANGFUSE_PROJECT)" = "$(stack_setting LANGFUSE_INIT_PROJECT_ID)"
printf '' | AUTH_PUBLIC_URL=https://auth.example.test wire
check "a setting in the environment over the stack's .env, as Compose reads it" test "$(app_setting AUTH_ISSUER)" = https://auth.example.test
printf '' | wire
cp "$scratch/wire/app/.env" "$scratch/wire/first"
printf 'LITELLM_API_KEY=sk-made-up\nAPP_PORT=8801\n' | wire --analytics --umami --langfuse-project
check "and runs again to the same file, keeping the role's password" cmp -s "$scratch/wire/first" "$scratch/wire/app/.env"
printf 'AUTH_ISSUER=http://127.0.0.1:54321/auth/v1\nAUTH_SERVICE_ROLE_KEY=made-up\n' | STACKR_DATABASE=supabase wire
check "on local Supabase: its database and owner, and GoTrue's addresses emptied" test \
  "$(app_setting STACK_DATABASE_ADMIN_URL) $(app_setting STACK_AUTH_JWKS_URL)x$(app_setting STACK_AUTH_ADMIN_URL)x $(app_setting AUTH_SERVICE_ROLE_KEY)" = \
  "postgresql+asyncpg://postgres:postgres@supabase_db_stackr-supabase:5432/postgres xx made-up"
check "and Langfuse's keys, as the smoke test set them" test "$(app_setting LANGFUSE_PUBLIC_KEY) $(app_setting LANGFUSE_SECRET_KEY)" = \
  "$(stack_setting LANGFUSE_PUBLIC_KEY) $(stack_setting LANGFUSE_SECRET_KEY)"
printf 'STACK_DATABASE_URL=postgresql+asyncpg://given:pw@db:5432/postgres\n' |
  STACKR_DB_HOST=db STACKR_DB_ADMIN_PASSWORD='p@ss/word' wire
check "the database's host and owner, as make names them, the password quoted" test "$(app_setting STACK_DATABASE_ADMIN_URL)" = \
  "postgresql+asyncpg://postgres:p%40ss%2Fword@db:5432/postgres"
check "and the application's role, as stdin gives it" test "$(app_setting STACK_DATABASE_URL)" = "postgresql+asyncpg://given:pw@db:5432/postgres"
cp "$scratch/wire/app/.env" "$scratch/wire/first"
dollar() { printf 'LITELLM_API_KEY=a%sb\n' '$' | wire; }
check "wire-app refuses a value with \$ in it" refused dollar
check "and changes nothing" cmp -s "$scratch/wire/first" "$scratch/wire/app/.env"
sed -i.bak 's/^LANGFUSE_SECRET_KEY=.*/LANGFUSE_SECRET_KEY=/' "$scratch/wire/stack/.env"
check "wire-app refuses a stack whose secrets make env hasn't made" refused uv run scripts/wire-app "$scratch/wire/app" --stack "$scratch/wire/stack"
check "and says so" said "run \`make env\` in stackr first"
mv "$scratch/wire/stack/.env.bak" "$scratch/wire/stack/.env"
check "wire-app refuses an application with no .env" refused uv run scripts/wire-app "$scratch/wire" --stack "$scratch/wire/stack"
check "and says to make it" said "run \`make env\`"

# check-config on a copy whose config.yaml includes no groups, or whose groups lack `fast`.
copy() {
  rm -rf "$scratch/stack" && mkdir -p "$scratch/stack/scripts" "$scratch/stack/deploy"
  cp scripts/check-config "$scratch/stack/scripts/" && cp compose.yaml "$scratch/stack/"
  cp -R deploy/litellm "$scratch/stack/deploy/"
}
copy && sed -i.bak '/^include:/,/groups.yaml/d' "$scratch/stack/deploy/litellm/config.yaml"
check "check-config refuses a config.yaml that includes no groups" \
  refused uv run "$scratch/stack/scripts/check-config" litellm
copy && sed -i.bak 's/model_name: fast/model_name: quick/' "$scratch/stack/deploy/litellm/groups/upstream.yaml"
check "check-config refuses groups without fast" refused uv run "$scratch/stack/scripts/check-config" litellm
check "and names the file" said "groups/upstream.yaml doesn't define both default and fast"
copy
check "check-config passes the groups as they are" uv run "$scratch/stack/scripts/check-config" litellm

# check-config aws on a copy of the AWS recipe that names Umami, which it must not run (ADR-0050).
copy && cp -R deploy/aws deploy/host deploy/prometheus "$scratch/stack/deploy/"
echo '# umami: http://umami:3000' >>"$scratch/stack/deploy/aws/modules/stack/locals.tf"
check "check-config refuses the AWS recipe with Umami in it" \
  refused uv run "$scratch/stack/scripts/check-config" aws
check "and names the file" said "deploy/aws/modules/stack/locals.tf names Umami"

exit $status
