[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
{%- if use_artifactr %}
    "artifactr-ai[sql,postgres,fastapi,mcp,otel,langfuse,litellm]",
{%- endif %}
{%- if use_reflexr %}
    "reflexr[sql,postgres,fastapi,mcp,otel,langfuse,litellm{% if evals %},evals{% endif %}]",
{%- endif %}
{%- if evals %}
    "evalr[langfuse]",
{%- endif %}
    "pyjwt[crypto]>=2.10",
    "uvicorn[standard]>=0.54",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.app:main"

[dependency-groups]
test = [
    "pytest>=9.1",
    "pytest-asyncio>=1.4",
    "pytest-cov>=7.1",
    "httpx>=0.28",
    "aiosqlite>=0.22",
]
lint = ["ruff>=0.16", "pyright>=1.1.414"]
dev = [
    { include-group = "test" },
    { include-group = "lint" },
    "pre-commit>=4.6",
]

[build-system]
requires = ["uv_build>=0.12,<0.13"]
build-backend = "uv_build"

# The libraries are not on PyPI: each comes from its repository, pinned to a commit. To move to
# a newer one, change its rev here (or answer again with `copier update`), then `uv lock`.
[tool.uv.sources]
{%- if use_artifactr %}
artifactr-ai = { git = "https://github.com/alexnodeland/artifactr", rev = "{{ artifactr_rev }}" }
{%- endif %}
{%- if use_reflexr %}
reflexr = { git = "https://github.com/alexnodeland/reflexr", rev = "{{ reflexr_rev }}" }
{%- endif %}
{%- if evals %}
evalr = { git = "https://github.com/alexnodeland/evalr", rev = "{{ evalr_rev }}" }
{%- endif %}

# ─── lint and format ──────────────────────────────────────────────────────────

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.format]
docstring-code-format = true

[tool.ruff.lint]
select = [
    "E", "W", "F", "I", "N", "D", "UP", "B", "SIM", "RUF", "C4", "PIE", "RET",
    "PT", "ASYNC", "PERF", "ARG", "T20", "ERA",
]
ignore = [
    "D105", # magic methods document themselves
    "D107", # __init__ is documented on the class
    "N818", # exceptions are named for what happened (Unauthenticated), not with an Error suffix
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"{% if evals %}, "evals"{% endif %}]
# The libraries' adapters share their names with the libraries they adapt.
known-third-party = ["fastapi", "mcp", "langfuse"]
# The family's libraries get a section of their own, after the other third-party ones.
section-order = ["future", "standard-library", "third-party", "family", "first-party", "local-folder"]

[tool.ruff.lint.isort.sections]
family = ["artifactr", "reflexr", "evalr"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["D", "ARG"]
{%- if evals %}
# The experiments print their results: they are a command.
"evals/**" = ["T20"]
{%- endif %}

# ─── types ────────────────────────────────────────────────────────────────────

[tool.pyright]
include = ["src", "tests"{% if evals %}, "evals"{% endif %}]
strict = ["src"{% if evals %}, "evals"{% endif %}]
typeCheckingMode = "standard"
pythonVersion = "{{ python_version }}"
venvPath = "."
venv = ".venv"

# ─── tests and coverage ───────────────────────────────────────────────────────

[tool.pytest.ini_options]
testpaths = ["tests"]
{%- if evals %}
# The evals/ directory is importable from the project's root.
pythonpath = ["."]
{%- endif %}
addopts = ["--strict-markers", "--strict-config", "-ra"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
filterwarnings = [
    "error",
    # backoff, which Langfuse uses, calls asyncio.iscoroutinefunction, deprecated in Python 3.14.
    "ignore:'asyncio.iscoroutinefunction' is deprecated:DeprecationWarning:backoff",
]

[tool.coverage.run]
branch = true
source = ["src/{{ package_name }}"{% if evals %}, "evals"{% endif %}]

[tool.coverage.report]
fail_under = 100
show_missing = true
skip_covered = true
exclude_also = [
    "if TYPE_CHECKING:",
    "^\\s*\\.\\.\\.$",
    "class .*\\(Protocol.*\\):",
]
