def build(tmp_path: Path) -> Path:
    """A browser build's directory, as small as one can be."""
    (tmp_path / "index.html").write_text("<!doctype html><title>GridCraft</title>")
    return tmp_path


def test_an_editor_serves_the_build_and_lattices_shim(tmp_path: Path) -> None:
    from {{ package_name }}.editor import editor_from_environment

    environ = {
        "EDITOR_APP": "gridcraft",
        "EDITOR_BUILD": str(build(tmp_path)),
        "PORTAL_URL": "http://127.0.0.1:{{ app_port }}",
    }
    with TestClient(editor_from_environment(environ)) as client:
        page = client.get("/")
        shim = client.get("/.lattice/shim.html")
    assert page.status_code == shim.status_code == 200
    assert "frame-ancestors" in page.headers["content-security-policy"]


def test_the_editors_module_serves_it(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    served: list[tuple[str, int]] = []

    def run(_app: Any, *, host: str, port: int) -> None:
        served.append((host, port))

    monkeypatch.setattr(uvicorn, "run", run)
    monkeypatch.setenv("EDITOR_APP", "gridcraft")
    monkeypatch.setenv("EDITOR_BUILD", str(build(tmp_path)))
    monkeypatch.setenv("PORTAL_URL", "http://127.0.0.1:{{ app_port }}")
    monkeypatch.delitem(sys.modules, "{{ package_name }}.editor", raising=False)
    runpy.run_module("{{ package_name }}.editor", run_name="__main__")
    assert served == [("0.0.0.0", 8000)]
