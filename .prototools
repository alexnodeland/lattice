# The tools CI installs through .github/actions/toolchain, and proto installs anywhere else
# (`proto use`). Renovate's proto manager keeps them current, proto itself among them; a bump of
# proto also needs its digests in .github/actions/toolchain/proto.sha256.
proto = "0.63.1"
bun = "1.4.3"
moon = "2.5.6"
uv = "0.12.12"
# stackr's AWS recipe (RFC-0004), from plugins of lattice's own, which proto loads once you trust
# this file: `proto trust .prototools`. Renovate moves these two by its custom managers.
tofu = "1.13.1"
tflint = "0.64.0"

[plugins.tools]
tofu = "file://./packages/stackr/deploy/aws/tools/tofu.toml"
tflint = "file://./packages/stackr/deploy/aws/tools/tflint.toml"

# Only this file chooses proto's tools: uv owns Python, from .python-version.
[settings]
detect-strategy = "only-prototools"
