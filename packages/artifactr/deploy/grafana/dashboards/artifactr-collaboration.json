{
  "uid": "artifactr-collaboration",
  "title": "artifactr / Collaboration",
  "description": "How people and agents share the work: proposals, edits and feedback.",
  "tags": [
    "artifactr"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "artifactr dashboards",
      "type": "dashboards",
      "tags": [
        "artifactr"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total, job)",
          "refId": "job"
        },
        "definition": "label_values(artifactr_commands_total, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": null,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(artifactr_commands_total{job=~\"$job\"}, artifactr_tenant_id)",
          "refId": "tenant"
        },
        "definition": "label_values(artifactr_commands_total{job=~\"$job\"}, artifactr_tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Proposals",
      "description": "Proposals created, accepted and rejected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_proposal_action) (rate(artifactr_proposals_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_proposal_action}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Acceptance rate",
      "description": "The share of decided proposals that were accepted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (rate(artifactr_proposals_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_proposal_action=\"accepted\"}[$__rate_interval]))) / clamp_min(sum (rate(artifactr_proposals_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_proposal_action=~\"accepted|rejected\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "accepted",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Changes by who",
      "description": "Artifact edits by people, the agent and external agents.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_actor_kind) (rate(artifactr_artifact_changes_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_change=\"changed\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_actor_kind}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Agent's share of edits",
      "description": "The share of artifact edits made by the agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (rate(artifactr_artifact_changes_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_change=\"changed\", artifactr_actor_kind=\"agent\"}[$__rate_interval]))) / clamp_min(sum (rate(artifactr_artifact_changes_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\", artifactr_change=\"changed\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "agent",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Feedback by type",
      "description": "Feedback given, by type and what it is about.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_feedback_type, artifactr_feedback_target) (rate(artifactr_feedback_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_feedback_type}} on {{artifactr_feedback_target}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Feedback by who",
      "description": "Feedback from people and from evaluators.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (artifactr_actor_kind) (rate(artifactr_feedback_total{job=~\"$job\", artifactr_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{artifactr_actor_kind}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
