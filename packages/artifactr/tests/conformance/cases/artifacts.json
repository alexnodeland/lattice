    {
      "name": "the artifact type describes its own changes",
      "actor": {
        "kind": "user",
        "id": "alice",
        "name": "Alice"
      },
      "given": {
        "artifacts": [
          {
            "id": "list_1",
            "kind": "checklist",
            "version": 1,
            "data": {
              "title": "Launch",
              "items": {
                "t1": {
                  "title": "Write docs",
                  "done": false
                }
              }
            },
            "updated_by": {
              "kind": "user",
              "id": "alice",
              "name": "Alice"
            }
          }
        ]
      },
      "command": {
        "type": "edit_artifact",
        "artifact_id": "list_1",
        "base_version": 1,
        "patch": {
          "kind": "json_patch",
          "ops": [
            {
              "op": "replace",
              "path": "/items/t1/done",
              "value": true
            }
          ]
        },
        "proposal_id": "prp_new"
      },
      "expect": {
        "outcome": {
          "type": "applied",
          "version": 2
        },
        "events": [
          {
            "summary": "checked 'Write docs'"
          }
        ]
      }
    },
    {
      "name": "a patch is described when nothing else describes the change",
