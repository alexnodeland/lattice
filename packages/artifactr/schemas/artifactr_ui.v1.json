{
  "$defs": {
    "App": {
      "additionalProperties": false,
      "description": "A mini app: one HTML file an agent wrote, its text fallback, and its state.\n\nportalr runs it sandboxed, on an origin of its own, loading nothing, while mini apps are on\nin the workspace; its ``summary`` is shown beside it, and in its place where it doesn't run.\nAn agent writes it, and its HTML names nothing to load, which the agent's tools and the\nchecks hold; a person changes only its ``state``, through the app.",
      "properties": {
        "html": {
          "title": "Html",
          "type": "string"
        },
        "state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "State",
          "type": "object"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "html"
      ],
      "title": "App",
      "type": "object"
    },
    "ArrayProperty": {
      "additionalProperties": false,
      "description": "Some of its items' choices, as checkboxes.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
