#!/usr/bin/env bash
# Validate the stack's configuration without starting it. CI runs exactly this.
#
# Usage: scripts/validate   (after `make env`, so `.env` exists)
set -euo pipefail
cd "$(dirname "$0")/.."

failures=0
step() { printf '\n==> %s\n' "$*"; }
fail() {
  printf 'FAIL: %s\n' "$*" >&2
  failures=$((failures + 1))
}

if [[ ! -f .env ]]; then
  echo "validate: .env is missing; run \`make env\` first" >&2
  exit 1
fi

step "YAML lint"
uv run yamllint --strict . || fail "yamllint"

step "Compose configuration, per profile"
# Every profile on its own and all of them together, failing on warnings such
# as a variable missing from .env.
check_compose() {
  local label=$1 output
  shift
  if ! output=$(docker compose "$@" config --quiet 2>&1); then
    fail "compose ($label): $output"
  elif [[ -n $output ]]; then
    fail "compose ($label) warned: $output"
  else
    echo "ok: $label"
  fi
}
check_compose "no profile"
for profile in $(docker compose config --profiles); do
  check_compose "$profile" --profile "$profile"
done
check_compose "all profiles" --profile '*'
# A single host (RFC-0004): the overlay, on every profile, with the domain it serves.
STACKR_DOMAIN=example.com check_compose "a single host" \
  -f compose.yaml -f deploy/host/compose.prod.yaml --profile '*'
# The task trackers' recipes (lattice RFC-0004), each a project of its own, on stackr's .env.
for tracker in trackers/*/compose.yaml; do
  check_compose "${tracker%/compose.yaml}" --env-file .env -f "$tracker"
done

step "The single host's edge"
if docker run --rm -v "$PWD/deploy/host/Caddyfile:/etc/caddy/Caddyfile:ro" -e STACKR_DOMAIN=example.com \
  -e STACKR_EDITOR_HOSTS=gridcraft.example.com \
  "$(STACKR_DOMAIN=example.com docker compose -f compose.yaml -f deploy/host/compose.prod.yaml \
    config --format json | jq -r .services.caddy.image)" \
  caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
  echo "ok: deploy/host/Caddyfile"
else
  fail "deploy/host/Caddyfile"
fi

step "Grafana dashboards"
uv run scripts/check-config dashboards || fail "dashboards"

step "The Supabase project"
uv run scripts/check-config supabase || fail "supabase"

step "The gateway's configuration"
uv run scripts/check-config litellm || fail "litellm"

step "What make up refuses, and the gateway's groups' check"
scripts/check-make || fail "make"

step "The AWS recipe, against the stack"
uv run scripts/check-config aws || fail "aws"

step "The application template, rendered in every variant"
uv run scripts/check-template || fail "template"

step "Service configurations, with each service's own validator"
# Each runs the image compose.yaml pins, offline, with the config mounted as
# the service would see it.
compose_json=$(docker compose --profile '*' config --format json)
image_of() { jq -r --arg name "$1" '.services[$name].image' <<<"$compose_json"; }
# The environment compose.yaml gives a service, in a private file rather than
# on docker's command line.
env_dir=$(mktemp -d)
trap 'rm -rf "$env_dir"' EXIT
env_file_of() {
  (umask 077 && jq -r --arg name "$1" \
    '.services[$name].environment // {} | to_entries[] | "\(.key)=\(.value)"' \
    <<<"$compose_json" >"$env_dir/$1.env")
  printf '%s' "$env_dir/$1.env"
}
check_service() {
  local label=$1 output
  shift
  if output=$(docker run --rm --network none "$@" 2>&1); then
    echo "ok: $label"
  else
    fail "$label: $output"
  fi
}
check_service "OpenTelemetry Collector" \
  --env-file "$(env_file_of otel-collector)" \
  -v "$PWD/deploy/otel-collector:/etc/otelcol-contrib:ro" \
  "$(image_of otel-collector)" validate --config=/etc/otelcol-contrib/config.yaml
check_service "Prometheus" \
  -v "$PWD/deploy/prometheus:/etc/prometheus:ro" --entrypoint promtool \
  "$(image_of prometheus)" check config --syntax-only /etc/prometheus/prometheus.yml
check_service "Tempo" \
  -v "$PWD/deploy/tempo:/etc/tempo:ro" \
  "$(image_of tempo)" -config.file=/etc/tempo/tempo.yaml -config.expand-env=true -config.verify=true
check_service "Loki" \
  -v "$PWD/deploy/loki:/etc/loki:ro" \
  "$(image_of loki)" -config.file=/etc/loki/loki.yaml -config.expand-env=true -verify-config=true

step "Shell scripts"
# OpenTofu's templates (*.tftpl) are scripts only once rendered, with their values in place:
# deploy/aws/check renders the state host's user data and checks it.
shell_scripts=()
while IFS= read -r file; do shell_scripts+=("$file"); done \
  < <(grep -rlE --exclude='*.tftpl' '^#!/usr/bin/env (bash|sh)' scripts deploy .devcontainer template | sort)
if uv run shellcheck "${shell_scripts[@]}"; then
  echo "ok: ${shell_scripts[*]}"
else
  fail "shellcheck"
fi

step "Python scripts"
if uv run ruff format --check . && uv run ruff check .; then
  echo "ok"
else
  fail "ruff"
fi

if ((failures > 0)); then
  printf '\nvalidate: %d check(s) failed\n' "$failures" >&2
  exit 1
fi
printf '\nvalidate: all checks passed\n'
