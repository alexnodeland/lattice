#!/usr/bin/env bash
# Run everything together on this machine (stackr ADR-0053): stackr's stack, on plain PostgreSQL
# with GoTrue, and an application from the template beside it, with the portal, every crafting
# app copier.yml names without a `platform:` (so not Blender, on any machine), and diagrams. They
# stay two Compose projects, `stackr` and the application's, joined by the stack's networks, as
# `make smoke-app` runs them.
#
# Usage, from lattice's root, as `make dev`, `make dev-down`, `make dev-status` and `make dev-reset`:
#   scripts/dev up|down|status|reset
#   DEV_APP_DIR     where the application is generated (default: .local/run/portal, gitignored)
#   DEV_APP_NAME    its name, from which its package and Compose project are named (default: Portal)
#   DEV_REF         the commit it is generated from, or updated to, which must be on origin,
#                   since the image installs the libraries from GitHub at it (default: HEAD)
#   DEV_TENANT      the gateway's tenant whose key the application uses (default: dev)
#   DEV_DIAGRAMS    the application's DIAGRAMS, set on every run (default: on)
#   DEV_LAN         yes, to start with STACKR_BIND or APP_BIND beyond the loopback (default: no)
#   DEV_STACKR_DIR  stackr's directory, for scripts/check-dev (default: packages/stackr)
#
# `up` is safe to run again. It generates the application and makes its two gateway keys once.
# When the application was generated from another commit than DEV_REF, it runs `copier update`
# there to DEV_REF, keeping its answers, and commits the result ("chore: update from template");
# it refuses, before anything starts, an application with uncommitted changes, and an update that
# leaves conflicts (`.rej` files or conflict markers), naming the files. It makes the keys once,
# writing each key into the application's .env (mode 0600) as soon as it is made, and never
# printing it. It sets FILES_CRAFTS there only while it is unset, so your choice stays, and
# DIAGRAMS from DEV_DIAGRAMS every time. The image build, the database role (`db-roles`) and the
# start are idempotent and run every time. `down` stops both projects and keeps their data;
# `reset` deletes the containers and volumes of these two projects alone, the application's
# first, once you confirm, and takes the gateway keys, which went with the stack, out of its .env.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$(pwd -P)
stackr=${DEV_STACKR_DIR:-$root/packages/stackr}
app=${DEV_APP_DIR:-.local/run/portal}
[[ $app == /* ]] || app=$root/$app
app=${app%/}
# The stack's images and the application's run natively, and each project is the one its own
# directory names: settings exported for other work would change either.
unset DOCKER_DEFAULT_PLATFORM COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PATH_SEPARATOR
PROFILES="observability langfuse gateway auth analytics umami"
# The gateway keys the application's .env holds, which the stack's data holds too.
KEYS=(LITELLM_API_KEY PORTAL_LITELLM_KEY)

say() { printf 'dev: %s\n' "$*" >&2; }
die() {
  say "$*"
  exit 1
}
need() { command -v "$1" >/dev/null || die "$1 isn't installed: $2"; }
# A setting of a .env, as `make` reads it: its first line, or DEFAULT.
setting() {
  local value
  value=$(sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1)
  printf '%s' "${value:-${3:-}}"
}
app_compose() { docker compose --project-directory "$app" "$@"; }
# Whether DEV_APP_DIR holds an application make dev generated.
generated() { [[ -f $app/.copier-answers.yml ]]; }
# The application's Compose project, as its compose.yaml names it; refused unless it is a name
# Compose takes, and not the stack's.
app_project() {
  local name
  name=$(sed -n 's/^name: *//p' "$app/compose.yaml" | head -n 1)
  [[ $name =~ ^[a-z0-9][a-z0-9_-]*$ && $name != stackr ]] ||
    die "$app/compose.yaml names the project '$name', which isn't an application's"
  printf '%s' "$name"
}
# A path with `..` and links resolved, whether or not it is there yet.
resolved() { uv run --no-sync python -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
# git, with an identity of its own where this machine has none, for the application's first
# commit, and no hooks: it is the template's output, as generated.
git_quietly() {
  local identity=()
  [[ -n $(git config user.name || true) ]] || identity+=(-c user.name="make dev")
  [[ -n $(git config user.email || true) ]] || identity+=(-c user.email="make-dev@localhost")
  git ${identity[@]+"${identity[@]}"} -c commit.gpgsign=false "$@"
}

# The crafting apps whose workers run: every one copier.yml pins without a `platform:`, so not
# those built for one platform alone (Blender's, amd64's), on any machine.
crafts() {
  uv run --no-sync python -c '
import sys, yaml
crafts = yaml.safe_load(open(sys.argv[1]))["crafts"]["default"]
print(",".join(name for name, craft in crafts.items() if "platform" not in craft))
' "$stackr/copier.yml"
}

# What `up` needs, checked before anything starts: the tools, the adapter, where the application
# goes, and, for an application not generated yet or generated from another commit, a commit on
# origin (into `commit`, and the one it was generated from into `from`).
preflight() {
  need docker "Docker, with Compose v2, runs both projects"
  docker compose version >/dev/null 2>&1 || die "Docker has no Compose v2 (\`docker compose\`)"
  need uv "https://docs.astral.sh/uv/"
  need git "the application is a repository of its own"
  need make "both projects' commands are make targets"
  # The ports publish on the loopback alone, unless DEV_LAN=yes chooses otherwise.
  local bind
  for bind in "$(setting "$stackr/.env" STACKR_BIND 127.0.0.1)" "$(setting "$app/.env" APP_BIND 127.0.0.1)"; do
    [[ $bind == 127.* || $bind == localhost || $bind == ::1 || ${DEV_LAN:-} == yes ]] ||
      die "STACKR_BIND or APP_BIND publishes on $bind, beyond this machine: set DEV_LAN=yes to choose that"
  done
  # Copier and PyYAML are stackr's dev group's, at uv.lock's versions: where lattice's
  # environment hasn't them, that group alone is installed into .venv, beside what is there, and
  # no file of lattice's changes.
  if ! uv run --no-sync python -c 'import copier, yaml' 2>/dev/null; then
    say "installing stackr's dev group, Copier among it, into .venv"
    uv sync --quiet --locked --inexact --package stackr --only-group dev ||
      die "couldn't install stackr's dev group (offline?): \`uv sync --package stackr --only-group dev\` at lattice's root installs it"
    uv run --no-sync python -c 'import copier, yaml' 2>/dev/null ||
      die "lattice's environment still has no Copier, after \`uv sync --package stackr --only-group dev\`"
  fi
  local adapter want recorded where
  adapter=$(setting "$stackr/.env" STACKR_DATABASE)
  [[ ! -f $stackr/.env || $adapter == postgres ]] ||
    die "stackr's .env chooses STACKR_DATABASE=${adapter:-supabase}; this runs on postgres, with GoTrue: set it there, after \`make down\` in packages/stackr, or run the stack as it is and wire an application by hand (docs/stackr/getting-started.md)"
  [[ ! -L $app ]] || die "DEV_APP_DIR=$app is a link: name the directory itself"
  where=$(resolved "$app")
  [[ $where != "$root" && $root/ != "$where"/* ]] || die "DEV_APP_DIR=$app would hold lattice itself"
  want=$(git rev-parse --verify "${DEV_REF:-HEAD}^{commit}") || die "DEV_REF=${DEV_REF:-HEAD} isn't a commit"
  if generated; then
    recorded=$(sed -n 's/^_commit: *//p' "$app/.copier-answers.yml" | head -n 1)
    [[ $(git rev-parse --verify --quiet "$recorded^{commit}" || true) != "$want" ]] || return 0
    local changes
    changes=$(git -C "$app" status --porcelain 2>&1) ||
      die "$app isn't a git repository, which \`copier update\` needs: $changes"
    [[ -z $changes ]] ||
      die "$app was generated from $recorded, not ${DEV_REF:-HEAD} ($want), and has changes that aren't committed: commit or discard them there, and \`make dev\` updates it; nothing was started"
    commit=$want from=${recorded:-another commit}
    pushed
    return
  fi
  [[ ! -e $app || -z $(ls -A "$app") ]] ||
    die "$app is there, and isn't an application make dev generated: set DEV_APP_DIR to another directory"
  # A run that died while generating left this: it is started again from nothing, if it is that.
  if [[ -e $app.rendering ]]; then
    [[ -z $(ls -A "$app.rendering") || -f $app.rendering/.copier-answers.yml ]] ||
      die "$app.rendering is there, and isn't one make dev was generating: remove it, or set DEV_APP_DIR"
    rm -rf "$app.rendering"
  fi
  [[ -z $(git status --porcelain) ]] ||
    say "lattice's working tree has changes, which aren't generated: the application is lattice at a commit"
  commit=$want
  pushed
}

# Whether `commit` is on origin, where the image installs the libraries from.
pushed() {
  git remote get-url origin >/dev/null 2>&1 ||
    die "this clone has no remote origin: the image installs the libraries from GitHub, at a commit there"
  git fetch --quiet origin ||
    die "offline: can't tell whether $commit is on origin: set DEV_REF to a commit you know is pushed"
  [[ -n $(git for-each-ref --contains "$commit" refs/remotes/origin) ]] ||
    die "$commit isn't on origin ($(git remote get-url origin)): the image installs the libraries from GitHub at it, so push it, or set DEV_REF to a commit that is"
}

# The application, generated from the commit preflight checked, in a repository of its own, as
# `copier update` and its hooks need: beside where it goes, and moved there once it is whole.
render() {
  generated && return
  local rendering=$app.rendering
  say "generating ${DEV_APP_NAME:-Portal} in $app, from $commit"
  mkdir -p "$(dirname "$app")"
  uv run --no-sync copier copy --quiet --defaults --vcs-ref "$commit" \
    --data project_name="${DEV_APP_NAME:-Portal}" "$root" "$rendering"
  uv lock --quiet --directory "$rendering"
  git -C "$rendering" init --quiet
  git -C "$rendering" add --all
  git_quietly -C "$rendering" commit --quiet --no-verify --message "Generated from lattice at $commit"
  rmdir "$app" 2>/dev/null || true
  mv "$rendering" "$app"
}

# The application, moved to the commit preflight checked when it was generated from another, with
# `copier update` and its answers, and committed in its own repository. An update that leaves
# conflicts stops here, before anything starts, naming the files.
update() {
  [[ -n $from ]] || return 0
  local conflicts
  say "updating $app from $from to $commit"
  uv run --no-sync copier update --quiet --defaults --vcs-ref "$commit" "$app" ||
    die "\`copier update\` failed in $app: see above; nothing was started"
  conflicts=$({
    (cd "$app" && find . -name '*.rej' -not -path './.git/*' -not -path './.venv/*' -not -path '*/node_modules/*' | sed 's|^\./||')
    git -C "$app" grep --untracked -I -l -E '^(<<<<<<<|>>>>>>>)( |$)' || true
  } | sort -u | tr '\n' ' ')
  [[ -z $conflicts ]] ||
    die "\`copier update\` to $commit left conflicts in $app: ${conflicts% }. Resolve them there, remove the .rej files and commit, then run \`make dev\` again; nothing was started"
  uv lock --quiet --directory "$app"
  git -C "$app" add --all
  git -C "$app" diff --cached --quiet ||
    git_quietly -C "$app" commit --quiet --no-verify --message "chore: update from template"
}

# stackr's .env, on the postgres adapter: chosen when there is none (preflight refused another).
stack_env() {
  [[ -f $stackr/.env ]] || (umask 077 && echo STACKR_DATABASE=postgres >"$stackr/.env")
  make -s -C "$stackr" env STACKR_DATABASE=postgres
}

# A `stackr` project's PostgreSQL volume, from an earlier stack, keeps the admin password it was
# made with, whatever .env says now: then the stack's db-init would fail halfway. So where there
# is one, PostgreSQL alone is started (or the running one used) and signed in to with .env's
# password, which goes to psql in its environment, never on a command line; if that fails,
# nothing else starts. It signs in over the container's own address, as db-init does from
# another container: the image trusts the loopback and the socket, where any password passes.
# compose.yaml alone: a single host's overlay (STACKR_RECIPE=host) isn't applied here.
# `exec -e PGPASSWORD`, without a value, takes it from this environment (Compose v2; checked
# against a real PostgreSQL on Compose 5.1.2).
stack_volume() {
  [[ -n $(docker volume ls --quiet --filter label=com.docker.compose.project=stackr \
    --filter label=com.docker.compose.volume=postgres-data) ]] || return 0
  local stack=(docker compose --project-directory "$stackr" --profile postgres) said
  local left="the stack's PostgreSQL container may be left running: \`make dev-down\` stops it"
  "${stack[@]}" up --detach --wait postgres || die "PostgreSQL didn't start, to check its volume: $left"
  # shellcheck disable=SC2016 # expanded in the container
  if said=$(PGPASSWORD=$(setting "$stackr/.env" POSTGRES_ADMIN_PASSWORD) "${stack[@]}" exec -T -e PGPASSWORD \
    postgres sh -c 'psql --host "$(hostname -i | cut -d " " -f 1)" --username postgres --dbname postgres --command "SELECT 1"' 2>&1); then
    return 0
  fi
  [[ $said != *"password authentication failed"* ]] ||
    die "the stack's PostgreSQL volume (project stackr, postgres-data) was made with another POSTGRES_ADMIN_PASSWORD than packages/stackr/.env has: use the .env that made it, or \`make dev-reset\`, which deletes the stack's data. $left"
  die "signing in to the stack's PostgreSQL failed: $said. $left"
}

# Settings into the application's .env, through stackr's scripts/wire-app, from stdin. It says
# the names of what it set, never a value.
wire() {
  (cd "$stackr" && uv run --no-sync scripts/wire-app "$app" --analytics --umami --langfuse-project --stdin)
}

# A key just made, into the application's .env; if it can't be written, how to get another.
keep() {
  printf '%s=%s\n' "$1" "$2" | wire ||
    die "$1 was made, and couldn't be written into $app/.env: $3"
}

# The application's two gateway keys, each made once, and written into its .env as soon as it is
# made: a tenant's, and the read-only one portalr's admin reads spend with. Neither is printed.
keys() {
  local tenant=${DEV_TENANT:-dev} alias key status
  alias="$tenant-$(basename "$app")"
  local again="delete the key $alias on the gateway (LiteLLM's /key/delete, by its alias), or set DEV_TENANT to another tenant"
  if [[ -z $(setting "$app/.env" LITELLM_API_KEY) ]]; then
    key=$(cd "$stackr" && uv run --no-sync scripts/create-tenant "$tenant" --quiet --key-alias "$alias") ||
      die "making the gateway key for tenant $tenant failed: see above"
    [[ -n $key ]] || die "the gateway has a key $alias already, whose value can't be read back: $again"
    keep LITELLM_API_KEY "$key" "$again"
  fi
  if [[ -z $(setting "$app/.env" PORTAL_LITELLM_KEY) ]]; then
    local rotate="\`make portal-key ARGS=--rotate\` in packages/stackr replaces it, then run this again"
    status=0
    key=$(cd "$stackr" && uv run --no-sync scripts/create-portal-key --quiet) || status=$?
    ((status != 3)) ||
      die "the gateway has portalr's spend-read key already, whose value can't be read back: $rotate"
    ((status == 0)) && [[ -n $key ]] || die "making portalr's spend-read key failed: see above"
    keep PORTAL_LITELLM_KEY "$key" "$rotate"
  fi
}

# The crafting apps, while .env doesn't choose them, and diagrams, from DEV_DIAGRAMS.
choices() {
  local list settings="DIAGRAMS=${DEV_DIAGRAMS:-on}"$'\n'
  if [[ -z $(setting "$app/.env" FILES_CRAFTS) ]]; then
    list=$(crafts)
    [[ -n $list ]] || die "copier.yml names no crafting app this machine runs"
    settings+="FILES_CRAFTS=$list"$'\n'
  fi
  printf '%s' "$settings" | wire
}

up() {
  local commit="" from="" admin
  preflight
  render
  update
  stack_env
  stack_volume
  say "starting stackr's stack: $PROFILES"
  make -s -C "$stackr" up PROFILES="$PROFILES" STACKR_DATABASE=postgres
  [[ -f $app/.env ]] || make -s -C "$app" env
  keys
  choices
  admin="$(uv run --no-sync python -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb"))["project"]["name"])' "$app/pyproject.toml")-admin"
  say "building the application, and creating the role it works as"
  app_compose --profile app build app
  app_compose --profile app run --rm --no-deps -T app "$admin" db-roles
  make -s -C "$app" up
  say "running: the portal at http://127.0.0.1:$(setting "$app/.env" APP_PORT 8800)/, Grafana at http://127.0.0.1:$(setting "$stackr/.env" GRAFANA_PORT 3000)/"
  say "the first person in: make first-run EMAIL=you@example.com, in $app"
}

down() {
  [[ -f $app/compose.yaml ]] && make -s -C "$app" down
  make -s -C "$stackr" down
}

status() {
  make -s -C "$stackr" ps
  [[ -f $app/compose.yaml ]] && app_compose --profile '*' ps
  return 0
}

# Deletes the two projects' containers and volumes, by their names alone, once confirmed: the
# application's first, since it is on the stack's networks. Local images, networks and anything
# else of Docker's are left as they are. The gateway's keys went with the stack's data, so they
# are taken out of the application's .env, and the next `up` makes new ones.
reset() {
  local projects=() answer project
  generated && [[ -f $app/compose.yaml ]] && projects+=("$(app_project)")
  projects+=(stackr)
  [[ -t 0 ]] || die "reset deletes the data of ${projects[*]}: run it in a terminal, to confirm"
  say "Docker context: $(docker context show). The project stackr is the stack's, which every clone and worktree of lattice on this machine shares."
  read -r -p "Delete the containers and volumes of ${projects[*]}? Type yes: " answer
  [[ $answer == yes ]] || die "nothing was deleted"
  # By its name alone: Compose v2 finds a project's containers and volumes by its labels, with no
  # compose file, and removes that project's and nothing else.
  docker compose version >/dev/null 2>&1 || die "Docker has no Compose v2 (\`docker compose\`)"
  for project in "${projects[@]}"; do
    docker compose -p "$project" down --volumes
  done
  if [[ -f $app/.env ]]; then
    # Where .env is, a link's target, so a link stays one.
    local env
    env=$(resolved "$app/.env")
    (umask 077 && grep -v -E "^($(IFS='|' && echo "${KEYS[*]}"))=" "$env" >"$env.reset" || true)
    mv "$env.reset" "$env"
    say "took ${KEYS[*]} out of $app/.env: the next \`make dev\` makes new ones"
  fi
}

case ${1:-} in
  up | down | status | reset) "$1" ;;
  *) die "usage: scripts/dev up|down|status|reset" ;;
esac
