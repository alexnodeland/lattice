class Recorder:
    """Stands in for a connection to PostgreSQL: it records what it is asked to run."""

    dialect = postgresql.dialect()

    def __init__(self, *, found: bool = False, exempt: bool = False) -> None:
        self.answers = iter([1 if found else None, exempt])
        self.executed: list[str] = []

    def scalar(self, statement: object, parameters: dict[str, str]) -> object:
        assert parameters["role"] == "my app"
        return next(self.answers)

    def exec_driver_sql(self, statement: str) -> None:
        self.executed.append(statement)


@pytest.mark.parametrize(("found", "verb"), [(False, "CREATE"), (True, "ALTER")])
def test_the_role_is_created_or_its_password_set(found: bool, verb: str) -> None:
    recorder = Recorder(found=found)
    create_role(cast(Connection, recorder), "my app", "it's secret", "app")
    [statement] = recorder.executed
    assert statement.startswith(f'{verb} ROLE "my app" LOGIN PASSWORD \'SCRAM-SHA-256$4096:')
    assert "secret" not in statement, "only the password's verifier is sent"


def test_a_role_that_row_level_security_doesnt_hold_is_refused() -> None:
    with pytest.raises(Invalid, match="bypasses row-level security"):
        create_role(cast(Connection, Recorder(exempt=True)), "my app", "secret", "app")


RFC_7677 = SimpleNamespace(
    salt="W22ZaJ0SNY7soEsUEjb6gQ==",
    auth=(
        "n=user,r=rOprNGfwEbeRWgbNEkqO,"
        "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096,"
        "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0"
    ),
    proof="dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=",
    signature="6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=",
)
"""RFC 7677's exchange: the password "pencil", the client's proof and the server's signature."""


def test_the_verifier_checks_rfc_7677s_exchange() -> None:
    verifier = scram_verifier("pencil", salt=base64.b64decode(RFC_7677.salt))
    method, rest = verifier.split("$", 1)
    iterations_salt, keys = rest.split("$")
    assert (method, iterations_salt) == ("SCRAM-SHA-256", f"4096:{RFC_7677.salt}")
    stored, server = (base64.b64decode(key) for key in keys.split(":"))
    auth = RFC_7677.auth.encode()
    assert hmac.digest(server, auth, "sha256") == base64.b64decode(RFC_7677.signature)
    signature = hmac.digest(stored, auth, "sha256")
    client = bytes(a ^ b for a, b in zip(base64.b64decode(RFC_7677.proof), signature, strict=True))
    assert hashlib.sha256(client).digest() == stored, "the client's proof verifies"
    assert scram_verifier("pencil") != scram_verifier("pencil"), "each has a salt of its own"


