def token(
    user: str = "alice",
    *,
{%- if access != 'grantr' %}
    tenant: str | None = TENANT,
{%- endif %}
    audience: str = "authenticated",
    expires_in: int = 3600,
    secret: str = SECRET,
    **claims: Any,
) -> str:
    """An HS256 access token, like one Supabase Auth issues on its legacy JWT secret{% if access == 'grantr' %}: who, never
    where{% endif %}."""
    payload: dict[str, Any] = {
        "sub": user,
        "aud": audience,
        "exp": int(time.time()) + expires_in,
        "email": f"{user}@example.com",
        **claims,
    }
{%- if access != 'grantr' %}
    if tenant is not None:
        payload["app_metadata"] = {"provider": "email", "tenant_id": tenant}
{%- endif %}
    return jwt.encode(payload, secret, algorithm="HS256")


def bearer(user: str = "alice", *, tenant: str = TENANT) -> dict[str, str]:
{%- if access == 'grantr' %}
    """The headers of a user's requests in a tenant: their token, and the tenant's name."""
    return {"Authorization": f"Bearer {token(user)}", "X-Tenant": tenant}
{%- else %}
    """The Authorization header of a user of a tenant."""
    return {"Authorization": f"Bearer {token(user, tenant=tenant)}"}
{%- endif %}


async def nobody(connection: HTTPConnection) -> Principal:
    """Authenticates no one: for parts whose tests never make a request."""
    raise Unauthenticated("no one is signed in")


def say(text: str) -> ModelResponse:
    """A step that replies with text."""
    return ModelResponse(parts=[TextPart(text)])


def call(tool: str, **args: Any) -> ModelResponse:
    """A step that calls one tool."""
    return ModelResponse(parts=[ToolCallPart(tool_name=tool, args=args)])


class Script:
    """A model that answers each request with the next step, and records the requests' settings.

    Tests append steps as they go, and set ``delay``, in seconds, to make each answer take that
    long. The agents stream their requests, and ``function_model`` streams each step.
    """

    def __init__(self, *steps: ModelResponse) -> None:
        self.steps = list(steps)
        self.settings: list[dict[str, Any]] = []
        self.delay = 0.0

    @property
    def model(self) -> FunctionModel:
        return function_model(self._respond)

    async def _respond(self, messages: list[ModelMessage], info: AgentInfo) -> ModelResponse:
        self.settings.append(dict(info.model_settings or {}))
        await asyncio.sleep(self.delay)
        return self.steps.pop(0)


def settings(**gateway: Any) -> Settings:
    """Settings for the tests: HS256 tokens, the tenant's gateway key, no database."""
    return Settings(
        auth=AuthSettings(jwt_secret=SECRET),
        gateway=GatewaySettings(tenant_keys={TENANT: TENANT_KEY}, **gateway),
    )


{%- if access == 'grantr' %}


async def _seed(grants: Grants) -> None:
    await grants.provision_tenant(TENANT, owner="alice", admins=["bob"])
    await grants.provision_tenant(OTHER, owner="carol")


def seeded() -> Grants:
    """grantr in memory, with acme and initech; seeded in a thread, from any test."""
    grants = build_grants(InMemoryStorage(), name=Settings().service_name)
    with ThreadPoolExecutor(1) as thread:
        thread.submit(asyncio.run, _seed(grants)).result()
    return grants
{%- endif %}


def app(script: Script, config: Settings | None = None, **options: Any) -> FastAPI:
    """The application over a scripted model."""
{%- if access == 'grantr' %}
    options.setdefault("grants", seeded())
{%- endif %}
{%- if use_reflexr %}
    options.setdefault("poll_interval", timedelta(milliseconds=10))
{%- endif %}
    return create_app(config or settings(), model=script.model, **options)


def wait_for(condition: Callable[[], object], timeout: float = 30.0) -> None:
    """Wait, polling, until ``condition()`` is truthy; generously, for slow machines."""
    deadline = time.monotonic() + timeout
    while not condition():
        assert time.monotonic() < deadline, "timed out"
        time.sleep(0.01)


