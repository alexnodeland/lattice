        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TextPanel",
      "type": "object"
    },
    "UiHints": {
      "additionalProperties": false,
      "description": "How a form is shown, and nothing else.\n\nA hint names a component of the kit, or carries plain text: none carries a colour, a\nclass, HTML or a URL. ``fields`` hints each property by name, ``order`` and ``sections``\narrange them, and ``submit_label`` names the form's button.",
      "properties": {
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldHints"
          },
          "default": {},
          "title": "Fields",
          "type": "object"
        },
        "order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "sections": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Section"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sections"
        },
        "submit_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submit Label"
        }
      },
      "required": [],
      "title": "UiHints",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The data of artifactr.ui's artifact kinds, by kind; `ask_form`: the `args` of a paused request whose `tool_name` is `ask_form`; and `refusal_reason`: the `reason` an `invalid_state` refusal of a submission carries; and `integration_key`: the `integration` a `not_enabled` refusal names, for the forms' integrations.",
