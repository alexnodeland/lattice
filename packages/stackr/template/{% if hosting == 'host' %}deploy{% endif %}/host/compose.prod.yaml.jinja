# {{ project_name }} on a single host, beside stackr's stack behind its edge (stackr RFC-0004): an
# overlay on compose.yaml, for the app profile.
#
#   docker compose -f compose.yaml -f deploy/host/compose.prod.yaml --profile app up --detach --wait
#
# It runs the image APP_IMAGE names, as this application's CI publishes it, publishes no port,
# since stackr's Caddy reaches it as app:8000 on the stackr network, and joins only that network:
# on a single host, PostgreSQL and GoTrue are stackr's own services.
{%- if access == 'grantr' %} Before it first starts, and when
# DATABASE_URL's password changes, create the role it works as:
#
#   docker compose -f compose.yaml -f deploy/host/compose.prod.yaml --profile app \
#     run --rm app {{ project_slug }}-admin db-roles
{%- endif %}

services:
  app:
    build: !reset null
    image: ${APP_IMAGE:?set APP_IMAGE in .env, the image to run}
    ports: !reset []
{%- if use_tracker and tracker == 'plane' %}
    networks: !override
      stackr:
        aliases: [app.stackr.internal]
{%- if use_files %}
      files: {}
{%- endif %}
{%- else %}
    networks: !override [stackr{% if use_files %}, files{% endif %}]
{%- endif %}
    # GoTrue on the stack's network: its key set, and{% if access == 'grantr' %} its admin API, which the edge refuses{% else %} nothing else{% endif %}.
    environment:
      AUTH_JWKS_URL: http://gotrue:9999/.well-known/jwks.json
{%- if access == 'grantr' %}
      AUTH_ADMIN_URL: http://gotrue:9999
{%- endif %}
{%- if use_portal %}
      # The edge reaches the application as app:8000, so the client's address and scheme are in
      # X-Forwarded-*, which uvicorn trusts only from the addresses listed. The application is on
      # the stackr network with every service of the stack, so this trusts any of them: they are
      # stackr's own, and none is reachable from outside but through the edge.
      FORWARDED_ALLOW_IPS: "*"
      # The portal is part of what is deployed: the application doesn't start without the
      # Supabase project its UIs sign in to (PORTAL_SUPABASE_KEY in .env, the publishable key
      # only), rather than start with the portal off, nor with a project at a plain-http address.
      PORTAL_REQUIRED: "true"
      # The project is this host: the edge serves GoTrue's sign-in calls under /auth/v1 on the
      # application's own address, so a browser stays on one origin (the CSP's connect-src 'self',
      # no CORS), and the application passes none itself. Not the .env's PORTAL_SUPABASE_URL.
      PORTAL_SUPABASE_URL: https://app.${STACKR_DOMAIN:?set STACKR_DOMAIN in .env, the domain stackr's edge serves}
      # Invitations need Supabase's gateway (`/auth/v1/invite`), which a single host's GoTrue,
      # alone, doesn't have behind its private address, and its admin API is the edge's to refuse.
      # So they are off here, and say why; local Supabase's address in stackr.env is not this host's.
      PORTAL_AUTH_URL: ""
      # The kit .env names, in the image's copy of brand/ (brand/kit there is /brand/kit here).
      PORTAL_BRAND_DIR: ${PORTAL_BRAND_DIR:+/${PORTAL_BRAND_DIR}}
{%- if use_files %}
      # Each running app's editor at the edge, on a name of its own, <app>.<domain>, which
      # STACKR_EDITOR_HOSTS in stackr's .env lists (stackr ADR-0046).
      FILES_EDITOR_DOMAIN: ${STACKR_DOMAIN}
{%- endif %}
{%- endif %}
{%- if use_files and use_portal %}
{%- for name, craft in crafts.items() if craft.editor %}

  # {{ name }}'s editor, which stackr's edge reaches on the stackr network: no port of its own.
  files-{{ name }}-editor:
    ports: !reset []
    networks: !override [stackr]
    environment:
      PORTAL_URL: https://app.${STACKR_DOMAIN}
{%- endfor %}
{%- endif %}
