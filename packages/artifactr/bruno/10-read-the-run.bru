meta {
  name: Read the run
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/workspaces/{{workspace}}/runs/{{run}}
  body: none
  auth: none
}

script:pre-request {
  // The message starts its run in the background, so the run may not be recorded yet: wait, for
  // up to ten seconds, until the thread's log holds the run's `run_started`, then read the run
  // once. The log's tail always answers 200, so nothing waits on a 404: inside `bru run`'s
  // QuickJS sandbox a rejected `sendRequest` loses its `response`, so a 404 can't be told from a
  // failure there. The poll sends this request's headers, the collection's x-user among them.
  const run = bru.getVar("run");
  const thread = encodeURIComponent(bru.getEnvVar("thread"));
  const url = bru.interpolate(`{{baseUrl}}/workspaces/{{workspace}}/events?thread_id=${thread}`);
  const headers = req.getHeaders();
  const deadline = Date.now() + 10000;
  for (;;) {
    const tail = await bru.sendRequest({ method: "GET", url, headers });
    if (tail.data.some((envelope) => envelope.event.type === "run_started" && envelope.event.run_id === run)) {
      break;
    }
    if (Date.now() > deadline) {
      throw new Error("the run wasn't recorded within ten seconds: its run_started isn't in the log");
    }
    await bru.sleep(200);
  }
}

tests {
  test("it is the thread's run", function () {
    expect(res.status).to.equal(200);
    expect(res.body.thread_id).to.equal(bru.getEnvVar("thread"));
  });
}
