meta {
  name: Create a thread
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/workspaces/{{workspace}}/commands
  body: json
  auth: none
}

body:json {
  {
    "type": "command",
    "command_id": "create-thread",
    "command": {
      "type": "create_thread",
      "thread_id": "{{thread}}",
      "title": "Launch"
    }
  }
}

tests {
  test("it is recorded", function () {
    expect(res.status).to.equal(200);
    expect(res.body.ok).to.equal(true);
    expect(res.body.outcome.type).to.equal("recorded");
  });
}
