# What `docker build` leaves out: the image needs pyproject.toml, uv.lock, README.md and src/ (and
# scripts/ and brand/, for portalr's UIs and the brand kit, in an application that has the portal).
.git
.env
.venv
**/__pycache__
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
.cache
dist
tests
evals
# A brand kit is brand.json, its tokens and its assets and fonts: nothing hidden in brand/, such
# as an .env or an editor's file, goes into the image, which copies the folder.
brand/**/.*
