[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
{%- if use_artifactr %}
    "artifactr-ai[sql,postgres,fastapi,mcp,otel,langfuse,litellm{% if use_ui %},forms{% endif %}{% if use_files %},files{% endif %}{% if use_diagrams %},excalidraw{% endif %}]",
{%- endif %}
{%- if use_reflexr %}
    "reflexr[sql,postgres,fastapi,mcp,otel,langfuse,litellm{% if evals %},evals{% endif %}]",
{%- endif %}
{%- if evals %}
    "evalr[langfuse]",
{%- endif %}
{%- if access == 'grantr' %}
    "grantr[sql,postgres,fastapi]",
{%- endif %}
{%- if use_relayr %}
    "relayr-ai[sql,postgres,otel,langfuse,evals{% if use_ui %},forms{% endif %}{% if use_diagrams %},excalidraw{% endif %}{% if use_tracker %},fastapi,{{ tracker }}{% endif %}]",
{%- endif %}
{%- if use_tracker or use_files %}
    "httpx>=0.28",
{%- endif %}
{%- if use_portal %}
    "portalr[sql]",
{%- endif %}
{%- if use_integrations or use_portal %}
    "lattice-core-ai",
{%- endif %}
    "pyjwt[crypto]>=2.10",
    "uvicorn[standard]>=0.54",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.app:main"
{%- if access == 'grantr' %}
{{ project_slug }}-admin = "{{ package_name }}.admin:main"
{%- endif %}

[dependency-groups]
test = [
    "pytest>=9.1",
    "pytest-asyncio>=1.4",
    "pytest-cov>=7.1",
    "httpx>=0.28",
    "aiosqlite>=0.22",
]
{%- if evals and use_relayr %}
# The incident experiment drives the application in process, on SQLite.
evals = ["httpx>=0.28", "aiosqlite>=0.22"]
{%- endif %}
lint = ["ruff>=0.16", "pyright>=1.1.414"]
dev = [
{%- if evals and use_relayr %}
    { include-group = "evals" },
{%- endif %}
    { include-group = "test" },
    { include-group = "lint" },
    "pre-commit>=4.6",
]

[build-system]
requires = ["uv_build>=0.12,<0.13"]
build-backend = "uv_build"

# The libraries are on PyPI, but the template takes each from lattice, at the commit the template
# was rendered from, so `copier update` moves them with the template's code. To try another
# commit, change every rev here to it, then `uv lock`.{% if use_portal %}
#
# portalr's wheel carries its two UIs, which Vite builds; its source has none. The Dockerfile
# builds them from the same commit (PORTAL_UI_DIR); a checkout's `make portal-ui` does too.{% endif %}
[tool.uv.sources]
{%- for distribution, package, used in [
    ("artifactr-ai", "artifactr", use_artifactr),
    ("reflexr", "reflexr", use_reflexr),
    ("evalr", "evalr", evals),
    ("grantr", "grantr", access == 'grantr'),
    ("relayr-ai", "relayr", use_relayr),
    ("portalr", "portalr", use_portal),
    ("lattice-core-ai", "lattice-core", use_integrations or use_portal),
] if used %}
{%- if libraries_path %}
{{ distribution }} = { path = "{{ libraries_path }}/{{ package }}", editable = true }
{%- else %}
{{ distribution }} = { git = "https://github.com/alexnodeland/lattice", subdirectory = "packages/{{ package }}", rev = "{{ _copier_conf.vcs_ref_hash }}" }
{%- endif %}
{%- endfor %}

# ─── lint and format ──────────────────────────────────────────────────────────

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.format]
docstring-code-format = true

[tool.ruff.lint]
select = [
    "E", "W", "F", "I", "N", "D", "UP", "B", "SIM", "RUF", "C4", "PIE", "RET",
    "PT", "ASYNC", "PERF", "ARG", "T20", "ERA",
]
ignore = [
    "D105", # magic methods document themselves
    "D107", # __init__ is documented on the class
    "N818", # exceptions are named for what happened (Unauthenticated), not with an Error suffix
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"{% if evals %}, "evals"{% endif %}]
# The tests' helpers come last, whatever the package's name sorts as.
known-local-folder = ["conftest"]
# The libraries' adapters share their names with the libraries they adapt.
known-third-party = ["fastapi", "mcp", "langfuse"]
# lattice's libraries get a section of their own, after the other third-party ones.
section-order = ["future", "standard-library", "third-party", "family", "first-party", "local-folder"]

[tool.ruff.lint.isort.sections]
family = [{% if use_artifactr %}"artifactr", {% endif %}{% if use_reflexr %}"reflexr", {% endif %}"evalr"{% if access == 'grantr' %}, "grantr"{% endif %}{% if use_relayr %}, "relayr"{% endif %}{% if use_portal %}, "portalr"{% endif %}{% if use_integrations or use_portal %}, "lattice_core"{% endif %}]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["D", "ARG"]
{%- if evals %}
# The experiments print their results: they are a command.
"evals/**" = ["T20"]
{%- endif %}

# ─── types ────────────────────────────────────────────────────────────────────

[tool.pyright]
include = ["src", "tests"{% if evals %}, "evals"{% endif %}]
strict = ["src"{% if evals %}, "evals"{% endif %}]
typeCheckingMode = "standard"
pythonVersion = "{{ python_version }}"
venvPath = "."
venv = ".venv"

# ─── tests and coverage ───────────────────────────────────────────────────────

[tool.pytest.ini_options]
testpaths = ["tests"]
{%- if evals %}
# The evals/ directory is importable from the project's root.
pythonpath = ["."]
{%- endif %}
addopts = ["--strict-markers", "--strict-config", "-ra"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
filterwarnings = [
    "error",
    # backoff, which Langfuse uses, calls asyncio.iscoroutinefunction, deprecated in Python 3.14.
    "ignore:'asyncio.iscoroutinefunction' is deprecated:DeprecationWarning:backoff",
]

[tool.coverage.run]
branch = true
source = ["src/{{ package_name }}"{% if evals %}, "evals"{% endif %}]

[tool.coverage.report]
fail_under = 100
show_missing = true
skip_covered = true
exclude_also = [
    "if TYPE_CHECKING:",
    "^\\s*\\.\\.\\.$",
    "class .*\\(Protocol.*\\):",
]
