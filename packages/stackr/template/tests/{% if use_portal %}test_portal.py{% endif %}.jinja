MARK = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">'
    '<rect width="32" height="32" fill="#123456"/></svg>'
)
MAKEFILE = Path(__file__).parents[1] / "Makefile"


def a_kit(folder: Path) -> Path:
    """A brand kit of the deployment's: its names, and a mark for each scheme and the tab."""
    (folder / "assets").mkdir(parents=True)
    for name in ("mark-light.svg", "mark-dark.svg", "favicon.svg"):
        (folder / "assets" / name).write_text(MARK)
    brand = {
        "version": 1,
        "name": "acme",
        "identity": {"product": "Acme", "app": "Acme", "admin": "Acme admin"},
        "assets": {
            "mark": {"light": "assets/mark-light.svg", "dark": "assets/mark-dark.svg"},
            "favicon": "assets/favicon.svg",
        },
    }
    (folder / "brand.json").write_text(json.dumps(brand))
    return folder


def uis(folder: Path) -> Path:
    """Built UIs with a head, as a kit's title and stylesheet are put in."""
    for name in ("app", "admin"):
        (folder / name).mkdir(parents=True)
        (folder / name / "index.html").write_text("<head><title>portalr</title></head>")
    return folder


