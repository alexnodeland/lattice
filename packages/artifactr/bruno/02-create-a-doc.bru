meta {
  name: Create a doc
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workspaces/{{workspace}}/commands
  body: json
  auth: none
}

body:json {
  {
    "type": "command",
    "command_id": "create-doc",
    "command": {
      "type": "create_artifact",
      "artifact_id": "{{doc}}",
      "kind": "doc",
      "thread_id": "{{thread}}",
      "data": {
        "title": "Launch",
        "text": "Ship on Friday."
      }
    }
  }
}

tests {
  test("it is applied at version 1", function () {
    expect(res.status).to.equal(200);
    expect(res.body.outcome.type).to.equal("applied");
    expect(res.body.outcome.version).to.equal(1);
  });
}
