SCHEMA_NAME = re.compile(r"^[a-z_][a-z0-9_]{0,62}$")
"""The PostgreSQL schemas the application accepts: plain lowercase identifiers."""


@dataclass(frozen=True)
class AuthSettings:
    """How access tokens are verified: the identity port.

    Attributes:
        jwks_url: The issuer's JSON Web Key Set, for asymmetrically signed tokens (ES256, RS256),
            as local Supabase issues them.
        jwt_secret: A shared secret, for HS256 tokens, as Supabase projects on the legacy JWT
            secret issue them.
        audience: The ``aud`` a token must carry.
        issuer: The ``iss`` a token must carry, when set.
{%- if access == 'grantr' %}
        service_role_key: Supabase's service role key, for the admin commands that find a user
            by their email; the issuer's admin API is asked.
        admin_url: Where that admin API is, when not at the issuer: on a single host, GoTrue's
            private address, since the edge refuses its admin API (stackr RFC-0004).
{%- else %}
        tenant_claim: Where the tenant is in the token's claims, as a dotted path.
{%- endif %}
    """

    jwks_url: str | None = None
    jwt_secret: str | None = field(default=None, repr=False)
    audience: str = "authenticated"
    issuer: str | None = None
{%- if access == 'grantr' %}
    service_role_key: str | None = field(default=None, repr=False)
    admin_url: str | None = None
{%- else %}
    tenant_claim: str = "app_metadata.tenant_id"
{%- endif %}


@dataclass(frozen=True)
class ModelInfo:
    """A model a person may choose for a turn, as the composer's picker shows it (ADR-0097).

    Attributes:
        id: The gateway's model group, the name a message gives.
        label: What the picker calls it.
        family: Whose model it is, such as ``anthropic``, or ``local``.
        local: Whether it runs on the operator's own hardware: slower to its first token.
        reasoning: Whether it thinks before it answers.
    """

    id: str
    label: str
    family: str = ""
    local: bool = False
    reasoning: bool = False


ALWAYS: Final = (
    ModelInfo(id="default", label="Default"),
    ModelInfo(id="fast", label="Fast"),
)
"""The models every deployment offers, and every tenant by default: the gateway's two groups."""


@dataclass(frozen=True)
class GatewaySettings:
    """How agents reach models: the LLM gateway port.

    Attributes:
        base_url: The gateway's OpenAI-compatible API.
        api_key: The key requests use when their tenant has none of its own.
        model: The model group agents ask for.
        tenant_keys: Each tenant's own key, for its team's budget and rate limits.
        guardrails: The gateway's guardrails every request asks for.
        mock_response: A reply the gateway sends instead of calling a model, for smoke tests;
            the gateway honours it only for keys whose team allows mocked responses.
        first_output_seconds: The most a hosted model's request may take to start answering
            before the turn fails as ``model_stalled`` (artifactr ADR-0095).
        no_output_seconds: The most a hosted model may go quiet mid-answer before the same.
        local_first_output_seconds: The same two, for a model served on the operator's own
            hardware, which is slower to its first token.
        local_no_output_seconds: See above.
        local_models: Model names to count as local whatever their shape; artifactr knows
            LiteLLM's local providers' prefixes (``ollama/``, ``lm_studio/``, ...) and the
            ``local`` aliases by itself, and counts an unknown name as hosted.
        hosted_models: Model names to count as hosted whatever their shape.
        tool_seconds: The most a tool call may take to return before the turn fails as
            ``tool_stalled``; ``None`` waits as long as a tool needs.
        models: Every model a message may name: ``default`` and ``fast``, and those the operator
            lists. Nothing else is ever built, whatever a message names (artifactr ADR-0097).
        allowed_models: The models every tenant is offered, of ``models``: the ceiling each
            tenant's and workspace's ``models:allowed`` only narrows (lattice ADR-0030).
    """

    base_url: str = "http://localhost:4400"
    api_key: str | None = None
    model: str = "default"
    tenant_keys: Mapping[str, str] = field(default_factory=dict[str, str])
    guardrails: tuple[str, ...] = ("pii-mask", "prompt-injection")
    mock_response: str | None = None
    first_output_seconds: float = 120.0
    no_output_seconds: float = 120.0
    local_first_output_seconds: float = 300.0
    local_no_output_seconds: float = 300.0
    local_models: tuple[str, ...] = ()
    hosted_models: tuple[str, ...] = ()
    tool_seconds: float | None = 600.0
    models: tuple[ModelInfo, ...] = ALWAYS
    allowed_models: tuple[str, ...] = ("default", "fast")

    def __post_init__(self) -> None:
        ids = [model.id for model in self.models]
        if missing := [model.id for model in ALWAYS if model.id not in ids]:
            raise ValueError(f"LITELLM_MODELS must list {' and '.join(missing)}")
        if len(set(ids)) != len(ids):
            raise ValueError("LITELLM_MODELS lists a model twice")
        if unknown := sorted(set(self.allowed_models) - set(ids)):
            raise ValueError(f"LITELLM_MODELS_ALLOWED names unlisted {', '.join(unknown)}")


