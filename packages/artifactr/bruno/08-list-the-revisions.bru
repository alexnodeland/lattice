meta {
  name: List the revisions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/workspaces/{{workspace}}/artifacts/{{doc}}/revisions
  body: none
  auth: none
}

tests {
  test("both versions, oldest first", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map((r) => r.version)).to.eql([1, 2]);
  });
}
